  .ac-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .9rem; align-items: end; }
  .ac-wide { grid-column: 1 / -1; }
  .ac-grid .btn { justify-self: start; }
  .ac-days { grid-column: 1 / -1; border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .4rem 1rem; }
  .ac-days legend { font-weight: 600; font-size: .92rem; margin-bottom: .4rem; }
  .ac-days label { display: flex; gap: .35rem; align-items: center; font-size: .92rem; }
  .ac-row { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; margin-top: .8rem; }
