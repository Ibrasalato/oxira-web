---
import { t, contact, type Lang } from '../i18n/content';
import { link } from '../lib/routes';
import Logo from './Logo.astro';
import LangPicker from './LangPicker.astro';
import { builderText } from '../i18n/builder';
import { productsText } from '../i18n/products';
import { growthText } from '../i18n/growth';
import { company } from '../lib/company';

interface Props { lang: Lang; path: string; langs?: Lang[] }
const { lang, path, langs } = Astro.props;
const extra = {
  help: { ar: 'مركز المساعدة', en: 'Help center', de: 'Hilfe', fr: 'Aide', ru: 'Помощь' }[lang],
  cr: { ar: 'السجل التجاري', en: 'CR', de: 'HR-Nr.', fr: 'RC', ru: 'Рег. №' }[lang],
  vat: { ar: 'الرقم الضريبي', en: 'VAT', de: 'USt-Nr.', fr: 'TVA', ru: 'НДС' }[lang],
  verify: { ar: 'التحقق من السجل', en: 'Verify registration', de: 'Registrierung prüfen', fr: 'Vérifier l’immatriculation', ru: 'Проверить регистрацию' }[lang],
  trust: { ar: 'الثقة والأمان', en: 'Trust & security', de: 'Vertrauen & Sicherheit', fr: 'Confiance et sécurité', ru: 'Доверие и безопасность' }[lang],
};
const c = t[lang];
import { bundleText } from '../i18n/bundle';
import { serviceLandings, locationLandings, landingPath } from '../i18n/landing';
import { waText, waPath } from '../i18n/waAgent';
import { footerText } from '../i18n/companyPages';
// Service and location pages exist in Arabic and English only.
const lp = lang === 'ar' || lang === 'en' ? lang : null;
// Careers, press and status pages also exist in Arabic and English only.
const fx = lp ? footerText[lp] : null;
---
<footer class="ft">
  <div class="wrap">
    <div class="ft-top">
      <div class="ft-brand">
        <Logo variant="dark" class="ft-logo" />
        <p>{c.site.footerTagline}</p>
      </div>

      <nav aria-label={c.site.footerCols.company}>
        <h2>{c.site.footerCols.company}</h2>
        <ul>
          {c.site.nav.map((n) => <li><a href={link(lang, n.path)}>{n.label}</a></li>)}
          <li><a href={link(lang, '/website-builder/')}>{builderText[lang].navLabel}</a></li>
          <li><a href={link(lang, '/products/')}>{productsText[lang].nav.products}</a></li>
          <li><a href={link(lang, '/partners/')}>{builderText[lang].account.partner}</a></li>
          {lang === 'ar' && <li><a href={link(lang, '/blog/')}>المدونة</a></li>}
          <li><a href={link(lang, '/online-in-a-day/')}>{bundleText[lang].nav}</a></li>
          <li><a href={link(lang, '/website-audit/')}>{growthText[lang].audit.nav}</a></li>
          {fx && <li><a href={link(lang, '/careers/')}>{fx.careers}</a></li>}
          {fx && <li><a href={link(lang, '/press/')}>{fx.press}</a></li>}
          <li><a href={link(lang, '/help/')}>{extra.help}</a></li>
          <li><a href={link(lang, '/contact/')}>{c.site.contactCta}</a></li>
        </ul>
      </nav>

      <nav aria-label={c.site.footerCols.services}>
        <h2>{c.site.footerCols.services}</h2>
        <ul>
          {lp
            ? <>{serviceLandings.map((l) => <li><a href={link(lang, landingPath(l))}>{l[lp].name}</a></li>)}
                <li><a href={link(lang, '/ai-agents/')}>{c.site.nav.find((n) => n.path === '/ai-agents/')?.label}</a></li>
                <li><a href={link(lang, waPath)}>{waText[lp].name}</a></li>
                {locationLandings.map((l) => <li><a href={link(lang, landingPath(l))}>{l[lp].name}</a></li>)}
                <li><a href={link(lang, '/services/')}>{c.home.servicesLink}</a></li></>
            : c.services.list.map((s) => <li><a href={`${link(lang, '/services/')}#${s.icon}`}>{s.name}</a></li>)}
        </ul>
      </nav>

      <div>
        <h2>{c.site.footerCols.contact}</h2>
        <ul>
          <li><a href={contact.phoneHref} dir="ltr">{contact.phone}</a></li>
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li><a href={contact.whatsappHref} target="_blank" rel="noopener">{c.contact.labels.whatsapp}</a></li>
          <li><a href={`${link(lang, '/contact/')}?type=support`}>{c.contact.labels.support}</a></li>
          <li class="ft-addr">{c.contact.address}</li>
        </ul>
      </div>
    </div>

    <div class="ft-bottom">
      <div>
        <p>© {new Date().getFullYear()} {c.footer.rights}</p>
        {(company.cr || company.vat) && <p class="ft-reg">{company.cr && <span>{extra.cr}: <bdi dir="ltr">{company.cr}</bdi></span>}{company.vat && <span>{extra.vat}: <bdi dir="ltr">{company.vat}</bdi></span>}{company.verifyUrl && <a href={company.verifyUrl} target="_blank" rel="noopener">{extra.verify}</a>}</p>}
      </div>
      <div class="ft-legal">
        <a href={link(lang, '/privacy/')}>{c.legal.privacy}</a>
        <a href={link(lang, '/terms/')}>{builderText[lang].page.terms}</a>
        <a href={link(lang, '/trust/')}>{extra.trust}</a>
        {fx && <a href={link(lang, '/status/')}>{fx.status}</a>}
        <a href={link(lang, '/account/')}>{builderText[lang].account.title}</a>
        <LangPicker lang={lang} path={path} langs={langs} tone="dark" up />
      </div>
    </div>
  </div>
</footer>

<style>
  .ft { background: var(--navy-deep); color: var(--muted-on-navy); font-size: .97rem; }
  .ft-top { display: grid; grid-template-columns: 1.4fr 1fr 1.2fr 1.3fr; gap: 2.5rem; padding-block: clamp(3.5rem, 7vw, 5rem); }
  .ft-brand :global(.ft-logo) { font-size: 1.8rem; }
  .ft-brand p { margin-top: 1rem; max-width: 18rem; }
  .ft h2 { color: #fff; font-size: 1rem; margin-bottom: 1rem; }
  .ft ul { list-style: none; display: grid; gap: .55rem; }
  .ft a { color: var(--muted-on-navy); text-decoration: none; }
  .ft a:hover { color: #fff; }
  .ft-addr { line-height: 1.6; }
  .ft-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding-block: 1.5rem 6.5rem; border-top: 1px solid rgba(255,255,255,.08); font-size: .9rem; }
  .ft-legal { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1.5rem; min-width: 0; }
  @media (max-width: 900px) { .ft-top { grid-template-columns: 1fr 1fr; } .ft-brand { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .ft-top { grid-template-columns: 1fr; } }
  .ft-reg { display: flex; flex-wrap: wrap; gap: .3rem 1.2rem; margin-top: .35rem; font-size: .8rem; opacity: .75; }
  .ft-reg a { text-decoration: underline; text-underline-offset: .2em; }
</style>
