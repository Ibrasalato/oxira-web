---
import { t, contact, clientLogos, type Lang } from '../i18n/content';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p: string) => `${base}/${p}`;
const altHref = lang === 'ar' ? `${base}/en/` : `${base}/`;
const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || '';
const other = lang === 'ar' ? 'en' : 'ar';

// Wire-mesh waves, like the profile cover: two families of curves warped around a centre.
function mesh(w: number, h: number, rows: number, cols: number) {
  const paths: string[] = [];
  const warp = (x: number, y: number) => {
    const dx = (x - w * 0.62) / w, dy = (y - h * 0.55) / h;
    const g = Math.exp(-(dx * dx * 6 + dy * dy * 5));
    return { x: x + 90 * g * Math.sin(dy * 7), y: y + 70 * g * Math.cos(dx * 6) + 24 * Math.sin(x / w * 5.2) };
  };
  for (let r = 0; r <= rows; r++) {
    const pts: string[] = [];
    for (let i = 0; i <= 60; i++) {
      const p = warp((i / 60) * w, (r / rows) * h);
      pts.push(`${p.x.toFixed(1)},${p.y.toFixed(1)}`);
    }
    paths.push(`M${pts.join('L')}`);
  }
  for (let col = 0; col <= cols; col++) {
    const pts: string[] = [];
    for (let i = 0; i <= 40; i++) {
      const p = warp((col / cols) * w, (i / 40) * h);
      pts.push(`${p.x.toFixed(1)},${p.y.toFixed(1)}`);
    }
    paths.push(`M${pts.join('L')}`);
  }
  return paths.join('');
}
const heroMesh = mesh(1400, 720, 26, 44);
const serviceMesh = mesh(1400, 900, 22, 38);

// Network of points and lines, like the profile's contact page.
function network(w: number, h: number, n: number, seed: number) {
  let s = seed;
  const rnd = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
  const pts = Array.from({ length: n }, () => [rnd() * w, rnd() * h]);
  const lines: string[] = [];
  pts.forEach(([x, y], i) => {
    pts.slice(i + 1).forEach(([x2, y2]) => {
      if (Math.hypot(x - x2, y - y2) < w / 5.5) lines.push(`M${x.toFixed(0)},${y.toFixed(0)}L${x2.toFixed(0)},${y2.toFixed(0)}`);
    });
  });
  return { d: lines.join(''), pts };
}
const net = network(1400, 800, 34, 7);
---
<header class="top">
  <div class="wrap top-row">
    <a class="brand" href={lang === 'en' ? `${base}/en/` : `${base}/`} aria-label="Oxira">
      <Logo variant="dark" />
    </a>
    <nav class="nav" aria-label={lang === 'ar' ? 'القائمة الرئيسية' : 'Main'}>
      <a href="#about">{c.nav.about}</a>
      <a href="#services">{c.nav.services}</a>
      <a href="#clients">{c.nav.clients}</a>
      <a href="#work">{c.nav.work}</a>
      <a class="lang" href={altHref} hreflang={other} lang={other}>{c.switchLabel}</a>
      <a class="btn btn-amber nav-cta" href="#contact">{c.nav.contact}</a>
    </nav>
  </div>
</header>

<main>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <svg class="hero-mesh" viewBox="0 0 1400 720" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path d={heroMesh} />
    </svg>
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="kicker">{c.hero.kicker}</p>
        <h1 id="hero-title">{c.hero.title}</h1>
        <p class="hero-body">{c.hero.body}</p>
        <div class="hero-actions">
          <a class="btn btn-amber" href="#contact">{c.hero.cta}</a>
          <a class="btn btn-outline-light" href="#services">{c.hero.secondary}</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <svg class="circuit" viewBox="0 0 420 420">
          <g fill="none" stroke="var(--cyan)" stroke-width="2.5" stroke-linecap="round">
            <path d="M40 120h70l22-22" /><path d="M60 170v70l-24 24" /><path d="M300 330h60l20 20" />
            <path d="M370 90v80l-20 20" /><path d="M300 60h55" /><path d="M70 360h80l18-18" />
          </g>
          <g fill="var(--cyan)">
            <circle cx="40" cy="120" r="5" /><circle cx="132" cy="98" r="5" /><circle cx="60" cy="170" r="5" /><circle cx="36" cy="264" r="5" />
            <circle cx="380" cy="350" r="5" /><circle cx="300" cy="330" r="5" /><circle cx="370" cy="90" r="5" /><circle cx="350" cy="190" r="5" />
            <circle cx="300" cy="60" r="5" /><circle cx="355" cy="60" r="5" /><circle cx="70" cy="360" r="5" /><circle cx="168" cy="342" r="5" />
          </g>
        </svg>
        <div class="hero-mark"><Logo variant="dark" wordmark={false} /></div>
      </div>
    </div>
  </section>

  <!-- About: introduction, vision, mission -->
  <section id="about" class="about" aria-labelledby="about-title">
    <div class="wrap about-grid">
      <div class="intro">
        <h2 id="about-title">{c.about.introTitle}<span class="alt" lang={other}>{c.about.introEn}</span></h2>
        <p>{c.about.intro}</p>
      </div>
      <div class="vm">
        <article class="vm-card">
          <h3 class="tag-amber">{c.about.visionTitle}<span class="alt" lang={other}>{c.about.visionEn}</span></h3>
          <p>{c.about.vision}</p>
        </article>
        <article class="vm-card">
          <h3 class="tag-amber">{c.about.missionTitle}<span class="alt" lang={other}>{c.about.missionEn}</span></h3>
          <p>{c.about.mission}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="services" aria-labelledby="services-title">
    <svg class="services-mesh" viewBox="0 0 1400 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path d={serviceMesh} />
    </svg>
    <div class="wrap">
      <div class="head head-light">
        <h2 id="services-title">{c.services.title}</h2>
        <p>{c.services.body}</p>
      </div>
      <ul class="service-grid">
        {c.services.list.map((s) => (
          <li class="service">
            <div class="badge">
              <svg class="badge-ring" viewBox="0 0 100 100" aria-hidden="true">
                <circle cx="50" cy="50" r="46" fill="none" stroke="var(--amber)" stroke-width="7" stroke-dasharray="144.5 289" transform="rotate(-90 50 50)" />
                <circle cx="50" cy="50" r="38" fill="#fff" />
                <circle cx="50" cy="50" r="33" fill="none" stroke="var(--amber)" stroke-width="1.5" stroke-dasharray="80 207" transform="rotate(120 50 50)" />
              </svg>
              <Icon name={s.icon} class="badge-icon" />
            </div>
            <h3>{s.name}</h3>
            <p class="service-alt" lang={other}>{s.en}</p>
            <ul class="service-items">
              {s.items.map((it) => <li>{it}</li>)}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Advantages -->
  <section class="adv" aria-labelledby="adv-title">
    <div class="wrap">
      <div class="head head-center">
        <h2 id="adv-title">{c.advantages.title}</h2>
        <p class="adv-sub">{c.advantages.sub}</p>
      </div>
      <ol class="adv-grid">
        {c.advantages.list.map((a, i) => (
          <li class="adv-item">
            <span class="adv-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="tag-amber tag-sm">{a.name}</h3>
              <p>{a.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Clients -->
  <section id="clients" class="clients" aria-labelledby="clients-title">
    <div class="wrap">
      <div class="head head-center">
        <h2 id="clients-title">{c.clients.title}</h2>
        <p>{c.clients.body}</p>
      </div>
      <ul class="client-grid">
        {clientLogos.map((cl) => (
          <li class="client">
            <img src={asset(`clients/${cl.file}`)} alt={cl[lang]} loading="lazy" decoding="async" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Work -->
  <section id="work" class="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="head">
        <h2 id="work-title">{c.work.title}</h2>
        <p>{c.work.body}</p>
      </div>
      <ul class="projects">
        {c.work.projects.map((p) => (
          <li class="project">
            <div class="project-shot">
              <img src={asset(`work/${p.slug}.webp`)} alt="" loading="lazy" decoding="async" width="1200" height="808" />
            </div>
            <div class="project-body">
              <div class="project-logo"><img src={asset(`work/${p.slug}-logo.png`)} alt="" loading="lazy" /></div>
              <div>
                <span class="tag-blue">{p.sector}</span>
                <h3>{p.name}</h3>
              </div>
              <p>{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Call to action -->
  <section class="cta-band" aria-labelledby="cta-title">
    <div class="wrap cta-row">
      <div>
        <h2 id="cta-title">{c.cta.title}</h2>
        <p>{c.cta.body}</p>
      </div>
      <a class="btn btn-amber" href="#contact">{c.cta.button}</a>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="contact" aria-labelledby="contact-title">
    <svg class="net" viewBox="0 0 1400 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path d={net.d} />
      {net.pts.map(([x, y]) => <circle cx={x.toFixed(0)} cy={y.toFixed(0)} r="3.5" />)}
    </svg>
    <div class="wrap contact-grid">
      <div class="contact-info">
        <h2 id="contact-title">{c.contact.title}</h2>
        <p class="contact-lead">{c.contact.body}</p>
        <ul class="details">
          <li><Icon name="phone" class="d-icon" /><span class="sr-only">{c.contact.labels.phone}: </span><a href={contact.phoneHref} dir="ltr">{contact.phone}</a></li>
          <li><Icon name="whatsapp" class="d-icon" /><span class="sr-only">{c.contact.labels.whatsapp}: </span><a href={contact.whatsappHref} target="_blank" rel="noopener">{c.contact.labels.whatsapp}</a></li>
          <li><Icon name="mail" class="d-icon" /><span class="sr-only">{c.contact.labels.email}: </span><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li class="wide"><Icon name="pin" class="d-icon" /><span class="sr-only">{c.contact.labels.address}: </span><span>{c.contact.address}</span></li>
        </ul>
      </div>

      <form class="form" id="lead-form" novalidate
            data-endpoint={formEndpoint}
            data-email={contact.email}
            data-msg-sending={c.contact.form.sending}
            data-msg-sent={c.contact.form.sent}
            data-msg-failed={c.contact.form.failed}
            data-msg-required={c.contact.form.required}
            data-label-submit={c.contact.form.submit}>
        <h3>{c.contact.form.title}</h3>
        <label class="field">
          <span>{c.contact.form.name}</span>
          <input name="name" autocomplete="name" required />
        </label>
        <div class="field-row">
          <label class="field">
            <span>{c.contact.form.email}</span>
            <input name="email" type="email" autocomplete="email" dir="ltr" />
          </label>
          <label class="field">
            <span>{c.contact.form.phone}</span>
            <input name="phone" type="tel" autocomplete="tel" dir="ltr" />
          </label>
        </div>
        <label class="field">
          <span>{c.contact.form.service}</span>
          <select name="service">
            <option value="">{c.contact.form.serviceAny}</option>
            {c.services.list.map((s) => <option value={s.name}>{s.name}</option>)}
            <option value={c.contact.form.other}>{c.contact.form.other}</option>
          </select>
        </label>
        <label class="field">
          <span>{c.contact.form.details}</span>
          <textarea name="details" rows="4" required></textarea>
        </label>
        <input type="text" name="company_website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="btn btn-navy" type="submit">{c.contact.form.submit}</button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</main>

<footer class="foot">
  <div class="wrap foot-row">
    <Logo variant="dark" class="foot-logo" />
    <nav class="foot-nav" aria-label={lang === 'ar' ? 'روابط سريعة' : 'Quick links'}>
      <a href="#about">{c.nav.about}</a>
      <a href="#services">{c.nav.services}</a>
      <a href="#contact">{c.nav.contact}</a>
      <a href={altHref} lang={other}>{c.switchLabel}</a>
    </nav>
    <p>© {new Date().getFullYear()} {c.footer.rights}</p>
  </div>
</footer>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector('.form-status') as HTMLElement;
    const button = form.querySelector('button[type=submit]') as HTMLButtonElement;
    const d = form.dataset;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      if (data.company_website) return; // spam bot filled the hidden field
      delete data.company_website;

      if (!data.name?.trim() || !data.details?.trim() || !(data.email?.trim() || data.phone?.trim())) {
        status.textContent = d.msgRequired!;
        status.dataset.state = 'error';
        return;
      }

      // No endpoint configured yet: open the visitor's email app with the message filled in.
      if (!d.endpoint) {
        const body = Object.entries(data).filter(([, v]) => v).map(([k, v]) => `${k}: ${v}`).join('\n');
        location.href = `mailto:${d.email}?subject=${encodeURIComponent('Oxira: ' + data.name)}&body=${encodeURIComponent(body)}`;
        return;
      }

      button.disabled = true;
      button.textContent = d.msgSending!;
      status.textContent = '';
      try {
        const res = await fetch(d.endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, lang: document.documentElement.lang, page: location.href }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = d.msgSent!;
        status.dataset.state = 'ok';
      } catch {
        status.textContent = d.msgFailed!;
        status.dataset.state = 'error';
      } finally {
        button.disabled = false;
        button.textContent = d.labelSubmit!;
      }
    });
  }
</script>

<style>
  /* Header */
  .top { position: sticky; top: 0; z-index: 20; background: var(--navy-deep); border-bottom: 1px solid rgba(255,255,255,.08); }
  .top-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4.5rem; }
  .brand { text-decoration: none; font-size: 1.75rem; }
  .nav { display: flex; align-items: center; gap: clamp(.8rem, 2vw, 1.8rem); color: #DCE6EF; font-weight: 600; }
  .nav a:not(.btn) { text-decoration: none; }
  .nav a:not(.btn):not(.lang):hover { color: var(--amber); }
  .nav .btn { padding: .7rem 1.15rem; font-size: .95rem; }
  .lang { font-size: var(--s-1); padding: .25rem .8rem; border: 1px solid rgba(255,255,255,.3); border-radius: 999px; }
  .lang:hover { border-color: var(--amber); }
  @media (max-width: 900px) { .nav a[href^='#']:not(.btn) { display: none; } }
  @media (max-width: 440px) { .nav-cta { display: none; } }

  /* Shared heads and tags */
  .head { display: grid; gap: .75rem; margin-bottom: clamp(2rem, 5vw, 3.5rem); max-width: 44rem; }
  .head h2 { font-size: var(--s4); }
  .head p { color: var(--muted); font-size: 1.125rem; }
  .head-center { text-align: center; margin-inline: auto; justify-items: center; }
  .head-light h2 { color: #fff; }
  .head-light p { color: var(--muted-on-navy); }
  .alt { display: block; font-size: .5em; font-weight: 700; color: var(--amber); margin-top: .15rem; }
  .tag-amber { display: inline-flex; flex-direction: column; align-items: flex-start; background: var(--amber); color: var(--navy); padding: .55rem 1.1rem .65rem; border-radius: 10px; font-size: var(--s2); line-height: 1.25; }
  .tag-amber .alt { color: var(--navy); opacity: .75; font-size: .55em; }
  .tag-sm { font-size: 1.1rem; padding: .2rem .8rem .3rem; border-radius: 4px; }
  .tag-blue { display: inline-block; background: var(--blue); color: #fff; font-size: var(--s-1); font-weight: 700; padding: .15rem .75rem; border-radius: 6px; }

  /* Hero */
  .hero { position: relative; overflow: hidden; color: #fff; background: radial-gradient(120% 120% at 70% 40%, var(--navy-mid) 0%, var(--navy) 45%, var(--navy-deep) 100%); }
  .hero-mesh { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-mesh path { fill: none; stroke: #5FA7D8; stroke-opacity: .16; stroke-width: 1; }
  .hero-grid { position: relative; display: grid; grid-template-columns: 1.2fr .8fr; align-items: center; gap: clamp(2rem, 5vw, 4rem); padding-block: clamp(4rem, 10vw, 7.5rem); }
  .kicker { color: var(--amber); font-weight: 700; font-size: 1.05rem; margin-bottom: 1rem; }
  .hero h1 { font-size: var(--s5); line-height: 1.25; text-wrap: balance; }
  html[lang='en'] .hero h1 { line-height: 1.12; }
  .hero-body { margin-top: 1.25rem; font-size: 1.2rem; color: #C9D7E4; max-width: 34rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  .hero-visual { position: relative; aspect-ratio: 1; max-width: 420px; justify-self: center; width: 100%; }
  .circuit { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .9; }
  .hero-mark { position: absolute; inset: 22%; display: grid; place-items: center; font-size: clamp(8rem, 16vw, 13rem); }
  .hero-mark :global(.logo-mark) { filter: drop-shadow(0 14px 30px rgba(0,0,0,.35)); }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { max-width: 260px; order: -1; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-mark :global(polygon) { animation: piece .8s cubic-bezier(.2,.8,.2,1) both; }
    .hero-mark :global(polygon:nth-child(1)) { --dx: -24px; --dy: 0px; animation-delay: .1s; }
    .hero-mark :global(polygon:nth-child(2)) { --dx: 0px; --dy: -24px; animation-delay: .2s; }
    .hero-mark :global(polygon:nth-child(3)) { --dx: 24px; --dy: 0px; animation-delay: .3s; }
    .hero-mark :global(polygon:nth-child(4)) { --dx: 0px; --dy: 24px; animation-delay: .4s; }
    @keyframes piece { from { transform: translate(var(--dx), var(--dy)); opacity: 0; } to { transform: none; opacity: 1; } }
  }

  /* About */
  .about { padding-block: clamp(4rem, 9vw, 7rem); }
  .about-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .intro h2 { font-size: var(--s4); margin-bottom: 1.25rem; }
  .intro h2 .alt { font-size: .45em; }
  .intro p { font-size: 1.2rem; color: var(--muted); max-width: 34rem; }
  .vm { display: grid; gap: 1.5rem; }
  .vm-card { position: relative; border: 2px solid var(--amber); border-radius: var(--radius); padding: 0 1.5rem 1.6rem; background: #fff; }
  .vm-card h3 { transform: translateY(-50%); margin-bottom: -.4rem; }
  .vm-card p { color: var(--ink); font-size: 1.08rem; }
  @media (max-width: 860px) { .about-grid { grid-template-columns: 1fr; } .vm { gap: 2.2rem; margin-top: 1rem; } }

  /* Services */
  .services { position: relative; overflow: hidden; background: var(--navy); padding-block: clamp(4rem, 9vw, 7rem); color: #fff; }
  .services-mesh { position: absolute; inset: 0; width: 100%; height: 100%; }
  .services-mesh path { fill: none; stroke: #2E7FB8; stroke-opacity: .18; stroke-width: 1; }
  .services .wrap { position: relative; }
  .service-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 1.25rem; }
  .service { grid-column: span 2; background: rgba(7, 27, 47, .72); border: 1px solid rgba(255,255,255,.1); border-radius: var(--radius); padding: 1.75rem 1.5rem 1.6rem; backdrop-filter: blur(2px); }
  .service:nth-child(4) { grid-column: 2 / span 2; }
  .badge { position: relative; width: 92px; height: 92px; margin-bottom: 1.1rem; }
  .badge-ring { position: absolute; inset: 0; width: 100%; height: 100%; }
  .badge :global(.badge-icon) { position: absolute; inset: 0; margin: auto; width: 42px; height: 42px; color: var(--navy); }
  .service h3 { font-size: 1.35rem; }
  .service-alt { color: var(--amber); font-weight: 700; font-size: .95rem; margin-top: .1rem; }
  .service-items { list-style: none; margin: 1rem 0 0; padding: 0; color: #C9D7E4; font-size: .98rem; display: grid; gap: .45rem; }
  .service-items li { position: relative; padding-inline-start: 1.1rem; line-height: 1.6; }
  .service-items li::before { content: ''; position: absolute; inset-inline-start: 0; top: .62em; width: 6px; height: 6px; border-radius: 50%; background: var(--cyan); }
  @media (max-width: 980px) {
    .service-grid { grid-template-columns: 1fr 1fr; }
    .service, .service:nth-child(4) { grid-column: auto; }
  }
  @media (max-width: 620px) { .service-grid { grid-template-columns: 1fr; } }

  /* Advantages */
  .adv {
    padding-block: clamp(4rem, 9vw, 7rem);
    background-color: var(--paper);
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 56px 56px;
  }
