---
// Partner program: sign up and get a personal referral link by email.
import type { Lang } from '../i18n/content';
import { builderText } from '../i18n/builder';
import { link } from '../lib/routes';
import Base from '../layouts/Base.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const b = builderText[lang];
const p = b.partners;
const endpoint = 'https://ibrasalato.app.n8n.cloud/webhook/oxira-partner-signup';
---
<Base lang={lang} path="/partners/" title={p.pageTitle} description={p.pageDescription}>
  <section class="page-hero pt-hero">
    <div class="wrap pt-grid">
      <div>
        <p class="label">{p.kicker}</p>
        <h1>{p.h1}</h1>
        <p class="lead">{p.lead}</p>
        <ol class="pt-steps">
          {p.steps.map((s, i) => <li><span aria-hidden="true">{i + 1}</span><div><h2>{s.name}</h2><p>{s.text}</p></div></li>)}
        </ol>
      </div>
      <form class="pt-form" id="pt-form" data-endpoint={endpoint} data-lang={lang} data-sending={p.sending} data-done={p.done} data-failed={p.failed}>
        <h2>{p.formTitle}</h2>
        <label>{p.name}<input name="name" required maxlength="120" autocomplete="name" /></label>
        <label>{p.company}<input name="company" maxlength="120" autocomplete="organization" /></label>
        <label>{p.phone}<input name="phone" type="tel" dir="ltr" required maxlength="30" autocomplete="tel" /></label>
        <label>{p.email}<input name="email" type="email" dir="ltr" required maxlength="160" autocomplete="email" /></label>
        <input class="pt-hp" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="submit" class="btn btn-amber">{p.submit}</button>
        <p class="pt-status" role="status" hidden></p>
        <p class="pt-terms">{p.terms} <a href={link(lang, '/terms/')}>{b.page.terms}</a></p>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('pt-form') as HTMLFormElement;
  const status = form.querySelector<HTMLElement>('.pt-status')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button')!;
    const label = btn.textContent;
    btn.disabled = true; btn.textContent = form.dataset.sending!;
    let ok = false;
    try {
      const fd = new FormData(form);
      fd.set('lang', form.dataset.lang!);
      const res = await fetch(form.dataset.endpoint!, { method: 'POST', body: new URLSearchParams(fd as unknown as Record<string, string>) });
      ok = !!(await res.json().catch(() => ({})))?.success;
    } catch { ok = false; }
    status.hidden = false;
    status.className = `pt-status ${ok ? 'is-ok' : 'is-error'}`;
    status.textContent = ok ? form.dataset.done! : form.dataset.failed!;
    if (ok) form.reset();
    btn.disabled = false; btn.textContent = label;
  });
</script>

<style>
  .pt-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .pt-hero h1 { max-width: 16ch; }
  .pt-steps { list-style: none; display: grid; gap: 1.1rem; margin-top: 2rem; padding: 0; }
  .pt-steps li { display: flex; gap: 1rem; align-items: flex-start; }
  .pt-steps span { width: 40px; height: 40px; flex: none; border-radius: 12px; display: grid; place-items: center; background: var(--amber); color: var(--navy); font-weight: 700; }
  .pt-steps h2 { font-size: 1.1rem; }
  .pt-steps p { color: var(--muted); }
  .pt-form { display: grid; gap: .85rem; padding: 1.8rem; border-radius: var(--radius-lg, 20px); background: #fff; border: 1px solid var(--line); box-shadow: 0 30px 60px -40px rgba(6, 26, 45, .5); }
  .pt-form h2 { font-size: 1.3rem; }
  .pt-form label { display: grid; gap: .35rem; font-weight: 600; font-size: .92rem; }
  .pt-form input { font: 400 1rem var(--font); border: 1.5px solid var(--line); border-radius: 10px; padding: .7rem .85rem; color: var(--ink); }
  .pt-form input:focus { outline: none; border-color: var(--blue); }
  .pt-hp { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; clip: rect(0 0 0 0); }
  .pt-status { padding: .75rem 1rem; border-radius: 10px; font-size: .95rem; }
  .pt-status.is-ok { background: #E7F6EC; color: #1E6B3A; }
  .pt-status.is-error { background: #FEF3F2; color: #B42318; }
  .pt-terms { color: var(--muted); font-size: .85rem; }
  .pt-terms a { color: var(--blue); }
  @media (max-width: 900px) { .pt-grid { grid-template-columns: 1fr; } }
</style>
