---
import { t, type Lang } from '../i18n/content';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import CtaBand from '../components/CtaBand.astro';
import { team } from '../data/team';
import { leadershipTitle } from '../i18n/companyPages';
import { asset } from '../lib/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t[lang];
const pg = c.pages.about;
// Leadership appears only when src/data/team.ts has entries. Names, roles and bios fall back to English outside Arabic.
const tl = lang === 'ar' ? 'ar' : 'en';
const initials = (n: string) => n.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('');
---
<Base lang={lang} path="/about/" title={pg.title} description={pg.description}>
  <section class="page-hero">
    <div class="wrap ab-hero">
      <div>
        <h1>{pg.h1}</h1>
        <p class="lead">{c.about.intro}</p>
      </div>
      <div class="ab-mark" aria-hidden="true"><Logo variant="light" wordmark={false} /></div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap vm">
      <article>
        <h2>{c.about.visionTitle}</h2>
        <p>{c.about.vision}</p>
      </article>
      <article>
        <h2>{c.about.missionTitle}</h2>
        <p>{c.about.mission}</p>
      </article>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="why-title">
    <div class="wrap">
      <div class="sh"><h2 id="why-title">{c.advantages.title}</h2></div>
      <ul class="why">
        {c.advantages.list.map((a) => <li><h3>{a.name}</h3><p>{a.text}</p></li>)}
      </ul>
    </div>
  </section>

  {team.length > 0 && (
    <section class="section team-sec" aria-labelledby="team-title">
      <div class="wrap">
        <div class="sh"><h2 id="team-title">{leadershipTitle[lang]}</h2></div>
        <ul class="team">
          {team.map((m) => (
            <li>
              {m.photo
                ? <img class="tm-photo" src={asset(m.photo)} alt={m.name[tl]} width="400" height="400" loading="lazy" />
                : <span class="tm-photo tm-initials" aria-hidden="true">{initials(m.name[tl])}</span>}
              <h3 lang={tl}>{m.name[tl]}</h3>
              <p class="tm-role" lang={tl}>{m.role[tl]}</p>
              {m.bio && <p class="tm-bio" lang={tl}>{m.bio[tl]}</p>}
              {m.linkedin && <a class="more" href={m.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="process-title">
    <div class="wrap">
      <div class="sh"><h2 id="process-title">{c.process.title}</h2></div>
      <ol class="process">
        {c.process.steps.map((st, i) => (
          <li><span class="p-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3>{st.name}</h3><p>{st.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  .ab-hero { display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: center; }
  .ab-mark { font-size: clamp(8rem, 16vw, 13rem); }
  @media (max-width: 760px) { .ab-hero { grid-template-columns: 1fr; } .ab-mark { display: none; } }

  .vm { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); }
  .vm article { border-top: 3px solid var(--amber); padding-top: 1.5rem; display: grid; gap: .9rem; align-content: start; }
  .vm h2 { font-size: var(--s3); }
  .vm p { font-size: 1.15rem; color: var(--muted); }
  @media (max-width: 760px) { .vm { grid-template-columns: 1fr; } }

  .why { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem 2rem; }
  .why li { border-top: 2px solid var(--ink); padding-top: 1.25rem; display: grid; gap: .5rem; align-content: start; }
  .why h3 { font-size: var(--s1); }
  .why p { color: var(--muted); }
  @media (max-width: 860px) { .why { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .why { grid-template-columns: 1fr; } }

  .team-sec + .section { padding-top: 0; }
  .team { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2.5rem 2rem; }
  .team li { display: grid; gap: .4rem; align-content: start; justify-items: start; }
  .tm-photo { width: 100%; aspect-ratio: 1; height: auto; object-fit: cover; border-radius: var(--radius); background: var(--paper); margin-bottom: .75rem; }
  .tm-initials { display: grid; place-items: center; font-size: 3rem; font-weight: 700; color: var(--navy); background: var(--blue-soft); }
  .team h3 { font-size: var(--s1); }
  .tm-role { color: var(--blue); font-weight: 600; }
  .tm-bio { color: var(--muted); }
  @media (max-width: 860px) { .team { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .team { grid-template-columns: minmax(0, 1fr); } }

  .process { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .process li { display: grid; gap: .6rem; align-content: start; }
  .p-n { font-weight: 700; font-size: 2.4rem; line-height: 1; color: var(--amber); }
  .process h3 { font-size: var(--s1); }
  .process p { color: var(--muted); }
  @media (max-width: 860px) { .process { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .process { grid-template-columns: 1fr; } }
</style>
