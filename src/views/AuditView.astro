---
// Free website audit: a lead magnet. The check runs in n8n (Oxira 17) and the report is also emailed.
import type { Lang } from '../i18n/content';
import { link } from '../lib/routes';
import { growthText } from '../i18n/growth';
import Base from '../layouts/Base.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const A = growthText[lang].audit;
const endpoint = 'https://ibrasalato.app.n8n.cloud/webhook/oxira-site-audit';
const labels = { checks: A.checks, tips: A.tips, scores: A.scores, passed: A.passed, toFix: A.toFix, errUrl: A.errUrl, errEmail: A.errEmail, errFailed: A.errFailed, running: A.running };
const site = Astro.site!;
const ld = {
  '@context': 'https://schema.org', '@type': 'WebApplication', name: A.h1, url: new URL(link(lang, '/website-audit/'), site).href,
  applicationCategory: 'BusinessApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'SAR' },
  provider: { '@type': 'Organization', name: 'Oxira' },
};

---
<Base lang={lang} path="/website-audit/" title={A.title} description={A.description}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <section class="page-hero au-hero">
    <div class="wrap au-grid">
      <div>
        <p class="label">{A.nav}</p>
        <h1>{A.h1}</h1>
        <p class="lead">{A.lead}</p>
        <h2 class="au-what-t">{A.whatTitle}</h2>
        <ul class="au-what">{A.what.map((w) => <li>{w}</li>)}</ul>
      </div>
      <form class="au-form" id="au-form" data-endpoint={endpoint} data-lang={lang} data-labels={JSON.stringify(labels)}>
        <label>{A.url}<input name="url" required maxlength="300" placeholder={A.urlPh} dir="ltr" inputmode="url" autocomplete="url" /></label>
        <label>{A.name}<input name="name" required maxlength="100" autocomplete="name" /></label>
        <label>{A.email}<input name="email" type="email" required maxlength="160" dir="ltr" autocomplete="email" /></label>
        <label>{A.phone}<input name="phone" type="tel" maxlength="30" dir="ltr" autocomplete="tel" /></label>
        <input class="au-hp" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="submit" class="btn btn-amber">{A.submit}</button>
        <p class="au-status" role="status" hidden></p>
        <p class="au-privacy">{A.privacy} <a href={link(lang, '/privacy/')}>↗</a></p>
      </form>
    </div>
  </section>

  <section class="section-tight au-result" id="au-result" hidden aria-live="polite">
    <div class="wrap">
      <div class="au-top">
        <div class="au-ring"><svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="52" class="bg" /><circle cx="60" cy="60" r="52" class="fg" id="au-arc" /></svg><b id="au-score">0</b></div>
        <div>
          <p class="label">{A.scoreTitle}</p>
          <h2 id="au-host"></h2>
          <p class="au-sent">{A.sent}</p>
          <ul class="au-scores" id="au-scores"></ul>
        </div>
      </div>
      <ul class="au-checks" id="au-checks"></ul>
      <div class="au-cta">
        <div><h2>{A.ctaTitle}</h2><p>{A.ctaBody}</p></div>
        <div class="au-btns">
          <a class="btn btn-amber" href={`${link(lang, '/contact/')}?service=website-audit`}>{A.ctaBtn}</a>
          <a class="btn btn-ghost-light" href="#au-form" id="au-again">{A.again}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  type Check = { id: string; ok: boolean; value: string };
  const form = document.getElementById('au-form') as HTMLFormElement;
  const L = JSON.parse(form.dataset.labels!);
  const status = form.querySelector<HTMLElement>('.au-status')!;
  const out = document.getElementById('au-result')!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button')!;
    const label = btn.textContent;
    btn.disabled = true; btn.textContent = L.running; status.hidden = true;
    let r: any = null;
    try {
      const fd = new FormData(form); fd.set('lang', form.dataset.lang!);
      const res = await fetch(form.dataset.endpoint!, { method: 'POST', body: new URLSearchParams(fd as unknown as Record<string, string>) });
      r = await res.json();
    } catch { r = null; }
    btn.disabled = false; btn.textContent = label;
    if (!r || !r.success) {
      status.hidden = false; status.className = 'au-status is-error';
      status.textContent = r && r.error === 'url' ? L.errUrl : r && r.error === 'email' ? L.errEmail : L.errFailed;
      return;
    }
    document.getElementById('au-host')!.textContent = r.host;
    document.getElementById('au-score')!.textContent = String(r.score);
    const arc = document.getElementById('au-arc') as unknown as SVGCircleElement;
    const len = 2 * Math.PI * 52;
    arc.style.strokeDasharray = `${len}`; arc.style.strokeDashoffset = `${len * (1 - r.score / 100)}`;
    arc.style.stroke = r.score >= 80 ? '#1E8E4E' : r.score >= 50 ? '#F5A800' : '#D92D20';
    const sc = r.scores || {};
    document.getElementById('au-scores')!.innerHTML = Object.keys(L.scores).filter((k) => typeof sc[k] === 'number')
      .map((k) => `<li><span>${esc(L.scores[k])}</span><b>${sc[k]}</b></li>`).join('');
    const checks: Check[] = r.checks || [];
    const sorted = [...checks.filter((c) => !c.ok), ...checks.filter((c) => c.ok)];
    document.getElementById('au-checks')!.innerHTML = sorted.map((c) => `<li class="${c.ok ? 'ok' : 'bad'}"><span class="au-i" aria-hidden="true">${c.ok ? '✓' : '!'}</span><div><b>${esc(L.checks[c.id] || c.id)}</b><small>${c.ok ? esc(L.passed) : esc(L.tips[c.id] || L.toFix)}</small></div></li>`).join('');
    out.hidden = false;
    out.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  document.getElementById('au-again')!.addEventListener('click', () => { (form.querySelector('[name=url]') as HTMLInputElement).value = ''; setTimeout(() => (form.querySelector('[name=url]') as HTMLInputElement).focus(), 300); });
</script>

<style>
  .au-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .au-hero h1 { max-width: 14ch; }
  .au-what-t { font-size: 1.1rem; margin: 2rem 0 .8rem; }
  .au-what { list-style: none; display: grid; gap: .55rem; padding: 0; }
  .au-what li { position: relative; padding-inline-start: 1.6rem; color: var(--muted); }
  .au-what li::before { content: '✓'; position: absolute; inset-inline-start: 0; color: var(--blue); font-weight: 700; }
  .au-form { display: grid; gap: .85rem; padding: 1.8rem; border-radius: var(--radius-lg); background: #fff; border: 1px solid var(--line); box-shadow: 0 30px 60px -40px rgba(6, 26, 45, .5); }
  .au-form label { display: grid; gap: .35rem; font-weight: 600; font-size: .92rem; }
  .au-form input { font: 400 1rem var(--font); border: 1.5px solid var(--line); border-radius: 10px; padding: .75rem .85rem; color: var(--ink); min-width: 0; }
  .au-form input:focus { outline: none; border-color: var(--blue); }
  .au-hp { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; clip: rect(0 0 0 0); }
  .au-status.is-error { padding: .7rem 1rem; border-radius: 10px; background: #FEF3F2; color: #B42318; }
  .au-privacy { color: var(--muted); font-size: .85rem; }
  .au-privacy a { color: var(--blue); text-decoration: none; }
  .au-top { display: flex; flex-wrap: wrap; gap: 2rem; align-items: center; margin-bottom: 2rem; }
  .au-ring { position: relative; width: 150px; height: 150px; flex: none; }
  .au-ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .au-ring circle { fill: none; stroke-width: 10; }
  .au-ring .bg { stroke: var(--line); }
  .au-ring .fg { stroke-linecap: round; transition: stroke-dashoffset 1s ease; }
  .au-ring b { position: absolute; inset: 0; display: grid; place-items: center; font-size: 2.6rem; }
  .au-top h2 { font-size: var(--s3); direction: ltr; text-align: start; }
  .au-sent { color: var(--muted); margin-top: .3rem; }
  .au-scores { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; padding: 0; }
  .au-scores :global(li) { display: flex; gap: .5rem; padding: .4rem .8rem; border-radius: 999px; background: var(--paper); font-size: .92rem; }
  .au-checks { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; padding: 0; }
  .au-checks :global(li) { display: flex; gap: .8rem; align-items: flex-start; padding: 1rem 1.1rem; border: 1px solid var(--line); border-radius: 14px; }
  .au-checks :global(li div) { display: grid; gap: .2rem; }
  .au-checks :global(small) { color: var(--muted); font-size: .9rem; line-height: 1.55; }
  .au-checks :global(.au-i) { width: 28px; height: 28px; flex: none; border-radius: 50%; display: grid; place-items: center; font-weight: 700; }
  .au-checks :global(.ok .au-i) { background: #E7F6EC; color: #1E6B3A; }
  .au-checks :global(.bad) { border-color: #F5D0CC !important; background: #FFFBFA; }
  .au-checks :global(.bad .au-i) { background: #FEE4E2; color: #B42318; }
  .au-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 2rem; margin-top: 2rem; padding: 1.75rem; border-radius: var(--radius-lg); background: var(--navy); color: #fff; }
  .au-cta h2 { font-size: var(--s2); }
  .au-cta p { color: var(--muted-on-navy); margin-top: .4rem; max-width: 36rem; }
  .au-btns { display: flex; flex-wrap: wrap; gap: .6rem; }
  @media (max-width: 900px) { .au-grid { grid-template-columns: minmax(0, 1fr); } .au-checks { grid-template-columns: minmax(0, 1fr); } }
</style>
