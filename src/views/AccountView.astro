---
// Client account: sign in with an emailed link, then manage the website, renewals and add-ons.
import type { Lang } from '../i18n/content';
import { builderText } from '../i18n/builder';
import { link } from '../lib/routes';
import { addonIds, addonPrices, addonIcons } from '../builder/addons';
import Base from '../layouts/Base.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const b = builderText[lang];
const a = b.account;
const n8n = 'https://ibrasalato.app.n8n.cloud/webhook';
const config = {
  lang,
  loginEndpoint: `${n8n}/oxira-portal-login`,
  apiEndpoint: `${n8n}/oxira-portal`,
  seoEndpoint: `${n8n}/oxira-seo`,
  seoSettingsEndpoint: `${n8n}/oxira-seo-settings`,
  socialEndpoint: `${n8n}/oxira-social`,
  uploadEndpoint: `${n8n}/oxira-studio-upload`,
  imageBase: 'https://oxira-sites.oxira-sa.workers.dev/_img/',
  extEndpoint: `${n8n}/oxira-site-ext`,
  gscEmail: 'ibrasalato@gmail.com',
  builderUrl: link(lang, '/website-builder/'),
  helpUrl: `${link(lang, '/help/')}#domains-search-console`,
  numberLocale: lang === 'ar' ? 'ar-SA-u-nu-latn' : lang,
  text: a,
  addons: b.addons,
  sar: b.packages.sar,
  prices: addonPrices,
  icons: addonIcons,
  addonIds,
  partnersUrl: link(lang, '/partners/'),
};
---
<Base lang={lang} path="/account/" title={a.pageTitle} description={a.pageDescription} noindex>
  <div class="ac" id="account" data-config={JSON.stringify(config)} data-state="loading">
    <section class="ac-signin wrap" data-show="signin">
      <div class="ac-card ac-signin-card">
        <h1>{a.signInTitle}</h1>
        <p class="ac-muted">{a.signInBody}</p>
        <form id="ac-login">
          <label class="ac-field">{a.email}<input name="email" type="email" dir="ltr" required maxlength="160" autocomplete="email" /></label>
          <button type="submit" class="btn btn-amber">{a.send}</button>
        </form>
        <p class="ac-status" id="ac-login-status" role="status" hidden></p>
        <p class="ac-muted ac-small">{a.noAccount} <a href={link(lang, '/website-builder/')}>{a.buildOne}</a></p>
      </div>
    </section>

    <div class="ac-loading wrap" data-show="loading"><span class="ac-spinner" aria-hidden="true"></span><p>{a.loading}</p></div>

    <div class="ac-app wrap" data-show="app">
      <header class="ac-head">
        <div><h1>{a.title}</h1><p class="ac-muted" id="ac-email" dir="ltr"></p></div>
        <div class="ac-head-tools">
          <select id="ac-site" aria-label={a.site}></select>
          <button type="button" class="btn btn-ghost ac-small-btn" id="ac-signout">{a.signOut}</button>
        </div>
      </header>
      <p class="ac-note" id="ac-flash" hidden></p>
      <nav class="ac-tabs" id="ac-tabs" role="tablist"></nav>
      <main id="ac-panel" class="ac-panel"></main>
    </div>
  </div>
</Base>

<script>
  import qrcode from 'qrcode-generator';

  type Sub = { id: number; order_id: number; product: string; price: number; period: string; status: string; next_due: string; invoice_url: string };
  type Site = { order_id: number; name: string; url: string; status: string; plan: string; domain: string; spec: any; settings: any; external?: boolean; verified?: boolean };
  type Booking = { id: number; order_id: number; name: string; phone: string; email: string; service: string; date: string; time: string; note: string; status: string };
  type Ticket = { id: number; order_id: number; code: string; type: string; qty: number; amount: number; name: string; phone: string; email: string; status: string; checked_in: string };
  type View = { success: boolean; reason?: string; email: string; sites: Site[]; subs: Sub[]; bookings: Booking[]; tickets: Ticket[]; content: { order_id: number; month: string; posts: any[] }[]; payUrl?: string };

  const root = document.getElementById('account')!;
  const cfg = JSON.parse(root.dataset.config!);
  const T = cfg.text;
  const KEY = 'oxira-portal-k';
  const SITE_KEY = 'oxira-portal-site';
  const $ = <E extends Element>(s: string) => root.querySelector(s) as E;
  const esc = (s: unknown) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const fmt = new Intl.NumberFormat(cfg.numberLocale, { maximumFractionDigits: 2 });
  const store = {
    get: (k: string) => { try { return localStorage.getItem(k) || ''; } catch { return ''; } },
    set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* ignore */ } },
    del: (k: string) => { try { localStorage.removeItem(k); } catch { /* ignore */ } },
  };
  const show = (state: string) => { root.dataset.state = state; };

  // ---- Sign in ----
  const params = new URLSearchParams(location.search);
  const fromLink = params.get('k');
  if (fromLink && /^[a-f0-9]{40}$/.test(fromLink)) store.set(KEY, fromLink);
  const justPaid = params.has('paid');
  const socialBack = params.get('social');
  if (fromLink || justPaid || socialBack) history.replaceState(null, '', location.pathname + location.hash);
  let token = store.get(KEY);

  $<HTMLFormElement>('#ac-login').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button')!;
    const status = $<HTMLElement>('#ac-login-status');
    btn.disabled = true; btn.textContent = T.sending;
    try {
      await fetch(cfg.loginEndpoint, { method: 'POST', body: new URLSearchParams({ email: (form.elements.namedItem('email') as HTMLInputElement).value, lang: cfg.lang }) });
      status.textContent = T.sent; status.className = 'ac-status is-ok';
    } catch {
      status.textContent = T.failed; status.className = 'ac-status is-error';
    }
    status.hidden = false; btn.disabled = false; btn.textContent = T.send;
  });

  async function api(action: string, data: Record<string, unknown> = {}): Promise<any> {
    const res = await fetch(cfg.apiEndpoint, { method: 'POST', body: new URLSearchParams({ k: token, action, data: JSON.stringify(data) }) });
    const json = await res.json().catch(() => ({ success: false }));
    if (json?.reason === 'session') { signOut(T.expired); throw new Error('session'); }
    return json;
  }
  function signOut(message = '') {
    store.del(KEY); token = '';
    show('signin');
    if (message) { const s = $<HTMLElement>('#ac-login-status'); s.textContent = message; s.className = 'ac-status is-error'; s.hidden = false; }
  }
  $('#ac-signout').addEventListener('click', () => signOut());

  // ---- Data ----
  let view: View | null = null;
  let siteId = Number(store.get(SITE_KEY)) || 0;
  let tab = (location.hash.slice(1) || 'overview');
  const site = () => view?.sites.find((s) => s.order_id === siteId) ?? view?.sites[0];
  const subsOf = (id: number) => (view?.subs ?? []).filter((s) => s.order_id === id);
  const has = (product: string) => subsOf(site()!.order_id).some((s) => s.product === product && (s.status === 'active' || s.status === 'cancelling'));
  const isLive = (s: Site) => s.status === 'paid' || s.status === 'published';

  async function load() {
    if (!token) { show('signin'); return; }
    show('loading');
    try {
      const v = await api('load');
      if (!v?.success) throw new Error('load');
      view = v as View;
      if (view.sites.length && !view.sites.some((s) => s.order_id === siteId)) siteId = view.sites[0].order_id;
      $<HTMLElement>('#ac-email').textContent = view.email;
      const sel = $<HTMLSelectElement>('#ac-site');
      sel.replaceChildren(...view.sites.map((s) => new Option(`${s.name || '#' + s.order_id}${s.external ? ' · ' + T.extBadge : ''}`, String(s.order_id), false, s.order_id === siteId)));
      sel.hidden = view.sites.length < 2;
      show('app');
      draw();
      if (justPaid) flash(T.paidNote);
      if (socialBack) flash(socialBack === 'connected' ? T.socConnectedOk : T.socConnectErr);
    } catch (e) {
      if ((e as Error).message !== 'session') { show('signin'); flash(''); const s = $<HTMLElement>('#ac-login-status'); s.textContent = T.failed; s.className = 'ac-status is-error'; s.hidden = false; }
    }
  }
  $<HTMLSelectElement>('#ac-site').addEventListener('change', (e) => { siteId = Number((e.target as HTMLSelectElement).value); store.set(SITE_KEY, String(siteId)); draw(); });

  function flash(text: string) {
    const f = $<HTMLElement>('#ac-flash');
    f.textContent = text; f.hidden = !text;
  }

  // ---- Tabs ----
  const tabs = () => {
    const list = ['overview', 'addons'];
    const social = has('social') || has('socialpro') || has('ads');
    if (site()?.external) { if (has('seo') || has('seogrowth')) list.push('seo'); if (social) list.push('social'); return list; }
    if (has('booking')) list.push('bookings');
    list.push('menu');
    if (has('reviews')) list.push('reviews');
    if (has('chat')) list.push('chat');
    if (has('content')) list.push('content');
    if (has('tickets')) list.push('tickets');
    if (has('seo') || has('seogrowth')) list.push('seo');
    if (social) list.push('social');
    return list;
  };
  function draw() {
    const panel0 = $<HTMLElement>('#ac-panel');
    if (!view?.sites.length) {
      $<HTMLElement>('#ac-tabs').innerHTML = '';
      panel0.innerHTML = emptyState();
      return;
    }
    const list = tabs();
    if (!list.includes(tab)) tab = 'overview';
    $<HTMLElement>('#ac-tabs').innerHTML = list.map((t) => `<button type="button" role="tab" data-tab="${t}" aria-selected="${t === tab}">${esc(T.tabs[t] || (t === 'seo' ? T.seoTitle : t === 'social' ? T.socTitle : t))}</button>`).join('');
    const panel = $<HTMLElement>('#ac-panel');
    const s = site()!;
    panel.innerHTML = ({ overview, addons, bookings, menu, reviews, chat, content, tickets, seo, social } as Record<string, (s: Site) => string>)[tab](s);
    bind[tab]?.(s);
  }
  $('#ac-tabs').addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-tab]');
    if (!b) return;
    tab = b.dataset.tab!;
    history.replaceState(null, '', '#' + tab);
    flash('');
    draw();
  });

  const productName = (p: string) => T.products[p] || cfg.addons.items[p]?.name || p;
  const money = (n: number) => `${fmt.format(n)} ${cfg.sar}`;
  const card = (inner: string, cls = '') => `<section class="ac-card ${cls}">${inner}</section>`;
  const busy = async (btn: HTMLButtonElement, fn: () => Promise<void>) => {
    const label = btn.textContent;
    btn.disabled = true; btn.textContent = T.saving;
    try { await fn(); } finally { btn.disabled = false; btn.textContent = label; }
  };
  async function save(action: string, data: Record<string, unknown>, btn?: HTMLButtonElement) {
    const run = async () => {
      const r = await api(action, data);
      if (!r?.success) { flash(T.failed); return; }
      flash(T.saved);
      await reload();
    };
    if (btn) await busy(btn, run); else await run();
  }
  async function reload() {
    const v = await api('load');
    if (v?.success) { view = v; draw(); }
  }

  // ---- No website yet / websites hosted elsewhere ----
  const addSiteForm = () => `<form id="ac-ext-add" class="ac-ext-form">
      <label class="ac-field">${esc(T.extDomain)}<input name="domain" required maxlength="200" dir="ltr" placeholder="${esc(T.extDomainPh)}" inputmode="url"></label>
      <label class="ac-field">${esc(T.extName)}<input name="name" maxlength="120" dir="auto"></label>
      <button type="submit" class="btn btn-navy">${esc(T.extAdd)}</button></form>`;
  function emptyState() {
    return `<div class="ac-intro"><h2>${esc(T.emptyTitle)}</h2><p class="ac-muted">${esc(T.emptyBody)}</p></div>
      <div class="ac-empty">
        ${card(`<h2>${esc(T.newSiteTitle)}</h2><p class="ac-muted">${esc(T.newSiteBody)}</p><p><a class="btn btn-amber" href="${esc(cfg.builderUrl)}">${esc(T.newSiteCta)}</a></p>`)}
        ${card(`<h2>${esc(T.extTitle)}</h2><p class="ac-muted">${esc(T.extBody)}</p>${addSiteForm()}`)}
      </div>`;
  }
  const extCheck: Record<number, { email?: string; txt?: string; tried?: boolean }> = {};
  async function checkExternal(s: Site, btn?: HTMLButtonElement) {
    const run = async () => {
      const res = await fetch(cfg.extEndpoint, { method: 'POST', body: new URLSearchParams({ k: token, action: 'check', order_id: String(s.order_id) }) });
      const r = await res.json().catch(() => ({}));
      if (r?.reason === 'expired') { signOut(T.expired); return; }
      extCheck[s.order_id] = { email: r?.email, txt: r?.txt, tried: true };
      if (r?.verified) { flash(T.extVerified); await reload(); return; }
      if (btn) flash(T.extNotYet);
      draw();
    };
    if (btn) await busy(btn, run); else await run();
  }
  function externalOverview(s: Site) {
    const c = extCheck[s.order_id] || {};
    const verify = s.verified ? card(`<p class="ac-ok">${esc(T.extVerified)}</p>`) : card(`<h2>${esc(T.extVerifyTitle)}</h2><p class="ac-muted">${esc(T.extVerifyBody)}</p>
      <div class="ac-ext-opts">
        <div><h3 class="ac-h3">${esc(T.extOpt1Title)}</h3><p>${esc(T.extOpt1)}</p><p class="ac-mono" dir="ltr">${esc(c.email || cfg.gscEmail)}</p></div>
        <div><h3 class="ac-h3">${esc(T.extOpt2Title)}</h3><p>${esc(T.extOpt2)}</p><p class="ac-mono" dir="ltr">${c.txt ? esc(c.txt) : '…'}</p></div>
      </div>
      <p class="ac-row"><button type="button" class="btn btn-amber" data-ext-check>${esc(T.extCheck)}</button><a class="ac-link" href="${esc(cfg.helpUrl)}">${esc(T.extHelp)} →</a></p>`);
    if (!s.verified && !c.tried) setTimeout(() => checkExternal(s), 0);
    return card(`<div class="ac-site"><div><p class="ac-kicker">${esc(T.extBadge)}</p><h2>${esc(s.name || s.domain)}</h2>
        <p><a href="${esc(s.url)}" target="_blank" rel="noopener" dir="ltr" class="ac-url">${esc(s.domain)}</a></p></div>
        <a class="btn btn-navy" href="${esc(s.url)}" target="_blank" rel="noopener">${esc(T.visit)}</a></div>`)
      + verify + billingCard(s)
      + card(`<p class="ac-muted">${esc(T.extUpsell)}</p><p><a class="ac-link" href="${esc(cfg.builderUrl)}">${esc(T.newSiteCta)} →</a></p>`, 'ac-soft')
      + card(`<h2>${esc(T.extAddMore)}</h2>${addSiteForm()}`);
  }

  function billingCard(s: Site) {
    const subs = subsOf(s.order_id);
    const rows = subs.length ? subs.map((x) => `<tr>
      <td>${esc(productName(x.product))}</td>
      <td><span class="ac-chip st-${esc(x.status)}">${esc(T.state[x.status] || x.status)}</span></td>
      <td dir="ltr">${x.next_due && x.next_due < '2070' ? esc(x.next_due) : '—'}</td>
      <td>${x.price ? money(x.price) + (x.period === 'month' ? ' ' + esc(cfg.addons.perMonth) : '') : esc(cfg.addons.free)}</td>
      <td class="ac-actions">${x.invoice_url ? `<a class="btn btn-amber ac-small-btn" href="${esc(x.invoice_url)}">${esc(T.pay)}</a>` : ''}${x.status === 'active' && !['hosting', 'domain'].includes(x.product) ? `<button type="button" class="ac-link is-danger" data-cancel="${x.id}">${esc(T.cancel)}</button>` : ''}${x.status === 'cancelling' ? `<button type="button" class="ac-link" data-keep="${x.order_id}:${esc(x.product)}">${esc(T.keep)}</button>` : ''}</td>
    </tr>`).join('') : '';
    return rows ? card(`<h2>${esc(T.billing)}</h2><div class="ac-table-wrap"><table class="ac-table"><thead><tr><th>${esc(T.product)}</th><th></th><th>${esc(T.nextDue)}</th><th>${esc(T.price)}</th><th></th></tr></thead><tbody>${rows}</tbody></table></div><p class="ac-muted ac-small">${esc(T.vat)}</p>`) : '';
  }

  // ---- Overview ----
  function overview(s: Site) {
    if (s.external) return externalOverview(s);
    return card(`<div class="ac-site">
        <div><p class="ac-kicker">${esc(T.site)}</p><h2>${esc(s.name || '#' + s.order_id)}</h2>
        <p><span class="ac-chip st-${isLive(s) ? 'active' : 'pending'}">${esc(T.status[s.status] || s.status)}</span>${s.url ? ` <a href="${esc(s.url)}" target="_blank" rel="noopener" dir="ltr" class="ac-url">${esc(s.url.replace(/^https:\/\//, '').replace(/\/$/, ''))}</a>` : ''}</p></div>
        ${s.url ? `<a class="btn btn-navy" href="${esc(s.url)}" target="_blank" rel="noopener">${esc(T.visit)}</a>` : ''}
      </div>`)
      + billingCard(s)
      + card(`<h2>${esc(T.extAddMore)}</h2><p class="ac-muted">${esc(T.extBody)}</p>${addSiteForm()}`)
      + card(`<h2>${esc(T.partner)}</h2><p class="ac-muted">${esc(T.partnerBody)}</p><p><a class="ac-link" href="${esc(cfg.partnersUrl)}">${esc(T.partner)} →</a></p>`, 'ac-soft');
  }

  // ---- Add-ons ----
  function addons(s: Site) {
    const ext = !!s.external;
    const live = isLive(s) || (ext && !!s.verified);
    const noSiteNeeded = ['social', 'socialpro', 'ads'];
    return `<div class="ac-intro"><h2>${esc(cfg.addons.title)}</h2><p class="ac-muted">${esc(cfg.addons.body)}</p>${live ? '' : `<p class="ac-note">${esc(ext ? T.extNeedVerify : T.notLive)}</p>`}</div>
      <div class="ac-addons">${cfg.addonIds.map((id: string) => {
        const p = cfg.prices[id];
        const sub = subsOf(s.order_id).find((x) => x.product === id);
        const on = sub && (sub.status === 'active' || sub.status === 'cancelling');
        return `<article class="ac-addon${on ? ' is-on' : ''}">
          <span class="ac-addon-ic"><svg viewBox="0 0 24 24" aria-hidden="true">${cfg.icons[id]}</svg></span>
          <h3>${esc(cfg.addons.items[id].name)}</h3>
          <p class="ac-muted">${esc(cfg.addons.items[id].desc)}</p>
          <p class="ac-price">${p.price ? `<b>${money(p.price)}</b> ${esc(cfg.addons.perMonth)}` : `<b>${esc(cfg.addons.free)}</b>`}${p.feePercent ? ` <small>${esc(cfg.addons.fee)}</small>` : ''}</p>
          ${ext && !['seo', 'seogrowth', ...noSiteNeeded].includes(id) ? `<p class="ac-note">${esc(T.extOnlySeo)}</p>` : on ? `<span class="ac-chip st-active">${esc(T.active)}</span>` : sub?.invoice_url && sub.status === 'pending' ? `<a class="btn btn-amber" href="${esc(sub.invoice_url)}">${esc(T.pay)}</a>` : `<button type="button" class="btn btn-navy" data-subscribe="${id}" ${live || (ext && noSiteNeeded.includes(id)) ? '' : 'disabled'}>${esc(T.subscribe)}</button>`}
        </article>`;
      }).join('')}</div><p class="ac-muted ac-small">${esc(T.vat)}</p>`;
  }

  // ---- Bookings ----
  function bookings(s: Site) {
    const list = (view?.bookings ?? []).filter((x) => x.order_id === s.order_id);
    const st = s.settings || {};
    const days = (st.closedDays || []) as number[];
    return card(`<h2>${esc(T.bookingsTitle)}</h2>${list.length ? `<div class="ac-table-wrap"><table class="ac-table"><tbody>${list.map((x) => `<tr>
        <td dir="ltr"><b>${esc(x.date)}</b> ${esc(x.time)}</td>
        <td><b>${esc(x.name)}</b><br><a href="tel:${esc(x.phone)}" dir="ltr">${esc(x.phone)}</a></td>
        <td>${esc(x.service)}${x.note ? `<br><small class="ac-muted">${esc(x.note)}</small>` : ''}</td>
        <td><span class="ac-chip b-${esc(x.status)}">${esc(T.bstate[x.status] || x.status)}</span></td>
        <td class="ac-actions">${x.status === 'new' ? `<button type="button" class="btn btn-navy ac-small-btn" data-bk="${x.id}:confirmed">${esc(T.confirm)}</button>` : ''}${x.status !== 'cancelled' && x.status !== 'done' ? `<button type="button" class="ac-link" data-bk="${x.id}:done">${esc(T.done)}</button><button type="button" class="ac-link is-danger" data-bk="${x.id}:cancelled">${esc(T.cancel)}</button>` : ''}</td>
      </tr>`).join('')}</tbody></table></div>` : `<p class="ac-muted">${esc(T.noBookings)}</p>`}`)
      + card(`<h2>${esc(T.bookingSettings)}</h2><form id="ac-bset" class="ac-grid">
        <label class="ac-field">${esc(T.from)}<input type="time" name="bookingFrom" value="${esc(st.bookingFrom || '09:00')}"></label>
        <label class="ac-field">${esc(T.to)}<input type="time" name="bookingTo" value="${esc(st.bookingTo || '21:00')}"></label>
        <label class="ac-field">${esc(T.slot)}<input type="number" name="slotMinutes" min="10" max="240" step="5" value="${esc(st.slotMinutes || 30)}"></label>
        <label class="ac-field">${esc(T.capacity)}<input type="number" name="capacity" min="1" max="50" value="${esc(st.capacity || 1)}"></label>
        <fieldset class="ac-days"><legend>${esc(T.closedDays)}</legend>${T.days.map((d: string, i: number) => `<label><input type="checkbox" name="closed" value="${i}" ${days.includes(i) ? 'checked' : ''}> ${esc(d)}</label>`).join('')}</fieldset>
        <label class="ac-field ac-wide">${esc(T.note)}<input name="bookingNote" maxlength="300" value="${esc(st.bookingNote || '')}"></label>
        <button type="submit" class="btn btn-amber">${esc(T.save)}</button></form>`);
  }

  // ---- Menu ----
  let menuDraft: any = null;
  function menu(s: Site) {
    menuDraft = structuredClone(s.spec.menu || { title: '', note: '', categories: [] });
    if (!menuDraft.categories?.length) menuDraft.categories = [{ name: '', items: [{ name: '', desc: '', price: '' }] }];
    const qr = has('menu') && s.url ? qrCard(s.url + 'menu', T.qrMenuBody, 'menu') : card(`<p class="ac-muted">${esc(T.menuUpsell)}</p><button type="button" class="btn btn-navy" data-goto-addons>${esc(cfg.addons.items.menu.name)}</button>`, 'ac-soft');
    return card(`<h2>${esc(T.menuTitle)}</h2><p class="ac-muted">${esc(T.menuBody)}</p><div id="ac-menu"></div>
      <div class="ac-row"><button type="button" class="btn btn-ghost" data-add-cat>${esc(T.addCategory)}</button><button type="button" class="btn btn-amber" data-publish-menu>${esc(T.publish)}</button></div>`) + qr;
  }
  function drawMenu() {
    const box = root.querySelector<HTMLElement>('#ac-menu');
    if (!box) return;
    box.innerHTML = `<div class="ac-grid"><label class="ac-field">${esc(T.menuName)}<input data-m="title" maxlength="60" value="${esc(menuDraft.title)}"></label><label class="ac-field">${esc(T.menuNote)}<input data-m="note" maxlength="200" value="${esc(menuDraft.note)}"></label></div>`
      + menuDraft.categories.map((c: any, ci: number) => `<div class="ac-cat"><div class="ac-cat-head"><input data-m="c.${ci}.name" placeholder="${esc(T.category)}" maxlength="60" value="${esc(c.name)}"><button type="button" class="ac-link is-danger" data-del-cat="${ci}">${esc(T.remove)}</button></div>
        ${c.items.map((it: any, ii: number) => `<div class="ac-item"><input data-m="c.${ci}.i.${ii}.name" placeholder="${esc(T.itemName)}" maxlength="80" value="${esc(it.name)}"><input data-m="c.${ci}.i.${ii}.desc" placeholder="${esc(T.itemDesc)}" maxlength="200" value="${esc(it.desc)}"><input data-m="c.${ci}.i.${ii}.price" placeholder="${esc(T.itemPrice)}" maxlength="24" value="${esc(it.price)}" class="ac-price-in"><button type="button" class="ac-x" data-del-item="${ci}.${ii}" aria-label="${esc(T.remove)}">×</button></div>`).join('')}
        <button type="button" class="ac-link" data-add-item="${ci}">+ ${esc(T.addItem)}</button></div>`).join('');
  }

  // ---- QR helpers ----
  function qrSvg(text: string) {
    const q = qrcode(0, 'M'); q.addData(text); q.make();
    const n = q.getModuleCount(); let d = '';
    for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) if (q.isDark(r, c)) d += `M${c + 4} ${r + 4}h1v1h-1z`;
    return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${n + 8} ${n + 8}" shape-rendering="crispEdges"><rect width="100%" height="100%" fill="#fff"/><path d="${d}" fill="#000"/></svg>`;
  }
  function qrCard(url: string, body: string, kind: string) {
    return card(`<h2>${esc(T.qrTitle)}</h2><div class="ac-qr"><div class="ac-qr-img">${qrSvg(url)}</div><div><p class="ac-muted">${esc(body)}</p><p><a href="${esc(url)}" target="_blank" rel="noopener" dir="ltr" class="ac-url">${esc(url.replace(/^https:\/\//, ''))}</a></p>
      <div class="ac-row"><button type="button" class="btn btn-navy ac-small-btn" data-qr-png="${esc(url)}" data-qr-name="${kind}">${esc(T.download)}</button><button type="button" class="btn btn-ghost ac-small-btn" data-qr-print="${esc(url)}" data-qr-kind="${kind}">${esc(T.print)}</button></div></div></div>`);
  }
  async function svgToPng(svg: string, size: number, name: string) {
    const img = new Image();
    img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
    await img.decode();
    const c = document.createElement('canvas'); c.width = c.height = size;
    const ctx = c.getContext('2d')!; ctx.imageSmoothingEnabled = false; ctx.drawImage(img, 0, 0, size, size);
    downloadCanvas(c, name);
  }
  function downloadCanvas(c: HTMLCanvasElement, name: string) {
    c.toBlob((blob) => { if (!blob) return; const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name + '.png'; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 2000); }, 'image/png');
  }
  function printCard(url: string, kind: string) {
    const s = site()!;
    const title = kind === 'review' ? T.reviewsTitle : (s.spec.menu?.title || T.tabs.menu);
    const w = window.open('', '_blank');
    if (!w) return;
    w.document.write(`<!doctype html><html dir="${cfg.lang === 'ar' ? 'rtl' : 'ltr'}"><meta charset="utf-8"><title>${esc(s.name)}</title><style>body{font-family:system-ui,Tahoma,sans-serif;display:grid;place-items:center;min-height:100vh;margin:0}.c{width:9cm;padding:1cm;border:2px solid ${esc(s.spec.colors?.primary || '#0A253E')};border-radius:16px;text-align:center}.c h1{margin:0 0 .3cm;font-size:22px}.c h2{margin:0 0 .4cm;font-size:16px;color:#555}.c svg{width:6cm;height:6cm}@media print{@page{margin:0}}</style><div class="c"><h1>${esc(s.name)}</h1><h2>${esc(title)}</h2>${qrSvg(url)}</div><script>setTimeout(()=>print(),300)<\/script>`);
    w.document.close();
  }

  // ---- Reviews ----
  function reviews(s: Site) {
    const st = s.settings || {};
    return card(`<h2>${esc(T.reviewsTitle)}</h2><form id="ac-rev" class="ac-grid"><label class="ac-field ac-wide">${esc(T.googleUrl)}<input name="googleReviewUrl" type="url" dir="ltr" placeholder="https://g.page/r/…/review" value="${esc(st.googleReviewUrl || '')}"></label><p class="ac-muted ac-small ac-wide">${esc(T.googleHelp)}</p><button type="submit" class="btn btn-amber">${esc(T.save)}</button></form>`)
      + (s.url ? qrCard(s.url + 'review', T.qrReviewBody, 'review') : '');
  }

  // ---- AI assistant ----
  function chat(s: Site) {
    const st = s.settings || {};
    return card(`<h2>${esc(T.chatTitle)}</h2><p class="ac-muted">${esc(T.chatBody)}</p><form id="ac-chat"><label class="ac-field">${esc(T.chatNotes)}<textarea name="chatNotes" rows="7" maxlength="3000" dir="auto">${esc(st.chatNotes || '')}</textarea></label><div class="ac-row"><button type="submit" class="btn btn-amber">${esc(T.save)}</button>${s.url ? `<a class="btn btn-ghost" href="${esc(s.url)}chat" target="_blank" rel="noopener">${esc(T.chatTest)}</a>` : ''}</div></form>`);
  }

  // ---- Content ----
  function content(s: Site) {
    const packs = (view?.content ?? []).filter((c) => c.order_id === s.order_id);
    if (!packs.length) return card(`<h2>${esc(T.contentTitle)}</h2><p class="ac-muted">${esc(T.noContent)}</p>`);
    return `<div class="ac-intro"><h2>${esc(T.contentTitle)}</h2><p class="ac-muted">${esc(T.contentBody)}</p></div>` + packs.map((p, pi) => `<h3 class="ac-month" dir="ltr">${esc(p.month)}</h3><div class="ac-posts">${p.posts.map((x: any, i: number) => `<article class="ac-post">
      <canvas width="1080" height="1080" data-post="${pi}.${i}"></canvas>
      <p class="ac-kicker">${esc(T.day)} ${esc(x.day)}</p>
      <p class="ac-caption" dir="auto">${esc(x.caption)}</p><p class="ac-tags" dir="auto">${esc(x.hashtags)}</p>
      ${x.idea ? `<p class="ac-muted ac-small" dir="auto">💡 ${esc(x.idea)}</p>` : ''}
      <div class="ac-row"><button type="button" class="ac-link" data-copy="${pi}.${i}">${esc(T.copy)}</button><button type="button" class="ac-link" data-png="${pi}.${i}">${esc(T.download)}</button></div>
    </article>`).join('')}</div>`).join('');
  }
  function paintPost(c: HTMLCanvasElement, s: Site, post: any) {
    const ctx = c.getContext('2d')!;
    const p = s.spec.colors?.primary || '#0A253E', a = s.spec.colors?.accent || '#FFC400';
    const rtl = (s.spec.lang || 'ar') === 'ar';
    ctx.fillStyle = p; ctx.fillRect(0, 0, 1080, 1080);
    ctx.fillStyle = a; ctx.globalAlpha = .9; ctx.beginPath(); ctx.arc(rtl ? 120 : 960, 120, 260, 0, Math.PI * 2); ctx.fill(); ctx.globalAlpha = 1;
    ctx.fillRect(90, 760, 160, 14);
    const light = (() => { const n = parseInt(p.slice(1), 16); return ((n >> 16 & 255) * 299 + (n >> 8 & 255) * 587 + (n & 255) * 114) / 1000 > 150; })();
    ctx.fillStyle = light ? '#14171C' : '#FFFFFF';
    ctx.direction = rtl ? 'rtl' : 'ltr'; ctx.textAlign = rtl ? 'right' : 'left';
    const x = rtl ? 990 : 90;
    ctx.font = `700 88px ${getComputedStyle(document.body).fontFamily}`;
    const words = String(post.title || '').split(/\s+/); const lines: string[] = []; let line = '';
    for (const w of words) { const t = line ? line + ' ' + w : w; if (ctx.measureText(t).width > 900 && line) { lines.push(line); line = w; } else line = t; }
    if (line) lines.push(line);
    lines.slice(0, 4).forEach((l, i) => ctx.fillText(l, x, 470 + i * 110 - (lines.length - 1) * 40));
    ctx.font = `600 40px ${getComputedStyle(document.body).fontFamily}`;
    ctx.globalAlpha = .85; ctx.fillText(s.name || '', x, 960); ctx.globalAlpha = 1;
  }

  // ---- Tickets ----
  function tickets(s: Site) {
    const st = s.settings || {};
    const types = (st.tickets || []) as any[];
    const sold = (view?.tickets ?? []).filter((t) => t.order_id === s.order_id);
    return card(`<h2>${esc(T.ticketsTitle)}</h2><form id="ac-tk"><label class="ac-field">${esc(T.eventName)}<input name="eventName" maxlength="120" value="${esc(st.eventName || '')}"></label>
      <h3>${esc(T.ticketTypes)}</h3><div class="ac-item ac-type ac-type-head" aria-hidden="true"><span>${esc(T.ticketName)}</span><span>${esc(T.ticketPrice)}</span><span>${esc(T.ticketCap)}</span><span></span></div><div id="ac-types">${(types.length ? types : [{ name: '', price: 0, capacity: 0 }]).map((t, i) => typeRow(t, i)).join('')}</div>
      <div class="ac-row"><button type="button" class="btn btn-ghost" data-add-type>${esc(T.addType)}</button><button type="submit" class="btn btn-amber">${esc(T.save)}</button></div>
      <p class="ac-muted ac-small">${esc(T.ticketsFee)}</p></form>`)
      + card(`<h2>${esc(T.checkin)}</h2><form id="ac-checkin" class="ac-row"><input name="code" dir="ltr" maxlength="16" placeholder="${esc(T.checkinPh)}" class="ac-code" autocomplete="off" required><button type="submit" class="btn btn-navy">${esc(T.checkinBtn)}</button>${'BarcodeDetector' in window ? `<button type="button" class="btn btn-ghost" data-scan>${esc(T.scan)}</button>` : ''}</form><video id="ac-cam" playsinline hidden></video><p class="ac-status" id="ac-checkin-status" hidden></p>`)
      + card(`<h2>${esc(T.sales)} (${sold.reduce((n, t) => n + (t.qty || 0), 0)})</h2>${sold.length ? `<div class="ac-table-wrap"><table class="ac-table"><tbody>${sold.map((t) => `<tr><td dir="ltr"><b>${esc(t.code)}</b></td><td>${esc((types.find((x) => x.id === t.type) || {}).name || t.type)} × ${esc(t.qty)}</td><td>${esc(t.name)}<br><small dir="ltr">${esc(t.phone)}</small></td><td>${t.amount ? money(t.amount) : esc(cfg.addons.free)}</td><td>${t.checked_in ? `<span class="ac-chip st-active">${esc(T.checkedIn)}</span>` : ''}</td></tr>`).join('')}</tbody></table></div>` : '<p class="ac-muted">—</p>'}`);
  }
  const typeRow = (t: any, i: number) => `<div class="ac-item ac-type" data-type-row><input type="hidden" name="tid" value="${esc(t.id || '')}"><input name="tname" placeholder="${esc(T.ticketName)}" maxlength="80" value="${esc(t.name || '')}"><input name="tprice" type="number" min="0" placeholder="${esc(T.ticketPrice)}" value="${esc(t.price ?? 0)}" title="${esc(T.ticketPrice)}"><input name="tcap" type="number" min="0" placeholder="${esc(T.ticketCap)}" value="${esc(t.capacity ?? 0)}" title="${esc(T.ticketCap)}"><button type="button" class="ac-x" data-del-type aria-label="${esc(T.remove)}">×</button></div>`;

  // ---- Event wiring per tab ----
  const bind: Record<string, (s: Site) => void> = {
    overview: () => undefined,
    addons: () => undefined,
    seo: (s) => { loadSeo(s.order_id); },
    social: (s) => { loadSocial(s.order_id); },
    menu: () => drawMenu(),
    content: (s) => {
      const packs = (view?.content ?? []).filter((c) => c.order_id === s.order_id);
      root.querySelectorAll<HTMLCanvasElement>('canvas[data-post]').forEach((c) => {
        const [pi, i] = c.dataset.post!.split('.').map(Number);
        paintPost(c, s, packs[pi].posts[i]);
      });
    },
  };

  // ---- SEO add-on (Oxira 18 API): suggestions waiting for approval, Google report, weekly health ----
  const seoCache: Record<number, any> = {};
  async function seoApi(data: Record<string, string>) {
    const res = await fetch(cfg.seoEndpoint, { method: 'POST', body: new URLSearchParams({ k: token, ...data }) });
    return res.json().catch(() => ({ success: false }));
  }
  async function loadSeo(orderId: number, force = false) {
    const box = root.querySelector<HTMLElement>('#ac-seo');
    if (!box) return;
    if (!seoCache[orderId] || force) {
      const v = await seoApi({ action: 'list', order_id: String(orderId) });
      if (v?.reason === 'expired') { signOut(T.expired); return; }
      seoCache[orderId] = v?.success ? v : { items: [], report: null, health: null };
    }
    if (site()!.order_id === orderId) box.innerHTML = seoHtml(seoCache[orderId]);
  }
  function seoHtml(v: any) {
    const nf = new Intl.NumberFormat(cfg.numberLocale);
    const s0 = site()!;
    const growth = has('seogrowth');
    const st = v.settings || {}, brief = st.brief || {}, gbp = st.gbp || {}, wp = st.wp || {};
    const wpOn = !!(v.external && wp.ok);
    const rep = v.report;
    const cur = rep && rep.cur;
    const head = `<div class="ac-seo-head ac-noprint"><button type="button" class="btn btn-ghost ac-small-btn" data-seo-print>${esc(T.seoPrint)}</button></div>
      <div class="ac-print-only"><h1>${esc(T.seoReportFor)}</h1><p>${esc(s0.name || s0.domain || '')} · <span dir="ltr">${esc(s0.url || '')}</span> · ${esc(new Date().toLocaleDateString(cfg.lang === 'ar' ? 'ar-SA-u-nu-latn-ca-gregory' : cfg.numberLocale, { day: 'numeric', month: 'long', year: 'numeric' }))}</p></div>`;
    // Leads (websites hosted by Oxira)
    const LK = ['tel', 'wa', 'mail', 'form'] as const;
    const sum = (o: any, keys: readonly string[]) => keys.reduce((a, k) => a + (Number(o?.[k]) || 0), 0);
    const last = rep?.leads;
    const leads = v.external ? '' : card(`<h2>${esc(T.seoLeadsTitle)}</h2>
      <div class="ac-leads">
        <div><p class="ac-kicker">${esc(T.seoLeadsNow)}</p><b class="ac-big">${nf.format(sum(v.leadsNow, LK))}</b>
          <ul>${LK.map((k) => `<li><span>${esc(T.seoLeadKinds[k])}</span><b>${nf.format(Number(v.leadsNow?.[k]) || 0)}</b></li>`).join('')}</ul></div>
        ${last ? `<div><p class="ac-kicker">${esc(T.seoLeadsLast)} <span dir="ltr">${esc(last.month || '')}</span></p><b class="ac-big">${nf.format(sum(last, [...LK, 'bookings']))}</b>
          <ul>${[...LK, 'bookings'].map((k) => `<li><span>${esc(T.seoLeadKinds[k])}</span><b>${nf.format(Number(last[k]) || 0)}</b></li>`).join('')}</ul></div>` : ''}
      </div><p class="ac-muted ac-small">${esc(T.seoLeadsNote)}</p>`);
    // Google: last 28 days + monthly trend
    const hist = (v.history || []).filter((x: any) => x.cur);
    const maxC = Math.max(1, ...hist.map((x: any) => x.cur.clicks || 0));
    const trend = hist.length > 1 ? `<h3 class="ac-h3">${esc(T.seoTrend)}</h3><div class="ac-bars" role="img" aria-label="${esc(T.seoTrend)}">${hist.map((x: any) => `<div><span style="height:${Math.max(4, Math.round((x.cur.clicks || 0) / maxC * 100))}%"></span><b>${nf.format(Math.round(x.cur.clicks || 0))}</b><small dir="ltr">${esc(String(x.month).slice(5))}</small></div>`).join('')}</div>` : '';
    const report = card(`<h2>${esc(T.seoReport)}</h2>${cur ? `<div class="ac-stats"><div><b>${nf.format(Math.round(cur.clicks))}</b><span>${esc(T.seoClicks)}</span></div><div><b>${nf.format(Math.round(cur.impressions))}</b><span>${esc(T.seoImpressions)}</span></div><div><b>${cur.position ? cur.position.toFixed(1) : '—'}</b><span>${esc(T.seoPosition)}</span></div></div>${(rep.queries || []).length ? `<h3 class="ac-h3">${esc(T.seoQueries)}</h3><ol class="ac-queries">${rep.queries.slice(0, 8).map((q: any) => `<li dir="auto"><span>${esc(q.q)}</span><small>${q.clicks} · ${q.position}</small></li>`).join('')}</ol>` : ''}` : `<p class="ac-muted">${esc(T.seoNoData)}</p>`}${trend}`);
    // Keyword ranks: latest week vs the first week we have (up to 8 weeks back)
    const weeks = v.ranks?.data || [];
    const lastW = weeks[weeks.length - 1] || {}, firstW = weeks.length > 1 ? weeks[0] : {};
    const kws: string[] = (brief.keywords || []).length ? brief.keywords : Object.keys(lastW);
    const rankRows = kws.map((k) => {
      const p = lastW[k]?.p ?? null, p0 = firstW[k]?.p ?? null;
      const ch = p != null && p0 != null ? Math.round((p0 - p) * 10) / 10 : null;
      return `<tr><td dir="auto">${esc(k)}</td><td>${p == null ? `<span class="ac-muted">${esc(T.seoNotYet)}</span>` : '#' + p}</td><td>${ch == null || ch === 0 ? '—' : `<span class="${ch > 0 ? 'ac-up' : 'ac-down'}">${ch > 0 ? '▲' : '▼'} ${Math.abs(ch)}</span>`}</td><td>${nf.format(lastW[k]?.c || 0)}</td></tr>`;
    }).join('');
    const ranks = card(`<h2>${esc(T.seoRanks)}</h2>${!kws.length ? `<p class="ac-muted">${esc(T.seoRanksEmpty)}</p>` : !weeks.length ? `<p class="ac-muted">${esc(T.seoRanksWait)}</p>` : `<div class="ac-table-wrap"><table class="ac-table"><thead><tr><th>${esc(T.seoKw)}</th><th>${esc(T.seoPos)}</th><th>${esc(T.seoChange)}</th><th>${esc(T.seoClicks)}</th></tr></thead><tbody>${rankRows}</tbody></table></div><p class="ac-muted ac-small" dir="ltr">${esc(v.ranks.weeks[v.ranks.weeks.length - 1] || '')}</p>`}`);
    // Technical check
    const tech = rep?.tech;
    const h = v.health;
    const techCard = tech || h ? card(`<h2>${esc(T.seoTech)}</h2>${tech ? `<div class="ac-stats">${tech.performance != null ? `<div><b>${tech.performance}</b><span>${esc(T.seoSpeed)} /100</span></div>` : ''}${tech.lcp ? `<div><b dir="ltr">${esc(tech.lcp)}</b><span>${esc(T.seoLcp)}</span></div>` : ''}${tech.cls ? `<div><b dir="ltr">${esc(tech.cls)}</b><span>${esc(T.seoCls)}</span></div>` : ''}</div>
      <ul class="ac-checks">${Object.entries(tech.checks || {}).map(([k, ok]) => `<li class="${ok ? 'ok' : 'bad'}"><i aria-hidden="true">${ok ? '✓' : '✗'}</i>${esc(T.seoChecks[k] || k)}</li>`).join('')}</ul>` : ''}${h ? `<p class="${h.ok ? 'ac-ok' : 'ac-bad'}">${esc(h.ok ? T.seoHealthOk : T.seoHealthBad)} <small class="ac-muted" dir="ltr">${esc(h.date || '')}</small></p>` : ''}`) : '';
    // Suggestions waiting for approval
    const pending = (v.items || []).filter((x: any) => x.status === 'pending');
    const done = (v.items || []).filter((x: any) => x.status !== 'pending');
    const manual = (x: any) => x.kind === 'gbp' || x.kind === 'llms' || (v.external && !(wpOn && (x.kind === 'article' || x.kind === 'local')));
    const pubLabel = (x: any) => (x.kind === 'gbp' ? T.seoPosted : manual(x) ? T.seoMarkDone : wpOn ? T.seoWpPublish : T.seoApprove);
    const note = (x: any) => (x.kind === 'gbp' ? T.seoGbpNote : x.kind === 'llms' ? T.seoLlmsNote : '');
    const item = (x: any) => `<article class="ac-seo-item" data-seo-item="${x.id}">
      <p class="ac-chip">${esc(T.seoKinds[x.kind] || x.kind)}${x.lang && x.lang !== cfg.lang ? ` · ${esc(x.lang.toUpperCase())}` : ''}</p>
      ${note(x) ? `<p class="ac-muted ac-small">${esc(note(x))}</p>` : ''}
      ${x.kind !== 'llms' ? `<label class="ac-field">${esc(T.seoSuggested)}<input name="title" value="${esc(x.title)}" maxlength="90" dir="auto"></label>` : ''}
      ${x.kind !== 'gbp' && x.kind !== 'llms' ? `<label class="ac-field"><textarea name="description" rows="2" maxlength="180" dir="auto">${esc(x.description)}</textarea></label>` : ''}
      ${x.kind !== 'meta' ? `<details${manual(x) ? ' open' : ''}><summary>${esc(T.seoEdit)}</summary><textarea name="body" rows="${x.kind === 'gbp' ? 5 : 14}" dir="${x.kind === 'llms' ? 'auto' : 'auto'}" class="ac-seo-body">${esc(x.body)}</textarea></details>` : ''}
      <div class="ac-row">${manual(x) ? `<button type="button" class="btn btn-ghost ac-small-btn" data-seo-copy="${x.id}">${esc(T.seoCopy)}</button>` : ''}<button type="button" class="btn btn-amber ac-small-btn" data-seo-pub="${x.id}">${esc(pubLabel(x))}</button><button type="button" class="btn btn-ghost ac-small-btn" data-seo-rej="${x.id}">${esc(T.seoReject)}</button></div>
    </article>`;
    const list = card(`<h2>${esc(T.seoPending)}</h2><p class="ac-muted">${esc(v.external && !wpOn ? T.seoExtNote : T.seoBody)}</p>${pending.length ? pending.map(item).join('') : `<p class="ac-muted">${esc(T.seoNone)}</p>`}`, 'ac-noprint');
    const history = done.length ? card(`<ul class="ac-seo-done">${done.map((x: any) => `<li><span class="ac-chip ${x.status === 'published' ? 'st-active' : ''}">${esc(x.status === 'published' ? T.seoPublished : T.seoRejected)}</span> <span class="ac-muted ac-small">${esc(T.seoKinds[x.kind] || x.kind)}</span> <span dir="auto">${esc(x.title)}</span> ${x.url ? `<a class="ac-link" href="${esc(x.url)}" target="_blank" rel="noopener">↗</a>` : ''}</li>`).join('')}</ul>`) : '';
    // The owner's brief: used by the writer and for rank tracking
    const maxKw = growth ? 30 : 10;
    const ta = (name: string, label: string, val: string, rows = 2, extra = '') => `<label class="ac-field">${esc(label)}<textarea name="${name}" rows="${rows}" dir="auto" ${extra}>${esc(val || '')}</textarea></label>`;
    const briefCard = card(`<h2>${esc(T.seoBrief)}</h2><p class="ac-muted">${esc(T.seoBriefBody)}</p>
      <form id="ac-seo-brief" class="ac-form-grid">
        ${ta('services', T.seoServices, brief.services, 3, 'maxlength="1500"')}
        ${ta('areas', T.seoAreas, brief.areas, 2, 'maxlength="500"')}
        ${ta('audience', T.seoAudience, brief.audience, 2, 'maxlength="500"')}
        ${ta('usp', T.seoUsp, brief.usp, 2, 'maxlength="800"')}
        ${ta('keywords', T.seoKeywords, (brief.keywords || []).join('\n'), 5)}
