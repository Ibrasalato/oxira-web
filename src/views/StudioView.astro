---
// Oxira Studio: pick a design, give the basics, edit with the AI designer, then order.
import type { Lang } from '../i18n/content';
import { contact } from '../i18n/content';
import { builderText, plans, planIds, domainPrice } from '../i18n/builder';
import { siteLangs, fontIds, sectionIds } from '../builder/spec';
import { languages } from '../i18n/content';
import { link, asset } from '../lib/routes';
import Base from '../layouts/Base.astro';
import TemplateGallery from '../components/TemplateGallery.astro';
import { catalog, categoryIds } from '../builder/catalog';
import Logo from '../components/Logo.astro';
import { t } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const b = builderText[lang];
const s = b.studio;
const legal = t[lang].legal;
const builderEndpoint = import.meta.env.PUBLIC_BUILDER_ENDPOINT || 'https://ibrasalato.app.n8n.cloud/webhook/oxira-site-builder';
const orderEndpoint = import.meta.env.PUBLIC_ORDER_ENDPOINT || 'https://ibrasalato.app.n8n.cloud/webhook/oxira-site-order';
const n8nBase = 'https://ibrasalato.app.n8n.cloud/webhook';
const fmt = new Intl.NumberFormat(lang === 'ar' ? 'ar-SA-u-nu-latn' : lang, { maximumFractionDigits: 0 });
const config = {
  lang,
  builderEndpoint,
  uploadEndpoint: import.meta.env.PUBLIC_UPLOAD_ENDPOINT || `${n8nBase}/oxira-studio-upload`,
  imageBase: 'https://oxira-sites.oxira-sa.workers.dev/_img/',
  orderEndpoint,
  shareEndpoint: import.meta.env.PUBLIC_SHARE_ENDPOINT || `${n8nBase}/oxira-studio-share`,
  checkoutEndpoint: import.meta.env.PUBLIC_CHECKOUT_ENDPOINT || `${n8nBase}/oxira-site-checkout`,
  statusEndpoint: import.meta.env.PUBLIC_PAYMENT_STATUS_ENDPOINT || `${n8nBase}/oxira-site-payment-status`,
  fontBase: asset('builder/fonts'),
  whatsapp: contact.whatsappHref,
  plans,
  domainPrice,
  text: { ...s, sar: b.packages.sar },
  numberLocale: lang === 'ar' ? 'ar-SA-u-nu-latn' : lang,
};
const langName = (code: string) => languages.find((l) => l.code === code)?.name ?? code;
---
<Base lang={lang} path="/studio/" title={s.pageTitle} description={s.pageDescription} app>
  <div class="st" id="studio" data-step="1" data-config={JSON.stringify(config)}>
    <div class="st-top">
      <div class="st-top-in">
        <p class="st-title"><span class="st-title-mark"><Logo variant="light" wordmark={false} /></span>{s.title}</p>
        <ol class="st-steps" aria-label={s.title}>
          {s.steps.map((name, i) => (
            <li><button type="button" data-goto={i + 1} disabled={i > 0}><span>{i + 1}</span>{name}</button></li>
          ))}
        </ol>
      </div>
    </div>

    <!-- 1. Pick a design -->
    <section class="st-pick" data-panel="1" aria-labelledby="pick-title">
      <div class="wrap">
        <div class="sh"><h1 id="pick-title">{s.pickTitle}</h1><p>{s.pickBody}</p></div>
        <TemplateGallery lang={lang} mode="pick" action={s.use} />
      </div>
    </section>

    <!-- 2-4. Side panel + live preview -->
    <div class="st-work" data-panel="2 3 4">
      <aside class="st-side">
        <!-- 2. Basics -->
        <form class="st-basics" id="st-basics" data-panel="2" novalidate>
          <h1>{s.basicsTitle}</h1>
          <p class="st-muted">{s.basicsBody}</p>
          <fieldset class="st-kinds">
            <legend>{s.kind}</legend>
            {Object.entries(s.kinds).map(([k, v], i) => (
              <label><input type="radio" name="kind" value={k} checked={i === 0} /><span>{v}</span></label>
            ))}
          </fieldset>
          <label class="st-field">{s.name}<input name="name" required maxlength="60" placeholder={s.namePh} /></label>
          <label class="st-field">{s.about}<textarea name="about" rows="4" maxlength="1200" placeholder={s.aboutPh}></textarea></label>
          <div class="st-two">
            <label class="st-field">{s.phone}<input name="phone" type="tel" dir="ltr" maxlength="30" /></label>
            <label class="st-field">{s.email}<input name="email" type="email" dir="ltr" maxlength="80" /></label>
          </div>
          <div class="st-two">
            <label class="st-field">{s.city}<input name="city" maxlength="60" /></label>
            <label class="st-field">{s.siteLang}
              <select name="siteLang">{siteLangs.map((l) => <option value={l} selected={l === lang}>{langName(l)}</option>)}</select>
            </label>
          </div>
          <div class="st-actions">
            <button type="submit" class="btn btn-amber">{s.generate}</button>
            <button type="button" class="st-link" data-skip>{s.skip}</button>
          </div>
          <button type="button" class="st-link st-back" data-goto="1">{s.back}</button>
        </form>

        <!-- 3. Edit with AI -->
        <div class="st-editor" data-panel="3">
          <div class="st-chat-head">
            <span class="st-ai"><Logo variant="dark" wordmark={false} /></span>
            <div><strong>{s.chatTitle}</strong></div>
            <div class="st-tools">
              <button type="button" class="st-icon" data-undo disabled title={s.undo} aria-label={s.undo}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 14 4 9l5-5" /><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11" /></svg>
              </button>
            </div>
          </div>
          <div class="st-log" id="st-log" aria-live="polite"></div>
          <div class="st-sugs" id="st-sugs">
            {s.suggestions.map((q) => <button type="button" data-suggest>{q}</button>)}
          </div>
          <form class="st-ask" id="st-ask">
            <label class="sr-only" for="st-input">{s.chatPh}</label>
            <textarea id="st-input" rows="1" maxlength="1500" placeholder={s.chatPh} dir="auto"></textarea>
            <button type="submit" class="st-send" aria-label={s.send}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
            </button>
          </form>
          <p class="st-hint">{s.editHint}</p>
          <details class="st-media" open>
            <summary>{s.images}</summary>
            <div class="st-media-in">
              <p class="st-note">{s.imagesNote}</p>
              {(['logo', 'hero', 'about'] as const).map((slot) => (
                <div class="st-slot" data-slot={slot}>
                  <span class="st-slot-thumb" data-thumb></span>
                  <span class="st-slot-name">{slot === 'logo' ? s.logo : slot === 'hero' ? s.heroImage : s.aboutImage}</span>
                  <label class="st-up">
                    <input type="file" accept="image/jpeg,image/png,image/webp" data-upload={slot} hidden />
                    <span data-up-label>{s.upload}</span>
                  </label>
                  <button type="button" class="st-link st-rm" data-remove={slot} hidden>{s.remove}</button>
                </div>
              ))}
              <div class="st-slot st-slot-gal">
                <span class="st-slot-name">{s.gallery}</span>
                <label class="st-up">
                  <input type="file" accept="image/jpeg,image/png,image/webp" multiple data-upload="gallery" hidden />
                  <span data-up-label>{s.addPhotos}</span>
                </label>
                <div class="st-gal" id="st-gal"></div>
              </div>
              <p class="st-status is-error" id="st-up-error" hidden>{s.uploadFailed}</p>
            </div>
          </details>
          <details class="st-panel">
            <summary>{s.sectionsTitle}</summary>
            <div class="st-panel-in">
              <div class="st-checks">
                {sectionIds.map((id) => (
                  <label class="st-check"><input type="checkbox" data-section={id} /><span>{s.sectionNames[id]}</span></label>
                ))}
              </div>
              <h3>{s.extrasTitle}</h3>
              <label class="st-check"><input type="checkbox" data-extra="whatsappButton" /><span>{s.waButton}</span></label>
              <label class="st-check"><input type="checkbox" data-extra="contactForm" /><span>{s.contactForm}</span></label>
              <label class="st-field">{s.mapUrl}<input data-map type="url" dir="ltr" maxlength="300" placeholder={s.mapPh} /></label>
              <p class="st-status is-error" data-map-bad hidden>{s.mapBad}</p>
            </div>
          </details>
          <details class="st-panel">
            <summary>{s.reviewsTitle}</summary>
            <div class="st-panel-in">
              <p class="st-note">{s.reviewsNote}</p>
              <ul class="st-items" id="st-reviews"></ul>
              <form class="st-add" id="st-add-review">
                <label class="st-field">{s.quote}<textarea name="quote" rows="2" maxlength="400" required></textarea></label>
                <div class="st-two">
                  <label class="st-field">{s.author}<input name="name" maxlength="60" required /></label>
                  <label class="st-field">{s.role}<input name="role" maxlength="60" /></label>
                </div>
                <button type="submit" class="btn btn-ghost st-small">{s.add}</button>
              </form>
            </div>
          </details>
          <details class="st-panel">
            <summary>{s.faqTitle}</summary>
            <div class="st-panel-in">
              <ul class="st-items" id="st-faqs"></ul>
              <form class="st-add" id="st-add-faq">
                <label class="st-field">{s.question}<input name="q" maxlength="160" required /></label>
                <label class="st-field">{s.answer}<textarea name="a" rows="2" maxlength="600" required></textarea></label>
                <button type="submit" class="btn btn-ghost st-small">{s.add}</button>
              </form>
            </div>
          </details>
          <details class="st-panel">
            <summary>{s.versionsTitle}</summary>
            <div class="st-panel-in">
              <ul class="st-items" id="st-versions"></ul>
              <p class="st-note" id="st-no-versions">{s.noVersions}</p>
              <button type="button" class="btn btn-ghost st-small" data-save-version>{s.saveVersion}</button>
            </div>
          </details>
          <details class="st-quick">
            <summary>{s.controls}</summary>
            <div class="st-quick-in">
              <label class="st-field">{s.design}
                <select data-ctl="template">{categoryIds.map((c) => <optgroup label={b.categories[c]}>{catalog.filter((t) => t.cat === c).map((t) => <option value={t.id}>{b.categories[c]} · {b.gallery.designN.replace('{n}', String(t.n))}</option>)}</optgroup>)}</select>
              </label>
              <label class="st-field">{s.font}
                <select data-ctl="font">{fontIds.map((f) => <option value={f}>{s.fonts[f]}</option>)}</select>
              </label>
              <label class="st-field st-color">{s.primary}<input type="color" data-ctl="primary" /></label>
              <label class="st-field st-color">{s.accent}<input type="color" data-ctl="accent" /></label>
              <label class="st-field st-color">{s.background}<span class="st-bg"><input type="color" data-ctl="background" /><button type="button" class="st-link" data-bg-reset>{s.backgroundReset}</button></span></label>
              <label class="st-field">{s.siteLang}
                <select data-ctl="lang">{siteLangs.map((l) => <option value={l}>{langName(l)}</option>)}</select>
              </label>
              <button type="button" class="st-link" data-reset>{s.reset}</button>
            </div>
          </details>
          <button type="button" class="btn btn-navy st-to-order" data-goto="4">{s.toOrder}</button>
        </div>

        <!-- 4. Order -->
        <form class="st-order" id="st-order" data-panel="4" novalidate>
          <h1>{s.orderTitle}</h1>
          <p class="st-muted">{s.orderBody}</p>

          <h2>{s.packagesTitle}</h2>
          <ul class="st-pkgs">
            {planIds.map((id) => (
              <li>
                <label>
                  <input type="radio" name="plan" value={id} checked={id === 'pro'} />
                  <span class="st-pkg-text"><strong>{b.plans.items[id].name}{id === 'pro' && <em class="st-pop">{b.plans.popular}</em>}</strong><small>{b.plans.items[id].desc}</small></span>
                  <span class="st-pkg-price">{fmt.format(plans[id].price)} <small>{b.packages.sar} · {b.plans.firstYear}</small></span>
                </label>
              </li>
            ))}
          </ul>

          <h2>{s.domainTitle}</h2>
          <fieldset class="st-domain">
            <legend class="sr-only">{s.domainTitle}</legend>
            <label><input type="radio" name="domainOption" value="new" checked /> {s.domainNew}</label>
            <label><input type="radio" name="domainOption" value="own" /> {s.domainOwn}</label>
            <label><input type="radio" name="domainOption" value="none" /> {s.domainNone}</label>
          </fieldset>
          <label class="st-field" data-domain-name><span class="sr-only">{s.domainTitle}</span><input name="domainName" dir="ltr" maxlength="120" placeholder={s.domainPh} /></label>
          <p class="st-note">{s.domainNote}</p>

          <h2>{s.contactTitle}</h2>
          <label class="st-field">{s.yourName}<input name="name" required maxlength="120" autocomplete="name" /></label>
          <div class="st-two">
            <label class="st-field">{s.yourPhone}<input name="phone" type="tel" dir="ltr" required maxlength="30" autocomplete="tel" /></label>
            <label class="st-field">{s.yourEmail}<input name="email" type="email" dir="ltr" maxlength="160" autocomplete="email" /></label>
          </div>
          <label class="st-field">{s.notes}<textarea name="notes" rows="3" maxlength="3000" placeholder={s.notesPh}></textarea></label>
          <input class="st-hp" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="st-total">
            <span>{s.dueNow}</span>
            <strong><b id="st-total">0</b> {b.packages.sar}</strong>
          </div>
          <p class="st-note">{s.vat}</p>
          <div class="st-total st-total-vat">
            <span>{s.withVat}</span>
            <strong><b id="st-total-vat">0</b> {b.packages.sar}</strong>
          </div>
          <p class="st-status" id="st-order-status" role="status" hidden></p>
          <button type="submit" class="btn btn-amber st-submit">{s.submit}</button>
          <p class="st-consent">{s.consent} <a href={link(lang, '/privacy/')}>{legal.privacy}</a> · <a href={link(lang, '/terms/')} target="_blank">{b.page.terms}</a></p>
          <button type="button" class="st-link st-back" data-goto="3">{s.back}</button>
        </form>

        <!-- Done -->
        <div class="st-done" data-panel="5" id="st-done" data-state="ordered">
          <span class="st-done-mark" aria-hidden="true">
            <svg class="i-ok" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
            <span class="i-wait"></span>
            <svg class="i-warn" viewBox="0 0 24 24"><path d="M12 8v5M12 16.5v.5" /></svg>
          </span>
          <h1 id="st-done-title">{s.doneTitle}</h1>
          <p id="st-done-body"></p>
          <div class="st-done-steps">
            <h2>{s.doneNext}</h2>
            <ol>{s.doneSteps.map((x) => <li>{x}</li>)}</ol>
          </div>
          <div class="st-actions">
            <button type="button" class="btn btn-amber" id="st-pay-now" hidden>{s.payNow}</button>
            <a class="btn btn-navy" href={link(lang, '/')}>{s.doneHome}</a>
            <a class="btn btn-ghost" href={contact.whatsappHref} target="_blank" rel="noopener">{s.doneWhatsapp}</a>
          </div>
        </div>
      </aside>

      <div class="st-stage">
        <div class="st-stage-bar">
          <div class="st-device" role="group">
            <button type="button" data-device="desktop" aria-pressed="true">{s.desktop}</button>
            <button type="button" data-device="mobile" aria-pressed="false">{s.mobile}</button>
          </div>
          <button type="button" class="st-share-btn" data-share>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" /><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg>
            <span>{s.share}</span>
          </button>
        </div>
        <div class="st-share" id="st-share" hidden>
          <p id="st-share-msg">{s.shareReady}</p>
          <div class="st-share-row">
            <input id="st-share-url" readonly dir="ltr" aria-label={s.share} />
            <button type="button" class="btn btn-navy st-small" data-copy>{s.copy}</button>
            <a class="btn btn-ghost st-small" id="st-share-open" target="_blank" rel="noopener">{s.open}</a>
          </div>
        </div>
        <div class="st-frame-wrap" id="st-frame-wrap">
          <iframe id="st-frame" title={s.title} sandbox="allow-same-origin"></iframe>
          <div class="st-busy" id="st-busy" hidden>
            <span class="st-spinner" aria-hidden="true"></span>
            <p id="st-busy-text">{s.generating}</p>
            <small>{s.generatingNote}</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import { renderSite } from '../builder/render';
  import { guessCategory } from '../builder/catalog';
  import { sampleSpec, mergeSpec, looks, sectionIds, type Spec, type TemplateId, type SiteLang, type SectionId } from '../builder/spec';

  type Msg = { from: 'ai' | 'me' | 'note'; text: string };
  interface State {
    step: number;
    spec: Spec | null;
    history: Spec[];
    chat: Msg[];
    basics: Record<string, string>;
    sessionId: string;
    aiUsed?: boolean;
    versions?: { at: number; kind: 'ai' | 'saved'; spec: Spec }[];
    draftId?: string;
  }

  const root = document.getElementById('studio')!;
  const cfg = JSON.parse(root.dataset.config!);
  const T = cfg.text;
  const KEY = `oxira-studio-v1-${cfg.lang}`;
  const $ = <E extends Element>(sel: string) => root.querySelector(sel) as E;
  const $$ = <E extends Element>(sel: string) => Array.from(root.querySelectorAll(sel)) as E[];

  const newId = () => (crypto.randomUUID?.() ?? `${Date.now()}${Math.random()}`).replace(/[^a-zA-Z0-9]/g, '').slice(0, 24);
  const blank = (): State => ({ step: 1, spec: null, history: [], chat: [], basics: {}, sessionId: newId() });

  let state: State = blank();
  try {
    const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (saved && saved.spec) {
      state = { ...blank(), ...saved };
      state.spec = mergeSpec(sampleSpec(saved.spec.template ?? 'corporate', saved.spec.lang ?? cfg.lang), saved.spec);
    }
  } catch { /* storage unavailable */ }
  const save = () => {
    try { localStorage.setItem(KEY, JSON.stringify({ ...state, history: state.history.slice(-10), versions: (state.versions ?? []).slice(-12) })); } catch { /* ignore */ }
  };

  // Template chosen on the service page (?t=clinic) starts a fresh design.
  const params = new URLSearchParams(location.search);
  const wanted = params.get('t') as TemplateId | null;
  if (wanted && wanted in looks && (!state.spec || state.step === 1)) {
    state = { ...blank(), step: 2, spec: sampleSpec(wanted, cfg.lang as SiteLang) };
  }
  // Quick start from the service page: ?q=<what the business does>
  const quick = (params.get('q') || '').trim().slice(0, 600);
  if (quick) {
    const tpl: TemplateId = guessCategory(quick);
    state = { ...blank(), step: 2, spec: sampleSpec(tpl, cfg.lang as SiteLang), basics: { about: quick, siteLang: cfg.lang, kind: 'company' } };
    history.replaceState(null, '', location.pathname);
  }

  // ---- Preview ----
  const frame = $<HTMLIFrameElement>('#st-frame');
  const wrap = $<HTMLElement>('#st-frame-wrap');
  let renderTimer = 0;
  function render() {
    if (!state.spec) return;
    clearTimeout(renderTimer);
    renderTimer = window.setTimeout(() => {
      const y = frame.contentWindow?.scrollY ?? 0;
      frame.onload = () => frame.contentWindow?.scrollTo(0, y);
      frame.srcdoc = renderSite(state.spec!, { fontBase: cfg.fontBase, imageBase: cfg.imageBase, editable: true });
    }, 60);
  }
  // ---- Inline editing: click a text in the preview and type ----
  function setPath(target: unknown, path: string, value: string) {
    const keys = path.split('.');
    let o: any = target;
    for (const k of keys.slice(0, -1)) { o = o?.[k]; if (o == null) return false; }
    const last = keys[keys.length - 1];
    if (typeof o?.[last] !== 'string') return false;
    o[last] = value;
    return true;
  }
  const getPath = (target: unknown, path: string) => path.split('.').reduce<any>((o, k) => o?.[k], target);
  frame.addEventListener('load', () => {
    const doc = frame.contentDocument;
    if (!doc || !state.spec) return;
    const style = doc.createElement('style');
    style.textContent = '[data-f]{cursor:text;border-radius:4px;outline:2px dashed transparent;outline-offset:3px;transition:outline-color .15s}[data-f]:hover{outline-color:rgba(0,125,180,.55)}[data-f]:focus{outline:2px solid #007DB4;background:rgba(0,125,180,.06)}';
    doc.head.append(style);
    doc.querySelectorAll('details').forEach((d) => { d.open = true; });
    doc.querySelectorAll<HTMLElement>('[data-f]').forEach((el) => {
      el.setAttribute('contenteditable', 'plaintext-only');
      if (el.contentEditable !== 'plaintext-only') el.setAttribute('contenteditable', 'true');
      el.spellcheck = false;
    });
    doc.addEventListener('click', (e) => {
      const t = e.target as Element;
      if (t.closest?.('[data-f]') || t.closest?.('summary')) e.preventDefault();
    });
    doc.addEventListener('keydown', (e) => {
      const el = (e.target as Element).closest?.('[data-f]') as HTMLElement | null;
      if (!el) return;
      if (e.key === 'Enter' || e.key === 'Escape') { e.preventDefault(); if (e.key === 'Escape') el.textContent = getPath(state.spec, el.dataset.f!) ?? ''; el.blur(); }
    });
    doc.addEventListener('paste', (e) => {
      const el = (e.target as Element).closest?.('[data-f]');
      if (!el) return;
      e.preventDefault();
      const text = (e.clipboardData?.getData('text/plain') ?? '').replace(/\s+/g, ' ');
      doc.execCommand('insertText', false, text);
    });
    doc.addEventListener('focusout', (e) => {
      const el = (e.target as Element).closest?.('[data-f]') as HTMLElement | null;
      if (!el || !state.spec) return;
      const path = el.dataset.f!;
      const value = (el.textContent ?? '').replace(/\s+/g, ' ').trim().slice(0, 600);
      const before = getPath(state.spec, path);
      if (!value) { el.textContent = before ?? ''; return; }
      if (value === before) return;
      const snapshot = structuredClone(state.spec);
      if (setPath(state.spec, path, value)) {
        state.history.push(snapshot);
        drawLog(); save();
        if (path === 'name') render();
      }
    });
  });

  $$<HTMLButtonElement>('[data-device]').forEach((btn) =>
    btn.addEventListener('click', () => {
      $$<HTMLButtonElement>('[data-device]').forEach((x) => x.setAttribute('aria-pressed', String(x === btn)));
      wrap.classList.toggle('is-mobile', btn.dataset.device === 'mobile');
    }));

  // ---- Steps ----
  function go(step: number) {
    state.step = step;
    root.dataset.step = String(step);
    $$<HTMLButtonElement>('[data-goto]').forEach((x) => {
      if (!x.closest('.st-steps')) return;
      const n = Number(x.dataset.goto);
      x.disabled = n > maxReached();
      x.toggleAttribute('aria-current', n === step);
    });
    if (step >= 2) { render(); syncControls(); }
    if (step === 4) { prefillOrder(); updateTotal(); }
    save();
    window.scrollTo({ top: 0 });
    $<HTMLElement>('.st-side').scrollTop = 0;
  }
  const maxReached = () => (!state.spec ? 1 : state.chat.length || state.step >= 3 ? 4 : 2);
  root.addEventListener('click', (e) => {
    const g = (e.target as Element).closest<HTMLElement>('[data-goto]');
    if (g && !(g as HTMLButtonElement).disabled) go(Number(g.dataset.goto));
  });

  // 1. Pick
  $$<HTMLButtonElement>('[data-template]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const id = btn.dataset.template as TemplateId;
      const keep = state.spec;
      state.spec = sampleSpec(id, (keep?.lang ?? cfg.lang) as SiteLang);
      if (keep && state.chat.length) {
        // Keep the client's words, take the new look.
        state.spec = mergeSpec(keep, { template: id, colors: looks[id], font: looks[id].font });
      }
      go(state.chat.length ? 3 : 2);
    }));

  // 2. Basics
  const basics = $<HTMLFormElement>('#st-basics');
  for (const [k, v] of Object.entries(state.basics)) {
    const el = basics.elements.namedItem(k) as HTMLInputElement | RadioNodeList | null;
    if (el && 'value' in el) el.value = v;
  }
  basics.addEventListener('input', () => {
    if (!state.spec) return;
    const d = Object.fromEntries(new FormData(basics)) as Record<string, string>;
    state.basics = d;
    const sl = (d.siteLang || cfg.lang) as SiteLang;
    if (sl !== state.spec.lang) state.spec = { ...sampleSpec(state.spec.template, sl), colors: state.spec.colors, font: state.spec.font };
    state.spec.name = d.name?.trim() || sampleSpec(state.spec.template, sl).name;
    applyContact(d);
    render(); save();
  });
  function applyContact(d: Record<string, string>) {
    if (!state.spec) return;
    if (d.phone?.trim()) { state.spec.contact.phone = d.phone.trim(); state.spec.contact.whatsapp = d.phone.trim(); }
    if (d.email?.trim()) state.spec.contact.email = d.email.trim();
    if (d.city?.trim()) state.spec.contact.address = d.city.trim();
  }
  basics.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(basics)) as Record<string, string>;
    if (!d.name?.trim()) { (basics.elements.namedItem('name') as HTMLInputElement).focus(); return; }
    state.basics = d;
    const kinds = T.kinds as Record<string, string>;
    const message = [
      `Website for: ${kinds[d.kind] ?? d.kind}`,
      `Name: ${d.name}`,
      d.about && `About the business: ${d.about}`,
      d.phone && `Phone/WhatsApp: ${d.phone}`,
      d.email && `Email: ${d.email}`,
      d.city && `City: ${d.city}`,
      `Website language: ${d.siteLang}`,
    ].filter(Boolean).join('\n');
    go(3);
    state.chat = [];
    drawLog();
    await ask(message, 'create', true);
  });
  $('[data-skip]').addEventListener('click', () => {
    state.basics = Object.fromEntries(new FormData(basics)) as Record<string, string>;
    state.chat = [{ from: 'ai', text: T.chatWelcome }];
    drawLog();
    go(3);
  });

  // 3. Chat with the AI designer
  const log = $<HTMLElement>('#st-log');
  const input = $<HTMLTextAreaElement>('#st-input');
  const busy = $<HTMLElement>('#st-busy');
  const busyText = $<HTMLElement>('#st-busy-text');
  let working = false;

  function drawLog() {
    log.replaceChildren(...state.chat.map((m) => {
      const p = document.createElement('p');
      p.className = `st-msg st-${m.from}`;
      p.dir = 'auto';
      p.textContent = m.text;
      return p;
    }));
    log.scrollTop = log.scrollHeight;
    $<HTMLElement>('#st-sugs').hidden = state.chat.filter((m) => m.from === 'me').length > 1;
    $<HTMLButtonElement>('[data-undo]').disabled = state.history.length === 0;
  }

  async function ask(text: string, action: 'create' | 'edit', silent = false) {
    if (working || !state.spec) return;
    working = true;
    if (!silent) state.chat.push({ from: 'me', text });
    drawLog();
    busyText.textContent = action === 'create' ? T.generating : T.thinking;
    busy.hidden = false;
    root.classList.add('is-busy');
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 120000);
    try {
      const res = await fetch(cfg.builderEndpoint, {
        method: 'POST',
        body: new URLSearchParams({ sessionId: state.sessionId, action, message: text, spec: JSON.stringify(state.spec), lang: cfg.lang }),
        signal: ctrl.signal,
      });
      const data = await res.json().catch(() => ({}));
      if (data?.success && data.spec) {
        state.history.push(structuredClone(state.spec));
        state.spec = mergeSpec(state.spec, data.spec);
        state.aiUsed = true;
        state.chat.push({ from: 'ai', text: data.reply || '✓' });
        pushVersion('ai');
        render();
        syncControls();
      } else if (data?.unavailable) {
        state.chat.push({ from: 'note', text: T.aiDown });
        $<HTMLDetailsElement>('.st-quick').open = true;
      } else if (data?.reply) {
        state.chat.push({ from: 'ai', text: data.reply });
      } else {
        state.chat.push({ from: 'note', text: action === 'create' ? T.aiDown : T.aiFailed });
        if (action === 'create') $<HTMLDetailsElement>('.st-quick').open = true;
      }
    } catch {
      state.chat.push({ from: 'note', text: T.aiDown });
      $<HTMLDetailsElement>('.st-quick').open = true;
    } finally {
      clearTimeout(timer);
      working = false;
      busy.hidden = true;
      root.classList.remove('is-busy');
      drawLog();
      save();
    }
  }

  $<HTMLFormElement>('#st-ask').addEventListener('submit', (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text) return;
    input.value = '';
    input.style.height = '';
    ask(text, 'edit');
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); $<HTMLFormElement>('#st-ask').requestSubmit(); }
  });
  input.addEventListener('input', () => { input.style.height = ''; input.style.height = `${Math.min(input.scrollHeight, 140)}px`; });
  $$<HTMLButtonElement>('[data-suggest]').forEach((btn) => btn.addEventListener('click', () => ask(btn.textContent!.trim(), 'edit')));
  $<HTMLButtonElement>('[data-undo]').addEventListener('click', () => {
    const prev = state.history.pop();
    if (prev) { state.spec = prev; render(); syncControls(); drawLog(); save(); }
  });
  $('[data-reset]').addEventListener('click', () => {
    if (!confirm(T.resetConfirm)) return;
    try { localStorage.removeItem(KEY); } catch { /* ignore */ }
    state = blank();
    basics.reset();
    drawLog();
    go(1);
  });

  // Quick settings (work without the AI)
  const ctl = (name: string) => $<HTMLInputElement | HTMLSelectElement>(`[data-ctl="${name}"]`);
  // ---- Images (logo, photos) ----
  async function shrink(file: File, slot: string): Promise<Blob> {
    const bmp = await createImageBitmap(file);
    const max = slot === 'logo' ? 600 : 1600;
    const scale = Math.min(1, max / Math.max(bmp.width, bmp.height));
    const c = document.createElement('canvas');
    c.width = Math.round(bmp.width * scale);
    c.height = Math.round(bmp.height * scale);
    c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
    const png = slot === 'logo' && file.type !== 'image/jpeg';
    return new Promise((ok, fail) => c.toBlob((b) => (b ? ok(b) : fail(new Error('encode'))), png ? 'image/png' : 'image/jpeg', 0.82));
  }
  async function upload(file: File, slot: string): Promise<string | null> {
    const blob = await shrink(file, slot);
    const fd = new FormData();
    fd.append('file', blob, blob.type === 'image/png' ? 'image.png' : 'image.jpg');
    fd.append('sessionId', state.sessionId);
    const res = await fetch(cfg.uploadEndpoint, { method: 'POST', body: fd });
    const data = await res.json().catch(() => ({}));
    return data?.success && typeof data.id === 'string' ? data.id : null;
  }
  const upError = $<HTMLElement>('#st-up-error');
  function drawMedia() {
    const m = state.spec?.media;
    if (!m) return;
    for (const slot of ['logo', 'hero', 'about'] as const) {
      const row = $<HTMLElement>(`[data-slot="${slot}"]`);
      const id = m[slot];
      row.querySelector<HTMLElement>('[data-thumb]')!.style.backgroundImage = id ? `url(${cfg.imageBase}${id})` : '';
      row.querySelector<HTMLElement>('[data-up-label]')!.textContent = id ? T.change : T.upload;
      row.querySelector<HTMLButtonElement>('[data-remove]')!.hidden = !id;
    }
    $<HTMLElement>('#st-gal').replaceChildren(...m.gallery.map((id, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'st-gal-item';
      b.style.backgroundImage = `url(${cfg.imageBase}${id})`;
      b.title = T.remove;
      b.setAttribute('aria-label', `${T.remove} ${i + 1}`);
      b.addEventListener('click', () => change((s) => ({ ...s, media: { ...s.media, gallery: s.media.gallery.filter((_, j) => j !== i) } })));
      return b;
    }));
  }
  $$<HTMLInputElement>('[data-upload]').forEach((input) =>
    input.addEventListener('change', async () => {
      const slot = input.dataset.upload!;
      const files = Array.from(input.files || []).slice(0, slot === 'gallery' ? 9 : 1);
      input.value = '';
      if (!files.length || !state.spec) return;
      const label = input.parentElement!.querySelector<HTMLElement>('[data-up-label]')!;
      const before = label.textContent;
      label.textContent = T.uploading;
      upError.hidden = true;
      try {
        const ids = (await Promise.all(files.map((f) => upload(f, slot).catch(() => null)))).filter(Boolean) as string[];
        if (!ids.length) throw new Error('upload');
        change((s) => ({
          ...s,
          media: slot === 'gallery'
            ? { ...s.media, gallery: [...s.media.gallery, ...ids].slice(0, 9) }
            : { ...s.media, [slot]: ids[0] },
          sections: slot === 'gallery' && !s.sections.includes('gallery')
            ? [...s.sections.slice(0, 2), 'gallery', ...s.sections.slice(2)]
            : s.sections,
        }));
      } catch {
        upError.hidden = false;
      } finally {
        label.textContent = before;
        drawMedia();
      }
    }));
  $$<HTMLButtonElement>('[data-remove]').forEach((btn) =>
    btn.addEventListener('click', () => change((s) => ({ ...s, media: { ...s.media, [btn.dataset.remove!]: '' } }))));

  function syncControls() {
    drawMedia();
    if (!state.spec) return;
    ctl('template').value = state.spec.template;
    ctl('font').value = state.spec.font;
    ctl('primary').value = state.spec.colors.primary;
    ctl('accent').value = state.spec.colors.accent;
    ctl('background').value = state.spec.colors.background || '#ffffff';
    ctl('lang').value = state.spec.lang;
    drawPanels();
  }
  function change(fn: (s: Spec) => Spec) {
    if (!state.spec) return;
    state.history.push(structuredClone(state.spec));
    state.spec = fn(state.spec);
    render(); drawLog(); drawMedia(); drawPanels(); save();
  }
  ctl('template').addEventListener('change', (e) => {
    const id = (e.target as HTMLSelectElement).value as TemplateId;
    change((s) => mergeSpec(s, { template: id, colors: looks[id], font: looks[id].font }));
    syncControls();
  });
  ctl('font').addEventListener('change', (e) => change((s) => mergeSpec(s, { font: (e.target as HTMLSelectElement).value })));
  ctl('primary').addEventListener('change', (e) => change((s) => mergeSpec(s, { colors: { ...s.colors, primary: (e.target as HTMLInputElement).value } })));
  ctl('background').addEventListener('change', (e) => change((s) => mergeSpec(s, { colors: { ...s.colors, background: (e.target as HTMLInputElement).value } })));
  $('[data-bg-reset]').addEventListener('click', () => { change((s) => mergeSpec(s, { colors: { ...s.colors, background: '' } })); syncControls(); });
  ctl('accent').addEventListener('change', (e) => change((s) => mergeSpec(s, { colors: { ...s.colors, accent: (e.target as HTMLInputElement).value } })));
  ctl('lang').addEventListener('change', (e) => {
    const l = (e.target as HTMLSelectElement).value as SiteLang;
    if (state.aiUsed) {
      // Ask the AI to translate the client's own text.
      ask(`Translate the whole website into this language: ${l}.`, 'edit', true);
    } else {
      change((s) => ({ ...sampleSpec(s.template, l), colors: s.colors, font: s.font, name: s.name, contact: { ...sampleSpec(s.template, l).contact, phone: s.contact.phone, whatsapp: s.contact.whatsapp, email: s.contact.email } }));
    }
  });

  // ---- Sections, extras, reviews, FAQ ----
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, props: Partial<HTMLElementTagNameMap[K]> = {}, ...kids: (Node | string)[]) => {
    const n = Object.assign(document.createElement(tag), props);
    n.append(...kids);
    return n;
  };
  const withSection = (s: Spec, id: SectionId) => (s.sections.includes(id) ? s.sections : sectionIds.filter((x) => x === id || s.sections.includes(x)));
  const mapInput = $<HTMLInputElement>('[data-map]');
  function drawPanels() {
    const sp = state.spec;
    if (!sp) return;
    $$<HTMLInputElement>('[data-section]').forEach((x) => { x.checked = sp.sections.includes(x.dataset.section as SectionId); });
    $$<HTMLInputElement>('[data-extra]').forEach((x) => { x.checked = !!sp.extras[x.dataset.extra as 'whatsappButton' | 'contactForm']; });
    if (document.activeElement !== mapInput) mapInput.value = sp.extras.mapUrl;
    $<HTMLElement>('#st-reviews').replaceChildren(...sp.testimonials.items.map((q, i) => el('li', {},
      el('span', { dir: 'auto' }, `“${q.quote}”`, el('small', {}, [q.name, q.role].filter(Boolean).join(' · '))),
      el('button', { type: 'button', className: 'is-del', textContent: T.delete, onclick: () => change((s) => ({ ...s, testimonials: { ...s.testimonials, items: s.testimonials.items.filter((_, j) => j !== i) } })) }),
    )));
    $<HTMLElement>('#st-faqs').replaceChildren(...sp.faq.items.map((x, i) => el('li', {},
      el('span', { dir: 'auto' }, x.q, el('small', {}, x.a)),
      el('button', { type: 'button', className: 'is-del', textContent: T.delete, onclick: () => change((s) => ({ ...s, faq: { ...s.faq, items: s.faq.items.filter((_, j) => j !== i) } })) }),
    )));
    const vs = state.versions ?? [];
    const when = new Intl.DateTimeFormat(cfg.numberLocale, { hour: 'numeric', minute: '2-digit', day: 'numeric', month: 'short' });
    $<HTMLElement>('#st-versions').replaceChildren(...vs.slice().reverse().map((v) => el('li', {},
      el('span', {}, v.kind === 'ai' ? T.versionAi : T.versionSaved, el('small', {}, when.format(v.at))),
      el('button', { type: 'button', textContent: T.restore, onclick: () => { change(() => structuredClone(v.spec)); syncControls(); state.chat.push({ from: 'note', text: T.versionRestored }); drawLog(); save(); } }),
    )));
    $<HTMLElement>('#st-no-versions').hidden = vs.length > 0;
  }
  function pushVersion(kind: 'ai' | 'saved') {
    if (!state.spec) return;
    state.versions = [...(state.versions ?? []), { at: Date.now(), kind, spec: structuredClone(state.spec) }].slice(-12);
    drawPanels();
  }
  $('[data-save-version]').addEventListener('click', () => { pushVersion('saved'); save(); });
  $$<HTMLInputElement>('[data-section]').forEach((box) => box.addEventListener('change', () => {
    const id = box.dataset.section as SectionId;
    change((s) => ({ ...s, sections: box.checked ? withSection(s, id) : s.sections.filter((x) => x !== id) }));
  }));
  $$<HTMLInputElement>('[data-extra]').forEach((box) => box.addEventListener('change', () => {
    change((s) => ({ ...s, extras: { ...s.extras, [box.dataset.extra!]: box.checked } }));
  }));
  mapInput.addEventListener('change', () => {
    const v = mapInput.value.trim();
    const merged = state.spec ? mergeSpec(state.spec, { extras: { mapUrl: v } }) : null;
    const ok = merged && merged.extras.mapUrl === v;
