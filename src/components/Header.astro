---
import { t, type Lang } from '../i18n/content';
import { link } from '../lib/routes';
import Logo from './Logo.astro';
import LangPicker from './LangPicker.astro';
import { builderText } from '../i18n/builder';

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const c = t[lang];
const b = builderText[lang];
const onBuilder = path === '/website-builder/' || path === '/studio/';
---
<header class="hd" id="hd">
  <div class="wrap hd-row">
    <a class="hd-brand" href={link(lang, '/')} aria-label="Oxira">
      <Logo variant="light" />
    </a>

    <nav class="hd-nav" id="hd-nav" aria-label={lang === 'ar' ? 'القائمة الرئيسية' : 'Main'}>
      <ul>
        {c.site.nav.map((n) => (
          <li><a href={link(lang, n.path)} aria-current={path === n.path ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <li><a class="hd-build" href={link(lang, '/website-builder/')} aria-current={onBuilder ? 'page' : undefined}>{b.navLabel}<span class="hd-new">{b.badge}</span></a></li>
      </ul>
      <a class="btn btn-navy hd-cta-mobile" href={link(lang, '/contact/')}>{c.site.contactCta}</a>
    </nav>

    <div class="hd-end">
      <LangPicker lang={lang} path={path} />
      <a class="btn btn-navy hd-cta" href={link(lang, '/contact/')} aria-current={path === '/contact/' ? 'page' : undefined}>{c.site.contactCta}</a>
      <button type="button" class="hd-menu" id="hd-menu" aria-controls="hd-nav" aria-expanded="false">
        <span class="sr-only">{c.site.menu}</span>
        <i></i><i></i>
      </button>
    </div>
  </div>
</header>

<script>
  const hd = document.getElementById('hd')!;
  const btn = document.getElementById('hd-menu') as HTMLButtonElement;
  btn.addEventListener('click', () => {
    const open = hd.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  });
  const onScroll = () => hd.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .hd { position: sticky; top: 0; z-index: 40; border-bottom: 1px solid transparent; transition: border-color .2s; }
  .hd::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgba(255,255,255,.92); backdrop-filter: saturate(1.4) blur(12px); }
  .hd.is-open::before { background: #fff; }
  .hd.is-scrolled { border-bottom-color: var(--line); }
  .hd-row { display: flex; align-items: center; gap: 2rem; min-height: 4.75rem; }
  .hd-brand { font-size: 1.7rem; text-decoration: none; flex: none; }

  .hd-nav { flex: 1; }
  .hd-nav ul { list-style: none; display: flex; align-items: center; gap: clamp(.9rem, 1.7vw, 1.75rem); }
  .hd-nav ul a { white-space: nowrap; text-decoration: none; font-weight: 600; color: var(--muted); padding-block: .4rem; border-bottom: 2px solid transparent; }
  .hd-nav ul a:hover { color: var(--ink); }
  .hd-nav ul a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--amber); }
  .hd-cta-mobile { display: none; }
  .hd-nav ul a.hd-build { color: var(--ink); display: inline-flex; align-items: center; gap: .4rem; }
  .hd-new { font-size: .68rem; font-weight: 700; line-height: 1; padding: .28rem .45rem; border-radius: 999px; background: var(--amber); color: var(--navy); }

  .hd-end { display: flex; align-items: center; gap: .75rem; }
  .hd-cta { padding: .8rem 1.25rem; font-size: .95rem; }

  .hd-menu { display: none; width: 44px; height: 44px; border-radius: 12px; border: 1.5px solid var(--line); background: #fff; cursor: pointer; position: relative; }
  .hd-menu i { position: absolute; inset-inline: 12px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform .2s, top .2s; }
  .hd-menu i:first-of-type { top: 16px; }
  .hd-menu i:last-of-type { top: 25px; }
  .is-open .hd-menu i:first-of-type { top: 20px; transform: rotate(45deg); }
  .is-open .hd-menu i:last-of-type { top: 20px; transform: rotate(-45deg); }

  @media (max-width: 1200px) {
    .hd-row { justify-content: space-between; }
    .hd-menu { display: block; }
    .hd-cta { display: none; }
    .hd-nav { display: none; position: fixed; top: 4.75rem; left: 0; right: 0; bottom: 0; z-index: 41; background: #fff; padding: 1.5rem var(--gutter) 2rem; overflow-y: auto; }
    .is-open .hd-nav { display: flex; flex-direction: column; gap: 1.5rem; }
    .hd-nav ul { flex-direction: column; gap: 0; }
    .hd-nav li { border-bottom: 1px solid var(--line); }
    .hd-nav ul a { display: block; padding: 1rem 0; font-size: 1.25rem; color: var(--ink); border: 0; }
    .hd-nav ul a[aria-current='page'] { color: var(--blue); }
    .hd-nav a.hd-cta-mobile { display: inline-flex; color: #fff; padding: 1rem 1.6rem; font-size: 1.05rem; }
    :global(body:has(.hd.is-open) .oxchat) { display: none; }
  }
</style>
