---
import { t, contact, languages, type Lang } from '../i18n/content';
import { link, asset } from '../lib/routes';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Chat from '../components/Chat.astro';
// Fonts are self-hosted (no request to Google from visitors' browsers).
// Latin and Cyrillic: IBM Plex Sans. Arabic: Cairo. The browser picks per character.
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-700.css';
import '@fontsource/ibm-plex-sans/latin-ext-400.css';
import '@fontsource/ibm-plex-sans/latin-ext-600.css';
import '@fontsource/ibm-plex-sans/latin-ext-700.css';
import '@fontsource/ibm-plex-sans/cyrillic-400.css';
import '@fontsource/ibm-plex-sans/cyrillic-500.css';
import '@fontsource/ibm-plex-sans/cyrillic-600.css';
import '@fontsource/ibm-plex-sans/cyrillic-700.css';
import '@fontsource/tajawal/arabic-400.css';
import '@fontsource/tajawal/arabic-500.css';
import '@fontsource/tajawal/arabic-700.css';
import '@fontsource/tajawal/arabic-800.css';

interface Props {
  lang: Lang;
  path: string;          // page path without language prefix, e.g. '/', '/services/'
  title: string;
  description: string;
  /** App pages (the studio): no footer and no chat bubble. */
  app?: boolean;
  /** Keep out of search results (account pages). */
  noindex?: boolean;
  /** Languages this page exists in (default: all). Others get no hreflang and the picker sends them home. */
  langs?: Lang[];
  /** Hide the site chat bubble (pages that have their own chat). */
  nochat?: boolean;
}
const { lang, path, title, description, app = false, noindex = false, langs, nochat = false } = Astro.props;
// Visitor analytics: set the repo variable GA_ID (e.g. G-XXXXXXX) to turn on Google Analytics 4.
const gaId = import.meta.env.PUBLIC_GA_ID || 'G-3WN4EW3DPX';
const c = t[lang];
const site = Astro.site!;
const canonical = new URL(link(lang, path), site).href;
const alternates = languages.filter((l) => !langs || langs.includes(l.code)).map((l) => ({ code: l.code, href: new URL(link(l.code, path), site).href }));
const arUrl = new URL(link('ar', path), site).href;
const locale = languages.find((l) => l.code === lang)!.locale;
const ogImage = new URL(asset(`og-${lang}.png`), site).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Oxira',
  alternateName: 'أوكسيرا',
  url: new URL(link('ar', '/'), site).href,
  logo: new URL(asset('favicon.svg'), site).href,
  email: contact.email,
  telephone: contact.phone.replace(/\s/g, ''),
  address: { '@type': 'PostalAddress', streetAddress: '426 Al Sulaymaniyah, Al Urubah Rd.', addressLocality: 'Riyadh', addressCountry: 'SA' },
};
---
<!doctype html>
<html lang={lang} dir={c.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    {(!langs || langs.includes('ar')) && <link rel="alternate" hreflang="x-default" href={arUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Oxira" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0A253E" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={asset('sitemap.xml')} />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <!-- Local currency hint (see src/lib/fx.ts): pick the visitor's currency before first paint so price lines reserve their space. Saudi visitors get nothing. -->
    <script is:inline>(function(){try{var d=document.documentElement,c=null;try{c=localStorage.getItem('oxira-cur')}catch(e){}if(c&&/^[A-Z]{3}$/.test(c)){d.setAttribute('data-fx',c);return}var z=Intl.DateTimeFormat().resolvedOptions().timeZone||'',m={'Asia/Riyadh':'SAR','Asia/Dubai':'AED','Africa/Cairo':'EGP','Asia/Qatar':'QAR','Asia/Kuwait':'KWD','Asia/Bahrain':'BHD','Asia/Muscat':'OMR','Europe/London':'GBP','Europe/Jersey':'GBP','Europe/Guernsey':'GBP','Europe/Isle_of_Man':'GBP','Europe/Moscow':'USD','Europe/Istanbul':'USD','Europe/Kyiv':'USD','Europe/Kiev':'USD','Europe/Minsk':'USD'};if(!z||/^(UTC|GMT|Etc\/)/.test(z))z=/-GB$/i.test(navigator.language||'')?'Europe/London':'';c=m[z]||(/^Europe\//.test(z)?'EUR':z?'USD':'SAR');if(c!=='SAR')d.setAttribute('data-fx',c)}catch(e){}})()</script>
    <script is:inline>try{var r=new URLSearchParams(location.search).get('ref');if(r&&/^[a-z0-9]{3,20}$/i.test(r))localStorage.setItem('oxira-ref',JSON.stringify({c:r.toLowerCase(),t:Date.now()}))}catch(e){}</script>
    {gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
    {gaId && <script is:inline define:vars={{ gaId }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());var q=new URLSearchParams(location.search),k=new URLSearchParams();q.forEach(function(v,n){if(/^utm_|^gclid$/.test(n))k.set(n,v);});var s=k.toString();gtag('config',gaId,{page_location:location.origin+location.pathname+(s?'?'+s:''),allow_google_signals:false,allow_ad_personalization_signals:false});</script>}
  </head>
  <body>
    <a class="skip" href="#main">{c.site.skip}</a>
    <Header lang={lang} path={path} langs={langs} />
    <main id="main">
      <slot />
    </main>
    {!app && <Footer lang={lang} path={path} langs={langs} />}
    {!app && !nochat && <Chat lang={lang} />}
  </body>
</html>

<style is:global>
  :root {
    /* Oxira brand, from the company profile */
    --navy: #0A253E;
    --navy-deep: #061A2D;
    --navy-mid: #10375A;
    --amber: #F5A800;
    --amber-deep: #DB9600;
    --blue: #007DB4;
    --blue-soft: #E6F2F8;
    --cyan: #22C7E6;

    --ink: #0A253E;
    --muted: #556779;
    --muted-on-navy: #A7B8C8;
    --line: #E2E8EE;
    --paper: #F5F7F9;
    --white: #FFFFFF;

    --font: 'IBM Plex Sans', 'Tajawal', system-ui, sans-serif;

    --s-1: .875rem;
    --s0: 1.0625rem;
    --s1: 1.25rem;
    --s2: clamp(1.4rem, 2.2vw, 1.75rem);
    --s3: clamp(1.8rem, 3.4vw, 2.6rem);
    --s4: clamp(2.2rem, 4.6vw, 3.6rem);
    --s5: clamp(2.6rem, 6.4vw, 5rem);

    --gutter: clamp(1.25rem, 5vw, 3rem);
    --page: 76rem;
    --section: clamp(4.5rem, 10vw, 8.5rem);
    --radius: 18px;
    --radius-lg: 28px;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

  body {
    margin: 0;
    background: var(--white);
    color: var(--ink);
    font-family: var(--font);
    font-weight: 400;
    font-size: var(--s0);
    line-height: 1.8;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }
  html[dir='ltr'] body { line-height: 1.65; }

  h1, h2, h3, h4 { font-weight: 700; line-height: 1.3; margin: 0; }
  html[dir='ltr'] :is(h1, h2) { letter-spacing: -0.02em; line-height: 1.12; }
  html[lang='ar'] :is(h1, h2) { line-height: 1.35; }
  p { margin: 0; }
  a { color: inherit; }
  img, svg { display: block; max-width: 100%; }
  ul, ol { margin: 0; padding: 0; }

  :focus-visible { outline: 3px solid var(--amber); outline-offset: 3px; border-radius: 6px; }

  .skip { position: absolute; inset-inline-start: 1rem; top: -4rem; z-index: 100; background: var(--navy); color: #fff; padding: .6rem 1rem; border-radius: 8px; }
  .skip:focus { top: 1rem; }

  .wrap { width: 100%; max-width: var(--page); margin-inline: auto; padding-inline: var(--gutter); }
  .section { padding-block: var(--section); }
  .section-tight { padding-block: clamp(3.5rem, 7vw, 6rem); }
  .bg-paper { background: var(--paper); }
  .bg-navy { background: var(--navy); color: #fff; }

  /* Section heading block */
  .sh { display: grid; gap: 1rem; max-width: 46rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .sh h2 { font-size: var(--s4); }
  .sh p { font-size: 1.15rem; color: var(--muted); }
  .bg-navy .sh p { color: var(--muted-on-navy); }
  .sh-row { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .sh-row .sh { margin-bottom: 0; }
  .label { color: var(--blue); font-weight: 700; font-size: 1rem; }
  .bg-navy .label { color: var(--amber); }

  /* Buttons and links */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
    font: 700 1rem/1 var(--font); padding: 1.05rem 1.6rem; border-radius: 12px;
    text-decoration: none; border: 1.5px solid transparent; cursor: pointer;
    transition: background-color .15s, color .15s, border-color .15s;
  }
  .btn-amber { background: var(--amber); color: var(--navy); }
  .btn-amber:hover { background: var(--amber-deep); }
  .btn-navy { background: var(--navy); color: #fff; }
  .btn-navy:hover { background: var(--navy-mid); }
  .btn-ghost { border-color: var(--line); color: var(--ink); background: #fff; }
  .btn-ghost:hover { border-color: var(--navy); }
  .btn-ghost-light { border-color: rgba(255,255,255,.35); color: #fff; }
  .btn-ghost-light:hover { border-color: #fff; background: rgba(255,255,255,.06); }

  .more { display: inline-flex; align-items: center; gap: .45rem; font-weight: 700; color: #00699A; text-decoration: none; }
  .more::after { content: ''; width: .5em; height: .5em; border-top: 2px solid currentColor; border-inline-end: 2px solid currentColor; transform: rotate(45deg); }
  html[dir='rtl'] .more::after { transform: rotate(-45deg); }
  .more:hover { text-decoration: underline; text-underline-offset: .3em; }
  .bg-navy .more { color: var(--amber); }

  /* Page hero for inner pages */
  .page-hero { padding-block: clamp(4rem, 9vw, 7rem) clamp(2.5rem, 5vw, 4rem); }
  .page-hero h1 { font-size: var(--s5); max-width: 18ch; text-wrap: balance; }
  .page-hero .lead { margin-top: 1.25rem; font-size: clamp(1.1rem, 1.6vw, 1.3rem); color: var(--muted); max-width: 44rem; }

  /* Local currency hint under SAR prices (components/Fx.astro, FxNote.astro). Hidden unless <html data-fx> is set. */
  .fx, .fx-note { display: none; }
  html[data-fx] .fx { display: block; min-height: 1.5em; line-height: 1.5; font-size: .85rem; font-weight: 500; opacity: .8; }
  html[data-fx] .fx-inline { display: inline; min-height: 0; }
  html[data-fx] .fx-inline:not(:empty)::before { content: ' · '; }
  html[data-fx='SAR'] .fx { display: none; }
  html[data-fx] .fx-note { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem 1rem; margin-top: 1rem; font-size: .85rem; color: var(--muted); }
  html[data-fx] .fx-note.fx-dark { color: var(--muted-on-navy); }
  .fx-note label { display: inline-flex; align-items: center; gap: .4rem; }
  .fx-pick { font: 600 .85rem var(--font); color: var(--ink); background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: .15rem .35rem; cursor: pointer; }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>
