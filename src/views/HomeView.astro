---
import { t, type Lang } from '../i18n/content';
import { link, asset } from '../lib/routes';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import ClientStrip from '../components/ClientStrip.astro';
import AgentsDemo from '../components/AgentsDemo.astro';
import CtaBand from '../components/CtaBand.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t[lang];
const h = c.home;
const featured = c.work.projects.slice(0, 2);
const firstChat = c.agents.chats[0];
---
<Base lang={lang} path="/" title={c.pages.home.title} description={c.pages.home.description}>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="label">{c.hero.kicker}</p>
        <h1 id="hero-title">{h.title}</h1>
        <p class="hero-body">{h.body}</p>
        <div class="hero-actions">
          <a class="btn btn-amber" href={link(lang, '/contact/')}>{h.cta}</a>
          <a class="btn btn-ghost" href={link(lang, '/services/')}>{h.secondary}</a>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="hv-glow"></div>
        <div class="hv-browser">
          <div class="hv-bar"><i></i><i></i><i></i></div>
          <img src={asset('products/classti-dashboard.webp')} alt="" width="1440" height="1024" />
        </div>
        <div class="hv-chat">
          <div class="hv-chat-head"><span class="hv-av"><Logo variant="dark" wordmark={false} /></span><strong>{c.chat.title}</strong></div>
          <p class="hv-msg hv-user">{firstChat.messages[0].text}</p>
          <p class="hv-msg hv-bot">{firstChat.messages[3].text}</p>
        </div>
        <div class="hv-mark"><Logo variant="light" wordmark={false} /></div>
      </div>
    </div>
  </section>

  <!-- Clients -->
  <section class="section-tight trusted" aria-label={h.trusted}>
    <div class="wrap">
      <ClientStrip lang={lang} title={h.trusted} />
    </div>
  </section>

  <!-- Services -->
  <section class="section" aria-labelledby="svc-title">
    <div class="wrap">
      <div class="sh-row">
        <div class="sh">
          <h2 id="svc-title">{h.servicesTitle}</h2>
          <p>{h.servicesBody}</p>
        </div>
        <a class="more" href={link(lang, '/services/')}>{h.servicesLink}</a>
      </div>
      <ul class="svc-grid">
        {c.services.list.map((s) => (
          <li>
            <a class="svc" href={s.icon === 'agent' ? link(lang, '/ai-agents/') : `${link(lang, '/services/')}#${s.icon}`}>
              <span class="svc-icon"><Icon name={s.icon} /></span>
              <h3>{s.name}</h3>
              <p>{s.items[0]}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- AI agents -->
  <section class="section bg-navy agents" aria-labelledby="ag-title">
    <div class="wrap ag-grid">
      <div class="ag-text">
        <p class="label" lang={lang === 'ar' ? 'en' : 'ar'}>{c.agents.kicker}</p>
        <h2 id="ag-title">{c.agents.title}</h2>
        <p class="ag-body">{h.agentsBody}</p>
        <ul class="ag-caps">
          {c.agents.capabilities.slice(0, 4).map((cap) => (
            <li><strong>{cap.name}</strong><span>{cap.text}</span></li>
          ))}
        </ul>
        <a class="btn btn-amber" href={link(lang, '/ai-agents/')}>{h.agentsLink}</a>
      </div>
      <AgentsDemo lang={lang} tone="dark" />
    </div>
  </section>

  <!-- Classti -->
  <section class="section ct" aria-labelledby="ct-title">
    <div class="wrap ct-grid">
      <div class="ct-text">
        <p class="label" dir="ltr">{c.products.tagline}</p>
        <h2 id="ct-title">{h.classtiTitle}</h2>
        <p class="ct-body">{c.products.lead}</p>
        <ul class="ct-list">
          {c.products.suite.map((it) => <li><strong>{it.name}</strong><span>{it.text}</span></li>)}
        </ul>
        <a class="more" href={link(lang, '/classti/')}>{h.classtiLink}</a>
      </div>
      <div class="ct-visual" aria-hidden="true">
        <img src={asset('products/classti-exams.webp')} alt="" width="1440" height="1025" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Work -->
  <section class="section bg-paper" aria-labelledby="wk-title">
    <div class="wrap">
      <div class="sh-row">
        <div class="sh"><h2 id="wk-title">{h.workTitle}</h2><p>{c.work.body}</p></div>
        <a class="more" href={link(lang, '/work/')}>{h.workLink}</a>
      </div>
      <ul class="wk-grid">
        {featured.map((p) => (
          <li class="wk">
            <div class="wk-shot"><img src={asset(`work/${p.slug}.webp`)} alt="" width="1200" height="808" loading="lazy" /></div>
            <div class="wk-body">
              <span class="wk-sector">{p.sector}</span>
              <h3>{p.name}</h3>
              <p>{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Why Oxira -->
  <section class="section" aria-labelledby="why-title">
    <div class="wrap">
      <div class="sh-row">
        <div class="sh"><h2 id="why-title">{c.advantages.title}</h2></div>
        <a class="more" href={link(lang, '/about/')}>{h.aboutLink}</a>
      </div>
      <ul class="why">
        {c.advantages.list.map((a) => <li><h3>{a.name}</h3><p>{a.text}</p></li>)}
      </ul>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  /* Hero */
  .hero { padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(2rem, 5vw, 4rem); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .hero h1 { font-size: clamp(2.6rem, 5.2vw, 4.4rem); margin-top: 1rem; text-wrap: balance; }
  .hero-body { margin-top: 1.5rem; font-size: clamp(1.1rem, 1.5vw, 1.25rem); color: var(--muted); max-width: 34rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2.25rem; }

  .hero-visual { position: relative; padding: 2rem 0 3rem; }
  .hv-glow { position: absolute; inset: 8% -10% 0 10%; background: radial-gradient(closest-side, rgba(0,125,180,.18), transparent); filter: blur(10px); }
  .hv-browser { position: relative; border-radius: 16px; overflow: hidden; background: #fff; box-shadow: 0 50px 90px -40px rgba(10,37,62,.55), 0 0 0 1px rgba(10,37,62,.08); }
  .hv-bar { display: flex; gap: 6px; padding: .65rem .9rem; background: #F1F4F7; border-bottom: 1px solid var(--line); direction: ltr; }
  .hv-bar i { width: 10px; height: 10px; border-radius: 50%; background: #CBD5DE; }
  .hv-browser img { width: 100%; height: auto; }
  .hv-chat { position: absolute; inset-inline-start: -1.5rem; bottom: 0; width: min(290px, 70%); background: #fff; border-radius: 18px; padding: .9rem; box-shadow: 0 30px 60px -25px rgba(10,37,62,.5), 0 0 0 1px rgba(10,37,62,.06); display: grid; gap: .5rem; }
  .hv-chat-head { display: flex; align-items: center; gap: .5rem; font-size: .9rem; }
  .hv-av { width: 30px; height: 30px; border-radius: 9px; background: var(--navy); display: grid; place-items: center; font-size: .95rem; }
  .hv-msg { font-size: .82rem; line-height: 1.55; padding: .5rem .7rem; border-radius: 12px; white-space: pre-line; }
  .hv-user { background: var(--navy); color: #fff; justify-self: end; max-width: 85%; }
  .hv-bot { background: var(--paper); }
  .hv-mark { position: absolute; inset-inline-end: -1rem; top: 0; width: 64px; height: 64px; border-radius: 18px; background: #fff; display: grid; place-items: center; font-size: 2rem; box-shadow: 0 20px 40px -18px rgba(10,37,62,.45); }
  @media (prefers-reduced-motion: no-preference) {
    .hv-browser { animation: rise .9s cubic-bezier(.2,.8,.2,1) both; }
    .hv-chat { animation: rise .9s .25s cubic-bezier(.2,.8,.2,1) both; }
    .hv-mark { animation: rise .9s .4s cubic-bezier(.2,.8,.2,1) both; }
    @keyframes rise { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hv-chat { inset-inline-start: .5rem; }
    .hv-mark { inset-inline-end: .5rem; }
  }

  .trusted { border-block: 1px solid var(--line); }

  /* Services */
  .svc-grid { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .svc { display: grid; gap: .75rem; align-content: start; height: 100%; padding: 2rem; border-radius: var(--radius); border: 1px solid var(--line); text-decoration: none; background: #fff; transition: border-color .2s, box-shadow .2s; }
  .svc:hover { border-color: transparent; box-shadow: 0 24px 50px -28px rgba(10,37,62,.35), 0 0 0 1px var(--line); }
  .svc-icon { width: 52px; height: 52px; border-radius: 14px; background: var(--blue-soft); color: var(--blue); display: grid; place-items: center; font-size: 28px; margin-bottom: .5rem; }
  .svc h3 { font-size: var(--s1); }
  .svc p { color: var(--muted); }
  @media (max-width: 960px) { .svc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .svc-grid { grid-template-columns: 1fr; } }

  /* AI agents */
  .ag-grid { display: grid; grid-template-columns: 1fr auto; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  .ag-text h2 { font-size: var(--s4); margin-top: .75rem; }
  .ag-body { color: var(--muted-on-navy); font-size: 1.15rem; margin-top: 1.25rem; max-width: 36rem; }
  .ag-caps { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem 2rem; margin: 2.25rem 0 2.5rem; }
  .ag-caps li { display: grid; gap: .25rem; border-top: 1px solid rgba(255,255,255,.14); padding-top: 1rem; }
  .ag-caps span { color: var(--muted-on-navy); font-size: .97rem; line-height: 1.6; }
  @media (max-width: 960px) { .ag-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .ag-caps { grid-template-columns: 1fr; } }

  /* Classti */
  .ct-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  .ct-text h2 { font-size: var(--s4); margin-top: .75rem; }
  .ct-text .label { color: #2EB24B; }
  .ct-body { color: var(--muted); font-size: 1.12rem; margin-top: 1.25rem; }
  .ct-list { list-style: none; display: grid; gap: 1rem; margin: 2rem 0; }
  .ct-list li { display: grid; gap: .1rem; padding-inline-start: 1rem; border-inline-start: 3px solid #2EB24B; }
  .ct-list span { color: var(--muted); font-size: .97rem; }
  .ct-visual { border-radius: 16px; overflow: hidden; box-shadow: 0 50px 90px -45px rgba(15,31,23,.6), 0 0 0 1px var(--line); }
  .ct-visual img { width: 100%; height: auto; }
  @media (max-width: 960px) { .ct-grid { grid-template-columns: 1fr; } }

  /* Work */
  .wk-grid { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .wk { background: #fff; border-radius: var(--radius); overflow: hidden; box-shadow: 0 0 0 1px var(--line); }
  .wk-shot { aspect-ratio: 16 / 10; overflow: hidden; background: #EEF2F5; }
  .wk-shot img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .wk:hover .wk-shot img { transform: scale(1.03); }
  .wk-body { padding: 1.5rem 1.75rem 1.9rem; display: grid; gap: .4rem; }
  .wk-sector { color: var(--blue); font-weight: 700; font-size: .9rem; }
  .wk h3 { font-size: var(--s1); }
  .wk p { color: var(--muted); }
  @media (max-width: 860px) { .wk-grid { grid-template-columns: 1fr; } }

  /* Why */
  .why { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem 2rem; }
  .why li { border-top: 2px solid var(--ink); padding-top: 1.25rem; display: grid; gap: .5rem; }
  .why h3 { font-size: var(--s1); }
  .why p { color: var(--muted); }
  @media (max-width: 860px) { .why { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .why { grid-template-columns: 1fr; } }
</style>
