---
// WhatsApp-style chat demos by sector, with tabs.
import { t, type Lang } from '../i18n/content';
import Icon from './Icon.astro';

interface Props { lang: Lang; tone?: 'light' | 'dark' }
const { lang, tone = 'light' } = Astro.props;
const c = t[lang];
---
<div class={`demo demo-${tone}`}>
  <div class="demo-tabs" role="tablist" aria-label={c.agents.demoLabel}>
    {c.agents.chats.map((ch, i) => (
      <button type="button" role="tab" id={`tab-${ch.id}`} aria-controls={`chat-${ch.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{ch.tab}</button>
    ))}
  </div>
  <div class="phone">
    <div class="phone-screen">
      {c.agents.chats.map((ch, i) => (
        <div class="chat" role="tabpanel" id={`chat-${ch.id}`} aria-labelledby={`tab-${ch.id}`} hidden={i !== 0}>
          <div class="chat-head">
            <span class="chat-avatar"><Icon name="agent" /></span>
            <span><strong>{ch.name}</strong><small>{c.agents.online}</small></span>
          </div>
          <ol class="chat-body">
            {ch.messages.map((m) => (
              <li class={`msg msg-${m.from}`}>
                {'voice' in m && m.voice ? (
                  <span class="voice" aria-label={`${c.agents.voice} ${m.voice}`}>
                    <span class="voice-play" aria-hidden="true"></span>
                    <span class="voice-wave" aria-hidden="true">{Array.from({ length: 22 }, (_, k) => <i style={`height:${4 + ((k * 7) % 13)}px`}></i>)}</span>
                    <span class="voice-len">{m.voice}</span>
                  </span>
                ) : (
                  <span class="msg-text">{'text' in m ? m.text : ''}</span>
                )}
                <time>{m.time}{m.from === 'user' && <span class="ticks" aria-hidden="true">✓✓</span>}</time>
              </li>
            ))}
          </ol>
          <div class="chat-input" aria-hidden="true"><span>{c.agents.typeHere}</span><span class="mic"></span></div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  // Sector tabs for the AI agent chat demo
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.demo-tabs [role=tab]'));
  const select = (tab: HTMLButtonElement) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls')!);
      if (panel) panel.hidden = !on;
    });
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const rtl = document.documentElement.dir === 'rtl';
      const next = e.key === (rtl ? 'ArrowLeft' : 'ArrowRight');
      const prev = e.key === (rtl ? 'ArrowRight' : 'ArrowLeft');
      if (!next && !prev) return;
      e.preventDefault();
      const t = tabs[(i + (next ? 1 : -1) + tabs.length) % tabs.length];
      select(t); t.focus();
    });
  });

</script>

<style>
  .demo { display: grid; gap: 1rem; justify-items: center; }
  .phone-screen { color: var(--ink); }
  .demo-dark .demo-tabs button { background: transparent; color: #fff; border-color: rgba(255,255,255,.28); }
  .demo-dark .demo-tabs button:hover { border-color: #fff; }
  .demo-dark .demo-tabs button[aria-selected='true'] { background: #fff; color: var(--navy); border-color: #fff; }
  .demo-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; }
  .demo-tabs button { font: 700 .95rem/1 var(--font); padding: .6rem 1rem; border-radius: 999px; border: 1.5px solid var(--line); background: #fff; color: var(--ink); cursor: pointer; }
  .demo-tabs button:hover { border-color: var(--navy); }
  .demo-tabs button[aria-selected='true'] { background: var(--navy); border-color: var(--navy); color: #fff; }

  .phone { width: min(340px, 100%); border-radius: 44px; padding: 12px; background: var(--navy-deep); box-shadow: 0 40px 70px -35px rgba(10,37,62,.7), inset 0 0 0 2px #22384F; }
  .phone-screen { border-radius: 34px; overflow: hidden; background: #EFE7DE; height: 560px; position: relative; }
  .chat { display: flex; flex-direction: column; height: 100%; }
  .chat[hidden] { display: none; }
  .chat-head { display: flex; align-items: center; gap: .7rem; background: #0B5C4E; color: #fff; padding: 2.1rem 1rem .8rem; }
  .chat-head strong { display: block; font-size: 1rem; line-height: 1.3; }
  .chat-head small { display: block; font-size: .78rem; opacity: .8; line-height: 1.3; }
  .chat-avatar { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: #fff; color: var(--navy); font-size: 22px; flex: none; }
  .chat-body {
    list-style: none; margin: 0; padding: 1rem .8rem; flex: 1; display: flex; flex-direction: column; gap: .5rem; overflow: hidden;
    background-image: radial-gradient(rgba(10,37,62,.06) 1.2px, transparent 1.2px); background-size: 16px 16px;
  }
  .msg { max-width: 82%; padding: .45rem .7rem .3rem; border-radius: 10px; font-size: .92rem; line-height: 1.55; box-shadow: 0 1px 1px rgba(0,0,0,.08); position: relative; }
  .msg-user { align-self: flex-end; background: #D9FDD3; border-start-end-radius: 2px; }
  .msg-agent { align-self: flex-start; background: #fff; border-start-start-radius: 2px; }
  .msg-text { white-space: pre-line; display: block; }
  .msg time { display: block; text-align: end; font-size: .68rem; color: #54626B; margin-top: .1rem; }
  .ticks { color: #53BDEB; margin-inline-start: .3rem; letter-spacing: -.25em; }
  .voice { display: flex; align-items: center; gap: .55rem; min-width: 190px; direction: ltr; padding-top: .25rem; }
  .voice-play { width: 0; height: 0; border-block: 7px solid transparent; border-left: 11px solid #54656F; }
  .voice-wave { display: flex; align-items: center; gap: 2px; flex: 1; }
  .voice-wave i { display: block; width: 3px; border-radius: 2px; background: #8AA19A; }
  .voice-len { font-size: .72rem; color: #667781; }
  .chat-input { display: flex; align-items: center; gap: .5rem; padding: .6rem .7rem .9rem; }
  .chat-input span:first-child { flex: 1; background: #fff; border-radius: 999px; padding: .5rem 1rem; color: #8696A0; font-size: .9rem; }
  .mic { width: 40px; height: 40px; border-radius: 50%; background: #0B8A6E; flex: none; }

</style>
