---
import { t, type Lang } from '../i18n/content';
import { link } from '../lib/routes';
import { classtiText, classtiLinks as L } from '../i18n/classti';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = t[lang].products;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const other = lang === 'ar' ? 'en' : 'ar';
const x = classtiText[lang];
const ext = { target: '_blank', rel: 'noopener' };
// Screens copied from classti.com (public/products/classti/), Arabic or English UI.
const sl = lang === 'ar' ? 'ar' : 'en';
const shot = (name: string) => `${base}/products/classti/${name}-${sl}.webp`;
const shotSize: Record<string, [number, number]> = {
  dashboard: [960, 600], owner: [800, 500], 'lead-tasks': [720, 675], timetable: [720, 498], radar: [720, 498], live: [720, 498],
};
---
<section id="products" class="products" aria-labelledby="products-title">
  <div class="wrap">

    <!-- Classti intro -->
    <div class="classti-hero">
      <div class="ct-brand">
        <h1 id="products-title" class="ct-h1">
          <img src={`${base}/products/classti-logo-light.png`} alt="Classti, Smart School Network" width="482" height="147" />
        </h1>
      </div>
      <p class="ct-lead">{p.lead}</p>
      <ul class="ct-badges" aria-label={p.alsoLabel}>{x.badges.map((b) => <li>{b}</li>)}</ul>
      <div class="ct-access">
        <a class="btn ct-acc-main" href={L.demo} {...ext}>{x.access.demo}</a>
        <a class="btn ct-acc-ghost" href={L.trial} {...ext}>{x.access.trial}</a>
        <a class="btn ct-acc-ghost" href={L.login} {...ext}>{x.access.login}</a>
        <a class="ct-acc-link" href={L.site(lang)} {...ext}>{x.access.visit} <span dir="ltr">classti.com</span> ↗</a>
      </div>
      <ul class="ct-suite" aria-label={p.suiteLabel}>
        {p.suite.map((it) => (
          <li><a href={`#ct-${it.key}`}><strong>{it.name}</strong><span dir="ltr">{it.en}</span><small>{it.text}</small></a></li>
        ))}
      </ul>
    </div>

    <!-- School platform -->
    <div id="ct-platform" class="ct-block">
      <div class="ct-text">
        <p class="ct-en" lang="en">{p.platform.en}</p>
        <h2>{p.platform.title}</h2>
        <p class="ct-blead">{p.platform.lead}</p>
      </div>

      <div class="shots">
        <div class="shot-tabs" role="tablist" aria-label={p.platform.shotsLabel}>
          {p.platform.shots.map((sh, i) => (
            <button type="button" role="tab" id={`shot-tab-${i}`} aria-controls={`shot-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{sh.tab}</button>
          ))}
        </div>
        <div class="browser">
          <div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i><span dir="ltr">school.classti.com</span></div>
          {p.platform.shots.map((sh, i) => (
            <div class="shot" role="tabpanel" id={`shot-${i}`} aria-labelledby={`shot-tab-${i}`} hidden={i !== 0}>
              <img src={shot(sh.file)} alt={sh.caption} width={(shotSize[sh.file] || [960, 600])[0]} height={(shotSize[sh.file] || [960, 600])[1]} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              <p class="shot-cap">{sh.caption}</p>
            </div>
          ))}
        </div>
      </div>

      <ul class="modules">
        {p.platform.modules.map((m) => (
          <li>
            <h3>{m.name}</h3>
            <ul>{m.items.map((it) => <li>{it}</li>)}</ul>
          </li>
        ))}
      </ul>
    </div>

    <!-- Features (mirrors classti.com) -->
    <div class="ct-block">
      <h2>{x.featuresTitle}</h2>
      <p class="ct-blead">{x.featuresLead}</p>
      <ul class="feats">{x.features.map((f) => <li><strong>{f.name}</strong><span>{f.text}</span></li>)}</ul>
    </div>

    <!-- Apps -->
    <div class="apps">
      <!-- Student app -->
      <article id="ct-student" class="app">
        <div class="phone-ct phone-sm">
          <div class="pc-screen"><img src={`${base}/products/classti/family-home-${sl}.webp`} alt={p.student.lead} width="240" height="520" loading="lazy" decoding="async" /></div>
        </div>
        <div class="app-text">
          <p class="ct-en" lang="en">{p.student.en}</p>
          <h2>{p.student.title}</h2>
          <p class="ct-blead">{p.student.lead}</p>
          <ul class="checks">{p.student.features.map((f) => <li>{f}</li>)}</ul>
          <div class="stores" aria-label={x.download}>
            <a class="store" href={L.apps.student.play} {...ext}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 2.5v19l10-9.5L4 2.5Zm11.3 8.3 2.6-2.5L6.6 1.9l8.7 8.9Zm0 2.4-8.7 8.9 11.3-6.4-2.6-2.5Zm5.2-2.9L18.4 9l-2.7 3 2.7 3 2.1-1.2c.9-.5.9-1.9 0-2.5Z"/></svg><span><small>{x.download}</small>Google Play</span></a>
            <a class="store" href={L.apps.student.apple} {...ext}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.7.9-.8 0-2-.9-3.2-.9-1.7 0-3.2 1-4 2.4-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8s1.9.8 3.2.8c1.3 0 2.1-1.2 2.9-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.4-1-2.4-3.7ZM14 5.4c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.6 2.8-1.4Z"/></svg><span><small>{x.download}</small>App Store</span></a>
          </div>
        </div>
      </article>

      <!-- Teacher app -->
      <article id="ct-teacher" class="app app-rev">
        <div class="phone-ct">
          <div class="pc-screen"><img src={`${base}/products/classti/t-home-${sl}.webp`} alt={p.teacher.lead} width="560" height="1214" loading="lazy" decoding="async" /></div>
        </div>
        <div class="app-text">
          <p class="ct-en" lang="en">{p.teacher.en}</p>
          <h2>{p.teacher.title}</h2>
          <p class="ct-blead">{p.teacher.lead}</p>
          <ul class="checks">{p.teacher.features.map((f) => <li>{f}</li>)}</ul>
          <div class="stores" aria-label={x.download}>
            <a class="store" href={L.apps.teacher.play} {...ext}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 2.5v19l10-9.5L4 2.5Zm11.3 8.3 2.6-2.5L6.6 1.9l8.7 8.9Zm0 2.4-8.7 8.9 11.3-6.4-2.6-2.5Zm5.2-2.9L18.4 9l-2.7 3 2.7 3 2.1-1.2c.9-.5.9-1.9 0-2.5Z"/></svg><span><small>{x.download}</small>Google Play</span></a>
            <a class="store" href={L.apps.teacher.apple} {...ext}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.7.9-.8 0-2-.9-3.2-.9-1.7 0-3.2 1-4 2.4-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8s1.9.8 3.2.8c1.3 0 2.1-1.2 2.9-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.4-1-2.4-3.7ZM14 5.4c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.6 2.8-1.4Z"/></svg><span><small>{x.download}</small>App Store</span></a>
          </div>
        </div>
      </article>

      <!-- Nursery app -->
      <article id="ct-nursery" class="app nursery">
        <div class="phone-ct">
          <div class="pc-screen"><img src={`${base}/products/classti/nu-timeline-${sl}.webp`} alt={x.nursery.lead} width="560" height="1214" loading="lazy" decoding="async" /></div>
        </div>
        <div class="app-text">
          <p class="ct-en" lang="en">{x.nursery.en}</p>
          <h2>{x.nursery.title}</h2>
          <p class="ct-blead">{x.nursery.lead}</p>
          <ul class="checks">{x.nursery.features.map((f) => <li>{f}</li>)}</ul>
          <div class="stores" aria-label={x.download}>
            <a class="store" href={L.apps.nursery.play} {...ext}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 2.5v19l10-9.5L4 2.5Zm11.3 8.3 2.6-2.5L6.6 1.9l8.7 8.9Zm0 2.4-8.7 8.9 11.3-6.4-2.6-2.5Zm5.2-2.9L18.4 9l-2.7 3 2.7 3 2.1-1.2c.9-.5.9-1.9 0-2.5Z"/></svg><span><small>{x.download}</small>Google Play</span></a>
          </div>
        </div>
      </article>
    </div>

    <!-- Solutions -->
    <div class="ct-block">
      <h2>{x.solutionsTitle}</h2>
      <ul class="sols">{x.solutions.map((s2) => <li><h3>{s2.name}</h3><p>{s2.text}</p></li>)}</ul>
    </div>

    <!-- Integrations & security -->
    <div class="ct-block ct-two">
      <div><h3>{x.integrationsTitle}</h3><ul class="chips">{x.integrations.map((i) => <li>{i}</li>)}</ul></div>
      <div><h3>{x.securityTitle}</h3><ul class="chips">{x.security.map((i) => <li>{i}</li>)}</ul></div>
    </div>

    <div class="ct-final">
      <h2>{x.ctaTitle}</h2>
      <p>{x.ctaBody}</p>
      <div class="ct-access">
        <a class="btn ct-acc-main" href={L.demo} {...ext}>{x.access.demo}</a>
        <a class="btn ct-acc-ghost" href={L.trial} {...ext}>{x.access.trial}</a>
        <a class="btn ct-acc-ghost" href={L.pricing} {...ext}>{x.access.pricing}</a>
        <a class="ct-acc-link" href={`${link(lang, '/contact/')}?service=${encodeURIComponent(p.ctaValue)}`}>{x.contact}</a>
      </div>
    </div>
  </div>
</section>

<script>
  const shotTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.shot-tabs [role=tab]'));
  const pick = (tab: HTMLButtonElement) => {
    shotTabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls')!);
      if (panel) panel.hidden = !on;
    });
  };
  shotTabs.forEach((tab, i) => {
    tab.addEventListener('click', () => pick(tab));
    tab.addEventListener('keydown', (e) => {
      const rtl = document.documentElement.dir === 'rtl';
      const next = e.key === (rtl ? 'ArrowLeft' : 'ArrowRight');
      const prev = e.key === (rtl ? 'ArrowRight' : 'ArrowLeft');
      if (!next && !prev) return;
      e.preventDefault();
      const t = shotTabs[(i + (next ? 1 : -1) + shotTabs.length) % shotTabs.length];
      pick(t); t.focus();
    });
  });
</script>

<style>
  /* Classti keeps its own forest-green identity inside the Oxira page */
  .products {
    --ct-deep: #0F1F17;
    --ct-dark: #12442B;
    --ct: #00512E;
    --ct-bright: #2EB24B;
    --ct-soft: #4D9E7B;
    --ct-mint: #E7F4EC;
    padding-block: clamp(2rem, 4vw, 3rem) var(--section);
    background: #fff;
  }
  .p-head { display: grid; gap: .75rem; max-width: 44rem; margin-bottom: clamp(2rem, 5vw, 3rem); }
  .p-head h2 { font-size: var(--s4); }
  .p-head p { color: var(--muted); font-size: 1.125rem; }

  .classti-hero {
    position: relative; overflow: hidden; border-radius: 24px; color: #fff;
    padding: clamp(1.75rem, 5vw, 3.5rem);
    background: radial-gradient(90% 120% at 15% 0%, #1E6B43 0%, var(--ct-dark) 40%, var(--ct-deep) 100%);
  }
  .ct-brand { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.25rem; }
  .ct-h1 { margin: 0; line-height: 0; }
  .ct-h1 img { width: clamp(220px, 28vw, 320px); height: auto; }
  .ct-tag { color: #B9D9C7; font-weight: 600; letter-spacing: .02em; }
  .ct-lead { margin-top: 1.25rem; font-size: 1.2rem; color: #DDEDE3; max-width: 46rem; }
  .ct-suite { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .ct-suite a { display: grid; gap: .15rem; height: 100%; text-decoration: none; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.14); border-radius: 16px; padding: 1.1rem 1.2rem; }
  .ct-suite a:hover { background: rgba(255,255,255,.12); border-color: var(--ct-bright); }
  .ct-suite strong { font-size: 1.2rem; }
  .ct-suite span { color: var(--ct-bright); font-weight: 700; font-size: .92rem; }
  .ct-suite small { color: #C8DED1; font-size: .95rem; margin-top: .3rem; }
  .ct-also { margin-top: 1.25rem; color: #B9D9C7; font-size: .98rem; }
  @media (max-width: 980px) { .ct-suite { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .ct-suite { grid-template-columns: 1fr; } }
  .ct-badges { list-style: none; margin: 1.1rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .ct-badges li { font-size: .85rem; font-weight: 700; color: #DDEDE3; border: 1px solid rgba(255,255,255,.22); border-radius: 999px; padding: .3rem .8rem; }
  .ct-badges li::before { content: '✓ '; color: var(--ct-bright); }
  .ct-access { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1rem; margin-top: 1.5rem; }
  .ct-acc-main { background: #1A7F35; color: #fff; }
  .ct-acc-main:hover { background: #146A2B; }
  .ct-acc-ghost { background: transparent; color: inherit; box-shadow: inset 0 0 0 1.5px currentColor; }
  .ct-acc-ghost:hover { background: rgba(255,255,255,.1); }
  .ct-acc-link { color: inherit; font-weight: 700; text-underline-offset: 4px; }
  .classti-hero .ct-acc-link { color: #B9F0C8; }
  .feats { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .feats li { display: grid; gap: .3rem; border: 1px solid var(--line); border-radius: 16px; padding: 1.1rem 1.2rem; border-inline-start: 4px solid var(--ct-bright); }
  .feats strong { font-size: 1.05rem; color: var(--ct); }
  .feats span { color: var(--muted); font-size: .96rem; line-height: 1.6; }
  @media (max-width: 900px) { .feats { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .feats { grid-template-columns: 1fr; } }
  .stores { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.5rem; }
  .store { display: inline-flex; align-items: center; gap: .55rem; background: #0F1F17; color: #fff; text-decoration: none; border-radius: 12px; padding: .5rem 1rem .5rem .8rem; line-height: 1.15; }
  .store:hover { background: var(--ct); }
  .store svg { width: 22px; height: 22px; fill: currentColor; flex: none; }
  .store span { display: grid; font-weight: 700; font-size: 1rem; direction: ltr; text-align: start; }
  .store small { font-weight: 500; font-size: .7rem; opacity: .8; }
  .nursery { background: var(--ct-mint); border-radius: 28px; padding: clamp(1.5rem, 4vw, 3rem); }
  .sols { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .sols li { background: linear-gradient(160deg, #12442B, #0F1F17); color: #fff; border-radius: 20px; padding: 1.5rem; }
  .sols h3 { margin: 0 0 .6rem; font-size: 1.2rem; color: #B9F0C8; }
  .sols p { color: #D3E6DA; line-height: 1.7; font-size: .98rem; }
  @media (max-width: 900px) { .sols { grid-template-columns: 1fr; } }
  .ct-two { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .ct-two h3 { font-size: 1.2rem; color: var(--ct); margin: 0 0 .8rem; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .chips li { background: var(--ct-mint); color: #1D3A2A; border-radius: 999px; padding: .4rem .9rem; font-weight: 600; font-size: .92rem; }
  @media (max-width: 760px) { .ct-two { grid-template-columns: 1fr; } }
  .ct-final { margin-top: clamp(3.5rem, 7vw, 5rem); text-align: center; border-radius: 24px; padding: clamp(2rem, 5vw, 3rem); color: #fff; background: radial-gradient(90% 120% at 50% 0%, #1E6B43 0%, var(--ct-dark) 45%, var(--ct-deep) 100%); }
  .ct-final h2 { font-size: var(--s3); }
  .ct-final p { color: #D3E6DA; margin-top: .6rem; }
  .ct-final .ct-access { justify-content: center; }

  .ct-block { margin-top: clamp(3.5rem, 7vw, 5rem); scroll-margin-top: 6rem; }
  .ct-en { color: var(--ct); font-weight: 700; font-size: .95rem; }
  .ct-block h2, .app h2 { font-size: var(--s3); margin-top: .2rem; }
  .ct-blead { color: var(--muted); font-size: 1.12rem; margin-top: .75rem; max-width: 40rem; }

  .shots { margin-top: 1.75rem; }
  .shot-tabs { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1rem; }
  .shot-tabs button { font: 700 .95rem/1 var(--font); padding: .65rem 1.1rem; border-radius: 999px; border: 1.5px solid var(--line); background: #fff; color: var(--ink); cursor: pointer; }
  .shot-tabs button:hover { border-color: var(--ct); }
  .shot-tabs button[aria-selected='true'] { background: var(--ct); border-color: var(--ct); color: #fff; }
  .browser { border-radius: 16px; overflow: hidden; background: #fff; box-shadow: 0 0 0 1px var(--line), 0 40px 70px -40px rgba(15,31,23,.55); }
  .browser-bar { display: flex; align-items: center; gap: .4rem; padding: .7rem 1rem; background: #EEF2EF; border-bottom: 1px solid var(--line); direction: ltr; }
  .browser-bar i { width: 11px; height: 11px; border-radius: 50%; background: #C9D3CD; }
  .browser-bar span { margin-inline-start: 1rem; flex: 1; max-width: 22rem; background: #fff; border-radius: 6px; padding: .2rem .8rem; font-size: .8rem; color: #4A5A51; }
  .shot { margin: 0; }
  .shot img { width: 100%; height: auto; }
  .shot-cap { padding: 1rem 1.25rem 1.2rem; color: var(--muted); font-size: 1rem; border-top: 1px solid var(--line); }

  .modules { list-style: none; margin: 1.75rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .modules > li { background: var(--ct-mint); border-radius: 16px; padding: 1.25rem 1.25rem 1.35rem; }
  .modules h3 { margin: 0 0 .6rem; font-size: 1.12rem; font-weight: 700; color: var(--ct); }
  .modules ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .35rem; }
  .modules ul li { position: relative; padding-inline-start: 1rem; font-size: .97rem; line-height: 1.6; color: #24372D; }
  .modules ul li::before { content: ''; position: absolute; inset-inline-start: 0; top: .62em; width: 6px; height: 6px; border-radius: 2px; background: var(--ct-bright); }
  @media (max-width: 980px) { .modules { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .modules { grid-template-columns: 1fr; } }

  .apps { display: grid; gap: clamp(3.5rem, 7vw, 5rem); margin-top: clamp(3.5rem, 7vw, 5rem); }
  .app { display: grid; grid-template-columns: auto 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; scroll-margin-top: 6rem; }
  .app-rev .phone-ct { order: 2; }
  .checks { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: .7rem 1.5rem; }
  .checks li { position: relative; padding-inline-start: 1.9rem; font-weight: 600; line-height: 1.55; }
  .checks li::before { content: '✓'; position: absolute; inset-inline-start: 0; top: .05em; width: 1.35rem; height: 1.35rem; border-radius: 50%; background: var(--ct-mint); color: var(--ct); font-size: .8rem; font-weight: 700; display: grid; place-items: center; }
  @media (max-width: 860px) {
    .app { grid-template-columns: 1fr; justify-items: center; }
    .app-rev .phone-ct { order: 0; }
    .app-text { justify-self: stretch; }
  }
  @media (max-width: 520px) { .checks { grid-template-columns: 1fr; } }

  /* Phone frames around real app screens */
  .phone-ct { width: 290px; border-radius: 42px; padding: 10px; background: #0E1A14; box-shadow: 0 40px 70px -35px rgba(15,31,23,.65), inset 0 0 0 2px #253A2E; }
  .pc-screen { border-radius: 32px; overflow: hidden; background: #F5F8F6; line-height: 0; }
  .pc-screen img { width: 100%; height: auto; }
  .phone-sm { width: 262px; }

</style>
