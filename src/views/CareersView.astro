---
// Careers: honest "join us" page. No open positions are listed, so no JobPosting structured data.
// Applications go by email (prefilled subject "وظيفة - <area>") or WhatsApp. Arabic and English only.
import { contact } from '../i18n/content';
import { link } from '../lib/routes';
import { careersText, cpLangs, type CpLang } from '../i18n/companyPages';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';

interface Props { lang: CpLang }
const { lang } = Astro.props;
const C = careersText[lang];
const mail = (area = '') => `mailto:${contact.email}?subject=${encodeURIComponent(C.subjectPrefix + area)}&body=${encodeURIComponent(C.emailBody)}`;
const wa = `${contact.whatsappHref}?text=${encodeURIComponent(C.whatsappText)}`;
const icons: Record<string, string> = {
  software: '<path d="M8 8l-5 4 5 4M16 8l5 4-5 4M14 5l-4 14"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  agent: '<rect x="4" y="7" width="16" height="12" rx="3"/><path d="M12 3v4M9 12h.01M15 12h.01M9 16h6"/>',
  infra: '<rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/><path d="M7 7h.01M7 17h.01"/>',
  transform: '<path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3"/><path d="M18 3v4h-4M6 21v-4h4"/>',
  design: '<path d="M12 20l7-7-3-3-7 7v3z"/><path d="M16 10l-2-2M4 4l6 2-2 2z"/><path d="M14 6l4 4"/>',
  events: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4M8 15h3"/>',
};
const site = Astro.site!;
const ld = {
  '@context': 'https://schema.org', '@type': 'WebPage', name: C.h1, description: C.description,
  url: new URL(link(lang, '/careers/'), site).href, inLanguage: lang,
  about: { '@type': 'Organization', name: 'Oxira', url: new URL(link(lang, '/'), site).href, email: contact.email },
};
---
<Base lang={lang} path="/careers/" title={C.title} description={C.description} langs={cpLangs}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <section class="page-hero">
    <div class="wrap cr-hero">
      <div>
        <p class="label">{C.kicker}</p>
        <h1>{C.h1}</h1>
        <p class="lead">{C.lead}</p>
      </div>
      <aside class="cr-open">
        <h2>{C.noOpenTitle}</h2>
        <p>{C.noOpenBody}</p>
        <a class="btn btn-amber" href={mail()}>{C.applyNow}</a>
      </aside>
    </div>
  </section>

  <section class="section-tight cr-pt0" aria-labelledby="cr-areas">
    <div class="wrap">
      <div class="sh"><h2 id="cr-areas">{C.areasTitle}</h2><p>{C.areasBody}</p></div>
      <ul class="cr-areas">
        {C.areas.map((a) => (
          <li>
            <span class="cr-ic"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[a.icon]} /></span>
            <h3>{a.name}</h3>
            <p>{a.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="cr-values">
    <div class="wrap">
      <div class="sh"><h2 id="cr-values">{C.valuesTitle}</h2></div>
      <ul class="cr-values">
        {C.values.map((v) => <li><h3>{v.name}</h3><p>{v.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section" id="apply" aria-labelledby="cr-apply">
    <div class="wrap cr-apply">
      <div>
        <div class="sh"><h2 id="cr-apply">{C.applyTitle}</h2></div>
        <ol class="cr-steps">
          {C.steps.map((s, i) => <li><span aria-hidden="true">{i + 1}</span><div><h3>{s.name}</h3><p>{s.text}</p></div></li>)}
        </ol>
      </div>
      <div class="cr-card">
        <a class="btn btn-amber" href={mail()}>{C.emailCta}</a>
        <a class="btn btn-ghost" href={wa} target="_blank" rel="noopener">{C.whatsappCta}</a>
        <p class="cr-pick">{C.pickArea}</p>
        <ul class="cr-chips">
          {C.areas.map((a) => <li><a href={mail(a.name)}>{a.name}</a></li>)}
        </ul>
        <p class="cr-mail"><a href={mail()} dir="ltr">{contact.email}</a></p>
        <p class="cr-file">{C.onFile}</p>
      </div>
    </div>
  </section>

  <section class="section-tight cr-pt0" aria-labelledby="cr-partners">
    <div class="wrap">
      <div class="cr-partners">
        <div>
          <h2 id="cr-partners">{C.partnersTitle}</h2>
          <p>{C.partnersBody}</p>
        </div>
        <a class="btn btn-navy" href={link(lang, '/partners/')}>{C.partnersCta}</a>
      </div>
    </div>
  </section>

  <div style="height: var(--section)"></div>
  <CtaBand lang={lang} />
</Base>

<style>
  .cr-hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); gap: clamp(2rem, 5vw, 4rem); align-items: end; }
  .cr-hero h1 { max-width: 14ch; }
  .cr-open { display: grid; gap: .75rem; justify-items: start; padding: 1.75rem; border-radius: var(--radius-lg); background: var(--navy); color: #fff; }
  .cr-open h2 { font-size: 1.3rem; }
  .cr-open p { color: var(--muted-on-navy); }
  .cr-open .btn { margin-top: .5rem; }
  .cr-pt0 { padding-top: 0; }

  .cr-areas { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .cr-areas li { padding: 1.6rem; border: 1px solid var(--line); border-radius: var(--radius); display: grid; gap: .6rem; align-content: start; }
  .cr-ic { width: 48px; height: 48px; border-radius: 14px; background: var(--blue-soft); color: var(--blue); display: grid; place-items: center; }
  .cr-ic svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .cr-areas h3 { font-size: 1.15rem; }
  .cr-areas p { color: var(--muted); }

  .cr-values { list-style: none; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 2rem 1.75rem; }
  .cr-values li { border-top: 2px solid var(--ink); padding-top: 1.25rem; display: grid; gap: .5rem; align-content: start; }
  .cr-values h3 { font-size: var(--s1); }
  .cr-values p { color: var(--muted); }

  .cr-apply { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .cr-apply .sh { margin-bottom: 2rem; }
  .cr-steps { list-style: none; display: grid; gap: 1.3rem; }
  .cr-steps li { display: flex; gap: 1rem; align-items: flex-start; }
  .cr-steps span { width: 40px; height: 40px; flex: none; border-radius: 12px; display: grid; place-items: center; background: var(--amber); color: var(--navy); font-weight: 700; }
  .cr-steps h3 { font-size: 1.1rem; }
  .cr-steps p { color: var(--muted); }
  .cr-card { display: grid; gap: .75rem; padding: 1.8rem; border-radius: var(--radius-lg); background: #fff; border: 1px solid var(--line); box-shadow: 0 30px 60px -40px rgba(6, 26, 45, .5); }
  .cr-pick { margin-top: .75rem; font-weight: 700; font-size: .95rem; }
  .cr-chips { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem; }
  .cr-chips a { display: inline-block; padding: .45rem .85rem; border-radius: 999px; border: 1.5px solid var(--line); text-decoration: none; font-weight: 600; font-size: .9rem; color: var(--ink); }
  .cr-chips a:hover { border-color: var(--blue); color: var(--blue); }
  .cr-mail { margin-top: .5rem; }
  .cr-mail a { color: var(--blue); font-weight: 700; }
  .cr-file { color: var(--muted); font-size: .88rem; }

  .cr-partners { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem; padding: 1.75rem; border-radius: var(--radius); border: 1px solid var(--line); border-inline-start: 4px solid var(--amber); }
  .cr-partners h2 { font-size: var(--s2); margin-bottom: .35rem; }
  .cr-partners p { color: var(--muted); max-width: 44rem; }

  @media (max-width: 1000px) { .cr-values { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .cr-hero, .cr-apply { grid-template-columns: minmax(0, 1fr); } .cr-areas { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .cr-areas, .cr-values { grid-template-columns: minmax(0, 1fr); } }
</style>
