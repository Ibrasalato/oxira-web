---
// Blog index (Arabic only for now).
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { link } from '../../lib/routes';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = new Intl.DateTimeFormat('ar-SA-u-nu-latn-ca-gregory', { day: 'numeric', month: 'long', year: 'numeric' });
const site = Astro.site!;
const ld = {
  '@context': 'https://schema.org', '@type': 'Blog', name: 'مدونة أوكسيرا', url: new URL(link('ar', '/blog/'), site).href,
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title.replace(/ \| أوكسيرا$/, ''), url: new URL(link('ar', `/blog/${p.id}/`), site).href, datePublished: p.data.date.toISOString().slice(0, 10) })),
};
---
<Base lang="ar" path="/blog/" langs={['ar']} title="مدونة أوكسيرا: أدلة عملية للمواقع والتسويق الرقمي" description="مقالات عملية لأصحاب الأعمال في السعودية: تكلفة تصميم المواقع، أنظمة الحجز، المنيو الإلكتروني، تقييمات قوقل والشات بوت.">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <section class="page-hero">
    <div class="wrap">
      <p class="label">المدونة</p>
      <h1>أدلة عملية لنمو نشاطك على الإنترنت</h1>
      <p class="lead">مقالات واضحة لأصحاب الأعمال: كيف تختار موقعك وأدواتك، وكيف تجذب عملاء أكثر من قوقل.</p>
    </div>
  </section>
  <section class="section-tight pt0">
    <div class="wrap">
      <ul class="bl">
        {posts.map((p) => (
          <li>
            <a href={link('ar', `/blog/${p.id}/`)}>
              <time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt.format(p.data.date)}</time>
              <h2>{p.data.title.replace(/ \| أوكسيرا$/, '')}</h2>
              <p>{p.data.description}</p>
              <span class="more">اقرأ المقال</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .pt0 { padding-top: 0; }
  .bl { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; padding: 0; }
  .bl a { display: flex; flex-direction: column; gap: .6rem; height: 100%; padding: 1.6rem; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; }
  .bl a:hover { border-color: var(--navy); }
  .bl time { color: var(--blue); font-weight: 600; font-size: .9rem; }
  .bl h2 { font-size: 1.25rem; }
  .bl p { color: var(--muted); flex: 1; }
  @media (max-width: 900px) { .bl { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  @media (max-width: 600px) { .bl { grid-template-columns: minmax(0, 1fr); } }
</style>
