---
// Oxira KPI app (/kpi/app/), Arabic and English. All logic in src/kpi/app.ts; backend is n8n "KPI 1 — API".
import { kpiApp, KPI_API, type KpiLang } from '../i18n/kpi';
import { kpiLibrary } from '../i18n/kpiLib';
import { link } from '../lib/routes';
import Base from '../layouts/Base.astro';

interface Props { lang: KpiLang }
const { lang } = Astro.props;
const T = kpiApp[lang];
const cfg = {
  lang, api: KPI_API, t: T, lib: kpiLibrary,
  links: { book: link(lang, '/book/'), contact: link(lang, '/contact/') + '?service=Oxira%20KPI', home: link(lang, '/'), product: link(lang, '/kpi/') },
};
---
<Base lang={lang} path="/kpi/app/" title={T.title} description={T.description} langs={['ar', 'en']} app noindex>
  <div class="kx" id="kx-root" data-cfg={JSON.stringify(cfg)}><div class="kx-center">{T.loading}</div></div>
</Base>

<script>
  import { boot } from '../kpi/app';
  boot(document.getElementById('kx-root')!);
</script>

<style is:global>
  .kx { --k-bg: #F4F7FA; --k-hi: #12805C; --k-mid: #B7791F; --k-lo: #C0392B; min-height: calc(100vh - 80px); background: var(--k-bg); color: var(--ink); font-size: .97rem; }
  :is(.kx, .kx-modal) button { font: inherit; }
  :is(.kx, .kx-modal) :is(input, select, textarea) { font: inherit; font-size: .95rem; padding: .55rem .7rem; border: 1.5px solid var(--line); border-radius: 10px; background: #fff; color: var(--ink); width: 100%; min-width: 0; }
  :is(.kx, .kx-modal) :is(input, select, textarea):focus { outline: 2px solid var(--blue); outline-offset: 1px; border-color: transparent; }
  :is(.kx, .kx-modal) :is(input, select, textarea):disabled { background: #F1F4F7; color: #3C4E60; }
  .kx-center { display: grid; place-items: center; gap: 1rem; min-height: 50vh; color: var(--muted); text-align: center; padding: 2rem; }
  .kx-muted { color: var(--muted); font-size: .9rem; }
  .kx-err { color: var(--k-lo); font-weight: 600; min-height: 1.2em; }
  .kx-ok { color: var(--k-hi); } .kx-warn { color: var(--k-mid); }
  .kx-link { background: none; border: 0; padding: 0; color: #006A99; font-weight: 700; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .kx-link.danger, .btn.danger { color: var(--k-lo); }
  .kx-sm { padding: .5rem .95rem !important; font-size: .9rem !important; }
  .btn.is-busy { opacity: .6; pointer-events: none; }

  /* auth */
  .kx-auth { display: grid; place-items: center; padding: clamp(1.5rem, 5vw, 4rem) 1rem; }
  .kx-auth-card { width: min(100%, 30rem); background: #fff; border: 1px solid var(--line); border-radius: 22px; padding: clamp(1.5rem, 4vw, 2.5rem); box-shadow: 0 30px 70px -45px rgba(10,37,62,.5); }
  .kx-logo { font-weight: 800; font-size: 1.35rem; margin: 0; color: var(--navy); }
  .kx-logo::before { content: ''; display: inline-block; width: .7em; height: .7em; border-radius: 4px; background: linear-gradient(135deg, var(--amber), var(--blue)); margin-inline-end: .45em; }
  .kx-auth-lead { color: var(--muted); margin: .4rem 0 1.25rem; }
  .kx-tabs { display: grid; grid-template-columns: 1fr 1fr; background: var(--paper); border-radius: 12px; padding: 4px; margin-bottom: 1.25rem; }
  .kx-tabs button { border: 0; background: none; padding: .6rem; border-radius: 9px; font-weight: 700; color: var(--muted); cursor: pointer; }
  .kx-tabs button[aria-selected='true'] { background: #fff; color: var(--navy); box-shadow: 0 2px 8px rgba(10,37,62,.1); }
  .kx-form { display: grid; gap: .85rem; }
  .kx-form label, .kx-block { display: grid; gap: .3rem; font-weight: 600; font-size: .92rem; }
  .kx-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .kx-code { font-size: 1.6rem !important; letter-spacing: .4em; text-align: center; }
  .kx-email { font-weight: 700; margin: -.4rem 0 0; }
  .kx-check { display: flex !important; align-items: center; gap: .5rem; }
  .kx-check input, .kx-modal input[type=checkbox] { width: auto; }

  /* shell */
  .kx-banner { background: #FFF6DC; color: #5A4A10; text-align: center; padding: .55rem 1rem; font-weight: 600; font-size: .92rem; }
  .kx-banner.bad { background: #FDECEA; color: #8A1F14; }
  .kx-banner a { color: inherit; }
  .kx-shell { display: grid; grid-template-columns: 240px minmax(0, 1fr); min-height: calc(100vh - 80px); }
  .kx-side { background: var(--navy); color: #fff; padding: 1.5rem 1rem; display: flex; flex-direction: column; gap: 1rem; position: sticky; top: 0; height: 100vh; }
  .kx-side .kx-logo { color: #fff; }
  .kx-co { color: var(--muted-on-navy); font-size: .9rem; margin: -.6rem 0 .5rem; }
  .kx-side nav { display: grid; gap: .25rem; }
  .kx-nav { text-align: start; background: none; border: 0; color: #D6E2EC; padding: .65rem .8rem; border-radius: 10px; cursor: pointer; font-weight: 600; }
  .kx-nav:hover { background: rgba(255,255,255,.07); }
  .kx-nav.on { background: rgba(245,168,0,.16); color: #fff; box-shadow: inset 3px 0 0 var(--amber); }
  [dir='rtl'] .kx-nav.on { box-shadow: inset -3px 0 0 var(--amber); }
  .kx-user { margin-top: auto; display: grid; gap: .15rem; border-top: 1px solid rgba(255,255,255,.12); padding-top: 1rem; }
  .kx-user small { color: var(--muted-on-navy); }
  .kx-user .kx-link { color: #9FD6F2; justify-self: start; margin-top: .3rem; }
  .kx-main { min-width: 0; padding: 1.25rem clamp(1rem, 3vw, 2rem) 3rem; }
  .kx-top { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; }
  .kx-period { display: flex; align-items: center; gap: .5rem; font-weight: 700; }
  .kx-period select { width: auto; }
  .kx-top-act { display: flex; flex-wrap: wrap; gap: .5rem; }
  .kx-h1 { font-size: clamp(1.3rem, 2.2vw, 1.7rem); margin: 0 0 1.1rem; display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; }
  .kx-h1 small { font-size: .9rem; font-weight: 500; }

  .kx-cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .9rem; margin-bottom: 1.1rem; }
  .kx-card { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 1rem 1.1rem; display: grid; gap: .3rem; }
  .kx-card small { color: var(--muted); font-weight: 600; }
  .kx-card b { font-size: 1.7rem; }
  .kx-bar { display: block; height: 6px; background: var(--paper); border-radius: 99px; overflow: hidden; }
  .kx-bar > i { display: block; height: 100%; background: var(--blue); border-radius: 99px; }
  .kx-grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; align-items: start; }
  .kx-span2 { grid-column: 1 / -1; }
  .kx-panel { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 1.1rem 1.2rem; min-width: 0; }
  .kx-grid2 > div > .kx-panel + .kx-panel { margin-top: 1rem; }
  .kx-panel h2 { font-size: 1.05rem; margin: 0 0 .8rem; }
  .kx-panel h3, .kx-entry h3 { font-size: 1rem; margin: 1.2rem 0 .6rem; }
  .kx-hbars { list-style: none; margin: 0; padding: 0; display: grid; gap: .55rem; }
  .kx-hbars li { display: grid; grid-template-columns: 8rem 1fr 2.5rem; gap: .6rem; align-items: center; font-size: .92rem; }
  .kx-hbars i { display: block; height: 10px; background: var(--paper); border-radius: 99px; overflow: hidden; }
  .kx-hbars i i { height: 100%; background: linear-gradient(90deg, var(--blue), var(--cyan)); }
  .kx-rank { margin: 0; padding-inline-start: 1.2rem; display: grid; gap: .4rem; }
  .kx-rank li { display: flex; justify-content: space-between; gap: .5rem; }
  .kx-cols { display: flex; align-items: flex-end; gap: .75rem; height: 180px; padding-top: .5rem; }
  .kx-cols.small { height: 120px; }
  .kx-cols > div { flex: 1; display: grid; grid-template-rows: 1fr auto auto; justify-items: center; height: 100%; gap: .2rem; min-width: 0; }
  .kx-cols i { width: min(48px, 70%); align-self: end; border-radius: 8px 8px 3px 3px; background: var(--blue); min-height: 3px; }
  .kx-cols i.s-hi { background: var(--k-hi); } .kx-cols i.s-mid { background: #E0A423; } .kx-cols i.s-lo { background: var(--k-lo); }
  .kx-cols small { color: var(--muted); font-size: .78rem; text-align: center; }

  .kx-score { font-weight: 800; white-space: nowrap; }
  .s-hi { color: var(--k-hi); } .s-mid { color: var(--k-mid); } .s-lo { color: var(--k-lo); }
  .kx-pill { display: inline-block; font-size: .78rem; font-weight: 700; border-radius: 99px; padding: .15rem .65rem; background: var(--paper); color: var(--muted); }
  .kx-pill.st-open, .kx-pill.st-submitted { background: #E6F2F8; color: #005B85; }
  .kx-pill.st-approved { background: #E3F4EC; color: #0E6B4B; }
  .kx-pill.st-closed { background: #EDEFF2; color: #3C4E60; }

  .kx-tools { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin-bottom: .9rem; }
  .kx-tools input[type=search] { max-width: 16rem; }
  .kx-tools select { width: auto; max-width: 14rem; }
  .kx-grow { flex: 1; }
  .kx-scroll { overflow-x: auto; background: #fff; border: 1px solid var(--line); border-radius: 14px; }
  .kx-panel .kx-scroll, .kx-modal .kx-scroll { border: 0; }
  .kx-table { width: 100%; border-collapse: collapse; font-size: .93rem; }
  .kx-table th { text-align: start; font-size: .82rem; color: var(--muted); font-weight: 700; padding: .65rem .75rem; border-bottom: 1px solid var(--line); white-space: nowrap; background: #FAFBFC; }
  .kx-table td { padding: .6rem .75rem; border-bottom: 1px solid #EEF2F5; vertical-align: middle; }
  .kx-rows tbody tr { cursor: pointer; }
  .kx-rows tbody tr:hover, .kx-rows tbody tr:focus { background: #F6FAFD; outline: none; }
  .kx-rows tr.off td { color: #8A97A5; }
  .kx-num { width: 7rem !important; }
  .kx-short { width: 6rem !important; }
  .kx-empty { background: #fff; border: 1px dashed #C9D4DE; border-radius: 16px; padding: 2.5rem 1rem; text-align: center; display: grid; gap: .6rem; justify-items: center; }
  .kx-list { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; }
  .kx-list li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .3rem .75rem; padding: .6rem 0; border-bottom: 1px solid #EEF2F5; }
  .kx-list li small { flex-basis: 100%; }
  .kx-inline { display: flex; gap: .5rem; align-items: center; margin-bottom: .5rem; }
  .kx-kpilist { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: .5rem; }
  .kx-kpilist li { display: grid; gap: .1rem; padding: .55rem .7rem; border-radius: 10px; background: var(--paper); }
  .kx-kpilist small { color: var(--muted); }
  .kx-log { list-style: none; margin: 0; padding: 0; display: grid; gap: .35rem; font-size: .88rem; max-height: 18rem; overflow: auto; }

  /* modal and review editor */
  .kx-modal { border: 0; border-radius: 20px; padding: clamp(1.1rem, 3vw, 1.75rem); width: min(96vw, 34rem); max-height: 92vh; overflow: auto; box-shadow: 0 40px 90px -30px rgba(10,37,62,.55); color: var(--ink); }
  .kx-modal.wide { width: min(96vw, 64rem); }
  .kx-modal::backdrop { background: rgba(6,26,45,.55); }
  .kx-modal h2 { margin: 0 0 1rem; font-size: 1.3rem; padding-inline-end: 2rem; }
  .kx-x { position: absolute; inset-inline-end: 1rem; top: .8rem; border: 0; background: var(--paper); width: 2.2rem; height: 2.2rem; border-radius: 50%; font-size: 1.3rem; cursor: pointer; }
  .kx-modal .kx-x { position: sticky; float: inline-end; top: 0; }
  .kx-modal .kx-entry header { padding-inline-end: 2.9rem; }
  .kx-entry header { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
  .kx-big { font-size: 2.2rem; font-weight: 800; display: grid; justify-items: center; line-height: 1.1; }
  .kx-big small { font-size: .9rem; font-weight: 700; }
  .kx-comps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem 1rem; }
  .kx-comps label { display: grid; grid-template-columns: 1fr 6rem; gap: .5rem; align-items: center; font-weight: 600; font-size: .92rem; }
  .kx-self { background: var(--paper); border-radius: 12px; padding: .75rem 1rem; }
  .kx-note { background: #FFF6DC; border-radius: 10px; padding: .6rem .9rem; }
  .kx-block { margin-top: .9rem; }
  .kx-actions { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: flex-end; margin-top: 1.1rem; position: sticky; bottom: -1.75rem; background: #fff; padding: .75rem 0 .25rem; }

  .kx-toast { position: fixed; inset-inline-start: 50%; transform: translate(-50%, 140%); bottom: 1.25rem; background: var(--navy); color: #fff; padding: .7rem 1.1rem; border-radius: 12px; font-weight: 600; z-index: 9999; transition: transform .25s; max-width: 92vw; }
  [dir='rtl'] .kx-toast { transform: translate(50%, 140%); }
  .kx-toast.show { transform: translate(-50%, 0); }
  [dir='rtl'] .kx-toast.show { transform: translate(50%, 0); }
  .kx-toast.bad { background: #8A1F14; }

  @media (max-width: 900px) {
    .kx-shell { grid-template-columns: minmax(0, 1fr); }
    .kx-side { position: static; height: auto; flex-direction: row; flex-wrap: wrap; align-items: center; padding: .75rem 1rem; gap: .5rem 1rem; }
    .kx-co { margin: 0; }
    .kx-side nav { display: flex; overflow-x: auto; width: 100%; order: 3; gap: .25rem; }
    .kx-nav { white-space: nowrap; padding: .5rem .75rem; }
    .kx-user { margin: 0 0 0 auto; border: 0; padding: 0; grid-auto-flow: column; align-items: center; gap: .6rem; }
    [dir='rtl'] .kx-user { margin: 0 auto 0 0; }
    .kx-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kx-grid2, .kx-comps { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 520px) { .kx-row2 { grid-template-columns: minmax(0, 1fr); } .kx-hbars li { grid-template-columns: 6rem 1fr 2rem; } }

  @media print {
    body.kx-printing > *:not(dialog) { display: none !important; }
    body.kx-printing dialog { position: static; box-shadow: none; width: 100%; max-height: none; overflow: visible; }
    body.kx-printing .kx-actions, body.kx-printing .kx-x { display: none !important; }
  }
</style>
