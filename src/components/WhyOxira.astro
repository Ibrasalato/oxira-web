const icons = [
  '<path d="M8 3h8v4H8zM5 7h14v14H5z"/><path d="M9 12h6M9 16h4"/>',
  '<path d="M12 3l1.8 4.6L18 9l-4.2 1.6L12 15l-1.8-4.4L6 9l4.2-1.4z"/><path d="M18 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/>',
  '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  '<path d="M12 3l8 4v5c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V7z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
];
---
<section class="section bg-paper wo" aria-labelledby="wo-title">
  <div class="wrap">
    <div class="sh">
      <p class="label">{T.kicker}</p>
      <h2 id="wo-title">{T.title}</h2>
      <p>{T.body}</p>
    </div>
    <div class="wo-table" role="table" aria-label={T.title}>
      <div class="wo-row wo-head" role="row">
        <span role="columnheader">{T.aspect}</span>
        <span role="columnheader" class="wo-us">{T.us}</span>
        <span role="columnheader" class="wo-them">{T.them}</span>
      </div>
      {T.rows.map(([k, us, them]) => (
        <div class="wo-row" role="row">
          <span role="rowheader" class="wo-k">{k}</span>
          <span role="cell" class="wo-us"><i aria-hidden="true">✓</i><span><b class="wo-m">{T.us}: </b>{us}</span></span>
          <span role="cell" class="wo-them"><i aria-hidden="true">–</i><span><b class="wo-m">{T.them}: </b>{them}</span></span>
        </div>
      ))}
    </div>
    <ul class="wo-points">
      {T.points.map(([h, p], i) => (
        <li><span class="wo-ic"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></li>
      ))}
    </ul>
    <p class="wo-cta">
      <a class="btn btn-amber" href={link(lang, '/website-builder/')}>{T.cta}</a>
      <a class="btn btn-ghost" href={link(lang, '/contact/')}>{T.cta2}</a>
    </p>
  </div>
</section>

<style>
  .wo .label { color: var(--blue); font-weight: 700; margin-bottom: .4rem; }
  .wo .sh { margin-bottom: 2rem; }
  .wo-table { border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: #fff; }
  .wo-row { display: grid; grid-template-columns: 1fr 1.6fr 1.3fr; }
  .wo-row + .wo-row { border-top: 1px solid var(--line); }
  .wo-row > span { padding: 1rem 1.25rem; display: flex; gap: .6rem; align-items: flex-start; }
  .wo-head > span { font-weight: 700; font-size: .95rem; padding-block: 1.1rem; }
  .wo-head .wo-us { background: var(--navy); color: #fff; }
  .wo-head .wo-them { color: var(--muted); }
  .wo-k { font-weight: 700; color: var(--ink); }
  .wo-us { background: color-mix(in srgb, var(--amber) 9%, #fff); color: var(--ink); }
  .wo-us i { color: #1E8E4E; font-style: normal; font-weight: 800; }
  .wo-them { color: var(--muted); }
  .wo-them i { color: #A0AAB6; font-style: normal; font-weight: 800; }
  .wo-m { display: none; }
  .wo-points { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; }
  .wo-points li { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.4rem; display: grid; gap: .5rem; align-content: start; }
  .wo-points h3 { font-size: 1.08rem; }
  .wo-points p { color: var(--muted); }
  .wo-ic { width: 46px; height: 46px; border-radius: 13px; background: var(--blue-soft); color: var(--blue); display: grid; place-items: center; margin-bottom: .3rem; }
  .wo-ic svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .wo-cta { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  @media (max-width: 900px) { .wo-points { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 700px) {
    .wo-head { display: none; }
    .wo-row { grid-template-columns: minmax(0, 1fr); padding: .4rem 0; }
    .wo-row > span { padding: .45rem 1rem; }
    .wo-k { padding-top: .8rem !important; }
    .wo-us { margin-inline: .6rem; border-radius: 10px; }
    .wo-m { display: inline; font-weight: 700; }
    .wo-points { grid-template-columns: minmax(0, 1fr); }
  }
</style>
