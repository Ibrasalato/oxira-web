---
import { t, type Lang } from '../i18n/content';
import Base from '../layouts/Base.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const pol = t[lang].legal.policy;
---
<Base lang={lang} path="/privacy/" title={pol.title} description={pol.description}>
  <section class="page-hero">
    <div class="wrap">
      <h1>{pol.h1}</h1>
      <p class="updated">{pol.updated}</p>
      <p class="lead">{pol.intro}</p>
    </div>
  </section>

  <section class="policy">
    <div class="wrap">
      <div class="doc">
        {pol.sections.map((sec, i) => (
          <section aria-labelledby={`p-${i}`}>
            <h2 id={`p-${i}`}>{sec.h}</h2>
            {sec.p.map((para) => <p>{para}</p>)}
            {'list' in sec && sec.list && <ul>{sec.list.map((li) => <li>{li}</li>)}</ul>}
            {'after' in sec && sec.after && <p>{sec.after}</p>}
          </section>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .updated { color: var(--muted); font-weight: 600; margin-top: .75rem; }
  .policy { padding-bottom: var(--section); }
  .doc { max-width: 46rem; display: grid; gap: 2.5rem; border-top: 1px solid var(--line); padding-top: 2.5rem; }
  .doc section { display: grid; gap: .8rem; }
  .doc h2 { font-size: var(--s2); }
  .doc p, .doc li { font-size: 1.08rem; color: #2B3E50; }
  .doc ul { display: grid; gap: .5rem; padding-inline-start: 1.25rem; }
  .doc li::marker { color: var(--amber); }
</style>
