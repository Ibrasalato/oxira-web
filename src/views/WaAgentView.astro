---
// AI WhatsApp employee: landing page with the free try form (oxira-agent-try), plans and subscribe form.
// Arabic and English only. Copy in src/i18n/waAgent.ts.
import { link } from '../lib/routes';
import { waText, waLangs, waPath, waDemoPath, WA_PRICES, type WaLang } from '../i18n/waAgent';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import WaSubscribe from '../components/WaSubscribe.astro';
import waExamples from '../data/wa-examples.json';

interface Props { lang: WaLang }
const { lang } = Astro.props;
const W = waText[lang];
const F = W.form;
const site = Astro.site!;
const url = new URL(link(lang, waPath), site).href;
const nf = new Intl.NumberFormat(lang === 'ar' ? 'ar-SA-u-nu-latn' : 'en');
const cfg = { endpoint: 'https://api.oxira.sa/oxira-agent-try', demo: link(lang, waDemoPath), lang, t: { submit: F.submit, progress: F.progress, errors: F.errors } };
// Example businesses (fictional, always labelled as examples) with real replies from the live agent.
const esc = (t: string) => t.replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]!));
const fmt = (t: string) => esc(t).replace(/\*([^*\n]+)\*/g, '<b>$1</b>').replace(/\n/g, '<br>');
const exs = waExamples.examples.map((e) => ({
  key: e.key,
  demo: `${link(lang, waDemoPath)}?d=${e.demoId}`,
  business: e.business,
  label: lang === 'ar' ? e.label_ar : e.label_en,
  city: lang === 'ar' ? e.city_ar : e.city_en,
  dialect: lang === 'ar' ? e.dialect_ar : e.dialect_en,
  messages: e.messages.map((m) => ({ role: m.role === 'user' ? 'user' : 'agent', text: m.text })),
}));
const liveData = exs.map(({ business, label, city, messages }) => ({ business, sub: `${label} · ${city}`, messages }));
const first = exs[0];
const exIcons: Record<string, string> = {
  restaurant: '<path d="M14 6v13a4 4 0 0 0 8 0V6M18 6v36M34 42V6c-4 2-6 7-6 14v6h6" />',
  clinic: '<path d="M16 7c-5 0-8 4-8 9 0 6 3 9 4 15 1 7 2 11 5 11 3 0 3-8 7-8s4 8 7 8c3 0 4-4 5-11 1-6 4-9 4-15 0-5-3-9-8-9-3 0-5 2-8 2s-5-2-8-2z" />',
  salon: '<circle cx="13" cy="36" r="5" /><circle cx="35" cy="36" r="5" /><path d="M16.5 32.5 36 6M31.5 32.5 12 6" />',
  store: '<path d="M18 6h12v6H18zM20 12v4M28 12v4" /><rect x="11" y="16" width="26" height="26" rx="5" /><path d="M18 29h12" />',
};
const plans = (['basic', 'pro'] as const).map((id) => ({ id, price: WA_PRICES[id], ...W.plans[id] }));

const crumbs = [
  { name: W.crumbs.home, item: new URL(link(lang, '/'), site).href },
  { name: W.crumbs.agents, item: new URL(link(lang, '/ai-agents/'), site).href },
  { name: W.name, item: url },
];
const org = { '@type': 'Organization', name: 'Oxira', url: new URL(link(lang, '/'), site).href };
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: W.name,
    serviceType: lang === 'ar' ? 'وكيل ذكاء اصطناعي على واتساب' : 'AI WhatsApp agent',
    description: W.description,
    url,
    inLanguage: lang,
    areaServed: { '@type': 'Country', name: 'Saudi Arabia' },
    provider: org,
    offers: plans.map((p) => ({
      '@type': 'Offer',
      name: p.name,
      price: String(p.price),
      priceCurrency: 'SAR',
      url: `${url}#plans`,
      priceSpecification: { '@type': 'UnitPriceSpecification', price: String(p.price), priceCurrency: 'SAR', unitCode: 'MON', valueAddedTaxIncluded: false },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: W.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((cr, i) => ({ '@type': 'ListItem', position: i + 1, name: cr.name, item: cr.item })),
  },
];
---
<Base lang={lang} path={waPath} langs={waLangs} title={W.title} description={W.description}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />

  <section class="page-hero wa-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label={W.crumbs.label}>
        <a href={link(lang, '/')}>{W.crumbs.home}</a><span aria-hidden="true">/</span>
        <a href={link(lang, '/ai-agents/')}>{W.crumbs.agents}</a><span aria-hidden="true">/</span>
        <span aria-current="page">{W.name}</span>
      </nav>
      <div class="wa-grid">
        <div class="wa-intro">
          <p class="label wa-kicker"><span class="wa-ic"><Icon name="whatsapp" /></span>{W.kicker}</p>
          <h1>{W.h1}</h1>
          <p class="lead">{W.lead}</p>
        </div>

        <div class="wa-card">
          <form class="wa-form" id="wa-form" data-cfg={JSON.stringify(cfg)} novalidate aria-labelledby="wa-form-title">
            <h2 id="wa-form-title">{F.title}</h2>
            <label><span>{F.url} <span class="wa-opt">({F.urlHint})</span></span><input name="url" type="url" maxlength="300" placeholder={F.urlPh} dir="ltr" inputmode="url" autocomplete="url" /></label>
            <label>{F.business}<input name="business" required maxlength="100" autocomplete="organization" /></label>
            <label>
              <span>{F.notes}</span>
              <textarea name="notes" rows="3" maxlength="1500" placeholder={F.notesPh} aria-describedby="wa-notes-hint"></textarea>
              <small id="wa-notes-hint" class="wa-hint">{F.notesHint} <span class="wa-count" aria-hidden="true">0/1500</span></small>
            </label>
            <div class="wa-row">
              <label>
                {F.email}
                <input name="email" type="email" required maxlength="160" dir="ltr" autocomplete="email" aria-describedby="wa-email-hint" />
                <small id="wa-email-hint" class="wa-hint">{F.emailHint}</small>
              </label>
              <label><span>{F.phone} <span class="wa-opt">({F.optional})</span></span><input name="phone" type="tel" maxlength="30" dir="ltr" autocomplete="tel" /></label>
            </div>
            <input class="wa-hp" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <button type="submit" class="btn btn-amber">{F.submit}</button>
            <p class="wa-status is-error" role="alert" hidden></p>
            <p class="wa-privacy">{F.privacy} <a href={link(lang, '/privacy/')}>{F.privacyLink}</a></p>
          </form>
          <div class="wa-progress" id="wa-progress" hidden>
            <span class="wa-spin" aria-hidden="true"></span>
            <p class="wa-pmsg" aria-live="polite">{F.progress[0]}</p>
            <span class="wa-bar" aria-hidden="true"><i></i></span>
            <p class="wa-pnote">{F.progressNote}</p>
          </div>
        </div>

        <ul class="wa-points">{W.points.map((p) => <li>{p}</li>)}</ul>

        <figure class="wa-live" id="wa-live" data-ex={JSON.stringify(liveData)} data-tag={W.live.tag}>
          <div class="wa-phone" role="img" aria-label={W.live.label}>
            <div class="wa-lhead">
              <span class="wa-av" aria-hidden="true"><Icon name="agent" /></span>
              <span class="wa-who"><strong class="wa-biz">{first.business}</strong><small><span class="wa-sub">{first.label} · {first.city}</span><span class="wa-on"> · {W.live.online}</span></small></span>
              <span class="wa-ltag">{W.live.tag}</span>
            </div>
            <div class="wa-screen">
              <ol class="wa-log" aria-hidden="true">
                {first.messages.slice(0, 2).map((m) => <li class={`wa-msg wa-${m.role}`} dir="auto" set:html={fmt(m.text)} />)}
              </ol>
            </div>
          </div>
          <figcaption>{W.live.note}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section-tight wa-exs" id="examples" aria-labelledby="wa-ex">
    <div class="wrap">
      <div class="sh"><h2 id="wa-ex">{W.examples.title}</h2><p>{W.examples.body}</p></div>
      <ul class="wa-excards">
        {exs.map((e) => (
          <li>
            <a href={e.demo}>
              <span class="wa-exhead">
                <span class="wa-exic" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" set:html={exIcons[e.key]} /></span>
                <span class="wa-extag">{W.examples.tag}</span>
              </span>
              <strong class="wa-exlabel">{e.label}</strong>
              <span class="wa-exmeta">{e.city} · {e.dialect}</span>
              <q class="wa-exq" dir="auto">{e.messages[0].text}</q>
              <span class="more">{W.examples.cta}</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn-navy wa-exown" href="#wa-form">{W.examples.own}</a>
    </div>
  </section>

  <section class="section-tight bg-navy" aria-labelledby="wa-steps">
    <div class="wrap">
      <div class="sh"><h2 id="wa-steps">{W.stepsTitle}</h2></div>
      <ol class="wa-steps">
        {W.steps.map((s, i) => (
          <li><span class="wa-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3>{s.t}</h3><p>{s.d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="wa-can">
    <div class="wrap">
      <div class="sh"><h2 id="wa-can">{W.canTitle}</h2><p>{W.canBody}</p></div>
      <ul class="wa-cards">
        {W.can.map((x) => <li><h3>{x.t}{x.pro && <span class="wa-pro">{W.proBadge}</span>}</h3><p>{x.d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section-tight bg-paper" id="plans" aria-labelledby="wa-plans">
    <div class="wrap">
      <div class="sh"><h2 id="wa-plans">{W.plansTitle}</h2><p>{W.plansBody}</p></div>
      <div class="wa-plans">
        {plans.map((p) => (
          <article class={`wa-plan${p.id === 'pro' ? ' is-pro' : ''}`}>
            {p.id === 'pro' && <span class="wa-tag">{W.popular}</span>}
            <h3>{p.name}</h3>
            <p class="wa-price"><b>{nf.format(p.price)}</b> {W.sar} <span>{W.perMonth}</span></p>
            {p.intro && <p class="wa-pintro">{p.intro}</p>}
            <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
            <button type="button" class={`btn ${p.id === 'pro' ? 'btn-amber' : 'btn-navy'}`} data-wa-sub data-plan={p.id}>{p.cta}</button>
          </article>
        ))}
      </div>
      <ul class="wa-pnotes">{W.planNotes.map((n) => <li>{n}</li>)}</ul>
      <a class="more wa-tryfirst" href="#wa-form">{W.tryFirst}</a>
    </div>
  </section>

  <WaSubscribe lang={lang} />

  <section class="section-tight" aria-labelledby="wa-faq">
    <div class="wrap wa-body">
      <h2 id="wa-faq">{W.faqTitle}</h2>
      <div class="wa-faq">
        {W.faq.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>

  <section class="section-tight wa-pt0" aria-labelledby="wa-rel">
    <div class="wrap">
      <h2 id="wa-rel" class="wa-rel-h">{W.related}</h2>
      <ul class="wa-rel">{W.relatedLinks.map((r) => <li><a href={link(lang, r.path)}>{r.label}</a></li>)}</ul>
    </div>
  </section>
</Base>

<script>
  // Hero: replays the example conversations (typing, user, typing, agent). Static when reduced motion is on.
  const live = document.getElementById('wa-live');
  if (live && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    type Ex = { business: string; sub: string; messages: { role: string; text: string }[] };
    const exs: Ex[] = JSON.parse(live.dataset.ex!);
    const log = live.querySelector<HTMLElement>('.wa-log')!;
    const biz = live.querySelector<HTMLElement>('.wa-biz')!;
    const sub = live.querySelector<HTMLElement>('.wa-sub')!;
    const esc = (t: string) => t.replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]!));
    const fmt = (t: string) => esc(t).replace(/\*([^*\n]+)\*/g, '<b>$1</b>').replace(/\n/g, '<br>');
    const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
    let visible = false;
    const until = () => new Promise<void>((r) => { const t = () => (visible && !document.hidden ? r() : setTimeout(t, 400)); t(); });
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(live);
    const add = (cls: string, html: string) => {
      const li = document.createElement('li');
      li.className = `wa-msg ${cls} is-in`; li.setAttribute('dir', 'auto'); li.innerHTML = html;
      log.append(li);
      return li;
    };
    const dots = (who: string) => add(`wa-${who} wa-typing`, '<i></i><i></i><i></i>');
    (async () => {
      let ex = 0; let step = 2; // the page already shows the first exchange
      for (;;) {
        const e = exs[ex];
        const m = e.messages[step];
        if (m) {
          await until();
          const t = dots(m.role === 'user' ? 'user' : 'agent');
          await wait(m.role === 'user' ? 1100 : 1500);
          t.remove();
          add(`wa-${m.role === 'user' ? 'user' : 'agent'}`, fmt(m.text));
          await wait(m.role === 'user' ? 500 : 2600 + Math.min(m.text.length * 12, 2400));
          step++;
          continue;
        }
        await wait(1200);
        log.classList.add('is-out');
        await wait(450);
        ex = (ex + 1) % exs.length; step = 0;
        const n = exs[ex];
        log.replaceChildren(); log.classList.remove('is-out');
        biz.textContent = n.business; sub.textContent = n.sub;
        await wait(500);
      }
    })();
  }

  const form = document.getElementById('wa-form') as HTMLFormElement;
  const c = JSON.parse(form.dataset.cfg!);
  const E = c.t.errors as Record<string, string>;
  const status = form.querySelector<HTMLElement>('.wa-status')!;
  const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
  const prog = document.getElementById('wa-progress')!;
  const pmsg = prog.querySelector<HTMLElement>('.wa-pmsg')!;
  const notes = form.elements.namedItem('notes') as HTMLTextAreaElement;
  const count = form.querySelector<HTMLElement>('.wa-count')!;
  notes.addEventListener('input', () => { count.textContent = `${notes.value.length}/1500`; });

  const fail = (code: string) => {
    status.hidden = false;
    status.textContent = E[code] || E.server;
    const hasBiz = !!(form.elements.namedItem('business') as HTMLInputElement).value.trim();
    const focus = ({ url: 'url', email: 'email', fetch: 'notes', content: 'notes', input: hasBiz ? 'notes' : 'business' } as Record<string, string>)[code];
    if (focus) (form.elements.namedItem(focus) as HTMLElement).focus();
  };

  let timer = 0;
  const busy = (on: boolean) => {
    form.hidden = on; prog.hidden = !on; btn.disabled = on;
    clearInterval(timer);
    if (on) {
      let i = 0; pmsg.textContent = c.t.progress[0];
      prog.classList.remove('is-run'); void prog.offsetWidth; prog.classList.add('is-run');
      timer = window.setInterval(() => { i = Math.min(i + 1, c.t.progress.length - 1); pmsg.textContent = c.t.progress[i]; if (i === c.t.progress.length - 1) clearInterval(timer); }, 9000);
    }
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.hidden = true;
    const f = new FormData(form);
    const v = (k: string) => String(f.get(k) || '').trim();
    let url = v('url');
    if (url && !/^https?:\/\//i.test(url)) url = 'https://' + url;
    if (url && !/^https?:\/\/[^\s/]+\.[^\s/]{2,}/i.test(url)) return fail('url');
    if (!v('business') || (!url && !v('notes'))) return fail('input');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v('email'))) return fail('email');
    busy(true);
    const ac = new AbortController();
    const to = setTimeout(() => ac.abort(), 90000);
    let r: any = null; let code = 'server';
    try {
      const body = { url, business: v('business'), notes: v('notes').slice(0, 1500), email: v('email'), phone: v('phone'), lang: c.lang, company_website: v('company_website') };
      const res = await fetch(c.endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body), signal: ac.signal });
      r = await res.json();
    } catch (err) { if ((err as Error)?.name === 'AbortError') code = 'timeout'; }
    clearTimeout(to);
    if (r && r.success && r.demoId) {
      try { localStorage.setItem('oxira-wa-demo', JSON.stringify({ id: r.demoId, business: r.business || v('business') })); } catch { /* ignore */ }
      location.href = `${c.demo}?d=${encodeURIComponent(r.demoId)}`;
      return;
    }
    busy(false);
    fail(r && r.error ? String(r.error) : code);
  });
</script>

<style>
  .crumbs { display: flex; flex-wrap: wrap; gap: .5rem; font-size: .9rem; color: var(--muted); margin-bottom: 1.5rem; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--blue); }
  .crumbs [aria-current] { color: var(--ink); font-weight: 600; }
  .wa-hero { padding-top: clamp(1.5rem, 3vw, 2.5rem); }
  #plans, .wa-card, #wa-form, #examples { scroll-margin-top: 5.5rem; }
  .wa-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 30rem); grid-template-areas: 'intro card' 'points card' 'live card'; gap: 1.5rem clamp(2rem, 5vw, 4rem); align-items: start; }
  .wa-intro { grid-area: intro; }
  .wa-card { grid-area: card; }
  .wa-points { grid-area: points; }
  .wa-hero h1 { font-size: clamp(1.85rem, 3.6vw, 3rem); max-width: 20ch; }
  .wa-kicker { display: inline-flex; align-items: center; gap: .6rem; margin-bottom: 1rem; }
  .wa-ic { width: 40px; height: 40px; border-radius: 12px; background: #E7F6EC; color: #0B8A6E; display: grid; place-items: center; flex: none; font-size: 24px; }
  .wa-points { list-style: none; display: grid; gap: .6rem; }
  .wa-points li { position: relative; padding-inline-start: 1.7rem; font-weight: 600; }
  .wa-points li::before { content: '✓'; position: absolute; inset-inline-start: 0; color: #0B8A6E; font-weight: 800; }

  .wa-live { grid-area: live; width: min(25rem, 100%); margin: 0; }
  .wa-phone { border-radius: 30px; padding: 9px; background: var(--navy-deep); box-shadow: 0 30px 60px -35px rgba(10,37,62,.6), inset 0 0 0 2px #22384F; }
  .wa-lhead { display: flex; align-items: center; gap: .6rem; background: #0B5C4E; color: #fff; padding: .75rem .85rem; border-radius: 22px 22px 0 0; }
  .wa-av { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: #fff; color: var(--navy); font-size: 20px; flex: none; }
  .wa-who { display: grid; min-width: 0; flex: 1; }
  .wa-who strong { font-size: .95rem; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wa-who small { font-size: .75rem; opacity: .85; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wa-ltag { flex: none; font-size: .7rem; font-weight: 700; line-height: 1; padding: .35rem .55rem; border-radius: 999px; background: var(--amber); color: var(--navy); }
  .wa-log {
    list-style: none; margin: 0; padding: .9rem .75rem; height: 24rem; display: flex; flex-direction: column; justify-content: flex-end; gap: .45rem; overflow: hidden; 
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 2.5rem); mask-image: linear-gradient(to bottom, transparent 0, #000 2.5rem);
    transition: opacity .4s ease;
  }
  .wa-screen { border-radius: 0 0 22px 22px; overflow: hidden; background: #EFE7DE radial-gradient(rgba(10,37,62,.06) 1.2px, transparent 1.2px) 0 0 / 16px 16px; }
  .wa-log.is-out { opacity: 0; }
  .wa-log :global(.wa-msg) { flex: none; max-width: 86%; padding: .4rem .65rem; border-radius: 10px; font-size: .86rem; line-height: 1.6; box-shadow: 0 1px 1px rgba(0,0,0,.08); overflow-wrap: anywhere; color: var(--ink); }
  .wa-log :global(.wa-user) { align-self: flex-end; background: #D9FDD3; border-start-end-radius: 2px; }
  .wa-log :global(.wa-agent) { align-self: flex-start; background: #fff; border-start-start-radius: 2px; }
  .wa-log :global(.is-in) { animation: wa-in .28s ease-out; }
  .wa-log :global(.wa-typing) { display: flex; gap: 4px; padding: .65rem .75rem; }
  .wa-log :global(.wa-typing i) { width: 7px; height: 7px; border-radius: 50%; background: #8696A0; animation: wa-dot 1.2s infinite ease-in-out; }
  .wa-log :global(.wa-typing i:nth-of-type(2)) { animation-delay: .15s; }
  .wa-log :global(.wa-typing i:nth-of-type(3)) { animation-delay: .3s; }
  @keyframes wa-in { from { opacity: 0; transform: translateY(8px); } }
  @keyframes wa-dot { 0%, 60%, 100% { opacity: .35; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-3px); } }
  .wa-live figcaption { margin-top: .7rem; font-size: .85rem; color: var(--muted); }

  .wa-exs { padding-top: clamp(1rem, 2vw, 2rem); }
  .wa-excards { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr)); gap: 1.25rem; }
  .wa-excards a { height: 100%; display: flex; flex-direction: column; gap: .45rem; padding: 1.4rem; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; color: var(--ink); text-decoration: none; transition: border-color .2s, box-shadow .2s; }
