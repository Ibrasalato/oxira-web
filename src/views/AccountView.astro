---
// Client account: sign up / sign in with email + password (6-digit email code), then a dashboard for websites, services and billing.
import type { Lang } from '../i18n/content';
import { builderText } from '../i18n/builder';
import { link } from '../lib/routes';
import { addonIds, addonPrices, addonIcons } from '../builder/addons';
import Base from '../layouts/Base.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const b = builderText[lang];
const a = b.account;
const n8n = 'https://ibrasalato.app.n8n.cloud/webhook';
const config = {
  lang,
  authEndpoint: `${n8n}/oxira-auth`,
  apiEndpoint: `${n8n}/oxira-portal`,
  seoEndpoint: `${n8n}/oxira-seo`,
  seoSettingsEndpoint: `${n8n}/oxira-seo-settings`,
  socialEndpoint: `${n8n}/oxira-social`,
  uploadEndpoint: `${n8n}/oxira-studio-upload`,
  imageBase: 'https://oxira-sites.oxira-sa.workers.dev/_img/',
  extEndpoint: `${n8n}/oxira-site-ext`,
  gscEmail: 'ibrasalato@gmail.com',
  builderUrl: link(lang, '/website-builder/'),
  helpUrl: `${link(lang, '/help/')}#domains-search-console`,
  numberLocale: lang === 'ar' ? 'ar-SA-u-nu-latn' : lang,
  text: a,
  addons: b.addons,
  sar: b.packages.sar,
  perYear: b.packages.perYear,
  prices: addonPrices,
  icons: addonIcons,
  addonIds,
  partnersUrl: link(lang, '/partners/'),
  contactUrl: link(lang, '/contact/'),
};
const eye = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>';
const ic = {
  home: '<path d="M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z"/>',
  site: '<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 8h18M8 21h8"/>',
  billing: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4"/>',
  profile: '<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>',
  support: '<path d="M4 13v-1a8 8 0 0 1 16 0v1"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/>',
  out: '<path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 17l5-5-5-5M15 12H4"/>',
};
---
<Base lang={lang} path="/account/" title={a.pageTitle} description={a.pageDescription} noindex>
  <div class="ac" id="account" data-config={JSON.stringify(config)} data-state="loading">
    <section class="ac-auth wrap" data-show="signin">
      <div class="ac-auth-box">
        <aside class="ac-auth-side" aria-hidden="true">
          <p class="ac-auth-brand">Oxira</p>
          <h2>{a.authSideTitle}</h2>
          <ul>{a.authSidePoints.map((x: string) => <li>{x}</li>)}</ul>
          <p class="ac-auth-secure"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>{a.authSecure}</p>
        </aside>
        <div class="ac-auth-main">
          <div class="ac-auth-tabs" role="tablist" id="ac-auth-tabs">
            <button type="button" role="tab" data-auth="login" aria-selected="true">{a.authLoginTab}</button>
            <button type="button" role="tab" data-auth="signup" aria-selected="false">{a.authSignupTab}</button>
          </div>

          <form class="ac-auth-form" data-step="login" novalidate>
            <h1>{a.authWelcome}</h1>
            <p class="ac-muted">{a.authLoginSub}</p>
            <label class="ac-field">{a.email}<input name="email" type="email" dir="ltr" required maxlength="160" autocomplete="email" /></label>
            <div class="ac-field"><span class="ac-lbl-row"><label for="ac-lpw">{a.authPassword}</label><button type="button" class="ac-link ac-small" data-go="forgot">{a.authForgot}</button></span>
              <span class="ac-pw"><input id="ac-lpw" name="password" type="password" dir="ltr" required maxlength="128" autocomplete="current-password" /><button type="button" class="ac-eye" data-eye aria-label={a.authShow} set:html={eye} /></span></div>
            <button type="submit" class="btn btn-amber ac-auth-btn">{a.authLoginBtn}</button>
            <p class="ac-auth-alt">{a.authNoAccount} <button type="button" class="ac-link" data-auth="signup">{a.authSignupTab}</button></p>
          </form>

          <form class="ac-auth-form" data-step="signup" novalidate hidden>
            <h1>{a.authSignupTitle}</h1>
            <p class="ac-muted">{a.authSignupSub}</p>
            <label class="ac-field">{a.authName}<input name="name" required maxlength="80" autocomplete="name" dir="auto" /></label>
            <label class="ac-field">{a.email}<input name="email" type="email" dir="ltr" required maxlength="160" autocomplete="email" /></label>
            <div class="ac-auth-2">
              <label class="ac-field"><span>{a.authPhone} <small class="ac-muted">({a.authOptional})</small></span><input name="phone" type="tel" dir="ltr" maxlength="20" autocomplete="tel" inputmode="tel" placeholder="05XXXXXXXX" /></label>
              <label class="ac-field"><span>{a.authCompany} <small class="ac-muted">({a.authOptional})</small></span><input name="company" maxlength="120" autocomplete="organization" dir="auto" /></label>
            </div>
            <div class="ac-field"><label for="ac-spw">{a.authPassword}</label>
              <span class="ac-pw"><input id="ac-spw" name="password" type="password" dir="ltr" required maxlength="128" autocomplete="new-password" data-meter /><button type="button" class="ac-eye" data-eye aria-label={a.authShow} set:html={eye} /></span>
              <span class="ac-meter" aria-hidden="true"><i></i><i></i><i></i><i></i></span><small class="ac-muted" data-meter-label>{a.authPwHint}</small></div>
            <label class="ac-field">{a.authPassword2}<input name="password2" type="password" dir="ltr" required maxlength="128" autocomplete="new-password" /></label>
            <button type="submit" class="btn btn-amber ac-auth-btn">{a.authSignupBtn}</button>
            <p class="ac-muted ac-small">{a.authAgree} <a href={link(lang, '/terms/')}>{a.authTerms}</a> {a.authAnd} <a href={link(lang, '/privacy/')}>{a.authPrivacy}</a>.</p>
            <p class="ac-auth-alt">{a.authHaveAccount} <button type="button" class="ac-link" data-auth="login">{a.authLoginTab}</button></p>
          </form>

          <form class="ac-auth-form" data-step="verify" novalidate hidden>
            <span class="ac-auth-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
            <h1>{a.authVerifyTitle}</h1>
            <p class="ac-muted">{a.authVerifyBody} <b dir="ltr" data-auth-email></b></p>
            <div class="ac-otp" data-otp role="group" aria-label={a.authCode}>{[0, 1, 2, 3, 4, 5].map(() => <input inputmode="numeric" autocomplete="one-time-code" maxlength="6" dir="ltr" aria-label={a.authCode} />)}</div>
            <button type="submit" class="btn btn-amber ac-auth-btn">{a.authVerifyBtn}</button>
            <p class="ac-auth-alt"><button type="button" class="ac-link" data-resend="verify">{a.authResend}</button> · <button type="button" class="ac-link" data-auth="signup">{a.authChangeEmail}</button></p>
            <p class="ac-muted ac-small">{a.authCheckSpam}</p>
          </form>

          <form class="ac-auth-form" data-step="forgot" novalidate hidden>
            <span class="ac-auth-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>
            <h1>{a.authForgotTitle}</h1>
            <p class="ac-muted">{a.authForgotBody}</p>
            <label class="ac-field">{a.email}<input name="email" type="email" dir="ltr" required maxlength="160" autocomplete="email" /></label>
            <button type="submit" class="btn btn-amber ac-auth-btn">{a.authForgotBtn}</button>
            <p class="ac-auth-alt"><button type="button" class="ac-link" data-auth="login">{a.authBack}</button></p>
          </form>

          <form class="ac-auth-form" data-step="reset" novalidate hidden>
            <h1>{a.authResetTitle}</h1>
            <p class="ac-muted">{a.authResetBody} <b dir="ltr" data-auth-email></b></p>
            <div class="ac-otp" data-otp role="group" aria-label={a.authCode}>{[0, 1, 2, 3, 4, 5].map(() => <input inputmode="numeric" autocomplete="one-time-code" maxlength="6" dir="ltr" aria-label={a.authCode} />)}</div>
            <div class="ac-field"><label for="ac-rpw">{a.authNewPassword}</label>
              <span class="ac-pw"><input id="ac-rpw" name="password" type="password" dir="ltr" required maxlength="128" autocomplete="new-password" data-meter /><button type="button" class="ac-eye" data-eye aria-label={a.authShow} set:html={eye} /></span>
              <span class="ac-meter" aria-hidden="true"><i></i><i></i><i></i><i></i></span><small class="ac-muted" data-meter-label>{a.authPwHint}</small></div>
            <label class="ac-field">{a.authPassword2}<input name="password2" type="password" dir="ltr" required maxlength="128" autocomplete="new-password" /></label>
            <button type="submit" class="btn btn-amber ac-auth-btn">{a.authResetBtn}</button>
            <p class="ac-auth-alt"><button type="button" class="ac-link" data-resend="reset">{a.authResend}</button> · <button type="button" class="ac-link" data-auth="login">{a.authBack}</button></p>
          </form>

          <p class="ac-status" id="ac-login-status" role="status" aria-live="polite" hidden></p>
        </div>
      </div>
    </section>

    <div class="ac-loading wrap" data-show="loading"><span class="ac-spinner" aria-hidden="true"></span><p>{a.loading}</p></div>

    <div class="ac-app wrap" data-show="app">
      <div class="ac-shell">
        <aside class="ac-side">
          <div class="ac-me"><span class="ac-avatar" id="ac-avatar" aria-hidden="true"></span><div><b id="ac-name"></b><small id="ac-email" dir="ltr"></small></div></div>
          <nav class="ac-nav" id="ac-nav" aria-label={a.navMenu}>
            {(['home', 'site', 'billing', 'profile'] as const).map((k) => <button type="button" data-sec={k}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic[k]} /><span>{({ home: a.navHome, site: a.navSites, billing: a.navBilling, profile: a.navProfile })[k]}</span></button>)}
          </nav>
          <div class="ac-side-foot">
            <a href={link(lang, '/contact/')}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic.support} />{a.navSupport}</a>
            <button type="button" id="ac-signout"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic.out} />{a.signOut}</button>
          </div>
        </aside>
        <div class="ac-main">
          <header class="ac-head">
            <div><h1 id="ac-title">{a.title}</h1><p class="ac-muted" id="ac-sub"></p></div>
            <div class="ac-head-tools"><select id="ac-site" aria-label={a.site}></select></div>
          </header>
          <p class="ac-note" id="ac-flash" hidden></p>
          <div data-sec-panel="home" id="ac-home"></div>
          <div data-sec-panel="site"><nav class="ac-tabs" id="ac-tabs" role="tablist"></nav><main id="ac-panel" class="ac-panel"></main></div>
          <div data-sec-panel="billing" id="ac-billing"></div>
          <div data-sec-panel="profile" id="ac-profile"></div>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import qrcode from 'qrcode-generator';

  type Sub = { id: number; order_id: number; product: string; price: number; period: string; status: string; next_due: string; invoice_url: string };
  type Site = { order_id: number; name: string; url: string; status: string; plan: string; domain: string; spec: any; settings: any; external?: boolean; verified?: boolean };
  type Booking = { id: number; order_id: number; name: string; phone: string; email: string; service: string; date: string; time: string; note: string; status: string };
  type Ticket = { id: number; order_id: number; code: string; type: string; qty: number; amount: number; name: string; phone: string; email: string; status: string; checked_in: string };
  type View = { success: boolean; reason?: string; email: string; sites: Site[]; subs: Sub[]; bookings: Booking[]; tickets: Ticket[]; content: { order_id: number; month: string; posts: any[] }[]; payUrl?: string };

  const root = document.getElementById('account')!;
  const cfg = JSON.parse(root.dataset.config!);
  const T = cfg.text;
  const KEY = 'oxira-portal-k';
  const SITE_KEY = 'oxira-portal-site';
  const $ = <E extends Element>(s: string) => root.querySelector(s) as E;
  const esc = (s: unknown) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const fmt = new Intl.NumberFormat(cfg.numberLocale, { maximumFractionDigits: 2 });
  const store = {
    get: (k: string) => { try { return localStorage.getItem(k) || ''; } catch { return ''; } },
    set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* ignore */ } },
    del: (k: string) => { try { localStorage.removeItem(k); } catch { /* ignore */ } },
  };
  const show = (state: string) => { root.dataset.state = state; };

  // ---- Sign in ----
  const params = new URLSearchParams(location.search);
  const fromLink = params.get('k');
  if (fromLink && /^[a-f0-9]{40}$/.test(fromLink)) store.set(KEY, fromLink);
  const justPaid = params.has('paid');
  const socialBack = params.get('social');
  if (fromLink || justPaid || socialBack) history.replaceState(null, '', location.pathname + location.hash);
  let token = store.get(KEY);

  // ---- Sign in / create account (Oxira 26 API: oxira-auth) ----
  const PW_OK = /^(?=.*[A-Za-z؀-ۿ])(?=.*\d).{8,128}$/;
  let authEmail = '';
  const authStatus = () => $<HTMLElement>('#ac-login-status');
  function authMsg(text: string, ok = false) { const el = authStatus(); el.textContent = text; el.className = 'ac-status ' + (ok ? 'is-ok' : 'is-error'); el.hidden = !text; }
  function step(name: string) {
    root.querySelectorAll<HTMLFormElement>('[data-step]').forEach((f) => { f.hidden = f.dataset.step !== name; });
    const tabsEl = $<HTMLElement>('#ac-auth-tabs');
    tabsEl.hidden = !['login', 'signup'].includes(name);
    tabsEl.querySelectorAll<HTMLButtonElement>('[data-auth]').forEach((x) => x.setAttribute('aria-selected', String(x.dataset.auth === name)));
    root.querySelectorAll<HTMLElement>('[data-auth-email]').forEach((x) => { x.textContent = authEmail; });
    authMsg('');
    const f = root.querySelector<HTMLFormElement>(`[data-step="${name}"]`)!;
    if (authEmail) f.querySelectorAll<HTMLInputElement>('input[name=email]').forEach((i) => { if (!i.value) i.value = authEmail; });
    f.querySelectorAll<HTMLInputElement>('[data-otp] input').forEach((i) => { i.value = ''; });
    setTimeout(() => (f.querySelector<HTMLInputElement>('[data-otp] input, input:not([type=hidden])'))?.focus(), 30);
  }
  async function auth(action: string, data: Record<string, string> = {}): Promise<any> {
    try {
      const res = await fetch(cfg.authEndpoint, { method: 'POST', body: new URLSearchParams({ action, lang: cfg.lang, ...data }) });
      return await res.json();
    } catch { return { success: false, reason: 'network' }; }
  }
  const errText = (r: any) => String(T.authErr[r?.reason] || T.authErr.network).replace('{m}', String(r?.minutes ?? 15)).replace('{s}', String(r?.seconds ?? 60));
  const val = (f: HTMLFormElement, n: string) => ((f.elements.namedItem(n) as HTMLInputElement | null)?.value || '').trim();
  const otpOf = (f: HTMLFormElement) => [...f.querySelectorAll<HTMLInputElement>('[data-otp] input')].map((i) => i.value).join('');
  async function busyAuth(f: HTMLFormElement, fn: () => Promise<void>) {
    const btn = f.querySelector<HTMLButtonElement>('button[type=submit]')!;
    if (btn.disabled) return;
    const label = btn.textContent; btn.disabled = true; btn.classList.add('is-busy');
    try { await fn(); } finally { btn.disabled = false; btn.classList.remove('is-busy'); btn.textContent = label; }
  }
  function enter(k: string) {
    token = k; store.set(KEY, k);
    root.querySelectorAll<HTMLInputElement>('.ac-auth input').forEach((i) => { i.value = ''; });
    load();
  }
  let cool = 0, coolTimer = 0;
  function cooldown(sec = 60) {
    cool = sec; clearInterval(coolTimer);
    const paint = () => root.querySelectorAll<HTMLButtonElement>('[data-resend]').forEach((x) => { x.disabled = cool > 0; x.textContent = cool > 0 ? String(T.authResendIn).replace('{s}', String(cool)) : T.authResend; });
    paint();
    coolTimer = window.setInterval(() => { cool -= 1; paint(); if (cool <= 0) clearInterval(coolTimer); }, 1000);
  }
  // OTP boxes: type, paste, backspace
  root.querySelectorAll<HTMLElement>('[data-otp]').forEach((box) => {
    const inputs = [...box.querySelectorAll<HTMLInputElement>('input')];
    inputs.forEach((inp, i) => {
      inp.addEventListener('input', () => {
        const d = inp.value.replace(/\D/g, '');
        if (d.length > 1) { d.slice(0, 6 - i).split('').forEach((c, j) => { inputs[i + j].value = c; }); inputs[Math.min(5, i + d.length - 1)].focus(); }
        else { inp.value = d; if (d && i < 5) inputs[i + 1].focus(); }
        if (inputs.every((x) => x.value)) box.closest('form')!.requestSubmit();
      });
      inp.addEventListener('keydown', (e) => { if (e.key === 'Backspace' && !inp.value && i > 0) { inputs[i - 1].focus(); inputs[i - 1].value = ''; } });
      inp.addEventListener('focus', () => inp.select());
    });
  });
  // Password strength
  root.querySelectorAll<HTMLInputElement>('[data-meter]').forEach((inp) => {
    const field = inp.closest('.ac-field')!;
    inp.addEventListener('input', () => {
      const v = inp.value;
      let n = 0;
      if (v.length >= 8) n++;
      if (/[A-Za-z؀-ۿ]/.test(v) && /\d/.test(v)) n++;
      if (v.length >= 12) n++;
      if (/[^A-Za-z0-9؀-ۿ]/.test(v) || (/[a-z]/.test(v) && /[A-Z]/.test(v))) n++;
      if (!PW_OK.test(v)) n = Math.min(n, 1);
      field.setAttribute('data-score', v ? String(n) : '');
      field.querySelector<HTMLElement>('[data-meter-label]')!.textContent = v ? T.authStrength[Math.max(0, n - 1)] + (PW_OK.test(v) ? '' : ' · ' + T.authPwHint) : T.authPwHint;
    });
  });
  root.addEventListener('click', (e) => {
    const t = e.target as Element;
    const eyeBtn = t.closest<HTMLButtonElement>('[data-eye]');
    if (eyeBtn) { const i = eyeBtn.parentElement!.querySelector('input')!; i.type = i.type === 'password' ? 'text' : 'password'; eyeBtn.classList.toggle('is-on', i.type === 'text'); return; }
    const go = t.closest<HTMLElement>('[data-auth], [data-go]');
    if (go && root.dataset.state === 'signin') { const name = go.dataset.auth || go.dataset.go!; const f = go.closest('form'); const em = f ? val(f as HTMLFormElement, 'email') : ''; if (em) authEmail = em; step(name); return; }
    const rs = t.closest<HTMLButtonElement>('[data-resend]');
    if (rs) {
      (async () => {
        rs.disabled = true;
        const r = await auth('resend', { email: authEmail, purpose: rs.dataset.resend! });
        if (r?.success) { authMsg(T.authCodeSent, true); cooldown(60); } else { authMsg(errText(r)); cooldown(r?.seconds || 5); }
      })();
    }
  });
  root.querySelectorAll<HTMLFormElement>('[data-step]').forEach((f) => f.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = f.dataset.step!;
    busyAuth(f, async () => {
      authMsg('');
      if (name === 'login') {
        const email = val(f, 'email'); const password = (f.elements.namedItem('password') as HTMLInputElement).value;
        if (!/^\S+@\S+\.\S+$/.test(email)) { authMsg(T.authErr.email); return; }
        if (!password) { authMsg(T.authErr.invalid); return; }
        const r = await auth('login', { email, password });
        if (r?.success && r.k) { enter(r.k); return; }
        if (r?.reason === 'unverified') { authEmail = email; step('verify'); authMsg(T.authErr.unverified, true); cooldown(60); return; }
        authMsg(errText(r));
      } else if (name === 'signup') {
        const email = val(f, 'email'), nm = val(f, 'name'); const pw = (f.elements.namedItem('password') as HTMLInputElement).value, pw2 = (f.elements.namedItem('password2') as HTMLInputElement).value;
        if (nm.length < 2) { authMsg(T.authErr.name); return; }
        if (!/^\S+@\S+\.\S+$/.test(email)) { authMsg(T.authErr.email); return; }
        if (!PW_OK.test(pw)) { authMsg(T.authErr.weak); return; }
        if (pw !== pw2) { authMsg(T.authErr.mismatch); return; }
        const r = await auth('signup', { email, name: nm, phone: val(f, 'phone'), company: val(f, 'company'), password: pw });
        if (r?.success) { authEmail = email; step('verify'); authMsg(T.authCodeSent, true); cooldown(60); return; }
        authMsg(errText(r));
      } else if (name === 'verify') {
        const code = otpOf(f);
        if (code.length !== 6) { authMsg(T.authErr.code); return; }
        const r = await auth('verify', { email: authEmail, code });
        if (r?.success && r.k) { enter(r.k); return; }
        f.querySelectorAll<HTMLInputElement>('[data-otp] input').forEach((i) => { i.value = ''; });
        f.querySelector<HTMLInputElement>('[data-otp] input')!.focus();
        authMsg(errText(r));
      } else if (name === 'forgot') {
        const email = val(f, 'email');
        if (!/^\S+@\S+\.\S+$/.test(email)) { authMsg(T.authErr.email); return; }
        const r = await auth('forgot', { email });
        if (r?.success) { authEmail = email; step('reset'); authMsg(T.authCodeSent, true); cooldown(60); return; }
        authMsg(errText(r));
      } else if (name === 'reset') {
        const code = otpOf(f); const pw = (f.elements.namedItem('password') as HTMLInputElement).value, pw2 = (f.elements.namedItem('password2') as HTMLInputElement).value;
        if (code.length !== 6) { authMsg(T.authErr.code); return; }
        if (!PW_OK.test(pw)) { authMsg(T.authErr.weak); return; }
        if (pw !== pw2) { authMsg(T.authErr.mismatch); return; }
        const r = await auth('reset', { email: authEmail, code, password: pw });
        if (r?.success && r.k) { enter(r.k); return; }
        authMsg(errText(r));
      }
    });
  }));
  if (location.hash === '#signup') step('signup');

  async function api(action: string, data: Record<string, unknown> = {}): Promise<any> {
    const res = await fetch(cfg.apiEndpoint, { method: 'POST', body: new URLSearchParams({ k: token, action, data: JSON.stringify(data) }) });
    const json = await res.json().catch(() => ({ success: false }));
    if (json?.reason === 'session') { signOut(T.expired); throw new Error('session'); }
    return json;
  }
  function signOut(message = '') {
    if (token && !message) auth('logout', { k: token });
    store.del(KEY); token = ''; me = null;
    show('signin'); step('login');
    if (message) authMsg(message);
  }
  $('#ac-signout').addEventListener('click', () => signOut());

  // ---- Data ----
  let view: View | null = null;
  let siteId = Number(store.get(SITE_KEY)) || 0;
  const SECS = ['home', 'billing', 'profile'];
  const hash0 = location.hash.slice(1);
  let sec = SECS.includes(hash0) ? hash0 : hash0 && hash0 !== 'signup' ? 'site' : 'home';
  let tab = sec === 'site' ? hash0 : 'overview';
  let me: any = null;
  const site = () => view?.sites.find((s) => s.order_id === siteId) ?? view?.sites[0];
  const subsOf = (id: number) => (view?.subs ?? []).filter((s) => s.order_id === id);
  const has = (product: string) => subsOf(site()!.order_id).some((s) => s.product === product && (s.status === 'active' || s.status === 'cancelling'));
  const isLive = (s: Site) => s.status === 'paid' || s.status === 'published';

  async function load() {
    if (!token) { show('signin'); return; }
    show('loading');
    try {
      const [v, m] = await Promise.all([api('load'), auth('me', { k: token })]);
      if (!v?.success) throw new Error('load');
      view = v as View;
      me = m?.success ? m : { email: v.email, name: '' };
      if (view.sites.length && !view.sites.some((s) => s.order_id === siteId)) siteId = view.sites[0].order_id;
      $<HTMLElement>('#ac-email').textContent = view.email;
      paintMe();
      const sel = $<HTMLSelectElement>('#ac-site');
      sel.replaceChildren(...view.sites.map((s) => new Option(`${s.name || '#' + s.order_id}${s.external ? ' · ' + T.extBadge : ''}`, String(s.order_id), false, s.order_id === siteId)));
      sel.hidden = view.sites.length < 2;
      show('app');
      draw();
      if (justPaid) { flash(T.paidNote); }
      if (socialBack) flash(socialBack === 'connected' ? T.socConnectedOk : T.socConnectErr);
    } catch (e) {
      if ((e as Error).message !== 'session') { show('signin'); flash(''); const s = $<HTMLElement>('#ac-login-status'); s.textContent = T.failed; s.className = 'ac-status is-error'; s.hidden = false; }
    }
  }
  $<HTMLSelectElement>('#ac-site').addEventListener('change', (e) => { siteId = Number((e.target as HTMLSelectElement).value); store.set(SITE_KEY, String(siteId)); draw(); });

  function flash(text: string) {
    const f = $<HTMLElement>('#ac-flash');
    f.textContent = text; f.hidden = !text;
  }

  // ---- Tabs ----
  const tabs = () => {
    const list = ['overview', 'addons'];
    const social = has('social') || has('socialpro') || has('ads');
    if (site()?.external) { if (has('seo') || has('seogrowth')) list.push('seo'); if (social) list.push('social'); return list; }
    if (has('booking')) list.push('bookings');
    list.push('menu');
    if (has('reviews')) list.push('reviews');
    if (has('chat')) list.push('chat');
    if (has('content')) list.push('content');
    if (has('tickets')) list.push('tickets');
    if (has('seo') || has('seogrowth')) list.push('seo');
    if (social) list.push('social');
    return list;
  };
  function drawSite() {
    const panel0 = $<HTMLElement>('#ac-panel');
    if (!view?.sites.length) {
      $<HTMLElement>('#ac-tabs').innerHTML = '';
      panel0.innerHTML = emptyState();
      return;
    }
    const list = tabs();
    if (!list.includes(tab)) tab = 'overview';
    $<HTMLElement>('#ac-tabs').innerHTML = list.map((t) => `<button type="button" role="tab" data-tab="${t}" aria-selected="${t === tab}">${esc(T.tabs[t] || (t === 'seo' ? T.seoTitle : t === 'social' ? T.socTitle : t))}</button>`).join('');
    const panel = $<HTMLElement>('#ac-panel');
    const s = site()!;
    panel.innerHTML = ({ overview, addons, bookings, menu, reviews, chat, content, tickets, seo, social } as Record<string, (s: Site) => string>)[tab](s);
    bind[tab]?.(s);
  }
  $('#ac-tabs').addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-tab]');
    if (!b) return;
    tab = b.dataset.tab!;
    history.replaceState(null, '', '#' + tab);
    window.scrollTo({ top: 0 });
    flash('');
    draw();
  });

  // ---- Dashboard sections: home, websites (tabs), billing, profile ----
  function draw() {
    root.querySelectorAll<HTMLButtonElement>('#ac-nav [data-sec]').forEach((b) => b.setAttribute('aria-current', b.dataset.sec === sec ? 'page' : 'false'));
    root.querySelectorAll<HTMLElement>('[data-sec-panel]').forEach((p) => { p.hidden = p.dataset.secPanel !== sec; });
    $<HTMLSelectElement>('#ac-site').hidden = sec !== 'site' || (view?.sites.length ?? 0) < 2;
    const first = String(me?.name || '').split(/\s+/)[0];
    $<HTMLElement>('#ac-title').textContent = sec === 'home' ? (first ? String(T.dashHello).replace('{name}', first) : T.dashHelloNoName) : sec === 'site' ? T.navSites : sec === 'billing' ? T.navBilling : T.navProfile;
    $<HTMLElement>('#ac-sub').textContent = sec === 'home' ? T.dashSub : '';
    if (sec === 'site') drawSite();
    else if (sec === 'home') $<HTMLElement>('#ac-home').innerHTML = homeHtml();
    else if (sec === 'billing') $<HTMLElement>('#ac-billing').innerHTML = billingAllHtml();
    else $<HTMLElement>('#ac-profile').innerHTML = profileHtml();
  }
  function goTo(next: string, nextTab = '', order = 0) {
    sec = next;
    if (order && view?.sites.some((x) => x.order_id === order)) { siteId = order; store.set(SITE_KEY, String(order)); const sel = $<HTMLSelectElement>('#ac-site'); sel.value = String(order); }
    if (nextTab) tab = nextTab;
    history.replaceState(null, '', '#' + (sec === 'site' ? tab : sec));
    flash('');
    draw();
    window.scrollTo({ top: 0 });
  }
  root.addEventListener('click', (e) => {
    const t = e.target as Element;
    const n = t.closest<HTMLButtonElement>('#ac-nav [data-sec]');
    if (n) { goTo(n.dataset.sec!, n.dataset.sec === 'site' ? (tab || 'overview') : ''); return; }
    const g = t.closest<HTMLElement>('[data-goto]');
    if (g) { const [x, y, z] = g.dataset.goto!.split(':'); goTo(x, y || 'overview', Number(z) || 0); }
  });
  function paintMe() {
    const nm = String(me?.name || '') || String(view?.email || '').split('@')[0];
    $<HTMLElement>('#ac-name').textContent = nm;
    const parts = nm.trim().split(/\s+/).filter(Boolean);
    $<HTMLElement>('#ac-avatar').textContent = (/^[A-Za-z]/.test(parts[0] || '') ? (parts[0][0] + (parts[1]?.[0] || '')) : (parts[0]?.[0] || '·')).toUpperCase();
  }
  const dateLocale = cfg.lang === 'ar' ? 'ar-SA-u-nu-latn-ca-gregory' : cfg.numberLocale;
  const niceDate = (d: string) => (d && d < '2070' ? new Date(d.length === 10 ? d + 'T12:00:00' : d).toLocaleDateString(dateLocale, { day: 'numeric', month: 'short', year: 'numeric' }) : '—');
  const activeSubs = () => (view?.subs ?? []).filter((x) => x.status === 'active' || x.status === 'cancelling');
  const unpaid = () => (view?.subs ?? []).filter((x) => x.invoice_url && !['active', 'cancelling', 'cancelled'].includes(x.status));
  const siteLabel = (id: number) => { const x = view?.sites.find((y) => y.order_id === id); return x ? x.name || x.domain || '#' + id : '#' + id; };
  const TAB_OF: Record<string, string> = { seo: 'seo', seogrowth: 'seo', social: 'social', socialpro: 'social', ads: 'social', booking: 'bookings', menu: 'menu', reviews: 'reviews', chat: 'chat', content: 'content', tickets: 'tickets' };
  const svgIc = (path: string) => `<svg viewBox="0 0 24 24" aria-hidden="true">${path}</svg>`;
  const GEN_IC = '<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 8h18"/>';
  const priceOf = (x: Sub) => (x.price ? money(x.price) + (x.period === 'month' ? ' ' + cfg.addons.perMonth : x.period === 'year' ? ' ' + (cfg.perYear || '') : '') : cfg.addons.free);
  function homeHtml() {
    const subs = activeSubs();
    const monthly = subs.filter((x) => x.period === 'month').reduce((n, x) => n + (Number(x.price) || 0), 0);
    const next = subs.filter((x) => x.price && x.next_due && x.next_due < '2070').map((x) => x.next_due).sort()[0] || '';
    const sites = view?.sites ?? [];
    const kpi = (icon: string, value: string, label: string) => `<div class="ac-kpi"><span class="ac-kpi-ic">${svgIc(icon)}</span><b>${value}</b><small>${esc(label)}</small></div>`;
    const kpis = `<div class="ac-kpis">${kpi('<path d="M4 12l5 5L20 6"/>', fmt.format(subs.length), T.kpiServices)}${kpi('<path d="M12 3v18M17 7H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>', monthly ? esc(money(monthly)) : '—', T.kpiMonthly)}${kpi('<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>', esc(niceDate(next)), T.kpiNext)}${kpi(GEN_IC, fmt.format(sites.length), T.kpiSites)}</div>`;
    const due = unpaid();
    const alert = due.length ? card(`<h2>${esc(T.needsPay)}</h2><ul class="ac-due">${due.map((x) => `<li><span><b>${esc(productName(x.product))}</b> <small class="ac-muted">${esc(siteLabel(x.order_id))}</small></span><span>${esc(priceOf(x))}</span><a class="btn btn-amber ac-small-btn" href="${esc(x.invoice_url)}">${esc(T.payNow)}</a></li>`).join('')}</ul>`, 'ac-alert') : '';
    if (!sites.length) return kpis + emptyState();
    const svc = subs.length ? `<div class="ac-svc">${subs.map((x) => `<article class="ac-svc-item">
        <span class="ac-svc-ic">${svgIc(cfg.icons[x.product] || GEN_IC)}</span>
        <div class="ac-svc-txt"><b>${esc(productName(x.product))}</b><small>${esc(siteLabel(x.order_id))} · ${esc(priceOf(x))}</small></div>
        <div class="ac-svc-meta"><span class="ac-chip st-${esc(x.status)}">${esc(T.state[x.status] || x.status)}</span>${x.next_due && x.next_due < '2070' ? `<small class="ac-muted">${esc(T.dueOn)} ${esc(niceDate(x.next_due))}</small>` : ''}</div>
        <button type="button" class="btn btn-ghost ac-small-btn" data-goto="site:${TAB_OF[x.product] || 'overview'}:${x.order_id}">${esc(T.manage)}</button>
      </article>`).join('')}</div>` : `<div class="ac-empty-svc"><p class="ac-muted">${esc(T.noServices)}</p><p><button type="button" class="btn btn-amber" data-goto="site:addons">${esc(T.browseAddons)}</button></p></div>`;
    const quick = [
      [`a href="${esc(cfg.builderUrl)}"`, '<path d="M12 5v14M5 12h14"/>', T.qBuild],
      ['button type="button" data-goto="site:addons"', '<path d="M4 7h16M4 12h16M4 17h10"/>', T.qAddon],
      ['button type="button" data-goto="site:overview"', '<path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/>', T.qExternal],
      [`a href="${esc(cfg.contactUrl)}"`, '<path d="M4 13v-1a8 8 0 0 1 16 0v1"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/>', T.qSupport],
    ].map(([tag, icon, label]) => `<${tag} class="ac-quick">${svgIc(icon)}<span>${esc(label)}</span></${tag.split(' ')[0]}>`).join('');
    const siteList = sites.map((x) => `<li><div><b>${esc(x.name || x.domain || '#' + x.order_id)}</b>${x.url ? `<a href="${esc(x.url)}" target="_blank" rel="noopener" dir="ltr">${esc(x.url.replace(/^https?:\/\//, '').replace(/\/$/, ''))}</a>` : ''}</div><button type="button" class="ac-link" data-goto="site:overview:${x.order_id}">${esc(T.manage)}</button></li>`).join('');
    return kpis + alert + `<div class="ac-dash">
      <section class="ac-card ac-dash-main"><div class="ac-card-head"><h2>${esc(T.myServices)}</h2>${subs.length ? `<button type="button" class="ac-link" data-goto="site:addons">${esc(T.browseAddons)} →</button>` : ''}</div>${svc}</section>
      <div class="ac-dash-side">
        ${card(`<h2>${esc(T.quickTitle)}</h2><div class="ac-quicks">${quick}</div>`)}
        ${card(`<h2>${esc(T.mySites)}</h2><ul class="ac-sites">${siteList}</ul>`)}
      </div></div>`;
  }
  function billingAllHtml() {
    const subs = [...(view?.subs ?? [])].sort((x, y) => String(x.next_due || '9').localeCompare(String(y.next_due || '9')));
    if (!subs.length) return card(`<p class="ac-muted">${esc(T.noBilling)}</p><p><button type="button" class="btn btn-amber" data-goto="site:addons">${esc(T.browseAddons)}</button></p>`);
    return card(`<h2>${esc(T.billingAllTitle)}</h2><div class="ac-table-wrap"><table class="ac-table"><thead><tr><th>${esc(T.product)}</th><th>${esc(T.siteCol)}</th><th></th><th>${esc(T.nextDue)}</th><th>${esc(T.price)}</th><th></th></tr></thead><tbody>${subs.map((x) => `<tr>
      <td><b>${esc(productName(x.product))}</b></td><td>${esc(siteLabel(x.order_id))}</td>
      <td><span class="ac-chip st-${esc(x.status)}">${esc(T.state[x.status] || x.status)}</span></td>
      <td>${esc(niceDate(x.next_due))}</td><td>${esc(priceOf(x))}</td>
      <td class="ac-actions">${x.invoice_url && !['active', 'cancelling'].includes(x.status) ? `<a class="btn btn-amber ac-small-btn" href="${esc(x.invoice_url)}">${esc(T.payNow)}</a>` : `<button type="button" class="ac-link" data-goto="site:overview:${x.order_id}">${esc(T.manage)}</button>`}</td>
    </tr>`).join('')}</tbody></table></div><p class="ac-muted ac-small">${esc(T.vat)}</p>`);
  }
  function profileHtml() {
    const m = me || {};
    const info = card(`<h2>${esc(T.secTitle)}</h2><dl class="ac-dl"><div><dt>${esc(T.email)}</dt><dd dir="ltr">${esc(view?.email || '')}</dd></div>${m.since ? `<div><dt>${esc(T.memberSince)}</dt><dd>${esc(niceDate(m.since))}</dd></div>` : ''}${m.last_login ? `<div><dt>${esc(T.lastLogin)}</dt><dd>${esc(niceDate(m.last_login))}</dd></div>` : ''}</dl><p><button type="button" class="btn btn-ghost ac-small-btn" data-signout>${esc(T.signOutBtn)}</button></p>`);
    if (!m.has_password) return card(`<p class="ac-note">${esc(T.profNoPw)}</p>`) + info;
    return `<div class="ac-prof">${card(`<h2>${esc(T.profTitle)}</h2><form id="ac-prof-form" class="ac-form-grid">
        <label class="ac-field ac-wide">${esc(T.authName)}<input name="name" required maxlength="80" value="${esc(m.name || '')}" dir="auto" autocomplete="name"></label>
        <label class="ac-field">${esc(T.authPhone)}<input name="phone" type="tel" dir="ltr" maxlength="20" value="${esc(m.phone || '')}" autocomplete="tel"></label>
        <label class="ac-field">${esc(T.authCompany)}<input name="company" maxlength="120" value="${esc(m.company || '')}" dir="auto"></label>
        <div class="ac-wide"><button type="submit" class="btn btn-navy">${esc(T.profSave)}</button></div></form>`)}
      ${card(`<h2>${esc(T.pwTitle)}</h2><form id="ac-pw-form" class="ac-form-grid">
        <label class="ac-field ac-wide">${esc(T.pwCurrent)}<input name="current" type="password" dir="ltr" required maxlength="128" autocomplete="current-password"></label>
        <label class="ac-field">${esc(T.authNewPassword)}<input name="password" type="password" dir="ltr" required maxlength="128" autocomplete="new-password"></label>
        <label class="ac-field">${esc(T.authPassword2)}<input name="password2" type="password" dir="ltr" required maxlength="128" autocomplete="new-password"></label>
        <p class="ac-muted ac-small ac-wide">${esc(T.authPwHint)}</p>
        <div class="ac-wide"><button type="submit" class="btn btn-navy">${esc(T.pwSave)}</button></div></form>`)}</div>` + info;
  }
  $<HTMLElement>('#ac-profile').addEventListener('click', (e) => { if ((e.target as Element).closest('[data-signout]')) signOut(); });
  $<HTMLElement>('#ac-profile').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const btn = f.querySelector<HTMLButtonElement>('button[type=submit]')!;
    await busy(btn, async () => {
      if (f.id === 'ac-prof-form') {
        const data = { name: val(f, 'name'), phone: val(f, 'phone'), company: val(f, 'company') };
        if (data.name.length < 2) { flash(T.authErr.name); return; }
        const r = await auth('profile', { k: token, ...data });
        if (r?.reason === 'session') { signOut(T.expired); return; }
        if (r?.success) { me = { ...me, ...data }; paintMe(); draw(); flash(T.profSaved); } else flash(errText(r));
      } else if (f.id === 'ac-pw-form') {
        const cur = (f.elements.namedItem('current') as HTMLInputElement).value, pw = (f.elements.namedItem('password') as HTMLInputElement).value, pw2 = (f.elements.namedItem('password2') as HTMLInputElement).value;
        if (!PW_OK.test(pw)) { flash(T.authErr.weak); return; }
        if (pw !== pw2) { flash(T.authErr.mismatch); return; }
        const r = await auth('password', { k: token, current: cur, password: pw });
        if (r?.reason === 'session') { signOut(T.expired); return; }
        if (r?.success) { f.reset(); flash(T.pwChanged); } else flash(r?.reason === 'invalid' ? T.authErr.invalid : errText(r));
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

  const productName = (p: string) => T.products[p] || cfg.addons.items[p]?.name || p;
  const money = (n: number) => `${fmt.format(n)} ${cfg.sar}`;
  const card = (inner: string, cls = '') => `<section class="ac-card ${cls}">${inner}</section>`;
  const busy = async (btn: HTMLButtonElement, fn: () => Promise<void>) => {
    const label = btn.textContent;
    btn.disabled = true; btn.textContent = T.saving;
    try { await fn(); } finally { btn.disabled = false; btn.textContent = label; }
  };
  async function save(action: string, data: Record<string, unknown>, btn?: HTMLButtonElement) {
    const run = async () => {
      const r = await api(action, data);
      if (!r?.success) { flash(T.failed); return; }
      flash(T.saved);
      await reload();
    };
    if (btn) await busy(btn, run); else await run();
  }
  async function reload() {
    const v = await api('load');
    if (v?.success) { view = v; draw(); }
  }

  // ---- No website yet / websites hosted elsewhere ----
  const addSiteForm = () => `<form id="ac-ext-add" class="ac-ext-form">
      <label class="ac-field">${esc(T.extDomain)}<input name="domain" required maxlength="200" dir="ltr" placeholder="${esc(T.extDomainPh)}" inputmode="url"></label>
      <label class="ac-field">${esc(T.extName)}<input name="name" maxlength="120" dir="auto"></label>
      <button type="submit" class="btn btn-navy">${esc(T.extAdd)}</button></form>`;
  function emptyState() {
    return `<div class="ac-intro"><h2>${esc(T.emptyTitle)}</h2><p class="ac-muted">${esc(T.emptyBody)}</p></div>
      <div class="ac-empty">
        ${card(`<h2>${esc(T.newSiteTitle)}</h2><p class="ac-muted">${esc(T.newSiteBody)}</p><p><a class="btn btn-amber" href="${esc(cfg.builderUrl)}">${esc(T.newSiteCta)}</a></p>`)}
        ${card(`<h2>${esc(T.extTitle)}</h2><p class="ac-muted">${esc(T.extBody)}</p>${addSiteForm()}`)}
      </div>`;
  }
  const extCheck: Record<number, { email?: string; txt?: string; tried?: boolean }> = {};
  async function checkExternal(s: Site, btn?: HTMLButtonElement) {
    const run = async () => {
      const res = await fetch(cfg.extEndpoint, { method: 'POST', body: new URLSearchParams({ k: token, action: 'check', order_id: String(s.order_id) }) });
      const r = await res.json().catch(() => ({}));
      if (r?.reason === 'expired') { signOut(T.expired); return; }
      extCheck[s.order_id] = { email: r?.email, txt: r?.txt, tried: true };
      if (r?.verified) { flash(T.extVerified); await reload(); return; }
      if (btn) flash(T.extNotYet);
      draw();
    };
    if (btn) await busy(btn, run); else await run();
  }
  function externalOverview(s: Site) {
    const c = extCheck[s.order_id] || {};
    const verify = s.verified ? card(`<p class="ac-ok">${esc(T.extVerified)}</p>`) : card(`<h2>${esc(T.extVerifyTitle)}</h2><p class="ac-muted">${esc(T.extVerifyBody)}</p>
      <div class="ac-ext-opts">
        <div><h3 class="ac-h3">${esc(T.extOpt1Title)}</h3><p>${esc(T.extOpt1)}</p><p class="ac-mono" dir="ltr">${esc(c.email || cfg.gscEmail)}</p></div>
        <div><h3 class="ac-h3">${esc(T.extOpt2Title)}</h3><p>${esc(T.extOpt2)}</p><p class="ac-mono" dir="ltr">${c.txt ? esc(c.txt) : '…'}</p></div>
      </div>
      <p class="ac-row"><button type="button" class="btn btn-amber" data-ext-check>${esc(T.extCheck)}</button><a class="ac-link" href="${esc(cfg.helpUrl)}">${esc(T.extHelp)} →</a></p>`);
    if (!s.verified && !c.tried) setTimeout(() => checkExternal(s), 0);
    return card(`<div class="ac-site"><div><p class="ac-kicker">${esc(T.extBadge)}</p><h2>${esc(s.name || s.domain)}</h2>
        <p><a href="${esc(s.url)}" target="_blank" rel="noopener" dir="ltr" class="ac-url">${esc(s.domain)}</a></p></div>
        <a class="btn btn-navy" href="${esc(s.url)}" target="_blank" rel="noopener">${esc(T.visit)}</a></div>`)
      + verify + billingCard(s)
      + card(`<p class="ac-muted">${esc(T.extUpsell)}</p><p><a class="ac-link" href="${esc(cfg.builderUrl)}">${esc(T.newSiteCta)} →</a></p>`, 'ac-soft')
      + card(`<h2>${esc(T.extAddMore)}</h2>${addSiteForm()}`);
  }

  function billingCard(s: Site) {
    const subs = subsOf(s.order_id);
    const rows = subs.length ? subs.map((x) => `<tr>
      <td>${esc(productName(x.product))}</td>
      <td><span class="ac-chip st-${esc(x.status)}">${esc(T.state[x.status] || x.status)}</span></td>
