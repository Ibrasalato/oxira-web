    if (ok) change((s) => ({ ...s, extras: { ...s.extras, mapUrl: v } }));
  });
  $<HTMLFormElement>('#st-add-review').addEventListener('submit', (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const d = Object.fromEntries(new FormData(f)) as Record<string, string>;
    if (!d.quote?.trim() || !d.name?.trim()) return;
    change((s) => ({
      ...s,
      sections: withSection(s, 'testimonials'),
      testimonials: { ...s.testimonials, items: [...s.testimonials.items, { quote: d.quote.trim(), name: d.name.trim(), role: (d.role || '').trim() }].slice(0, 6) },
    }));
    f.reset();
  });
  $<HTMLFormElement>('#st-add-faq').addEventListener('submit', (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const d = Object.fromEntries(new FormData(f)) as Record<string, string>;
    if (!d.q?.trim() || !d.a?.trim()) return;
    change((s) => ({ ...s, sections: withSection(s, 'faq'), faq: { ...s.faq, items: [...s.faq.items, { q: d.q.trim(), a: d.a.trim() }].slice(0, 8) } }));
    f.reset();
  });

  // ---- Share a preview link ----
  const shareBtn = $<HTMLButtonElement>('[data-share]');
  const shareBox = $<HTMLElement>('#st-share');
  const shareUrl = $<HTMLInputElement>('#st-share-url');
  const shareMsg = $<HTMLElement>('#st-share-msg');
  shareBtn.addEventListener('click', async () => {
    if (!state.spec) return;
    const label = shareBtn.querySelector('span')!;
    shareBtn.disabled = true; label.textContent = T.sharing;
    try {
      const res = await fetch(cfg.shareEndpoint, { method: 'POST', body: new URLSearchParams({ spec: JSON.stringify(state.spec), draftId: state.draftId || '' }) });
      const data = await res.json().catch(() => ({}));
      if (!data?.success || typeof data.url !== 'string') throw new Error('share');
      state.draftId = data.draftId; save();
      shareUrl.value = data.url;
      $<HTMLAnchorElement>('#st-share-open').href = data.url;
      shareMsg.textContent = T.shareReady;
      shareBox.querySelector<HTMLElement>('.st-share-row')!.hidden = false;
    } catch {
      shareMsg.textContent = T.shareFailed;
      shareBox.querySelector<HTMLElement>('.st-share-row')!.hidden = true;
    } finally {
      shareBox.hidden = false;
      shareBtn.disabled = false; label.textContent = T.share;
    }
  });
  $('[data-copy]').addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    try { await navigator.clipboard.writeText(shareUrl.value); } catch { shareUrl.select(); document.execCommand('copy'); }
    b.textContent = T.copied;
    setTimeout(() => { b.textContent = T.copy; }, 1800);
  });

  // 4. Order
  const order = $<HTMLFormElement>('#st-order');
  const fmt = new Intl.NumberFormat(cfg.numberLocale, { maximumFractionDigits: 0 });
  const plan = () => ($<HTMLInputElement>('input[name="plan"]:checked')?.value ?? 'pro') as keyof typeof cfg.plans;
  const domainOpt = () => $<HTMLInputElement>('input[name="domainOption"]:checked')?.value ?? 'new';
  const extraDomain = () => domainOpt() === 'new' && !cfg.plans[plan()].domainIncluded;
  const chosen = () => [`plan:${plan()}`, ...(extraDomain() ? ['domain'] : [])];
  const fmt2 = new Intl.NumberFormat(cfg.numberLocale, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  function updateTotal() {
    const total = cfg.plans[plan()].price + (extraDomain() ? cfg.domainPrice : 0);
    $<HTMLElement>('#st-total').textContent = fmt.format(total);
    $<HTMLElement>('#st-total-vat').textContent = fmt2.format(Math.round(total * 115) / 100);
    return total;
  }
  const wantedPlan = params.get('plan');
  if (wantedPlan && wantedPlan in cfg.plans) $<HTMLInputElement>(`input[name="plan"][value="${wantedPlan}"]`).checked = true;
  const domainName = $<HTMLElement>('[data-domain-name]');
  order.addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.name === 'domainOption') {
      domainName.hidden = el.value === 'none';
    }
    updateTotal();
  });
  // Prefill contact from the basics (only empty fields).
  function prefillOrder() {
    for (const k of ['phone', 'email'] as const) {
      const el = order.elements.namedItem(k) as HTMLInputElement;
      if (!el.value && state.basics[k]) el.value = state.basics[k];
    }
  }

  const status = $<HTMLElement>('#st-order-status');
  order.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(order)) as Record<string, string>;
    if (!d.name?.trim() || (d.phone || '').replace(/\D/g, '').length < 7) {
      status.hidden = false; status.className = 'st-status is-error'; status.textContent = T.required;
      return;
    }
    const btn = $<HTMLButtonElement>('.st-submit');
    btn.disabled = true; btn.textContent = T.submitting;
    status.hidden = true;
    try {
      const res = await fetch(cfg.orderEndpoint, {
        method: 'POST',
        body: new URLSearchParams({
          name: d.name, phone: d.phone, email: d.email || '', notes: d.notes || '',
          clientType: state.basics.kind || '', template: state.spec!.template, siteName: state.spec!.name, siteLang: state.spec!.lang,
          domainOption: d.domainOption, domainName: d.domainOption === 'none' ? '' : d.domainName || '',
          addons: chosen().join(','), total: String(updateTotal()), spec: JSON.stringify(state.spec),
          lang: cfg.lang, page: location.pathname, company_website: d.company_website || '',
          ref: (() => { try { const r = JSON.parse(localStorage.getItem('oxira-ref') || 'null'); return r && Date.now() - r.t < 90 * 864e5 ? r.c : ''; } catch { return ''; } })(),
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!data?.success) throw new Error('order failed');
      try { localStorage.setItem(`${KEY}-last`, JSON.stringify(state.spec)); localStorage.removeItem(KEY); } catch { /* ignore */ }
      btn.textContent = T.redirecting;
      const paying = await checkout(data.orderId);
      if (!paying) showDone('ordered', data.orderId);
      return;
    } catch {
      status.hidden = false; status.className = 'st-status is-error';
      status.replaceChildren(document.createTextNode(`${T.failed} `), Object.assign(document.createElement('a'), { href: cfg.whatsapp, textContent: 'WhatsApp', target: '_blank', rel: 'noopener' }));
    } finally {
      btn.disabled = false; btn.textContent = T.submit;
    }
  });

  // ---- Payment (Moyasar) ----
  /** Ask n8n for a Moyasar payment page; returns true when the browser is being sent there. */
  async function checkout(orderId: number | string) {
    try {
      const res = await fetch(cfg.checkoutEndpoint, {
        method: 'POST',
        body: new URLSearchParams({ orderId: String(orderId), returnUrl: location.origin + location.pathname }),
      });
      const data = await res.json().catch(() => ({}));
      if (data?.success && typeof data.payUrl === 'string' && data.payUrl.startsWith('https://')) {
        location.href = data.payUrl;
        return true;
      }
    } catch { /* fall back to a payment link from the team */ }
    return false;
  }

  const done = $<HTMLElement>('#st-done');
  const payNow = $<HTMLButtonElement>('#st-pay-now');
  let doneOrder = '';
  function showDone(kind: 'ordered' | 'paid' | 'confirming' | 'cancelled', id: number | string) {
    const n = `#${id}`;
    doneOrder = String(id);
    const copy = {
      ordered: [T.doneTitle, T.doneBody],
      paid: [T.paidTitle, T.paidBody],
      confirming: [T.confirming, T.confirmingBody],
      cancelled: [T.cancelTitle, T.cancelBody],
    }[kind];
    done.dataset.state = kind;
    $<HTMLElement>('#st-done-title').textContent = copy[0];
    $<HTMLElement>('#st-done-body').textContent = copy[1].replace('{id}', n);
    payNow.hidden = kind !== 'cancelled';
    if (!state.spec) {
      try {
        const last = JSON.parse(localStorage.getItem(`${KEY}-last`) || 'null');
        if (last) state.spec = mergeSpec(sampleSpec(last.template ?? 'corporate', last.lang ?? cfg.lang), last);
      } catch { /* ignore */ }
    }
    render();
    root.dataset.step = '5';
    window.scrollTo({ top: 0 });
  }
  payNow.addEventListener('click', async () => {
    payNow.disabled = true;
    payNow.textContent = T.redirecting;
    if (!(await checkout(doneOrder))) { payNow.disabled = false; payNow.textContent = T.payNow; showDone('ordered', doneOrder); }
  });

  async function confirmPayment(id: string) {
    showDone('confirming', id);
    for (let i = 0; i < 6; i++) {
      try {
        const res = await fetch(cfg.statusEndpoint, { method: 'POST', body: new URLSearchParams({ orderId: id }) });
        const data = await res.json().catch(() => ({}));
        if (data?.status === 'paid') {
          showDone('paid', id);
          try { localStorage.removeItem(`${KEY}-last`); } catch { /* ignore */ }
          return;
        }
      } catch { /* retry */ }
      await new Promise((r) => setTimeout(r, 3000));
    }
  }

  // Start
  if (state.step >= 3 && !state.chat.length) state.chat = [{ from: 'ai', text: T.chatWelcome }];
  drawLog();
  const paidId = params.get('paid');
  const cancelId = params.get('cancel');
  if (paidId && /^\d+$/.test(paidId)) {
    history.replaceState(null, '', location.pathname);
    confirmPayment(paidId);
  } else if (cancelId && /^\d+$/.test(cancelId)) {
    history.replaceState(null, '', location.pathname);
    showDone('cancelled', cancelId);
  } else {
    go(state.spec ? Math.max(2, Math.min(state.step, 4)) : 1);
  }
</script>

