  // Post designs: the photo (AI or the owner's) with the headline and the business name, in the brand colours.
  const imgCache: Record<string, Promise<HTMLImageElement | null>> = {};
  function loadImg(id: string) {
    if (!id) return Promise.resolve(null);
    if (!imgCache[id]) imgCache[id] = new Promise((ok) => { const im = new Image(); im.crossOrigin = 'anonymous'; im.onload = () => ok(im); im.onerror = () => ok(null); im.src = imgUrl(id); });
    return imgCache[id];
  }
  async function drawDesign(c: HTMLCanvasElement, x: any, title: string) {
    const s0 = site()!;
    const ctx = c.getContext('2d')!;
    const W = c.width, H = c.height;
    const p = s0.spec?.colors?.primary || '#0A253E', a = s0.spec?.colors?.accent || '#F5A800';
    const rtl = /[؀-ۿ]/.test(title) || (!title && (s0.spec?.lang || 'ar') === 'ar');
    const font = getComputedStyle(document.body).fontFamily;
    const im = await loadImg(bgOverride[x.id] || x.bg);
    if (im) {
      const sc = Math.max(W / im.width, H / im.height);
      ctx.drawImage(im, (W - im.width * sc) / 2, (H - im.height * sc) / 2, im.width * sc, im.height * sc);
      const g = ctx.createLinearGradient(0, H * 0.45, 0, H);
      g.addColorStop(0, 'rgba(0,0,0,0)'); g.addColorStop(1, 'rgba(0,0,0,.78)');
      ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
    } else {
      ctx.fillStyle = p; ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = a; ctx.globalAlpha = .9; ctx.beginPath(); ctx.arc(rtl ? 120 : W - 120, 120, 260, 0, Math.PI * 2); ctx.fill(); ctx.globalAlpha = 1;
    }
    const pad = 80;
    ctx.direction = rtl ? 'rtl' : 'ltr'; ctx.textAlign = rtl ? 'right' : 'left';
    const tx = rtl ? W - pad : pad;
    const size = W >= 1080 ? 84 : 60;
    ctx.font = `700 ${size}px ${font}`;
    const words = String(title || '').split(/\s+/).filter(Boolean); const lines: string[] = []; let line = '';
    for (const w of words) { const t = line ? line + ' ' + w : w; if (ctx.measureText(t).width > W - pad * 2 && line) { lines.push(line); line = w; } else line = t; }
    if (line) lines.push(line);
    const L = lines.slice(0, 4);
    const baseY = H - 210 - (L.length - 1) * size * 1.2;
    ctx.fillStyle = '#FFFFFF'; ctx.shadowColor = 'rgba(0,0,0,.35)'; ctx.shadowBlur = im ? 12 : 0;
    L.forEach((l, i) => ctx.fillText(l, tx, baseY + i * size * 1.2));
    ctx.shadowBlur = 0;
    ctx.fillStyle = a; ctx.fillRect(rtl ? W - pad - 120 : pad, H - 150, 120, 10);
    ctx.font = `600 38px ${font}`; ctx.fillStyle = '#FFFFFF'; ctx.globalAlpha = .92;
    ctx.fillText(s0.name || '', tx, H - 80); ctx.globalAlpha = 1;
  }
  function paintSocial(v: any) {
    for (const c of root.querySelectorAll<HTMLCanvasElement>('canvas[data-soc-canvas]')) {
      const x = (v.items || []).find((i: any) => String(i.id) === c.dataset.socCanvas);
      if (x) drawDesign(c, x, x.title);
    }
  }
  async function uploadBlob(blob: Blob, name: string): Promise<string | null> {
    const fd = new FormData();
    fd.append('file', blob, name);
    fd.append('sessionId', 'social-' + site()!.order_id);
    const res = await fetch(cfg.uploadEndpoint, { method: 'POST', body: fd });
    const data = await res.json().catch(() => ({}));
    return data?.success && typeof data.id === 'string' ? data.id : null;
  }
  async function shrinkFile(file: File, max = 1600): Promise<Blob> {
    const bmp = await createImageBitmap(file);
    const sc = Math.min(1, max / Math.max(bmp.width, bmp.height));
    const c = document.createElement('canvas'); c.width = Math.round(bmp.width * sc); c.height = Math.round(bmp.height * sc);
    c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
    return new Promise((ok, fail) => c.toBlob((b) => (b ? ok(b) : fail(new Error('encode'))), 'image/jpeg', 0.86));
  }
  const canvasBlob = (c: HTMLCanvasElement) => new Promise<Blob | null>((ok) => c.toBlob((b) => ok(b), 'image/jpeg', 0.9));

  function seo(_s: Site) { return `<div id="ac-seo"><p class="ac-muted">${esc(T.loading)}</p></div>`; }

  const panel = $<HTMLElement>('#ac-panel');
  panel.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const s = site()!;
    const btn = t.closest<HTMLButtonElement>('button');
    if (!btn) return;
    if (btn.dataset.subscribe) {
      await busy(btn, async () => {
        const r = await api('subscribe', { order_id: s.order_id, product: btn.dataset.subscribe });
        if (r?.payUrl) { location.href = r.payUrl; return; }
        if (r?.success) { flash(T.saved); await reload(); } else flash(r?.reason === 'not_verified' ? T.extNeedVerify : r?.reason === 'not_for_external' ? T.extOnlySeo : T.failed);
      });
    } else if (btn.dataset.cancel) {
      if (confirm(T.cancelConfirm)) await save('cancel', { sub_id: Number(btn.dataset.cancel) }, btn);
    } else if (btn.dataset.keep) {
      const [order_id, product] = btn.dataset.keep.split(':');
      await save('subscribe', { order_id: Number(order_id), product }, btn);
    } else if (btn.dataset.bk) {
      const [id, status] = btn.dataset.bk.split(':');
      await save('booking', { booking_id: Number(id), status }, btn);
    } else if ('gotoAddons' in btn.dataset) {
      tab = 'addons'; draw();
    } else if ('addCat' in btn.dataset) {
      menuDraft.categories.push({ name: '', items: [{ name: '', desc: '', price: '' }] }); drawMenu();
    } else if (btn.dataset.delCat) {
      menuDraft.categories.splice(Number(btn.dataset.delCat), 1); drawMenu();
    } else if (btn.dataset.addItem) {
      menuDraft.categories[Number(btn.dataset.addItem)].items.push({ name: '', desc: '', price: '' }); drawMenu();
    } else if (btn.dataset.delItem) {
      const [ci, ii] = btn.dataset.delItem.split('.').map(Number); menuDraft.categories[ci].items.splice(ii, 1); drawMenu();
    } else if ('publishMenu' in btn.dataset) {
      await save('menu', { order_id: s.order_id, menu: menuDraft }, btn);
    } else if (btn.dataset.qrPng) {
      await svgToPng(qrSvg(btn.dataset.qrPng), 1200, `${btn.dataset.qrName}-qr`);
    } else if (btn.dataset.qrPrint) {
      printCard(btn.dataset.qrPrint, btn.dataset.qrKind || '');
    } else if (btn.dataset.copy) {
      const [pi, i] = btn.dataset.copy.split('.').map(Number);
      const post = (view?.content ?? []).filter((c) => c.order_id === s.order_id)[pi].posts[i];
      try { await navigator.clipboard.writeText(`${post.caption}\n\n${post.hashtags}`); btn.textContent = T.copied; setTimeout(() => { btn.textContent = T.copy; }, 1500); } catch { /* ignore */ }
    } else if (btn.dataset.png) {
      const c = root.querySelector<HTMLCanvasElement>(`canvas[data-post="${btn.dataset.png}"]`);
      if (c) downloadCanvas(c, `post-${btn.dataset.png}`);
    } else if ('addType' in btn.dataset) {
      const box = root.querySelector('#ac-types')!;
      box.insertAdjacentHTML('beforeend', typeRow({ name: '', price: 0, capacity: 0 }, box.children.length));
    } else if ('delType' in btn.dataset) {
      btn.closest('[data-type-row]')?.remove();
    } else if ('scan' in btn.dataset) {
      scan();
    } else if ('socConnect' in btn.dataset) {
      await busy(btn, async () => {
        const r = await socApi('meta_start', { lang: cfg.lang });
        if (r?.url) { location.href = r.url; return; }
        flash(r?.reason === 'meta_not_ready' ? T.socNotReady : T.failed);
      });
    } else if ('socDisconnect' in btn.dataset) {
      if (!confirm(T.socDisconnectConfirm)) return;
      await busy(btn, async () => { const r = await socApi('meta_disconnect'); flash(r?.success ? T.saved : T.failed); await loadSocial(s.order_id, true); });
    } else if (btn.dataset.socApprove || btn.dataset.socReject) {
      const id = Number(btn.dataset.socApprove || btn.dataset.socReject);
      const v = socCache[s.order_id];
      const x = (v?.items || []).find((i: any) => i.id === id);
      const el = root.querySelector<HTMLElement>(`[data-soc-item="${id}"]`);
      if (!x || !el) return;
      const val = (n: string) => el.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${n}"]`)?.value ?? '';
      await busy(btn, async () => {
        let r: any;
        if (btn.dataset.socReject) r = await socApi('reject', { item_id: id });
        else if (x.kind === 'ad') r = await socApi('approve', { item_id: id, budget: val('budget'), days: val('days'), text: val('text'), headline: val('headline') });
        else if (x.kind === 'reel') r = await socApi('approve', { item_id: id });
        else {
          const c = el.querySelector<HTMLCanvasElement>('canvas')!;
          await drawDesign(c, x, val('title'));
          const blob = await canvasBlob(c);
          const image = blob ? await uploadBlob(blob, 'post.jpg') : null;
          if (!image) { flash(T.socNoImage); return; }
          const platforms = [...el.querySelectorAll<HTMLInputElement>('input[name="platforms"]:checked')].map((i) => i.value);
          r = await socApi('approve', { item_id: id, title: val('title'), caption: val('caption'), hashtags: val('hashtags'), day: val('day'), time: val('time'), platforms, image });
        }
        if (r?.reason === 'expired') { signOut(T.expired); return; }
        flash(r?.success ? T.saved : ((T.socErr as any)[r?.reason] || T.failed));
        if (r?.success) await loadSocial(s.order_id, true);
      });
    } else if (btn.dataset.socDl) {
      const c = root.querySelector<HTMLCanvasElement>(`canvas[data-soc-canvas="${btn.dataset.socDl}"]`);
      if (c) c.toBlob((b) => { if (!b) return; const a = document.createElement('a'); a.href = URL.createObjectURL(b); a.download = `post-${btn.dataset.socDl}.jpg`; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 2000); }, 'image/jpeg', 0.92);
    } else if (btn.dataset.socCopy) {
      const x = (socCache[s.order_id]?.items || []).find((i: any) => String(i.id) === btn.dataset.socCopy);
      const el = root.querySelector<HTMLElement>(`[data-soc-item="${btn.dataset.socCopy}"]`);
      const cap = el?.querySelector<HTMLTextAreaElement>('[name="caption"]')?.value ?? x?.caption ?? '';
      const tags = el?.querySelector<HTMLInputElement>('[name="hashtags"]')?.value ?? x?.hashtags ?? '';
      try { await navigator.clipboard.writeText(`${cap}\n\n${tags}`.trim()); btn.textContent = T.socCopied; setTimeout(() => { btn.textContent = T.socCopy; }, 1500); } catch { /* ignore */ }
    } else if (btn.dataset.phDel) {
      btn.closest('[data-ph]')?.remove();
    } else if ('extCheck' in btn.dataset) {
      await checkExternal(s, btn);
    } else if ('seoPrint' in btn.dataset) {
      window.print();
    } else if ('wpOff' in btn.dataset) {
      await busy(btn, async () => {
        const r = await seoSettings('wp_disconnect', {});
        if (r?.reason === 'expired') { signOut(T.expired); return; }
        flash(r?.success ? T.saved : T.failed);
        await loadSeo(s.order_id, true);
      });
    } else if (btn.dataset.seoCopy) {
      const el = root.querySelector<HTMLElement>(`[data-seo-item="${btn.dataset.seoCopy}"]`)!;
      const v = (n: string) => (el.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${n}"]`)?.value ?? '');
      try { await navigator.clipboard.writeText([v('title'), v('description'), v('body')].filter(Boolean).join('\n\n')); btn.textContent = T.seoCopied; setTimeout(() => { btn.textContent = T.seoCopy; }, 1500); } catch { /* ignore */ }
    } else if (btn.dataset.seoPub || btn.dataset.seoRej) {
      const id = btn.dataset.seoPub || btn.dataset.seoRej!;
      const el = root.querySelector<HTMLElement>(`[data-seo-item="${id}"]`)!;
      const val = (n: string) => (el.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${n}"]`)?.value ?? '');
      await busy(btn, async () => {
        const r = await seoApi(btn.dataset.seoPub
          ? { action: 'publish', order_id: String(s.order_id), item_id: id, edited: '1', title: val('title'), description: val('description'), body: val('body') }
          : { action: 'reject', order_id: String(s.order_id), item_id: id });
        flash(r?.success ? T.saved : (T.seoWpErr[r?.reason] || T.failed));
        await loadSeo(s.order_id, true);
      });
    }
  });
  panel.addEventListener('input', (e) => {
    const rd = (e.target as HTMLElement).dataset?.socRedraw;
    if (rd) {
      const x = (socCache[site()!.order_id]?.items || []).find((i: any) => String(i.id) === rd);
      const c = root.querySelector<HTMLCanvasElement>(`canvas[data-soc-canvas="${rd}"]`);
      if (x && c) drawDesign(c, x, (e.target as HTMLInputElement).value);
      return;
    }
    const el = e.target as HTMLInputElement;
    const path = el.dataset.m;
    if (!path || !menuDraft) return;
    const p = path.split('.');
    if (p[0] === 'title' || p[0] === 'note') menuDraft[p[0]] = el.value;
    else if (p.length === 3) menuDraft.categories[Number(p[1])].name = el.value;
    else menuDraft.categories[Number(p[1])].items[Number(p[3])][p[4]] = el.value;
  });
  const g2 = (fd: FormData, n: string) => String(fd.get(n) || '');
  panel.addEventListener('change', async (e) => {
    const inp = e.target as HTMLInputElement;
    if (inp.dataset.socPhoto && inp.files?.[0]) {
      const id = Number(inp.dataset.socPhoto);
      flash(T.sending);
      try {
        const up = await uploadBlob(await shrinkFile(inp.files[0]), 'photo.jpg');
        if (!up) { flash(T.failed); return; }
        bgOverride[id] = up;
        const x = (socCache[site()!.order_id]?.items || []).find((i: any) => i.id === id);
        const c = root.querySelector<HTMLCanvasElement>(`canvas[data-soc-canvas="${id}"]`);
        const t = root.querySelector<HTMLInputElement>(`[data-soc-item="${id}"] [name="title"]`);
        if (x && c) await drawDesign(c, x, t?.value ?? x.title);
        flash(T.saved);
      } catch { flash(T.failed); }
    } else if ('phAdd' in inp.dataset && inp.files?.length) {
      const box = root.querySelector<HTMLElement>('#ac-soc-photos')!;
      for (const file of [...inp.files].slice(0, 10)) {
        try {
          const up = await uploadBlob(await shrinkFile(file), 'photo.jpg');
          if (up) box.insertAdjacentHTML('afterbegin', `<span class="ac-ph" data-ph="${up}" style="background-image:url(${imgUrl(up)})"><button type="button" class="ac-x" data-ph-del="${up}" aria-label="${esc(T.remove)}">×</button></span>`);
        } catch { /* skip */ }
      }
      inp.value = '';
    }
  });
  panel.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const s = site()!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const fd = new FormData(form);
    if (form.id === 'ac-soc-brief') {
      await busy(btn, async () => {
        const g = (n: string) => String(fd.get(n) || '');
        const photos = [...root.querySelectorAll<HTMLElement>('#ac-soc-photos [data-ph]')].map((x) => x.dataset.ph!).filter(Boolean);
        const r = await socApi('save_brief', { about: g('about'), audience: g('audience'), offers: g('offers'), areas: g('areas'), avoid: g('avoid'), voice: g('voice'), lang: g('lang'), time: g('time'), platforms: fd.getAll('platforms').map(String), photos, competitors: g('competitors'), replies: fd.get('replies') ? '1' : '', ads_cap: g('ads_cap'), ads_goal: g('ads_goal'), age_min: g('age_min'), age_max: g('age_max'), special: g('special') });
        if (r?.reason === 'expired') { signOut(T.expired); return; }
        flash(r?.success ? T.saved : T.failed);
        if (r?.success) await loadSocial(s.order_id, true);
      });
      return;
    }
    if (form.id === 'ac-meta-select') {
      await busy(btn, async () => {
        const r = await socApi('meta_select', { page_id: g2(fd, 'page_id'), ad_account_id: g2(fd, 'ad_account_id') });
        flash(r?.success ? T.saved : T.failed);
        if (r?.success) await loadSocial(s.order_id, true);
      });
      return;
    }
    if (form.id === 'ac-seo-brief') {
      await busy(btn, async () => {
        const g = (n: string) => String(fd.get(n) || '');
        const r = await seoSettings('save', { services: g('services'), areas: g('areas'), audience: g('audience'), usp: g('usp'), notes: g('notes'), keywords: g('keywords'), competitors: g('competitors'), langs: fd.get('lang_en') ? ['ar', 'en'] : [], gbp_maps: g('gbp_maps'), gbp_manager: fd.get('gbp_manager') ? '1' : '' });
        if (r?.reason === 'expired') { signOut(T.expired); return; }
        flash(r?.success ? T.saved : T.failed);
        if (r?.success) await loadSeo(site()!.order_id, true);
      });
      return;
    }
    if (form.id === 'ac-wp') {
      await busy(btn, async () => {
        const r = await seoSettings('wp_connect', { wp_url: String(fd.get('wp_url') || ''), wp_user: String(fd.get('wp_user') || ''), wp_pass: String(fd.get('wp_pass') || '') });
        if (r?.reason === 'expired') { signOut(T.expired); return; }
        flash(r?.success ? T.saved : (T.seoWpErr[r?.reason] || T.failed));
        if (r?.success) await loadSeo(site()!.order_id, true);
      });
      return;
    }
    if (form.id === 'ac-ext-add') {
      await busy(btn, async () => {
        const res = await fetch(cfg.extEndpoint, { method: 'POST', body: new URLSearchParams({ k: token, action: 'add', domain: String(fd.get('domain') || ''), name: String(fd.get('name') || ''), lang: cfg.lang }) });
        const r = await res.json().catch(() => ({}));
        if (r?.reason === 'expired') { signOut(T.expired); return; }
        if (!r?.success) { flash(r?.reason === 'domain' ? T.extErrDomain : T.failed); return; }
        siteId = Number(r.order_id) || siteId; store.set(SITE_KEY, String(siteId)); tab = 'overview';
        flash(T.saved); await load();
      });
      return;
    }
    if (form.id === 'ac-bset') {
      await save('settings', { order_id: s.order_id, settings: { bookingFrom: fd.get('bookingFrom'), bookingTo: fd.get('bookingTo'), slotMinutes: Number(fd.get('slotMinutes')), capacity: Number(fd.get('capacity')), closedDays: fd.getAll('closed').map(Number), bookingNote: fd.get('bookingNote') } }, btn);
    } else if (form.id === 'ac-rev') {
      await save('settings', { order_id: s.order_id, settings: { googleReviewUrl: String(fd.get('googleReviewUrl') || '').trim() } }, btn);
    } else if (form.id === 'ac-chat') {
      await save('settings', { order_id: s.order_id, settings: { chatNotes: fd.get('chatNotes') } }, btn);
    } else if (form.id === 'ac-tk') {
      const rows = Array.from(form.querySelectorAll('[data-type-row]')).map((r, i) => ({
        id: (r.querySelector<HTMLInputElement>('[name="tid"]')!.value) || `t${Date.now().toString(36)}${i}`,
        name: r.querySelector<HTMLInputElement>('[name="tname"]')!.value,
        price: Number(r.querySelector<HTMLInputElement>('[name="tprice"]')!.value) || 0,
        capacity: Number(r.querySelector<HTMLInputElement>('[name="tcap"]')!.value) || 0,
      })).filter((x) => x.name.trim());
      await save('settings', { order_id: s.order_id, settings: { eventName: fd.get('eventName'), tickets: rows } }, btn);
    } else if (form.id === 'ac-checkin') {
      await checkin(String(fd.get('code') || ''), btn);
      form.reset();
    }
  });
  async function checkin(code: string, btn?: HTMLButtonElement) {
    const status = root.querySelector<HTMLElement>('#ac-checkin-status')!;
    const run = async () => {
      const r = await api('checkin', { code: code.trim().toUpperCase() });
      status.hidden = false;
      if (r?.success && r.ticket) { status.className = 'ac-status is-ok'; status.textContent = `✓ ${T.checkedIn}: ${r.ticket.name} · ${r.ticket.type} × ${r.ticket.qty}`; }
      else { status.className = 'ac-status is-error'; status.textContent = T.checkinErr[r?.reason] || T.failed; }
    };
    if (btn) await busy(btn, run); else await run();
  }
  async function scan() {
    const video = root.querySelector<HTMLVideoElement>('#ac-cam')!;
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
      video.srcObject = stream; video.hidden = false; await video.play();
      const detector = new (window as any).BarcodeDetector({ formats: ['qr_code'] });
      const tick = async () => {
        if (video.hidden) return;
        const codes = await detector.detect(video).catch(() => []);
        const value = codes[0]?.rawValue as string | undefined;
        if (value) {
          stream.getTracks().forEach((t) => t.stop()); video.hidden = true;
          await checkin(value.split('/').pop() || value);
          return;
        }
        requestAnimationFrame(tick);
      };
      tick();
    } catch { /* camera not available */ }
  }

  load();
</script>

