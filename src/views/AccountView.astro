    return `<div class="ac-intro"><h2>${esc(T.contentTitle)}</h2><p class="ac-muted">${esc(T.contentBody)}</p></div>` + packs.map((p, pi) => `<h3 class="ac-month" dir="ltr">${esc(p.month)}</h3><div class="ac-posts">${p.posts.map((x: any, i: number) => `<article class="ac-post">
      <canvas width="1080" height="1080" data-post="${pi}.${i}"></canvas>
      <p class="ac-kicker">${esc(T.day)} ${esc(x.day)}</p>
      <p class="ac-caption" dir="auto">${esc(x.caption)}</p><p class="ac-tags" dir="auto">${esc(x.hashtags)}</p>
      ${x.idea ? `<p class="ac-muted ac-small" dir="auto">💡 ${esc(x.idea)}</p>` : ''}
      <div class="ac-row"><button type="button" class="ac-link" data-copy="${pi}.${i}">${esc(T.copy)}</button><button type="button" class="ac-link" data-png="${pi}.${i}">${esc(T.download)}</button></div>
    </article>`).join('')}</div>`).join('');
  }
  function paintPost(c: HTMLCanvasElement, s: Site, post: any) {
    const ctx = c.getContext('2d')!;
    const p = s.spec.colors?.primary || '#0A253E', a = s.spec.colors?.accent || '#FFC400';
    const rtl = (s.spec.lang || 'ar') === 'ar';
    ctx.fillStyle = p; ctx.fillRect(0, 0, 1080, 1080);
    ctx.fillStyle = a; ctx.globalAlpha = .9; ctx.beginPath(); ctx.arc(rtl ? 120 : 960, 120, 260, 0, Math.PI * 2); ctx.fill(); ctx.globalAlpha = 1;
    ctx.fillRect(90, 760, 160, 14);
    const light = (() => { const n = parseInt(p.slice(1), 16); return ((n >> 16 & 255) * 299 + (n >> 8 & 255) * 587 + (n & 255) * 114) / 1000 > 150; })();
    ctx.fillStyle = light ? '#14171C' : '#FFFFFF';
    ctx.direction = rtl ? 'rtl' : 'ltr'; ctx.textAlign = rtl ? 'right' : 'left';
    const x = rtl ? 990 : 90;
    ctx.font = `700 88px ${getComputedStyle(document.body).fontFamily}`;
    const words = String(post.title || '').split(/\s+/); const lines: string[] = []; let line = '';
    for (const w of words) { const t = line ? line + ' ' + w : w; if (ctx.measureText(t).width > 900 && line) { lines.push(line); line = w; } else line = t; }
    if (line) lines.push(line);
    lines.slice(0, 4).forEach((l, i) => ctx.fillText(l, x, 470 + i * 110 - (lines.length - 1) * 40));
    ctx.font = `600 40px ${getComputedStyle(document.body).fontFamily}`;
    ctx.globalAlpha = .85; ctx.fillText(s.name || '', x, 960); ctx.globalAlpha = 1;
  }

