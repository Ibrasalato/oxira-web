---
// A scaled-down live preview of a builder template. Loads a prebuilt preview page lazily;
// with custom colours it renders inline instead.
import { renderSite } from '../builder/render';
import { sampleSpec, mergeSpec, type TemplateId } from '../builder/spec';
import type { Lang } from '../i18n/content';
import { asset } from '../lib/routes';

interface Props { template: TemplateId; lang: Lang; height?: number; class?: string; colors?: { primary: string; accent: string }; eager?: boolean }
const { template, lang, height = 860, class: cls = '', colors, eager = false } = Astro.props;
let srcdoc: string | undefined;
if (colors) {
  const base = sampleSpec(template, lang);
  srcdoc = renderSite(mergeSpec(base, { colors: { ...base.colors, ...colors } }), { fontBase: asset('builder/fonts'), year: 2026 });
}
const src = srcdoc ? undefined : asset(`previews/${lang}/${template}.html`);
---
<div class={`thumb ${cls}`} style={`--h:${height}`} aria-hidden="true">
  <iframe src={src} srcdoc={srcdoc} sandbox="allow-same-origin" loading={eager ? 'eager' : 'lazy'} tabindex="-1" title=""></iframe>
</div>

<script>
  // Scale the 1280px-wide page down to the card width.
  const fit = (el: HTMLElement) => el.style.setProperty('--s', String(el.clientWidth / 1280));
  const ro = new ResizeObserver((entries) => entries.forEach((e) => fit(e.target as HTMLElement)));
  document.querySelectorAll<HTMLElement>('.thumb').forEach((el) => { fit(el); ro.observe(el); });
</script>

<style>
  .thumb { --s: .3; position: relative; overflow: hidden; aspect-ratio: 1280 / var(--h); background: #fff; }
  .thumb iframe { position: absolute; top: 0; left: 0; width: 1280px; height: calc(var(--h) * 1px); border: 0; transform: scale(var(--s)); transform-origin: 0 0; pointer-events: none; }
</style>
