  .ac-addon .btn, .ac-addon .ac-chip { align-self: flex-start; }
  .ac-addon-ic { width: 44px; height: 44px; border-radius: 12px; background: var(--blue-soft); color: var(--navy); display: grid; place-items: center; }
  .ac-addon-ic svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .ac-price b { font-size: 1.25rem; color: var(--navy); }
