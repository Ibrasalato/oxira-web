---
// Template gallery with business-category chips, a search box and "show more".
// mode "link": each card opens the studio with that design; mode "pick": cards are buttons with data-template.
import type { Lang } from '../i18n/content';
import { builderText } from '../i18n/builder';
import { catalog, categoryIds } from '../builder/catalog';
import { langCodes } from '../i18n/content';
import SiteThumb from './SiteThumb.astro';

interface Props { lang: Lang; mode: 'link' | 'pick'; href?: string; action: string; perPage?: number }
const { lang, mode, href = '', action, perPage = 12 } = Astro.props;
const b = builderText[lang];
const g = b.gallery;
// Category names in every language, so a search in any language finds the right designs.
const names = Object.fromEntries(categoryIds.map((c) => [c, langCodes.map((l) => builderText[l].categories[c]).join(' | ')]));
---
<div class="tg" data-tg data-per-page={perPage}>
  <div class="tg-tools">
    <label class="tg-search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <span class="sr-only">{g.searchPh}</span>
      <input type="search" data-tg-q placeholder={g.searchPh} autocomplete="off" dir="auto" />
    </label>
    <div class="tg-chips" role="group" aria-label={g.categoriesLabel}>
      <button type="button" data-tg-cat="" aria-pressed="true">{g.filterAll} <small>{catalog.length}</small></button>
      {categoryIds.map((c) => <button type="button" data-tg-cat={c} aria-pressed="false">{b.categories[c]}</button>)}
    </div>
  </div>
  <ul class="tg-grid">
    {catalog.map((t) => (
      <li data-cat={t.cat} data-names={names[t.cat]}>
        {mode === 'link' ? (
          <a href={`${href}?t=${t.id}`}>
            <SiteThumb template={t.id} lang={lang} height={900} class="tg-thumb" />
            <span class="tg-meta"><strong>{b.categories[t.cat]}</strong><small>{g.designN.replace('{n}', String(t.n))}</small></span>
            <span class="tg-go">{action}</span>
          </a>
        ) : (
          <button type="button" data-template={t.id}>
            <SiteThumb template={t.id} lang={lang} height={900} class="tg-thumb" />
            <span class="tg-meta"><strong>{b.categories[t.cat]}</strong><small>{g.designN.replace('{n}', String(t.n))}</small></span>
            <span class="tg-go">{action}</span>
          </button>
        )}
      </li>
    ))}
  </ul>
  <p class="tg-empty" data-tg-empty hidden>{g.noResults}</p>
  <div class="tg-more-wrap"><button type="button" class="btn btn-ghost tg-more" data-tg-more>{g.showMore}</button></div>
</div>

<script>
  import { categoryKeywords, type CategoryId } from '../builder/catalog';

  document.querySelectorAll<HTMLElement>('[data-tg]').forEach((root) => {
    const per = Number(root.dataset.perPage) || 12;
    const items = Array.from(root.querySelectorAll<HTMLElement>('.tg-grid > li'));
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tg-cat]'));
    const q = root.querySelector<HTMLInputElement>('[data-tg-q]')!;
    const more = root.querySelector<HTMLButtonElement>('[data-tg-more]')!;
    const empty = root.querySelector<HTMLElement>('[data-tg-empty]')!;
    let cat = '';
    let limit = per;

    const matches = (li: HTMLElement, text: string) => {
      if (!text) return true;
      const c = li.dataset.cat as CategoryId;
      return li.dataset.names!.toLowerCase().includes(text.toLowerCase()) || categoryKeywords[c].test(text);
    };
    function draw() {
      const text = q.value.trim();
      const shown = items.filter((li) => (!cat || li.dataset.cat === cat) && matches(li, text));
      // Without a filter, show one design of every category first so the variety is visible.
      if (!cat && !text) shown.sort((x, y) => items.indexOf(x) % 3 - items.indexOf(y) % 3 || items.indexOf(x) - items.indexOf(y));
      const grid = root.querySelector('.tg-grid')!;
      items.forEach((li) => { li.hidden = true; });
      shown.forEach((li, i) => { li.hidden = i >= limit; grid.append(li); });
      more.hidden = shown.length <= limit;
      empty.hidden = shown.length > 0;
    }
    chips.forEach((chip) => chip.addEventListener('click', () => {
      cat = chip.dataset.tgCat || '';
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === chip)));
      limit = cat ? 99 : per;
      draw();
    }));
    let t = 0;
    q.addEventListener('input', () => {
      clearTimeout(t);
      t = window.setTimeout(() => {
        if (q.value.trim() && cat) { cat = ''; chips.forEach((x) => x.setAttribute('aria-pressed', String(!x.dataset.tgCat))); }
        limit = q.value.trim() ? 99 : per;
        draw();
      }, 150);
    });
    more.addEventListener('click', () => { limit += per; draw(); });
    draw();
    // ?cat=clinic (from the product pages) opens the gallery on that business type.
    const want = new URLSearchParams(location.search).get('cat');
    if (want) chips.find((x) => x.dataset.tgCat === want)?.click();
  });
</script>

<style>
  .tg-tools { display: grid; gap: 1rem; margin-bottom: 1.75rem; }
  .tg-search { display: flex; align-items: center; gap: .6rem; max-width: 34rem; padding: .25rem .9rem; border: 1.5px solid var(--line); border-radius: 14px; background: #fff; }
  .tg-search:focus-within { border-color: var(--blue); }
  .tg-search svg { width: 20px; height: 20px; fill: none; stroke: var(--muted); stroke-width: 2; stroke-linecap: round; flex: none; }
  .tg-search input { flex: 1; min-width: 0; border: 0; outline: none; font: 400 1rem var(--font); padding: .65rem 0; background: transparent; color: var(--ink); }
  .tg-chips { display: flex; flex-wrap: wrap; gap: .45rem; }
  .tg-chips button { border: 1.5px solid var(--line); background: #fff; border-radius: 999px; padding: .45rem .9rem; font: 600 .9rem var(--font); color: var(--ink); cursor: pointer; white-space: nowrap; }
  .tg-chips button:hover { border-color: var(--navy); }
  .tg-chips button[aria-pressed='true'] { background: var(--navy); border-color: var(--navy); color: #fff; }
  .tg-chips small { opacity: .7; font-weight: 500; margin-inline-start: .2rem; }
  .tg-grid { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin: 0; padding: 0; }
  .tg-grid > li[hidden] { display: none; }
  .tg-grid a, .tg-grid button { display: grid; width: 100%; padding: 0; text-align: start; font: inherit; color: inherit; text-decoration: none; border: 1px solid var(--line); border-radius: var(--radius, 16px); overflow: hidden; background: #fff; cursor: pointer; transition: border-color .2s, box-shadow .2s, transform .2s; }
  .tg-grid a:hover, .tg-grid button:hover { border-color: var(--navy); box-shadow: 0 24px 40px -28px rgba(6, 26, 45, .5); transform: translateY(-2px); }
  .tg-grid :global(.tg-thumb) { border-bottom: 1px solid var(--line); }
  .tg-meta { display: flex; align-items: baseline; justify-content: space-between; gap: .5rem; padding: 1rem 1.2rem .2rem; }
  .tg-meta strong { font-size: 1.05rem; }
  .tg-meta small { color: var(--muted); font-size: .88rem; }
  .tg-go { padding: .3rem 1.2rem 1.1rem; color: var(--blue); font-weight: 700; font-size: .95rem; }
  .tg-empty { padding: 2rem 0; color: var(--muted); text-align: center; }
  .tg-more-wrap { display: flex; justify-content: center; margin-top: 2rem; }
  .tg-more[hidden] { display: none; }
  @media (max-width: 1060px) { .tg-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) {
    .tg-grid { grid-template-columns: 1fr; }
    .tg-chips { flex-wrap: nowrap; overflow-x: auto; margin-inline: -20px; padding: 0 20px 4px; scrollbar-width: none; }
  }
</style>
