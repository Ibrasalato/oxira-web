---
// Line icons for services and contact details, drawn to match the profile's icon style.
interface Props { name: string; class?: string }
const { name, class: cls = '' } = Astro.props;
---
<svg class={`icon ${cls}`} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'transform' && (
    <>
      <path d="M22 9.5a14.5 14.5 0 1 0 0 29" />
      <path d="M22 9.5v4M22 34.5v4M9.5 24h-3M12 14l-2.4-2.4M12 34l-2.4 2.4" />
      <circle cx="22" cy="24" r="5" />
      <path d="M27 18h6l3-4h4M27 24h13M27 30h6l3 4h4" />
      <circle cx="41.5" cy="14" r="1.6" fill="currentColor" /><circle cx="41.5" cy="24" r="1.6" fill="currentColor" /><circle cx="41.5" cy="34" r="1.6" fill="currentColor" />
    </>
  )}
  {name === 'software' && (
    <>
      <rect x="5" y="9" width="32" height="23" rx="2.5" />
      <path d="M15 40h12M21 32v8" />
      <path d="M16 17l-4 3.5 4 3.5M26 17l4 3.5-4 3.5M23 15.5l-4 10" />
      <circle cx="38" cy="12" r="5" /><path d="M38 4.5v2.5M38 17v2.5M30.5 12H33M43 12h2.5" />
    </>
  )}
  {name === 'infra' && (
    <>
      <rect x="7" y="7" width="34" height="10" rx="2" /><rect x="7" y="20" width="34" height="10" rx="2" />
      <circle cx="13" cy="12" r="1.4" fill="currentColor" /><circle cx="13" cy="25" r="1.4" fill="currentColor" />
      <path d="M20 12h15M20 25h15M24 30v6M10 41h28M24 36v5" />
      <circle cx="24" cy="36" r="1.6" fill="currentColor" />
    </>
  )}
  {name === 'home' && (
    <>
      <path d="M6 22L24 7l18 15M11 18v22h26V18" />
      <rect x="19" y="24" width="10" height="10" rx="1.5" />
      <path d="M22 24v-3M26 24v-3M22 34v3M26 34v3M19 27h-3M19 31h-3M29 27h3M29 31h3" />
    </>
  )}
  {name === 'ai' && (
    <>
      <rect x="14" y="14" width="20" height="20" rx="3" />
      <path d="M19 14V8M24 14V8M29 14V8M19 34v6M24 34v6M29 34v6M14 19H8M14 24H8M14 29H8M34 19h6M34 24h6M34 29h6" />
      <path d="M20 28l2.5-8h3l2.5 8M21 25.5h6" stroke-width="2" />
    </>
  )}
  {name === 'phone' && <path d="M17 7l-6 1c-2 .4-3.2 2.3-2.8 4.3C10.6 25 23 37.4 35.7 39.8c2 .4 3.9-.8 4.3-2.8l1-6-8-4-3.5 3.5c-4.4-2-8-5.6-10-10L23 17z" />}
  {name === 'mail' && (<><rect x="6" y="11" width="36" height="26" rx="3" /><path d="M7 13l17 13 17-13" /></>)}
  {name === 'globe' && (<><circle cx="24" cy="24" r="17" /><path d="M7 24h34M24 7c5 5 7 11 7 17s-2 12-7 17c-5-5-7-11-7-17s2-12 7-17z" /></>)}
  {name === 'pin' && (<><path d="M24 43s13-12.5 13-23a13 13 0 1 0-26 0c0 10.5 13 23 13 23z" /><circle cx="24" cy="20" r="5" /></>)}
  {name === 'whatsapp' && (<><path d="M9 39l2.5-8A15.5 15.5 0 1 1 18 37.2z" /><path d="M18.5 17c0 7 5.5 12.5 12.5 12.5l2-3-4-2-1.8 1.8a8 8 0 0 1-4.5-4.5L24.5 19l-2-4z" stroke-width="2" /></>)}
</svg>

<style>
  .icon { width: 1em; height: 1em; }
</style>
