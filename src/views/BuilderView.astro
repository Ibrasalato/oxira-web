---
// Service page: "Build your website in minutes" (Oxira Studio).
import type { Lang } from '../i18n/content';
import { builderText, plans, planIds, renewals, domainPrice } from '../i18n/builder';
import { catalog } from '../builder/catalog';
import { addonIds, addonPrices, addonIcons, productIds } from '../builder/addons';
import { link } from '../lib/routes';
import { productsText, productPath } from '../i18n/products';
import Base from '../layouts/Base.astro';
import SiteThumb from '../components/SiteThumb.astro';
import TemplateGallery from '../components/TemplateGallery.astro';
import Proof from '../components/Proof.astro';
import Logo from '../components/Logo.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const b = builderText[lang];
const p = b.page;
const studio = link(lang, '/studio/');
const fmt = new Intl.NumberFormat(lang === 'ar' ? 'ar-SA-u-nu-latn' : lang, { maximumFractionDigits: 0 });
---
<Base lang={lang} path="/website-builder/" title={p.title} description={p.description}>
  <section class="page-hero bd-hero">
    <div class="wrap bd-hero-grid">
      <div class="bd-copy">
        <p class="label">{p.kicker}</p>
        <h1>{p.h1}</h1>
        <p class="lead">{p.lead}</p>
        <form class="bd-quick" action={studio} method="get">
          <label for="bd-q">{p.quickLabel}</label>
          <div class="bd-quick-row">
            <input id="bd-q" name="q" required maxlength="300" placeholder={p.quickPh} autocomplete="off" />
            <button type="submit" class="btn btn-amber">{p.quickBtn}</button>
          </div>
        </form>
        <p class="bd-free">{p.free} <a href="#templates">{p.secondary}</a></p>
      </div>
      <div class="bd-demo" aria-hidden="true" data-demo>
        <div class="bd-window">
          <div class="bd-bar"><i></i><i></i><i></i><span>{p.demoLabel}</span></div>
          <div class="bd-frames">
            <div class="bd-frame is-on"><SiteThumb template="clinic" lang={lang} height={760} eager /></div>
            <div class="bd-frame"><SiteThumb template="clinic" lang={lang} height={760} colors={{ primary: '#0A253E', accent: '#C8A24A' }} /></div>
            <div class="bd-frame"><SiteThumb template="restaurant" lang={lang} height={760} eager /></div>
          </div>
          <div class="bd-scan"></div>
        </div>
        <div class="bd-chat">
          <span class="bd-chat-ai"><Logo variant="dark" wordmark={false} /></span>
          <p><span data-typed>{p.demo[0]}</span><i class="bd-caret"></i></p>
        </div>
        <script type="application/json" data-demo-text set:html={JSON.stringify(p.demo)} />
      </div>
    </div>
  </section>

  <section class="bd-trust" aria-label={p.trust[0]}>
    <ul class="wrap">{p.trust.map((x) => <li>{x}</li>)}</ul>
  </section>

  <section class="section-tight bg-paper" aria-labelledby="how-title">
    <div class="wrap">
      <div class="sh"><h2 id="how-title">{p.howTitle}</h2></div>
      <ol class="bd-steps">
        {p.steps.map((s, i) => (
          <li><span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3>{s.name}</h3><p>{s.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="templates" aria-labelledby="tpl-title">
    <div class="wrap">
      <div class="sh"><h2 id="tpl-title">{p.templatesTitle}</h2><p>{p.templatesBody} <b>{b.gallery.count.replace('{n}', String(catalog.length))}</b></p></div>
      <TemplateGallery lang={lang} mode="link" href={studio} action={p.useTemplate} />
    </div>
  </section>

  <section class="section bg-navy" id="plans" aria-labelledby="plans-title">
    <div class="wrap">
      <div class="sh"><h2 id="plans-title">{b.plans.title}</h2><p>{b.plans.body}</p></div>
      <ul class="bd-plans">
        {planIds.map((id) => (
          <li class={id === 'pro' ? 'is-pop' : ''}>
            {id === 'pro' && <span class="bd-pop">{b.plans.popular}</span>}
            <h3>{b.plans.items[id].name}</h3>
            <p class="bd-plan-desc">{b.plans.items[id].desc}</p>
            <p class="bd-price"><b>{fmt.format(plans[id].price)}</b> {b.packages.sar} <small>/ {b.plans.firstYear}</small></p>
            <ul class="bd-feat">{b.plans.items[id].features.map((f) => <li>{f}</li>)}</ul>
            <a class={`btn ${id === 'pro' ? 'btn-amber' : 'btn-ghost-light'}`} href={`${studio}?plan=${id}`}>{b.plans.choose}</a>
          </li>
        ))}
      </ul>
      <p class="bd-renew">{b.plans.renew.replace('{hosting}', fmt.format(renewals.hosting)).replace('{domain}', fmt.format(renewals.domain))} · <a href={link(lang, '/terms/')}>{p.terms}</a></p>
      <div class="bd-account">
        <h3>{p.accountTitle}</h3>
        <p>{p.accountBody}</p>
        <a class="bd-soon" href={link(lang, '/account/')}>{b.account.title} →</a>
      </div>
    </div>
  </section>

  <Proof lang={lang} />

  <section class="section" id="addons" aria-labelledby="addons-title">
    <div class="wrap">
      <div class="sh"><h2 id="addons-title">{b.addons.title}</h2><p>{b.addons.body}</p></div>
      <ul class="bd-addons">
        {addonIds.map((id) => (
          <li>
            <span class="bd-addon-ic"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={addonIcons[id]} /></span>
            <h3><a href={link(lang, productPath(id === 'seogrowth' ? 'seo' : id))}>{b.addons.items[id].name}</a></h3>
            <p>{b.addons.items[id].desc}</p>
            <p class="bd-addon-price">{addonPrices[id].price ? <><b>{fmt.format(addonPrices[id].price)}</b> {b.packages.sar} {b.addons.perMonth}</> : <b>{b.addons.free}</b>}{addonPrices[id].feePercent ? <small> {b.addons.fee}</small> : null}</p>
            <a class="more bd-addon-more" href={link(lang, productPath(id === 'seogrowth' ? 'seo' : id))}>{productsText[lang].common.learnMore}</a>
          </li>
        ))}
      </ul>
      <p class="bd-addons-note">{b.addons.fromAccount} <a href={link(lang, '/account/')}>{b.account.title}</a> · <a href={link(lang, '/products/')}>{productsText[lang].nav.all}</a></p>
      <div class="bd-partner">
        <p>{productsText[lang].common.partnerStrip}</p>
        <a class="btn btn-navy" href={link(lang, '/partners/')}>{productsText[lang].common.partnerCta}</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="cmp-title">
    <div class="wrap">
      <div class="sh"><h2 id="cmp-title">{p.compareTitle}</h2><p>{p.compareBody}</p></div>
      <div class="bd-cmp" role="table" aria-labelledby="cmp-title">
        <div class="bd-cmp-row bd-cmp-head" role="row">
          {p.compareCols.map((c, i) => <span role={i === 0 ? 'cell' : 'columnheader'} class={i === 1 ? 'is-studio' : ''}>{c}</span>)}
        </div>
        {p.compareRows.map((r) => (
          <div class="bd-cmp-row" role="row">
            <span role="rowheader">{r[0]}</span>
            <span role="cell" class="is-studio">{r[1]}</span>
            <span role="cell">{r[2]}</span>
          </div>
        ))}
        <div class="bd-cmp-row bd-cmp-foot" role="row">
          <span role="cell"></span>
          <span role="cell" class="is-studio"><a class="btn btn-amber" href={studio}>{p.compareStudio}</a></span>
          <span role="cell"><a class="btn btn-ghost" href={link(lang, '/contact/')}>{p.compareCustom}</a></span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap bd-faq-wrap">
      <div class="sh"><h2 id="faq-title">{p.faqTitle}</h2></div>
      <div class="bd-faq">
        {p.faq.map((x) => (
          <details>
            <summary>{x.q}</summary>
            <p>{x.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="bd-cta-title">
    <div class="wrap">
      <div class="bd-cta">
        <div>
          <h2 id="bd-cta-title">{p.ctaTitle}</h2>
          <p>{p.ctaBody}</p>
        </div>
        <a class="btn btn-amber" href={studio}>{p.ctaButton}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .bd-hero { overflow: hidden; }
  .bd-hero-grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .bd-copy h1 { max-width: 14ch; }
  .bd-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .bd-free { margin-top: 1rem; color: var(--muted); font-size: .95rem; }

  .bd-demo { position: relative; padding-bottom: 2.5rem; }
  .bd-window { position: relative; border-radius: 16px; overflow: hidden; background: #fff; box-shadow: 0 34px 70px -30px rgba(6, 26, 45, .5), 0 0 0 1px rgba(10, 37, 62, .08); }
  .bd-bar { display: flex; align-items: center; gap: 6px; padding: .55rem .8rem; background: #F1F4F7; border-bottom: 1px solid var(--line); }
  .bd-bar i { width: 9px; height: 9px; border-radius: 50%; background: #CBD5DF; }
  .bd-bar span { margin-inline-start: auto; font-size: .75rem; font-weight: 700; color: #1E8E4E; display: flex; align-items: center; gap: .35rem; }
  .bd-bar span::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #1E8E4E; animation: bd-pulse 1.6s ease-in-out infinite; }
  .bd-frames { position: relative; aspect-ratio: 1280 / 760; }
  .bd-frame { position: absolute; inset: 0; opacity: 0; transform: scale(1.015); transition: opacity .7s ease, transform .9s ease; }
  .bd-frame.is-on { opacity: 1; transform: none; }
  .bd-scan { position: absolute; inset: 2.1rem 0 0; background: linear-gradient(180deg, transparent, rgba(255, 196, 0, .18) 48%, rgba(255, 196, 0, .32) 50%, transparent 52%); background-size: 100% 220%; background-position: 0 120%; opacity: 0; pointer-events: none; }
  .bd-demo.is-working .bd-scan { opacity: 1; animation: bd-scan 1.1s ease-in-out; }
  .bd-chat { position: absolute; inset-inline-start: 6%; bottom: 0; display: flex; align-items: center; gap: .7rem; padding: .8rem 1.1rem .8rem .8rem; background: var(--navy); color: #fff; border-radius: 16px; font-weight: 600; font-size: .95rem; box-shadow: 0 20px 40px -18px rgba(6, 26, 45, .6); max-width: 88%; min-height: 3.6rem; }
  html[dir='rtl'] .bd-chat { padding: .8rem .8rem .8rem 1.1rem; }
  .bd-chat p { min-width: 0; }
  .bd-caret { display: inline-block; width: 2px; height: 1.05em; background: var(--amber); margin-inline-start: 3px; vertical-align: text-bottom; animation: bd-blink 1s step-end infinite; }
  @keyframes bd-blink { 50% { opacity: 0; } }
  @keyframes bd-pulse { 50% { opacity: .35; } }
  @keyframes bd-scan { from { background-position: 0 120%; } to { background-position: 0 -20%; } }
  @media (prefers-reduced-motion: reduce) { .bd-caret, .bd-bar span::before { animation: none; } .bd-frame { transition: none; } }
  .bd-chat-ai { width: 36px; height: 36px; flex: none; display: grid; place-items: center; border-radius: 10px; background: var(--navy-mid); font-size: 1.2rem; }

  .bd-steps { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .bd-steps li { display: grid; gap: .5rem; align-content: start; }
  .bd-steps span { font-weight: 700; color: #8A5A00; font-size: 1.1rem; }
  .bd-steps h3 { font-size: 1.2rem; }
  .bd-steps p { color: var(--muted); }

  .bd-tpls { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .bd-tpls a { display: grid; text-decoration: none; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: #fff; transition: border-color .2s, box-shadow .2s, transform .2s; }
  .bd-tpls a:hover { border-color: var(--navy); box-shadow: 0 24px 40px -28px rgba(6, 26, 45, .5); transform: translateY(-2px); }
  .bd-tpls :global(.bd-tpl-thumb) { border-bottom: 1px solid var(--line); }
  .bd-tpl-meta { display: grid; padding: 1rem 1.2rem .2rem; }
  .bd-tpl-meta strong { font-size: 1.1rem; }
  .bd-tpl-meta small { color: var(--muted); font-size: .95rem; }
  .bd-tpl-go { padding: .4rem 1.2rem 1.1rem; color: var(--blue); font-weight: 700; font-size: .95rem; }

  .bd-quick { margin-top: 2rem; display: grid; gap: .6rem; max-width: 34rem; }
  .bd-quick label { font-weight: 700; }
  .bd-quick-row { display: flex; gap: .5rem; padding: .4rem; background: #fff; border: 1.5px solid var(--line); border-radius: 16px; box-shadow: 0 18px 40px -28px rgba(6, 26, 45, .45); }
  .bd-quick-row:focus-within { border-color: var(--blue); }
  .bd-quick input { flex: 1; min-width: 0; border: 0; outline: none; font: 400 1.05rem var(--font); padding: .7rem .8rem; background: transparent; color: var(--ink); }
  .bd-quick .btn { white-space: nowrap; padding: .9rem 1.3rem; }
  .bd-free a { color: var(--blue); font-weight: 600; }
  .bd-trust { border-block: 1px solid var(--line); background: #fff; }
  .bd-trust ul { list-style: none; display: flex; flex-wrap: wrap; justify-content: space-between; gap: .75rem 2rem; padding-block: 1.1rem; }
  .bd-trust li { display: flex; align-items: center; gap: .5rem; font-weight: 600; color: var(--muted); font-size: .95rem; }
  .bd-trust li::before { content: ''; width: .5rem; height: .9rem; border-bottom: 2.5px solid #1E8E4E; border-right: 2.5px solid #1E8E4E; transform: rotate(45deg) translateY(-2px); flex: none; }
  .bd-plans { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; align-items: stretch; }
  .bd-plans > li { position: relative; display: flex; flex-direction: column; gap: .6rem; padding: 2rem 1.75rem; border-radius: var(--radius-lg); background: var(--navy-mid); border: 1px solid rgba(255, 255, 255, .1); }
  .bd-plans > li.is-pop { background: #fff; color: var(--ink); border-color: var(--amber); box-shadow: 0 30px 60px -30px rgba(0, 0, 0, .6); }
  .bd-pop { position: absolute; top: -.8rem; inset-inline-start: 1.5rem; background: var(--amber); color: var(--navy); font-weight: 700; font-size: .8rem; padding: .3rem .8rem; border-radius: 999px; }
  .bd-plans h3 { font-size: 1.35rem; }
  .bd-plan-desc { color: var(--muted-on-navy); }
  .is-pop .bd-plan-desc { color: var(--muted); }
  .bd-price { margin-top: .25rem; }
  .bd-price b { font-size: 2.3rem; color: var(--amber); line-height: 1.1; }
  .is-pop .bd-price b { color: var(--navy); }
  .bd-price small { color: var(--muted-on-navy); }
  .is-pop .bd-price small { color: var(--muted); }
  .bd-feat { list-style: none; display: grid; gap: .55rem; margin: .6rem 0 1.2rem; flex: 1; }
  .bd-feat li { display: flex; gap: .6rem; align-items: baseline; }
  .bd-feat li::before { content: ''; width: .45rem; height: .8rem; border-bottom: 2px solid var(--amber); border-right: 2px solid var(--amber); transform: rotate(45deg); flex: none; }
  .is-pop .bd-feat li::before { border-color: #1E8E4E; }
  .bd-plans .btn { width: 100%; }
  .bd-renew { margin-top: 1.5rem; color: var(--muted-on-navy); font-size: .95rem; }
  .bd-renew a { color: var(--amber); }
  .bd-account { margin-top: 2.5rem; padding: 1.5rem 1.75rem; border-radius: var(--radius); border: 1px dashed rgba(255, 255, 255, .25); display: grid; gap: .4rem; }
  .bd-account h3 { font-size: 1.1rem; }
  .bd-account p { color: var(--muted-on-navy); }
  .bd-soon { justify-self: start; padding: .5rem 1rem; border-radius: 999px; background: var(--amber); color: var(--navy); font-weight: 700; font-size: .92rem; text-decoration: none; }
  .bd-faq-wrap { display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; }
  .bd-faq { display: grid; gap: .6rem; }
  .bd-faq details { border: 1px solid var(--line); border-radius: 14px; background: #fff; }
  .bd-faq summary { cursor: pointer; padding: 1.1rem 1.25rem; font-weight: 700; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  .bd-faq summary::-webkit-details-marker { display: none; }
  .bd-faq summary::after { content: '+'; color: var(--blue); font-size: 1.3rem; line-height: 1; }
  .bd-faq details[open] summary::after { content: '−'; }
  .bd-faq details p { padding: 0 1.25rem 1.2rem; color: var(--muted); }

  .bd-addons { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; padding: 0; }
  .bd-addons li { display: flex; flex-direction: column; gap: .5rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .bd-addons h3 { font-size: 1.15rem; }
  .bd-addons p { color: var(--muted); }
  .bd-addons li > p:not(.bd-addon-price) { flex: 1; }
  .bd-addon-ic { width: 46px; height: 46px; border-radius: 12px; background: var(--blue-soft); color: var(--navy); display: grid; place-items: center; }
  .bd-addon-ic svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .bd-addon-price { color: var(--ink) !important; }
  .bd-addon-price b { font-size: 1.3rem; color: var(--navy); }
  .bd-addon-price small { color: var(--muted); }
  .bd-addons h3 a { text-decoration: none; }
  .bd-addons h3 a:hover { color: var(--blue); }
  .bd-addon-more { font-size: .95rem; }
  .bd-partner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; margin-top: 2rem; padding: 1.25rem 1.5rem; border-radius: var(--radius); background: #FFF6E0; border: 1px solid #F5DFA6; }
  .bd-partner p { font-weight: 600; max-width: 44rem; }
  .bd-addons-note { margin-top: 1.25rem; color: var(--muted); }
  .bd-addons-note a { color: var(--blue); font-weight: 600; }
  .bd-cmp { border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; background: #fff; }
  .bd-cmp-row { display: grid; grid-template-columns: 1fr 1.3fr 1.3fr; border-top: 1px solid var(--line); }
  .bd-cmp-row:first-child { border-top: 0; }
  .bd-cmp-row > span { padding: 1rem 1.25rem; line-height: 1.6; }
  .bd-cmp-row > span:first-child { font-weight: 700; }
  .bd-cmp-row > span:last-child { color: var(--muted); }
  .bd-cmp-row > .is-studio { background: var(--blue-soft); font-weight: 600; color: var(--ink); }
  .bd-cmp-head > span { font-weight: 700; font-size: 1.1rem; color: var(--ink) !important; padding-block: 1.2rem; }
  .bd-cmp-head > .is-studio { background: var(--navy); color: #fff !important; }
  .bd-cmp-foot > span { padding-block: 1.25rem; }
  .bd-cmp-foot .btn { width: 100%; }
  .bd-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; padding: clamp(2rem, 5vw, 3.5rem); border-radius: var(--radius-lg); background: var(--blue-soft); }
  .bd-cta h2 { font-size: var(--s3); }
  .bd-cta p { color: var(--muted); margin-top: .5rem; font-size: 1.1rem; }

  @media (max-width: 960px) {
    .bd-hero-grid { grid-template-columns: 1fr; }
    .bd-steps { grid-template-columns: 1fr 1fr; }
    .bd-tpls { grid-template-columns: 1fr 1fr; }
    .bd-plans, .bd-faq-wrap { grid-template-columns: 1fr; }
    .bd-addons { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 720px) {
    .bd-cmp-row { grid-template-columns: 1fr 1fr; }
    .bd-cmp-row > span:first-child { grid-column: 1 / -1; padding-bottom: 0; }
    .bd-cmp-head > span:first-child, .bd-cmp-foot > span:first-child { display: none; }
    .bd-cmp-row > span { padding: .8rem 1rem; }
  }
  @media (max-width: 600px) {
    .bd-steps, .bd-tpls, .bd-addons { grid-template-columns: 1fr; }
    .bd-quick-row { flex-direction: column; }
    .bd-chat { font-size: .85rem; }
  }
</style>

<script>
  // Hero demo: type a request, "apply" it, show the new design. Static when motion is reduced.
  document.querySelectorAll<HTMLElement>('[data-demo]').forEach((demo) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const lines: string[] = JSON.parse(demo.querySelector('[data-demo-text]')!.textContent || '[]');
    const typed = demo.querySelector<HTMLElement>('[data-typed]')!;
    const frames = Array.from(demo.querySelectorAll<HTMLElement>('.bd-frame'));
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let i = 0;
    const run = async () => {
      for (;;) {
        const line = Array.from(lines[i]);
        typed.textContent = '';
        for (const ch of line) { typed.textContent += ch; await wait(45 + Math.random() * 40); }
        await wait(500);
        demo.classList.remove('is-working'); void demo.offsetWidth; demo.classList.add('is-working');
        await wait(550);
        frames.forEach((f, j) => f.classList.toggle('is-on', j === i % frames.length));
        await wait(2600);
        i = (i + 1) % lines.length;
      }
    };
    new IntersectionObserver((entries, obs) => { if (entries[0].isIntersecting) { obs.disconnect(); run(); } }).observe(demo);
  });
</script>
