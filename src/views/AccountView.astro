  async function seoSettings(action: string, data: Record<string, unknown>) {
    const res = await fetch(cfg.seoSettingsEndpoint, { method: 'POST', body: new URLSearchParams({ k: token, action, order_id: String(site()!.order_id), data: JSON.stringify(data) }) });
