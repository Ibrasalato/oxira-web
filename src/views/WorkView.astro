---
import { t, type Lang } from '../i18n/content';
import { asset, link } from '../lib/routes';
import { caseStudies } from '../data/case-studies';
import { caseText, cpLang } from '../i18n/companyPages';
import Base from '../layouts/Base.astro';
import ClientStrip from '../components/ClientStrip.astro';
import CtaBand from '../components/CtaBand.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t[lang];
const pg = c.pages.work;
// Case study pages exist in Arabic and English only, and only for projects listed in src/data/case-studies.ts.
const cl = cpLang(lang);
const caseFor = (slug: string) => (cl && caseStudies.some((cs) => cs.slug === slug) ? link(lang, `/work/${slug}/`) : null);
---
<Base lang={lang} path="/work/" title={pg.title} description={pg.description}>
  <section class="page-hero">
    <div class="wrap">
      <h1>{pg.h1}</h1>
      <p class="lead">{pg.lead}</p>
    </div>
  </section>

  <section class="section-tight" aria-label={c.work.title}>
    <div class="wrap">
      <ol class="projects">
        {c.work.projects.map((p, i) => (
          <li class={`project ${i % 2 ? 'flip' : ''}`}>
            <div class="p-shot"><img src={asset(`work/${p.slug}.webp`)} alt="" width="1200" height="808" loading={i === 0 ? 'eager' : 'lazy'} /></div>
            <div class="p-body">
              <div class="p-logo"><img src={asset(`work/${p.slug}-logo.png`)} alt="" loading="lazy" /></div>
              {p.sector && <span class="p-sector">{p.sector}</span>}
              <h2>{p.name}</h2>
              <p>{p.text}</p>
              {caseFor(p.slug) && cl && <a class="more p-case" href={caseFor(p.slug)}>{caseText[cl].readCase}</a>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="clients-title">
    <div class="wrap">
      <div class="sh"><h2 id="clients-title">{c.clients.title}</h2><p>{c.clients.body}</p></div>
      <ClientStrip lang={lang} variant="grid" />
    </div>
  </section>

  <div style="height: var(--section)"></div>
  <CtaBand lang={lang} />
</Base>

<style>
  .projects { list-style: none; display: grid; gap: clamp(3rem, 7vw, 6rem); }
  .project { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .project.flip .p-shot { order: 2; }
  .p-shot { border-radius: var(--radius-lg); overflow: hidden; background: #EEF2F5; box-shadow: 0 0 0 1px var(--line); aspect-ratio: 16 / 10.8; }
  .p-shot img { width: 100%; height: 100%; object-fit: cover; }
  .p-body { display: grid; gap: .6rem; justify-items: start; }
  .p-logo { width: 76px; height: 76px; border-radius: 18px; background: #fff; box-shadow: 0 0 0 1px var(--line); display: grid; place-items: center; margin-bottom: .75rem; }
  .p-logo img { width: 70%; height: 70%; object-fit: contain; }
  .p-sector { color: var(--blue); font-weight: 700; }
  .p-body h2 { font-size: var(--s3); }
  .p-body p { color: var(--muted); font-size: 1.1rem; }
  .p-case { margin-top: .4rem; }
  @media (max-width: 860px) { .project { grid-template-columns: 1fr; } .project.flip .p-shot { order: 0; } }
</style>
