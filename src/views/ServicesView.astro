---
import { t, type Lang } from '../i18n/content';
import { link } from '../lib/routes';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import ProductCards from '../components/ProductCards.astro';
import { productsText } from '../i18n/products';
import { landingsByIcon, locationLandings, landingPath } from '../i18n/landing';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t[lang];
const pg = c.pages.services;
const other = lang === 'ar' ? 'en' : 'ar';
// Service and location pages exist in Arabic and English only.
const lp = lang === 'ar' || lang === 'en' ? lang : null;
---
<Base lang={lang} path="/services/" title={pg.title} description={pg.description}>
  <section class="page-hero">
    <div class="wrap">
      <h1>{pg.h1}</h1>
      <p class="lead">{pg.lead}</p>
      <nav class="jump" aria-label={pg.h1}>
        {c.services.list.map((s) => <a href={s.icon === 'agent' ? link(lang, '/ai-agents/') : `#${s.icon}`}>{s.name}</a>)}
      </nav>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <ol class="svc-list">
        {c.services.list.map((s) => (
          <li id={s.icon} class="svc-row">
            <div class="svc-name">
              <span class="svc-icon"><Icon name={s.icon} /></span>
              <h2>{s.name}</h2>
              {lang === 'ar' && <p class="svc-alt" lang="en">{s.en}</p>}
            </div>
            <div>
              <ul class="svc-items">
                {s.items.map((it) => <li>{it}</li>)}
              </ul>
              {lp && landingsByIcon(s.icon).length > 0 && (
                <ul class="svc-pages">
                  {landingsByIcon(s.icon).map((l) => <li><a href={link(lang, landingPath(l))}>{l[lp].name}</a></li>)}
                </ul>
              )}
            </div>
            <div class="svc-go">
              {s.icon === 'agent'
                ? <a class="more" href={link(lang, '/ai-agents/')}>{c.home.agentsLink}</a>
                : <a class="more" href={`${link(lang, '/contact/')}?service=${encodeURIComponent(s.name)}`}>{c.hero.cta}</a>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {lp && (
    <section class="section-tight svc-where" aria-labelledby="where-title">
      <div class="wrap">
        <h2 id="where-title">{lp === 'ar' ? 'نخدمك أينما كنت' : 'Where we work'}</h2>
        <ul class="svc-pages">
          {locationLandings.map((l) => <li><a href={link(lang, landingPath(l))}>{l[lp].name}</a></li>)}
        </ul>
      </div>
    </section>
  )}

  <section class="section bg-paper" id="monthly" aria-labelledby="monthly-title">
    <div class="wrap">
      <div class="sh-row">
        <div class="sh"><h2 id="monthly-title">{productsText[lang].common.servicesTitle}</h2><p>{productsText[lang].common.servicesBody}</p></div>
        <a class="more" href={link(lang, '/products/')}>{productsText[lang].nav.all}</a>
      </div>
      <ProductCards lang={lang} />
    </div>
  </section>

  <section class="section" aria-labelledby="process-title">
    <div class="wrap">
      <div class="sh"><h2 id="process-title">{c.process.title}</h2></div>
      <ol class="process">
        {c.process.steps.map((st, i) => (
          <li>
            <span class="p-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{st.name}</h3>
            <p>{st.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <div class="section-spacer"></div>
  <CtaBand lang={lang} />
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 2.5rem; }
  .jump a { text-decoration: none; font-weight: 600; font-size: .95rem; padding: .55rem 1rem; border-radius: 999px; border: 1px solid var(--line); color: var(--ink); }
  .jump a:hover { border-color: var(--navy); }

  .svc-list { list-style: none; border-top: 1px solid var(--line); }
  .svc-row { display: grid; grid-template-columns: 1.1fr 1.4fr auto; gap: clamp(1.5rem, 4vw, 4rem); padding-block: clamp(2.25rem, 4vw, 3.25rem); border-bottom: 1px solid var(--line); scroll-margin-top: 6rem; align-items: start; }
  .svc-icon { width: 52px; height: 52px; border-radius: 14px; background: var(--blue-soft); color: var(--blue); display: grid; place-items: center; font-size: 28px; margin-bottom: 1rem; }
  .svc-name h2 { font-size: var(--s2); }
  .svc-alt { color: var(--muted); font-weight: 600; margin-top: .25rem; }
  .svc-items { list-style: none; display: grid; gap: .75rem; }
  .svc-items li { position: relative; padding-inline-start: 1.5rem; font-size: 1.08rem; }
  .svc-items li::before { content: ''; position: absolute; inset-inline-start: 0; top: .7em; width: 8px; height: 8px; border-radius: 2px; background: var(--amber); }
  .svc-go { align-self: end; }
  .svc-pages { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.25rem; }
  .svc-pages a { display: inline-block; text-decoration: none; font-weight: 600; font-size: .95rem; padding: .5rem 1rem; border-radius: 999px; border: 1px solid var(--line); color: #00699A; }
  .svc-pages a:hover { border-color: var(--navy); }
  .svc-where { padding-top: 0; }
  .svc-where h2 { font-size: var(--s1); }
  @media (max-width: 960px) { .svc-row { grid-template-columns: 1fr; } }

  .process { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .process li { display: grid; gap: .6rem; align-content: start; }
  .p-n { font-weight: 700; font-size: 2.4rem; line-height: 1; color: var(--amber); }
  .process h3 { font-size: var(--s1); }
  .process p { color: var(--muted); }
  @media (max-width: 860px) { .process { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .process { grid-template-columns: 1fr; } }

  .section-spacer { height: var(--section); }
</style>
