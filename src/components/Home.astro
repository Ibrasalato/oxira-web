---
import { t, contact, clientLogos, type Lang } from '../i18n/content';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Products from './Products.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p: string) => `${base}/${p}`;
const altHref = lang === 'ar' ? `${base}/en/` : `${base}/`;
// Form messages go to the n8n workflow "Oxira 2 — Website contact form",
// which saves them and emails them to info@oxira.sa.
// Set PUBLIC_FORM_ENDPOINT to send them somewhere else.
const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || 'https://ibrasalato.app.n8n.cloud/webhook/oxira-website-contact';
const other = lang === 'ar' ? 'en' : 'ar';

// Wire-mesh waves, like the profile cover: two families of curves warped around a centre.
function mesh(w: number, h: number, rows: number, cols: number) {
  const paths: string[] = [];
  const warp = (x: number, y: number) => {
    const dx = (x - w * 0.62) / w, dy = (y - h * 0.55) / h;
    const g = Math.exp(-(dx * dx * 6 + dy * dy * 5));
    return { x: x + 90 * g * Math.sin(dy * 7), y: y + 70 * g * Math.cos(dx * 6) + 24 * Math.sin(x / w * 5.2) };
  };
  for (let r = 0; r <= rows; r++) {
    const pts: string[] = [];
    for (let i = 0; i <= 60; i++) {
      const p = warp((i / 60) * w, (r / rows) * h);
      pts.push(`${p.x.toFixed(1)},${p.y.toFixed(1)}`);
    }
    paths.push(`M${pts.join('L')}`);
  }
  for (let col = 0; col <= cols; col++) {
    const pts: string[] = [];
    for (let i = 0; i <= 40; i++) {
      const p = warp((col / cols) * w, (i / 40) * h);
      pts.push(`${p.x.toFixed(1)},${p.y.toFixed(1)}`);
    }
    paths.push(`M${pts.join('L')}`);
  }
  return paths.join('');
}
const heroMesh = mesh(1400, 720, 26, 44);
const serviceMesh = mesh(1400, 900, 22, 38);

// Network of points and lines, like the profile's contact page.
function network(w: number, h: number, n: number, seed: number) {
  let s = seed;
  const rnd = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
  const pts = Array.from({ length: n }, () => [rnd() * w, rnd() * h]);
  const lines: string[] = [];
  pts.forEach(([x, y], i) => {
    pts.slice(i + 1).forEach(([x2, y2]) => {
      if (Math.hypot(x - x2, y - y2) < w / 5.5) lines.push(`M${x.toFixed(0)},${y.toFixed(0)}L${x2.toFixed(0)},${y2.toFixed(0)}`);
    });
  });
  return { d: lines.join(''), pts };
}
const net = network(1400, 800, 34, 7);
---
<header class="top">
  <div class="wrap top-row">
    <a class="brand" href={lang === 'en' ? `${base}/en/` : `${base}/`} aria-label="Oxira">
      <Logo variant="dark" />
    </a>
    <nav class="nav" aria-label={lang === 'ar' ? 'القائمة الرئيسية' : 'Main'}>
      <a href="#about">{c.nav.about}</a>
      <a href="#services">{c.nav.services}</a>
      <a href="#agents">{c.agents.navLabel}</a>
      <a href="#products">{c.products.navLabel}</a>
      <a href="#clients">{c.nav.clients}</a>
      <a href="#work">{c.nav.work}</a>
      <a class="lang" href={altHref} hreflang={other} lang={other}>{c.switchLabel}</a>
      <a class="btn btn-amber nav-cta" href="#contact">{c.nav.contact}</a>
    </nav>
  </div>
</header>

<main>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <svg class="hero-mesh" viewBox="0 0 1400 720" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path d={heroMesh} />
    </svg>
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="kicker">{c.hero.kicker}</p>
        <h1 id="hero-title">{c.hero.title}</h1>
        <p class="hero-body">{c.hero.body}</p>
        <div class="hero-actions">
          <a class="btn btn-amber" href="#contact">{c.hero.cta}</a>
          <a class="btn btn-outline-light" href="#services">{c.hero.secondary}</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <svg class="circuit" viewBox="0 0 420 420">
          <g fill="none" stroke="var(--cyan)" stroke-width="2.5" stroke-linecap="round">
            <path d="M40 120h70l22-22" /><path d="M60 170v70l-24 24" /><path d="M300 330h60l20 20" />
            <path d="M370 90v80l-20 20" /><path d="M300 60h55" /><path d="M70 360h80l18-18" />
          </g>
          <g fill="var(--cyan)">
            <circle cx="40" cy="120" r="5" /><circle cx="132" cy="98" r="5" /><circle cx="60" cy="170" r="5" /><circle cx="36" cy="264" r="5" />
            <circle cx="380" cy="350" r="5" /><circle cx="300" cy="330" r="5" /><circle cx="370" cy="90" r="5" /><circle cx="350" cy="190" r="5" />
            <circle cx="300" cy="60" r="5" /><circle cx="355" cy="60" r="5" /><circle cx="70" cy="360" r="5" /><circle cx="168" cy="342" r="5" />
          </g>
        </svg>
        <div class="hero-mark"><Logo variant="dark" wordmark={false} /></div>
      </div>
    </div>
  </section>

  <!-- About: introduction, vision, mission -->
  <section id="about" class="about" aria-labelledby="about-title">
    <div class="wrap about-grid">
      <div class="intro">
        <h2 id="about-title">{c.about.introTitle}<span class="alt" lang={other}>{c.about.introEn}</span></h2>
        <p>{c.about.intro}</p>
      </div>
      <div class="vm">
        <article class="vm-card">
          <h3 class="tag-amber">{c.about.visionTitle}<span class="alt" lang={other}>{c.about.visionEn}</span></h3>
          <p>{c.about.vision}</p>
        </article>
        <article class="vm-card">
          <h3 class="tag-amber">{c.about.missionTitle}<span class="alt" lang={other}>{c.about.missionEn}</span></h3>
          <p>{c.about.mission}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="services" aria-labelledby="services-title">
    <svg class="services-mesh" viewBox="0 0 1400 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path d={serviceMesh} />
    </svg>
    <div class="wrap">
      <div class="head head-light">
        <h2 id="services-title">{c.services.title}</h2>
        <p>{c.services.body}</p>
      </div>
      <ul class="service-grid">
        {c.services.list.map((s) => (
          <li class="service">
            <div class="badge">
              <svg class="badge-ring" viewBox="0 0 100 100" aria-hidden="true">
                <circle cx="50" cy="50" r="46" fill="none" stroke="var(--amber)" stroke-width="7" stroke-dasharray="144.5 289" transform="rotate(-90 50 50)" />
                <circle cx="50" cy="50" r="38" fill="#fff" />
                <circle cx="50" cy="50" r="33" fill="none" stroke="var(--amber)" stroke-width="1.5" stroke-dasharray="80 207" transform="rotate(120 50 50)" />
              </svg>
              <Icon name={s.icon} class="badge-icon" />
            </div>
            <h3>{s.name}</h3>
            <p class="service-alt" lang={other}>{s.en}</p>
            <ul class="service-items">
              {s.items.map((it) => <li>{it}</li>)}
            </ul>
            {s.icon === 'agent' && <a class="service-more" href="#agents">{c.agents.navLabel}</a>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- AI Agent Automation -->
  <section id="agents" class="agents" aria-labelledby="agents-title">
    <div class="wrap">
      <div class="agents-top">
        <div class="agents-intro">
          <p class="agents-kicker" lang={other}>{c.agents.kicker}</p>
          <h2 id="agents-title">{c.agents.title}</h2>
          <p class="agents-body">{c.agents.body}</p>
          <ul class="caps">
            {c.agents.capabilities.map((cap) => (
              <li><h3>{cap.name}</h3><p>{cap.text}</p></li>
            ))}
          </ul>
        </div>

        <div class="demo">
          <div class="demo-tabs" role="tablist" aria-label={c.agents.demoLabel}>
            {c.agents.chats.map((ch, i) => (
              <button type="button" role="tab" id={`tab-${ch.id}`} aria-controls={`chat-${ch.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{ch.tab}</button>
            ))}
          </div>
          <div class="phone">
            <div class="phone-screen">
              {c.agents.chats.map((ch, i) => (
                <div class="chat" role="tabpanel" id={`chat-${ch.id}`} aria-labelledby={`tab-${ch.id}`} hidden={i !== 0}>
                  <div class="chat-head">
                    <span class="chat-avatar"><Icon name="agent" /></span>
                    <span><strong>{ch.name}</strong><small>{c.agents.online}</small></span>
                  </div>
                  <ol class="chat-body">
                    {ch.messages.map((m) => (
                      <li class={`msg msg-${m.from}`}>
                        {'voice' in m && m.voice ? (
                          <span class="voice" aria-label={`${c.agents.voice} ${m.voice}`}>
                            <span class="voice-play" aria-hidden="true"></span>
                            <span class="voice-wave" aria-hidden="true">{Array.from({ length: 22 }, (_, k) => <i style={`height:${4 + ((k * 7) % 13)}px`}></i>)}</span>
                            <span class="voice-len">{m.voice}</span>
                          </span>
                        ) : (
                          <span class="msg-text">{'text' in m ? m.text : ''}</span>
                        )}
                        <time>{m.time}{m.from === 'user' && <span class="ticks" aria-hidden="true">✓✓</span>}</time>
                      </li>
                    ))}
                  </ol>
                  <div class="chat-input" aria-hidden="true"><span>{c.agents.typeHere}</span><span class="mic"></span></div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="sectors">
        <div class="head">
          <h2 class="h-sm">{c.agents.sectorsTitle}</h2>
          <p>{c.agents.sectorsBody}</p>
        </div>
        <ul class="sector-grid">
          {c.agents.sectors.map((s) => (
            <li class="sector">
              <h3>{s.name}</h3>
              <p class="sector-who">{s.who}</p>
              <p>{s.text}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="steps-row">
        <div>
          <h2 class="h-sm">{c.agents.stepsTitle}</h2>
          <ol class="steps">
            {c.agents.steps.map((st, i) => (
              <li><span class="step-n" aria-hidden="true">{i + 1}</span><div><h3>{st.name}</h3><p>{st.text}</p></div></li>
            ))}
          </ol>
        </div>
        <div class="pricing">
          <p>{c.agents.pricing}</p>
          <a class="btn btn-amber" href="#contact" data-pick-service={c.agents.serviceValue}>{c.agents.cta}</a>
        </div>
      </div>
    </div>
  </section>

  <Products lang={lang} />

  <!-- Advantages -->
  <section class="adv" aria-labelledby="adv-title">
    <div class="wrap">
      <div class="head head-center">
        <h2 id="adv-title">{c.advantages.title}</h2>
        <p class="adv-sub">{c.advantages.sub}</p>
      </div>
      <ol class="adv-grid">
        {c.advantages.list.map((a, i) => (
          <li class="adv-item">
            <span class="adv-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="tag-amber tag-sm">{a.name}</h3>
              <p>{a.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Clients -->
  <section id="clients" class="clients" aria-labelledby="clients-title">
    <div class="wrap">
      <div class="head head-center">
        <h2 id="clients-title">{c.clients.title}</h2>
        <p>{c.clients.body}</p>
      </div>
      <ul class="client-grid">
        {clientLogos.map((cl) => (
          <li class="client">
            <img src={asset(`clients/${cl.file}`)} alt={cl[lang]} loading="lazy" decoding="async" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Work -->
  <section id="work" class="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="head">
        <h2 id="work-title">{c.work.title}</h2>
        <p>{c.work.body}</p>
      </div>
      <ul class="projects">
        {c.work.projects.map((p) => (
          <li class="project">
            <div class="project-shot">
              <img src={asset(`work/${p.slug}.webp`)} alt="" loading="lazy" decoding="async" width="1200" height="808" />
            </div>
            <div class="project-body">
              <div class="project-logo"><img src={asset(`work/${p.slug}-logo.png`)} alt="" loading="lazy" /></div>
              <div>
                <span class="tag-blue">{p.sector}</span>
                <h3>{p.name}</h3>
              </div>
              <p>{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Call to action -->
  <section class="cta-band" aria-labelledby="cta-title">
    <div class="wrap cta-row">
      <div>
        <h2 id="cta-title">{c.cta.title}</h2>
        <p>{c.cta.body}</p>
      </div>
      <a class="btn btn-amber" href="#contact">{c.cta.button}</a>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="contact" aria-labelledby="contact-title">
    <svg class="net" viewBox="0 0 1400 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path d={net.d} />
      {net.pts.map(([x, y]) => <circle cx={x.toFixed(0)} cy={y.toFixed(0)} r="3.5" />)}
    </svg>
    <div class="wrap contact-grid">
      <div class="contact-info">
        <h2 id="contact-title">{c.contact.title}</h2>
        <p class="contact-lead">{c.contact.body}</p>
        <ul class="details">
          <li><Icon name="phone" class="d-icon" /><span class="sr-only">{c.contact.labels.phone}: </span><a href={contact.phoneHref} dir="ltr">{contact.phone}</a></li>
          <li><Icon name="whatsapp" class="d-icon" /><span class="sr-only">{c.contact.labels.whatsapp}: </span><a href={contact.whatsappHref} target="_blank" rel="noopener">{c.contact.labels.whatsapp}</a></li>
          <li><Icon name="mail" class="d-icon" /><span class="sr-only">{c.contact.labels.email}: </span><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li><Icon name="support" class="d-icon" /><a href="#contact" data-pick-type="support">{c.contact.labels.support}</a></li>
          <li class="wide"><Icon name="pin" class="d-icon" /><span class="sr-only">{c.contact.labels.address}: </span><span>{c.contact.address}</span></li>
        </ul>
      </div>

      <form class="form" id="lead-form" novalidate
            data-endpoint={formEndpoint}
            data-email={contact.email}
            data-msg-sending={c.contact.form.sending}
            data-msg-sent={c.contact.form.sent}
            data-msg-failed={c.contact.form.failed}
            data-msg-pending={c.contact.form.pending}
            data-whatsapp={contact.whatsappHref}
            data-msg-required={c.contact.form.required}
            data-label-submit={c.contact.form.submit}
            data-subject-project={c.contact.form.subjectProject}
            data-subject-support={c.contact.form.subjectSupport}
            data-details-project={c.contact.form.details}
            data-details-support={c.contact.form.detailsSupport}
            data-hint-support={c.contact.form.detailsSupportHint}>
        <h3>{c.contact.form.title}</h3>
        <fieldset class="type-toggle">
          <legend class="sr-only">{c.contact.form.type}</legend>
          <label><input type="radio" name="type" value="project" checked /><span>{c.contact.form.typeProject}</span></label>
          <label><input type="radio" name="type" value="support" /><span>{c.contact.form.typeSupport}</span></label>
        </fieldset>
        <label class="field">
          <span>{c.contact.form.name}</span>
          <input name="name" autocomplete="name" required />
        </label>
        <div class="field-row">
          <label class="field">
            <span>{c.contact.form.email}</span>
            <input name="email" type="email" autocomplete="email" dir="ltr" />
          </label>
          <label class="field">
            <span>{c.contact.form.phone}</span>
            <input name="phone" type="tel" autocomplete="tel" dir="ltr" />
          </label>
        </div>
        <label class="field">
          <span>{c.contact.form.service}</span>
          <select name="service">
            <option value="">{c.contact.form.serviceAny}</option>
            {c.services.list.map((s) => <option value={s.name}>{s.name}</option>)}
            <option value={c.products.ctaValue}>{c.products.ctaValue}</option>
            <option value={c.contact.form.other}>{c.contact.form.other}</option>
          </select>
        </label>
        <label class="field">
          <span class="details-label">{c.contact.form.details}</span>
          <textarea name="details" rows="4" required></textarea>
        </label>
        <input type="text" name="company_website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="btn btn-navy" type="submit">{c.contact.form.submit}</button>
        <div class="form-status" role="status" aria-live="polite">
          <p class="fs-text"></p>
          <div class="fs-links" hidden>
            <a class="fs-mail" href="#">{c.contact.form.viaEmail}</a>
            <a class="fs-wa" href="#" target="_blank" rel="noopener">{c.contact.form.viaWhatsapp}</a>
          </div>
        </div>
      </form>
    </div>
  </section>
</main>

<footer class="foot">
  <div class="wrap foot-row">
    <Logo variant="dark" class="foot-logo" />
    <nav class="foot-nav" aria-label={lang === 'ar' ? 'روابط سريعة' : 'Quick links'}>
      <a href="#about">{c.nav.about}</a>
      <a href="#services">{c.nav.services}</a>
      <a href="#contact">{c.nav.contact}</a>
      <a href="#contact" data-pick-type="support">{c.contact.labels.support}</a>
      <a href={altHref} lang={other}>{c.switchLabel}</a>
    </nav>
    <p>© {new Date().getFullYear()} {c.footer.rights}</p>
  </div>
</footer>

<script>
  // Sector tabs for the AI agent chat demo
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.demo-tabs [role=tab]'));
  const select = (tab: HTMLButtonElement) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls')!);
      if (panel) panel.hidden = !on;
    });
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const rtl = document.documentElement.dir === 'rtl';
      const next = e.key === (rtl ? 'ArrowLeft' : 'ArrowRight');
      const prev = e.key === (rtl ? 'ArrowRight' : 'ArrowLeft');
      if (!next && !prev) return;
      e.preventDefault();
      const t = tabs[(i + (next ? 1 : -1) + tabs.length) % tabs.length];
      select(t); t.focus();
    });
  });

  // Buttons that jump to the form with a service already chosen
  document.querySelectorAll<HTMLAnchorElement>('[data-pick-service]').forEach((a) => {
    a.addEventListener('click', () => {
      const sel = document.querySelector<HTMLSelectElement>('#lead-form select[name=service]');
      if (sel) sel.value = a.dataset.pickService!;
    });
  });

  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector('.form-status') as HTMLElement;
    const button = form.querySelector('button[type=submit]') as HTMLButtonElement;
    const detailsLabel = form.querySelector('.details-label') as HTMLElement;
    const detailsBox = form.querySelector('textarea[name=details]') as HTMLTextAreaElement;
    const d = form.dataset;
    const fsText = status.querySelector('.fs-text') as HTMLElement;
    const fsLinks = status.querySelector('.fs-links') as HTMLElement;
    const show = (state: 'ok' | 'error' | '', text: string, links?: { mail: string; wa: string }) => {
      status.dataset.state = state;
      fsText.textContent = text;
      fsLinks.hidden = !links;
      if (links) {
        (fsLinks.querySelector('.fs-mail') as HTMLAnchorElement).href = links.mail;
        (fsLinks.querySelector('.fs-wa') as HTMLAnchorElement).href = links.wa;
      }
      if (state) status.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    // Project vs technical support: relabel the description field
    const setType = (type: string) => {
      const radio = form.querySelector<HTMLInputElement>(`input[name=type][value=${type}]`);
      if (radio) radio.checked = true;
      const support = type === 'support';
      detailsLabel.textContent = support ? d.detailsSupport! : d.detailsProject!;
      detailsBox.placeholder = support ? d.hintSupport! : '';
    };
    form.querySelectorAll<HTMLInputElement>('input[name=type]').forEach((r) => r.addEventListener('change', () => setType(r.value)));
    document.querySelectorAll<HTMLAnchorElement>('[data-pick-type]').forEach((a) => {
      a.addEventListener('click', () => setType(a.dataset.pickType!));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      if (data.company_website) return; // spam bot filled the hidden field
      delete data.company_website;

      if (!data.name?.trim() || !data.details?.trim() || !(data.email?.trim() || data.phone?.trim())) {
        show('error', d.msgRequired!);
        const firstEmpty = [form.elements.namedItem('name'), form.elements.namedItem('email'), form.elements.namedItem('details')]
          .find((el) => el && !(el as HTMLInputElement).value.trim()) as HTMLElement | undefined;
        firstEmpty?.focus();
        return;
      }

      const support = data.type === 'support';
      const subject = `${support ? d.subjectSupport : d.subjectProject}: ${data.name}`;
      const labels = Array.from(form.querySelectorAll('.field')).reduce<Record<string, string>>((acc, f) => {
        const input = f.querySelector('input, select, textarea') as HTMLInputElement | null;
        const label = f.querySelector('span');
        if (input && label) acc[input.name] = label.textContent!.trim();
        return acc;
      }, {});

      // Readable copy of the message, used for the email/WhatsApp fallback links
      const payload: Record<string, string> = {
        [form.querySelector('legend')!.textContent!.trim()]: form.querySelector('input[name=type]:checked + span')!.textContent!.trim(),
      };
      for (const [k, v] of Object.entries(data)) {
        if (k === 'type' || !v) continue;
        payload[labels[k] || k] = v;
      }

      button.disabled = true;
      button.textContent = d.msgSending!;
      show('', '');
      const text = Object.entries(payload).filter(([k]) => !k.startsWith('_')).map(([k, v]) => `${k}: ${v}`).join('\n');
      const links = {
        mail: `mailto:${d.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(text)}`,
        wa: `${d.whatsapp}?text=${encodeURIComponent(subject + '\n\n' + text)}`,
      };
      try {
        const res = await fetch(d.endpoint!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ ...data, lang: document.documentElement.lang, page: location.href }),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok || String(out.success) !== 'true') throw new Error(out.message || String(res.status));
        form.reset();
        setType('project');
        show('ok', d.msgSent!);
      } catch {
        show('error', d.msgFailed!, links);
      } finally {
        button.disabled = false;
        button.textContent = d.labelSubmit!;
      }
    });
  }
</script>

