  // Post designs: the photo (AI or the owner's) with the headline and the business name, in the brand colours.
  const imgCache: Record<string, Promise<HTMLImageElement | null>> = {};
  function loadImg(id: string) {
    if (!id) return Promise.resolve(null);
    if (!imgCache[id]) imgCache[id] = new Promise((ok) => { const im = new Image(); im.crossOrigin = 'anonymous'; im.onload = () => ok(im); im.onerror = () => ok(null); im.src = imgUrl(id); });
    return imgCache[id];
  }
  async function drawDesign(c: HTMLCanvasElement, x: any, title: string) {
    const s0 = site()!;
    const ctx = c.getContext('2d')!;
    const W = c.width, H = c.height;
    const p = s0.spec?.colors?.primary || '#0A253E', a = s0.spec?.colors?.accent || '#F5A800';
    const rtl = /[؀-ۿ]/.test(title) || (!title && (s0.spec?.lang || 'ar') === 'ar');
    const font = getComputedStyle(document.body).fontFamily;
    const im = await loadImg(bgOverride[x.id] || x.bg);
    if (im) {
      const sc = Math.max(W / im.width, H / im.height);
      ctx.drawImage(im, (W - im.width * sc) / 2, (H - im.height * sc) / 2, im.width * sc, im.height * sc);
      const g = ctx.createLinearGradient(0, H * 0.45, 0, H);
      g.addColorStop(0, 'rgba(0,0,0,0)'); g.addColorStop(1, 'rgba(0,0,0,.78)');
      ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
    } else {
      ctx.fillStyle = p; ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = a; ctx.globalAlpha = .9; ctx.beginPath(); ctx.arc(rtl ? 120 : W - 120, 120, 260, 0, Math.PI * 2); ctx.fill(); ctx.globalAlpha = 1;
    }
    const pad = 80;
    ctx.direction = rtl ? 'rtl' : 'ltr'; ctx.textAlign = rtl ? 'right' : 'left';
    const tx = rtl ? W - pad : pad;
    const size = W >= 1080 ? 84 : 60;
    ctx.font = `700 ${size}px ${font}`;
    const words = String(title || '').split(/\s+/).filter(Boolean); const lines: string[] = []; let line = '';
    for (const w of words) { const t = line ? line + ' ' + w : w; if (ctx.measureText(t).width > W - pad * 2 && line) { lines.push(line); line = w; } else line = t; }
    if (line) lines.push(line);
    const L = lines.slice(0, 4);
    const baseY = H - 210 - (L.length - 1) * size * 1.2;
    ctx.fillStyle = '#FFFFFF'; ctx.shadowColor = 'rgba(0,0,0,.35)'; ctx.shadowBlur = im ? 12 : 0;
    L.forEach((l, i) => ctx.fillText(l, tx, baseY + i * size * 1.2));
    ctx.shadowBlur = 0;
    ctx.fillStyle = a; ctx.fillRect(rtl ? W - pad - 120 : pad, H - 150, 120, 10);
    ctx.font = `600 38px ${font}`; ctx.fillStyle = '#FFFFFF'; ctx.globalAlpha = .92;
    ctx.fillText(s0.name || '', tx, H - 80); ctx.globalAlpha = 1;
  }
  function paintSocial(v: any) {
    for (const c of root.querySelectorAll<HTMLCanvasElement>('canvas[data-soc-canvas]')) {
      const x = (v.items || []).find((i: any) => String(i.id) === c.dataset.socCanvas);
      if (x) drawDesign(c, x, x.title);
    }
  }
  async function uploadBlob(blob: Blob, name: string): Promise<string | null> {
    const fd = new FormData();
    fd.append('file', blob, name);
    fd.append('sessionId', 'social-' + site()!.order_id);
    const res = await fetch(cfg.uploadEndpoint, { method: 'POST', body: fd });
    const data = await res.json().catch(() => ({}));
    return data?.success && typeof data.id === 'string' ? data.id : null;
  }
  async function shrinkFile(file: File, max = 1600): Promise<Blob> {
    const bmp = await createImageBitmap(file);
    const sc = Math.min(1, max / Math.max(bmp.width, bmp.height));
    const c = document.createElement('canvas'); c.width = Math.round(bmp.width * sc); c.height = Math.round(bmp.height * sc);
    c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
    return new Promise((ok, fail) => c.toBlob((b) => (b ? ok(b) : fail(new Error('encode'))), 'image/jpeg', 0.86));
  }
  const canvasBlob = (c: HTMLCanvasElement) => new Promise<Blob | null>((ok) => c.toBlob((b) => ok(b), 'image/jpeg', 0.9));

