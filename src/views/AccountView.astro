  // ---- SEO add-on (Oxira 18 API): suggestions waiting for approval, Google report, weekly health ----
  const seoCache: Record<number, any> = {};
  async function seoApi(data: Record<string, string>) {
    const res = await fetch(cfg.seoEndpoint, { method: 'POST', body: new URLSearchParams({ k: token, ...data }) });
    return res.json().catch(() => ({ success: false }));
  }
  async function loadSeo(orderId: number, force = false) {
    const box = root.querySelector<HTMLElement>('#ac-seo');
    if (!box) return;
    if (!seoCache[orderId] || force) {
      const v = await seoApi({ action: 'list', order_id: String(orderId) });
      if (v?.reason === 'expired') { signOut(T.expired); return; }
      seoCache[orderId] = v?.success ? v : { items: [], report: null, health: null };
    }
    if (site()!.order_id === orderId) box.innerHTML = seoHtml(seoCache[orderId]);
  }
  function seoHtml(v: any) {
    const nf = new Intl.NumberFormat(cfg.numberLocale);
    const s0 = site()!;
    const growth = has('seogrowth');
    const st = v.settings || {}, brief = st.brief || {}, gbp = st.gbp || {}, wp = st.wp || {};
    const wpOn = !!(v.external && wp.ok);
    const rep = v.report;
    const cur = rep && rep.cur;
    const head = `<div class="ac-seo-head ac-noprint"><button type="button" class="btn btn-ghost ac-small-btn" data-seo-print>${esc(T.seoPrint)}</button></div>
      <div class="ac-print-only"><h1>${esc(T.seoReportFor)}</h1><p>${esc(s0.name || s0.domain || '')} · <span dir="ltr">${esc(s0.url || '')}</span> · ${esc(new Date().toLocaleDateString(cfg.lang === 'ar' ? 'ar-SA-u-nu-latn-ca-gregory' : cfg.numberLocale, { day: 'numeric', month: 'long', year: 'numeric' }))}</p></div>`;
    // Leads (websites hosted by Oxira)
    const LK = ['tel', 'wa', 'mail', 'form'] as const;
    const sum = (o: any, keys: readonly string[]) => keys.reduce((a, k) => a + (Number(o?.[k]) || 0), 0);
    const last = rep?.leads;
    const leads = v.external ? '' : card(`<h2>${esc(T.seoLeadsTitle)}</h2>
      <div class="ac-leads">
        <div><p class="ac-kicker">${esc(T.seoLeadsNow)}</p><b class="ac-big">${nf.format(sum(v.leadsNow, LK))}</b>
          <ul>${LK.map((k) => `<li><span>${esc(T.seoLeadKinds[k])}</span><b>${nf.format(Number(v.leadsNow?.[k]) || 0)}</b></li>`).join('')}</ul></div>
        ${last ? `<div><p class="ac-kicker">${esc(T.seoLeadsLast)} <span dir="ltr">${esc(last.month || '')}</span></p><b class="ac-big">${nf.format(sum(last, [...LK, 'bookings']))}</b>
          <ul>${[...LK, 'bookings'].map((k) => `<li><span>${esc(T.seoLeadKinds[k])}</span><b>${nf.format(Number(last[k]) || 0)}</b></li>`).join('')}</ul></div>` : ''}
      </div><p class="ac-muted ac-small">${esc(T.seoLeadsNote)}</p>`);
    // Google: last 28 days + monthly trend
    const hist = (v.history || []).filter((x: any) => x.cur);
    const maxC = Math.max(1, ...hist.map((x: any) => x.cur.clicks || 0));
    const trend = hist.length > 1 ? `<h3 class="ac-h3">${esc(T.seoTrend)}</h3><div class="ac-bars" role="img" aria-label="${esc(T.seoTrend)}">${hist.map((x: any) => `<div><span style="height:${Math.max(4, Math.round((x.cur.clicks || 0) / maxC * 100))}%"></span><b>${nf.format(Math.round(x.cur.clicks || 0))}</b><small dir="ltr">${esc(String(x.month).slice(5))}</small></div>`).join('')}</div>` : '';
    const report = card(`<h2>${esc(T.seoReport)}</h2>${cur ? `<div class="ac-stats"><div><b>${nf.format(Math.round(cur.clicks))}</b><span>${esc(T.seoClicks)}</span></div><div><b>${nf.format(Math.round(cur.impressions))}</b><span>${esc(T.seoImpressions)}</span></div><div><b>${cur.position ? cur.position.toFixed(1) : '—'}</b><span>${esc(T.seoPosition)}</span></div></div>${(rep.queries || []).length ? `<h3 class="ac-h3">${esc(T.seoQueries)}</h3><ol class="ac-queries">${rep.queries.slice(0, 8).map((q: any) => `<li dir="auto"><span>${esc(q.q)}</span><small>${q.clicks} · ${q.position}</small></li>`).join('')}</ol>` : ''}` : `<p class="ac-muted">${esc(T.seoNoData)}</p>`}${trend}`);
    // Keyword ranks: latest week vs the first week we have (up to 8 weeks back)
    const weeks = v.ranks?.data || [];
    const lastW = weeks[weeks.length - 1] || {}, firstW = weeks.length > 1 ? weeks[0] : {};
    const kws: string[] = (brief.keywords || []).length ? brief.keywords : Object.keys(lastW);
    const rankRows = kws.map((k) => {
      const p = lastW[k]?.p ?? null, p0 = firstW[k]?.p ?? null;
      const ch = p != null && p0 != null ? Math.round((p0 - p) * 10) / 10 : null;
      return `<tr><td dir="auto">${esc(k)}</td><td>${p == null ? `<span class="ac-muted">${esc(T.seoNotYet)}</span>` : '#' + p}</td><td>${ch == null || ch === 0 ? '—' : `<span class="${ch > 0 ? 'ac-up' : 'ac-down'}">${ch > 0 ? '▲' : '▼'} ${Math.abs(ch)}</span>`}</td><td>${nf.format(lastW[k]?.c || 0)}</td></tr>`;
    }).join('');
    const ranks = card(`<h2>${esc(T.seoRanks)}</h2>${!kws.length ? `<p class="ac-muted">${esc(T.seoRanksEmpty)}</p>` : !weeks.length ? `<p class="ac-muted">${esc(T.seoRanksWait)}</p>` : `<div class="ac-table-wrap"><table class="ac-table"><thead><tr><th>${esc(T.seoKw)}</th><th>${esc(T.seoPos)}</th><th>${esc(T.seoChange)}</th><th>${esc(T.seoClicks)}</th></tr></thead><tbody>${rankRows}</tbody></table></div><p class="ac-muted ac-small" dir="ltr">${esc(v.ranks.weeks[v.ranks.weeks.length - 1] || '')}</p>`}`);
    // Technical check
    const tech = rep?.tech;
    const h = v.health;
    const techCard = tech || h ? card(`<h2>${esc(T.seoTech)}</h2>${tech ? `<div class="ac-stats">${tech.performance != null ? `<div><b>${tech.performance}</b><span>${esc(T.seoSpeed)} /100</span></div>` : ''}${tech.lcp ? `<div><b dir="ltr">${esc(tech.lcp)}</b><span>${esc(T.seoLcp)}</span></div>` : ''}${tech.cls ? `<div><b dir="ltr">${esc(tech.cls)}</b><span>${esc(T.seoCls)}</span></div>` : ''}</div>
      <ul class="ac-checks">${Object.entries(tech.checks || {}).map(([k, ok]) => `<li class="${ok ? 'ok' : 'bad'}"><i aria-hidden="true">${ok ? '✓' : '✗'}</i>${esc(T.seoChecks[k] || k)}</li>`).join('')}</ul>` : ''}${h ? `<p class="${h.ok ? 'ac-ok' : 'ac-bad'}">${esc(h.ok ? T.seoHealthOk : T.seoHealthBad)} <small class="ac-muted" dir="ltr">${esc(h.date || '')}</small></p>` : ''}`) : '';
    // Suggestions waiting for approval
    const pending = (v.items || []).filter((x: any) => x.status === 'pending');
    const done = (v.items || []).filter((x: any) => x.status !== 'pending');
    const manual = (x: any) => x.kind === 'gbp' || x.kind === 'llms' || (v.external && !(wpOn && (x.kind === 'article' || x.kind === 'local')));
    const pubLabel = (x: any) => (x.kind === 'gbp' ? T.seoPosted : manual(x) ? T.seoMarkDone : wpOn ? T.seoWpPublish : T.seoApprove);
    const note = (x: any) => (x.kind === 'gbp' ? T.seoGbpNote : x.kind === 'llms' ? T.seoLlmsNote : '');
    const item = (x: any) => `<article class="ac-seo-item" data-seo-item="${x.id}">
      <p class="ac-chip">${esc(T.seoKinds[x.kind] || x.kind)}${x.lang && x.lang !== cfg.lang ? ` · ${esc(x.lang.toUpperCase())}` : ''}</p>
      ${note(x) ? `<p class="ac-muted ac-small">${esc(note(x))}</p>` : ''}
      ${x.kind !== 'llms' ? `<label class="ac-field">${esc(T.seoSuggested)}<input name="title" value="${esc(x.title)}" maxlength="90" dir="auto"></label>` : ''}
      ${x.kind !== 'gbp' && x.kind !== 'llms' ? `<label class="ac-field"><textarea name="description" rows="2" maxlength="180" dir="auto">${esc(x.description)}</textarea></label>` : ''}
      ${x.kind !== 'meta' ? `<details${manual(x) ? ' open' : ''}><summary>${esc(T.seoEdit)}</summary><textarea name="body" rows="${x.kind === 'gbp' ? 5 : 14}" dir="${x.kind === 'llms' ? 'auto' : 'auto'}" class="ac-seo-body">${esc(x.body)}</textarea></details>` : ''}
      <div class="ac-row">${manual(x) ? `<button type="button" class="btn btn-ghost ac-small-btn" data-seo-copy="${x.id}">${esc(T.seoCopy)}</button>` : ''}<button type="button" class="btn btn-amber ac-small-btn" data-seo-pub="${x.id}">${esc(pubLabel(x))}</button><button type="button" class="btn btn-ghost ac-small-btn" data-seo-rej="${x.id}">${esc(T.seoReject)}</button></div>
    </article>`;
    const list = card(`<h2>${esc(T.seoPending)}</h2><p class="ac-muted">${esc(v.external && !wpOn ? T.seoExtNote : T.seoBody)}</p>${pending.length ? pending.map(item).join('') : `<p class="ac-muted">${esc(T.seoNone)}</p>`}`, 'ac-noprint');
    const history = done.length ? card(`<ul class="ac-seo-done">${done.map((x: any) => `<li><span class="ac-chip ${x.status === 'published' ? 'st-active' : ''}">${esc(x.status === 'published' ? T.seoPublished : T.seoRejected)}</span> <span class="ac-muted ac-small">${esc(T.seoKinds[x.kind] || x.kind)}</span> <span dir="auto">${esc(x.title)}</span> ${x.url ? `<a class="ac-link" href="${esc(x.url)}" target="_blank" rel="noopener">↗</a>` : ''}</li>`).join('')}</ul>`) : '';
    // The owner's brief: used by the writer and for rank tracking
    const maxKw = growth ? 30 : 10;
    const ta = (name: string, label: string, val: string, rows = 2, extra = '') => `<label class="ac-field">${esc(label)}<textarea name="${name}" rows="${rows}" dir="auto" ${extra}>${esc(val || '')}</textarea></label>`;
    const briefCard = card(`<h2>${esc(T.seoBrief)}</h2><p class="ac-muted">${esc(T.seoBriefBody)}</p>
      <form id="ac-seo-brief" class="ac-form-grid">
        ${ta('services', T.seoServices, brief.services, 3, 'maxlength="1500"')}
        ${ta('areas', T.seoAreas, brief.areas, 2, 'maxlength="500"')}
        ${ta('audience', T.seoAudience, brief.audience, 2, 'maxlength="500"')}
        ${ta('usp', T.seoUsp, brief.usp, 2, 'maxlength="800"')}
        ${ta('keywords', T.seoKeywords, (brief.keywords || []).join('\n'), 5)}
        <p class="ac-muted ac-small ac-wide">${esc(T.seoKeywordsHint.replace('{n}', String(maxKw)))}</p>
        ${ta('competitors', T.seoCompetitors, (brief.competitors || []).join('\n'), 3)}
        ${ta('notes', T.seoNotes, brief.notes, 3, 'maxlength="1500"')}
        <label class="ac-check ac-wide"><input type="checkbox" name="lang_en" ${(brief.langs || []).includes('en') ? 'checked' : ''} ${growth ? '' : 'disabled'}> ${esc(T.seoLangEn)}${growth ? '' : ` <small class="ac-muted">(${esc(T.seoLangGrowth)})</small>`}</label>
        <div class="ac-wide ac-gbp"><h3 class="ac-h3">${esc(T.seoGbpTitle)}</h3><p class="ac-muted ac-small">${esc(T.seoGbpBody)}</p><p class="ac-mono" dir="ltr">${esc(cfg.gscEmail)}</p>
          <label class="ac-field">${esc(T.seoGbpMaps)}<input name="gbp_maps" type="url" dir="ltr" maxlength="400" value="${esc(gbp.maps || '')}" placeholder="https://maps.app.goo.gl/…"></label>
          <label class="ac-check"><input type="checkbox" name="gbp_manager" ${gbp.manager ? 'checked' : ''}> ${esc(T.seoGbpManager)}</label></div>
        <button type="submit" class="btn btn-navy">${esc(T.seoSave)}</button>
      </form>`, 'ac-noprint');
    const wpCard = !v.external ? '' : card(`<h2>${esc(T.seoWp)}</h2>${wp.url ? `<p class="ac-ok">${esc(T.seoWpConnected)}: <span dir="ltr">${esc(wp.url)}</span> (${esc(wp.user || '')})</p><p><button type="button" class="btn btn-ghost ac-small-btn" data-wp-off>${esc(T.seoWpDisconnect)}</button></p>`
      : `<p class="ac-muted">${esc(T.seoWpBody)}</p><form id="ac-wp" class="ac-form-grid">
        <label class="ac-field">${esc(T.seoWpUrl)}<input name="wp_url" type="url" dir="ltr" required maxlength="200" value="${esc(s0.url ? String(s0.url).replace(/\/$/, '') : '')}"></label>
        <label class="ac-field">${esc(T.seoWpUser)}<input name="wp_user" dir="ltr" required maxlength="80" autocomplete="off"></label>
        <label class="ac-field ac-wide">${esc(T.seoWpPass)}<input name="wp_pass" dir="ltr" required maxlength="80" autocomplete="off" placeholder="xxxx xxxx xxxx xxxx xxxx xxxx"></label>
        <p class="ac-muted ac-small ac-wide">${esc(T.seoWpHow)}</p>
        <button type="submit" class="btn btn-navy">${esc(T.seoWpConnect)}</button></form>`}`, 'ac-noprint');
    return head + leads + report + ranks + techCard + list + briefCard + wpCard + history;
  }

  async function seoSettings(action: string, data: Record<string, unknown>) {
    const res = await fetch(cfg.seoSettingsEndpoint, { method: 'POST', body: new URLSearchParams({ k: token, action, order_id: String(site()!.order_id), data: JSON.stringify(data) }) });
    return res.json().catch(() => ({ success: false }));
  }


  // ---- Social media & ads (Oxira 22 API): Meta connection, brief, monthly plan approvals, report ----
  const socCache: Record<number, any> = {};
  const bgOverride: Record<number, string> = {};
  async function socApi(action: string, data: Record<string, unknown> = {}) {
    const res = await fetch(cfg.socialEndpoint, { method: 'POST', body: new URLSearchParams({ k: token, action, order_id: String(site()!.order_id), data: JSON.stringify(data) }) });
    return res.json().catch(() => ({ success: false }));
  }
  async function loadSocial(orderId: number, force = false) {
    const box = root.querySelector<HTMLElement>('#ac-social');
    if (!box) return;
    if (!socCache[orderId] || force) {
      const v = await socApi('list');
      if (v?.reason === 'expired') { signOut(T.expired); return; }
      socCache[orderId] = v?.success ? v : { items: [], settings: { brief: {}, meta: {} }, plan: '', ads: false };
    }
    if (site()!.order_id !== orderId) return;
    box.innerHTML = socialHtml(socCache[orderId]);
    paintSocial(socCache[orderId]);
  }
  function social(_s: Site) { return `<div id="ac-social"><p class="ac-muted">${esc(T.loading)}</p></div>`; }
  const imgUrl = (id: string) => (id ? cfg.imageBase + id : '');
  const opt = (v: string, label: string, cur: string) => `<option value="${esc(v)}"${v === cur ? ' selected' : ''}>${esc(label)}</option>`;
  function socialHtml(v: any) {
    const s0 = site()!;
    const nf = new Intl.NumberFormat(cfg.numberLocale);
    const b = v.settings?.brief || {}, m = v.settings?.meta || {};
    const pro = v.plan === 'pro';
    const hasSocial = !!v.plan;
    // Connection
    const noPages = !(m.pages || []).length;
    const connect = card(`<h2>${esc(T.socConnectTitle)}</h2>${m.connected || m.connected_at ? `
        <div class="ac-conn">
          <p><span class="ac-chip st-active">${esc(T.socConnected)}</span> ${m.user_name ? esc(m.user_name) : ''}</p>
          ${noPages ? `<p class="ac-note">${esc(T.socNoPages)}</p>` : ''}
          <form id="ac-meta-select" class="ac-form-grid">
            ${noPages ? '' : `<label class="ac-field">${esc(T.socPage)}<select name="page_id">${(m.pages || []).map((p: any) => opt(p.id, p.name + (p.ig_username ? ' · @' + p.ig_username : ''), m.page_id)).join('')}</select></label>`}
            ${v.ads ? `<label class="ac-field">${esc(T.socAdAcc)}<select name="ad_account_id"><option value="">—</option>${(m.adaccounts || []).map((a: any) => opt(a.id, a.name + ' (' + a.currency + ')', m.ad_account_id)).join('')}</select></label>` : ''}
            ${noPages ? '' : `<p class="ac-wide ac-muted ac-small">${m.ig_username ? `${esc(T.socIg)}: <b dir="ltr">@${esc(m.ig_username)}</b>` : esc(T.socNoIg)}</p>`}
            <div class="ac-row ac-wide">${noPages ? '' : `<button type="submit" class="btn btn-navy ac-small-btn">${esc(T.socSave)}</button>`}<button type="button" class="btn btn-ghost ac-small-btn" data-soc-connect>${esc(T.socReconnect)}</button><button type="button" class="btn btn-ghost ac-small-btn" data-soc-disconnect>${esc(T.socDisconnect)}</button></div>
          </form>
        </div>`
      : `<p class="ac-muted">${esc(T.socConnectBody)}</p>${v.metaReady ? `<p><button type="button" class="btn btn-navy" data-soc-connect>${esc(T.socConnect)}</button></p>` : `<p class="ac-note">${esc(T.socNotReady)}</p>`}`}`);
    // Plan
    const items: any[] = v.items || [];
    const months = [...new Set(items.filter((x) => x.kind !== 'reply').map((x) => x.month))].sort();
    const status = (x: any) => `<span class="ac-chip st-${esc(x.status)}">${esc((T.socStatus as any)[x.status] || x.status)}</span>`;
    const pf = (x: any) => String(x.platforms || 'instagram,facebook').split(',');
    const post = (x: any) => {
      const open = x.status === 'pending' || x.status === 'failed';
      return `<article class="ac-sp" data-soc-item="${x.id}">
        <canvas width="1080" height="1080" data-soc-canvas="${x.id}"></canvas>
        <div class="ac-sp-body">
          <p class="ac-row ac-sp-head">${status(x)} <span class="ac-muted ac-small" dir="ltr">${esc(x.day)} · ${esc(x.time)}</span></p>
          ${open ? `
          <label class="ac-field">${esc(T.socHeadline)}<input name="title" value="${esc(x.title)}" maxlength="120" dir="auto" data-soc-redraw="${x.id}"></label>
          <label class="ac-field">${esc(T.socCaption)}<textarea name="caption" rows="5" maxlength="2200" dir="auto">${esc(x.caption)}</textarea></label>
          <label class="ac-field">${esc(T.socHashtags)}<input name="hashtags" value="${esc(x.hashtags)}" maxlength="400" dir="auto"></label>
          <div class="ac-form-grid">
            <label class="ac-field">${esc(T.socDay)}<input type="date" name="day" value="${esc(x.day)}"></label>
            <label class="ac-field">${esc(T.socTime)}<input type="time" name="time" step="3600" value="${esc(x.time)}"></label>
          </div>
          <p class="ac-row">${['instagram', 'facebook'].map((p) => `<label class="ac-check"><input type="checkbox" name="platforms" value="${p}" ${pf(x).includes(p) ? 'checked' : ''}> ${esc((T.socPlatformNames as any)[p])}</label>`).join('')}</p>
          ${x.result?.error || x.result?.fb_error || x.result?.ig_error ? `<p class="ac-bad ac-small">${esc(x.result.error || x.result.fb_error || x.result.ig_error)}</p>` : ''}
          <div class="ac-row">
            <button type="button" class="btn btn-amber ac-small-btn" data-soc-approve="${x.id}">${esc(T.socApprove)}</button>
            <label class="btn btn-ghost ac-small-btn ac-file">${esc(T.socChangePhoto)}<input type="file" accept="image/jpeg,image/png" data-soc-photo="${x.id}" hidden></label>
            <button type="button" class="btn btn-ghost ac-small-btn" data-soc-reject="${x.id}">${esc(T.socReject)}</button>
          </div>` : `<p class="ac-caption" dir="auto">${esc(x.caption)}</p><p class="ac-tags" dir="auto">${esc(x.hashtags)}</p>`}
          <p class="ac-row"><button type="button" class="ac-link" data-soc-dl="${x.id}">${esc(T.socDownload)}</button><button type="button" class="ac-link" data-soc-copy="${x.id}">${esc(T.socCopy)}</button></p>
        </div>
      </article>`;
    };
    const reel = (x: any) => `<article class="ac-sp" data-soc-item="${x.id}">
        <canvas width="1080" height="1920" data-soc-canvas="${x.id}" class="ac-reel"></canvas>
        <div class="ac-sp-body">
          <p class="ac-row ac-sp-head">${status(x)} <span class="ac-muted ac-small" dir="ltr">${esc(x.day)}</span></p>
          <h3 class="ac-h3" dir="auto">${esc(x.title)}</h3>
          <p class="ac-kicker">${esc(T.socScript)}</p><p class="ac-caption" dir="auto">${esc(x.idea)}</p>
          <p class="ac-caption" dir="auto">${esc(x.caption)}</p><p class="ac-tags" dir="auto">${esc(x.hashtags)}</p>
          <p class="ac-row"><button type="button" class="ac-link" data-soc-dl="${x.id}">${esc(T.socDownloadCover)}</button><button type="button" class="ac-link" data-soc-copy="${x.id}">${esc(T.socCopy)}</button>
          ${x.status === 'pending' ? `<button type="button" class="btn btn-ghost ac-small-btn" data-soc-approve="${x.id}">${esc(T.socFilmed)}</button>` : ''}</p>
        </div>
      </article>`;
    const ad = (x: any) => {
      const a = x.ad || {};
      const open = x.status === 'pending' || x.status === 'failed';
      const res = x.result || {};
      return `<article class="ac-ad" data-soc-item="${x.id}">
        <p class="ac-row ac-sp-head">${status(x)} <b dir="auto">${esc(x.title)}</b></p>
        <dl class="ac-ad-meta">
          <div><dt>${esc(T.socGoal)}</dt><dd>${esc((T.socGoals as any)[a.goal] || a.goal || '')}</dd></div>
          <div><dt>${esc(T.socAudienceAd)}</dt><dd>${esc((a.cities || []).join('، ') || 'KSA')} · ${esc(a.age_min || 18)}–${esc(a.age_max || 65)}${(a.interests || []).length ? ' · ' + esc(a.interests.join(', ')) : ''}</dd></div>
          ${a.post_title ? `<div><dt>${esc(T.socBoostPost)}</dt><dd dir="auto">${esc(a.post_title)} (${esc(a.post_day)})</dd></div>` : `<div><dt>${esc(T.socLink)}</dt><dd dir="ltr">${esc(a.link || '')}</dd></div>`}
        </dl>
        ${a.why ? `<p class="ac-muted ac-small" dir="auto">💡 ${esc(a.why)}</p>` : ''}
        ${open && res.error ? `<p class="ac-bad ac-small">${esc((T.socErr as any)[res.error] || res.error)}</p>` : ''}
        ${open ? `<label class="ac-field">${esc(T.socAdHeadline)}<input name="headline" value="${esc(a.headline || '')}" maxlength="80" dir="auto"></label>
          <label class="ac-field">${esc(T.socAdText)}<textarea name="text" rows="4" maxlength="1500" dir="auto">${esc(a.text || '')}</textarea></label>
          <div class="ac-form-grid"><label class="ac-field">${esc(T.socBudget)}<input type="number" name="budget" min="20" step="10" value="${esc(a.budget || 0)}"></label>
          <label class="ac-field">${esc(T.socDays)}<input type="number" name="days" min="3" max="30" value="${esc(a.days || 7)}"></label></div>
          <p class="ac-muted ac-small">${esc(T.socAdNote)}</p>
          <div class="ac-row"><button type="button" class="btn btn-amber ac-small-btn" data-soc-approve="${x.id}">${esc(T.socApproveAd)}</button><button type="button" class="btn btn-ghost ac-small-btn" data-soc-reject="${x.id}">${esc(T.socReject)}</button></div>`
        : `<p class="ac-caption" dir="auto">${esc(a.text || '')}</p><p class="ac-muted ac-small">${esc(T.socBudget)}: <b>${money(Number(a.budget) || 0)}</b> · ${esc(T.socDays)}: ${esc(a.days || '')}${res.end ? ` · ${esc(T.socEnds)} <span dir="ltr">${esc(String(res.end).slice(0, 10))}</span>` : ''}</p>${res.error ? `<p class="ac-bad ac-small">${esc(res.error)}</p>` : ''}`}
      </article>`;
    };
    const plan = !months.length ? card(`<h2>${esc(T.socPlan)}</h2><p class="ac-muted">${esc(T.socPlanEmpty)}</p>`)
      : months.map((mo) => {
        const inMonth = items.filter((x) => x.month === mo);
        const posts = inMonth.filter((x) => x.kind === 'post'), reels = inMonth.filter((x) => x.kind === 'reel'), ads = inMonth.filter((x) => x.kind === 'ad');
        const pending = inMonth.filter((x) => x.status === 'pending' && x.kind !== 'reply').length;
        return card(`<div class="ac-plan-head"><h2>${esc(T.socPlan)} <span dir="ltr">${esc(mo)}</span></h2>${pending ? `<span class="ac-chip st-pending">${esc(T.socWaiting.replace('{n}', String(pending)))}</span>` : ''}</div>
          ${posts.length ? `<h3 class="ac-h3">${esc(T.socPosts)} (${posts.length})</h3><div class="ac-sp-grid">${posts.map(post).join('')}</div>` : ''}
          ${reels.length ? `<h3 class="ac-h3">${esc(T.socReels)} (${reels.length})</h3><div class="ac-sp-grid">${reels.map(reel).join('')}</div>` : ''}
          ${ads.length ? `<h3 class="ac-h3">${esc(T.socAds)} (${ads.length})</h3>${!m.ad_account_id ? `<p class="ac-note">${esc(T.socNeedAdAcc)}</p>` : ''}<div class="ac-ads">${ads.map(ad).join('')}</div>` : ''}`);
      }).join('');
    // Report
    const rep = v.report;
    const t = rep?.totals || {};
    const report = rep ? card(`<h2>${esc(T.socReport)} <span dir="ltr">${esc(rep.month)}</span></h2>
