---
import { t, type Lang } from '../i18n/content';
import { link } from '../lib/routes';
import Base from '../layouts/Base.astro';
import AgentsDemo from '../components/AgentsDemo.astro';
import CtaBand from '../components/CtaBand.astro';
import { landings, landingPath } from '../i18n/landing';
import { waText, isWaLang, waPath } from '../i18n/waAgent';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t[lang];
const a = c.agents;
const other = lang === 'ar' ? 'en' : 'ar';
// Related service, location and blog pages (Arabic and English only).
const lp = lang === 'ar' || lang === 'en' ? lang : null;
const rel = lp
  ? [
      { href: link(lang, waPath), label: waText[lp].name },
      ...['business-automation', 'egypt', 'gulf'].map((slug) => landings.find((l) => l.slug === slug)!).map((l) => ({ href: link(lang, landingPath(l)), label: l[lp].name })),
      { href: link(lang, '/products/ai-chatbot/'), label: lp === 'ar' ? 'الشات بوت للموقع' : 'Website chatbot' },
      ...(lp === 'ar' ? [{ href: link('ar', '/blog/whatsapp-ai-agent-benefits/'), label: 'فوائد وكيل الذكاء الاصطناعي على واتساب' }] : []),
    ]
  : [];
const wa = isWaLang(lang) ? waText[lang] : null;
const contactHref = `${link(lang, '/contact/')}?service=${encodeURIComponent(c.services.list.find((s) => s.icon === 'agent')!.name)}`;
---
<Base lang={lang} path="/ai-agents/" title={c.pages.agents.title} description={c.pages.agents.description}>
  <section class="page-hero ag-hero">
    <div class="wrap ag-hero-grid">
      <div>
        <p class="label" lang={lang === 'ar' ? 'en' : undefined}>{a.kicker}</p>
        <h1>{a.title}</h1>
        <p class="lead">{a.body}</p>
        <div class="ag-actions">
          {wa
            ? <><a class="btn btn-amber" href={link(lang, waPath)}>{wa.agentsCta}</a><a class="btn btn-ghost" href={contactHref}>{a.cta}</a></>
            : <><a class="btn btn-amber" href={contactHref}>{a.cta}</a><button type="button" class="btn btn-ghost" data-open-chat>{c.chat.open}</button></>}
        </div>
      </div>
      <AgentsDemo lang={lang} />
    </div>
  </section>

  <section class="section-tight bg-paper" aria-label={a.capabilities[0].name}>
    <div class="wrap">
      <ul class="caps">
        {a.capabilities.map((cap) => <li><h2>{cap.name}</h2><p>{cap.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="sectors-title">
    <div class="wrap">
      <div class="sh"><h2 id="sectors-title">{a.sectorsTitle}</h2><p>{a.sectorsBody}</p></div>
      <ul class="sectors">
        {a.sectors.map((s) => (
          <li>
            <h3>{s.name}</h3>
            <p class="who">{s.who}</p>
            <p>{s.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-navy" aria-labelledby="steps-title">
    <div class="wrap">
      <div class="sh"><h2 id="steps-title">{a.stepsTitle}</h2></div>
      <ol class="steps">
        {a.steps.map((st, i) => (
          <li>
            <span class="s-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{st.name}</h3>
            <p>{st.text}</p>
          </li>
        ))}
      </ol>
      <div class="pricing">
        <p>{a.pricing}</p>
        <div class="ag-actions ag-actions-tight">
          {wa && <a class="btn btn-amber" href={link(lang, waPath)}>{wa.agentsCta}</a>}
          <a class={`btn ${wa ? 'btn-ghost-light' : 'btn-amber'}`} href={contactHref}>{a.cta}</a>
        </div>
      </div>
    </div>
  </section>

  {rel.length > 0 ? (
    <section class="section-tight ag-rel" aria-labelledby="ag-rel-title">
      <div class="wrap">
        <h2 id="ag-rel-title">{lp === 'ar' ? 'صفحات ذات صلة' : 'Related pages'}</h2>
        <ul>{rel.map((r) => <li><a href={r.href}>{r.label}</a></li>)}</ul>
      </div>
    </section>
  ) : <div style="height: var(--section)"></div>}
  <CtaBand lang={lang} />
</Base>

<script>
  document.querySelectorAll('[data-open-chat]').forEach((b) =>
    b.addEventListener('click', () => (document.getElementById('ox-fab') as HTMLButtonElement | null)?.click())
  );
</script>

<style>
  .ag-hero-grid { display: grid; grid-template-columns: 1fr auto; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  .ag-hero h1 { margin-top: .75rem; font-size: var(--s4); max-width: 14ch; }
  .ag-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2.25rem; }
  .ag-actions-tight { margin-top: 0; }
  @media (max-width: 960px) { .ag-hero-grid { grid-template-columns: 1fr; } }

  .caps { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.25rem 2rem; }
  .caps li { display: grid; gap: .4rem; }
  .caps h2 { font-size: var(--s1); }
  .caps p { color: var(--muted); }
  @media (max-width: 860px) { .caps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .caps { grid-template-columns: 1fr; } }

  .sectors { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); gap: 1.25rem; }
  .sectors li { padding: 1.75rem; border-radius: var(--radius); border: 1px solid var(--line); display: grid; gap: .5rem; align-content: start; }
  .sectors h3 { font-size: var(--s1); }
  .who { color: var(--blue); font-weight: 700; font-size: .92rem; }
  .sectors p:last-child { color: var(--muted); }

  .steps { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .steps li { display: grid; gap: .6rem; align-content: start; border-top: 1px solid rgba(255,255,255,.15); padding-top: 1.25rem; }
  .s-n { font-weight: 700; font-size: 2.2rem; line-height: 1; color: var(--amber); }
  .steps h3 { font-size: var(--s1); }
  .steps p { color: var(--muted-on-navy); }
  .pricing { margin-top: clamp(2.5rem, 5vw, 4rem); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.75rem 2rem; border-radius: var(--radius); background: rgba(255,255,255,.06); }
  .ag-rel h2 { font-size: var(--s1); margin-bottom: 1rem; }
  .ag-rel ul { list-style: none; display: flex; flex-wrap: wrap; gap: .6rem; }
  .ag-rel a { display: inline-block; padding: .6rem 1.1rem; border-radius: 999px; border: 1px solid var(--line); text-decoration: none; font-weight: 600; }
  .ag-rel a:hover { border-color: var(--navy); }
  .pricing p { font-size: 1.15rem; max-width: 46rem; }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .steps { grid-template-columns: 1fr; } }
</style>
