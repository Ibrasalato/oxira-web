---
import { t, type Lang } from '../i18n/content';
import { link } from '../lib/routes';
import Logo from './Logo.astro';
import LangPicker from './LangPicker.astro';
import { builderText } from '../i18n/builder';
import { productsText, productPath } from '../i18n/products';
import { productIds, addonIcons } from '../builder/addons';
import { growthText } from '../i18n/growth';

interface Props { lang: Lang; path: string; langs?: Lang[] }
const { lang, path, langs } = Astro.props;
const c = t[lang];
const b = builderText[lang];
const P = productsText[lang];
const onProducts = path === '/website-builder/' || path === '/studio/' || path.startsWith('/products/');
const acct = b.account as any;
const bellText = { title: acct.notifTitle, empty: acct.notifEmpty, t: acct.notif, names: { ...(acct.products || {}), ...Object.fromEntries(productIds.map((id) => [id, P.items[id].name])) } };
const agentsLabel = c.site.nav.find((n) => n.path === '/ai-agents/')?.label ?? 'AI';
import { bundleText } from '../i18n/bundle';
---
<header class="hd" id="hd">
  <div class="wrap hd-row">
    <a class="hd-brand" href={link(lang, '/')} aria-label="Oxira">
      <Logo variant="light" />
    </a>

    <nav class="hd-nav" id="hd-nav" aria-label={lang === 'ar' ? 'القائمة الرئيسية' : 'Main'}>
      <ul>
        {c.site.nav.map((n) => (
          <li><a href={link(lang, n.path)} aria-current={path === n.path ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <li class="hd-dd">
          <button type="button" class="hd-build" id="hd-dd-btn" aria-expanded="false" aria-controls="hd-prod" data-current={onProducts ? 'page' : undefined}>
            {P.nav.products}<span class="hd-new">{b.badge}</span>
            <svg class="hd-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>
          <div class="hd-panel" id="hd-prod">
            <a class="hd-feat" href={link(lang, '/website-builder/')}>
              <span class="hd-new">{b.badge}</span>
              <b>{P.nav.websiteBuilder}</b>
              <small>{P.nav.websiteBuilderDesc}</small>
              <span class="hd-feat-go">{P.common.buildSite}</span>
            </a>
            <div class="hd-col">
              <p class="hd-h">{P.nav.addonsTitle}</p>
              <ul class="hd-addons">
                {productIds.map((id) => (
                  <li><a href={link(lang, productPath(id))} aria-current={path === productPath(id) ? 'page' : undefined}><span class="hd-ic"><svg viewBox="0 0 24 24" set:html={addonIcons[id]} /></span>{P.items[id].name}</a></li>
                ))}
              </ul>
            </div>
            <div class="hd-col">
              <p class="hd-h">{P.nav.otherTitle}</p>
              <ul class="hd-other">
                <li><a href={link(lang, '/classti/')}><b>Classti</b><small>{P.nav.classtiDesc}</small></a></li>
                <li><a href={link(lang, '/ai-agents/')}><b>{agentsLabel}</b><small>{P.nav.agentsDesc}</small></a></li>
                <li><a href={link(lang, '/online-in-a-day/')}><b>{bundleText[lang].nav}</b><small>{bundleText[lang].navDesc}</small></a></li>
                <li><a href={link(lang, '/website-audit/')}><b>{growthText[lang].audit.nav}</b><small dir="ltr">SEO · HTTPS · Mobile</small></a></li>
              </ul>
              <a class="more hd-all" href={link(lang, '/products/')}>{P.nav.all}</a>
            </div>
          </div>
        </li>
      </ul>
      <a class="btn btn-navy hd-cta-mobile" href={link(lang, '/contact/')}>{c.site.contactCta}</a>
    </nav>

    <div class="hd-end">
      <LangPicker lang={lang} path={path} langs={langs} />
      <a class="hd-acct hd-signin" href={link(lang, '/account/')} aria-current={path === '/account/' ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" /></svg>
        <span>{P.nav.signIn}</span>
      </a>
      <div class="hd-bell" id="hd-bell" data-t={JSON.stringify(bellText)} data-acc={link(lang, '/account/')}>
        <button type="button" class="hd-bell-btn" id="hd-bell-btn" aria-expanded="false" aria-controls="hd-bell-menu" aria-label={P.nav.notifications}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z" /><path d="M10 20a2 2 0 0 0 4 0" /></svg>
          <span class="hd-badge" hidden></span>
        </button>
        <div class="hd-bell-menu" id="hd-bell-menu"><p class="hd-bell-h">{P.nav.notifications}</p><ul id="hd-bell-list"></ul></div>
      </div>
      <div class="hd-user" id="hd-user">
        <button type="button" class="hd-user-btn" id="hd-user-btn" aria-expanded="false" aria-controls="hd-user-menu" aria-label={P.nav.accountMenu}>
          <span class="hd-av" data-av></span>
          <svg class="hd-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </button>
        <div class="hd-user-menu" id="hd-user-menu">
          <div class="hd-user-head"><span class="hd-av hd-av-lg" data-av></span><div><b data-me-name></b><small data-me-email dir="ltr"></small></div></div>
          <a href={`${link(lang, '/account/')}#home`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z" /></svg>{P.nav.dashboard}</a>
          <a href={`${link(lang, '/account/')}#overview`}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2" /><path d="M3 8h18M8 21h8" /></svg>{P.nav.mySites}</a>
          <a href={`${link(lang, '/account/')}#billing`}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18M7 15h4" /></svg>{P.nav.billing}</a>
          <a href={`${link(lang, '/account/')}#profile`}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" /></svg>{P.nav.profile}</a>
          <button type="button" data-hd-out><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 17l5-5-5-5M15 12H4" /></svg>{P.nav.signOut}</button>
        </div>
      </div>
      <script is:inline>try { if (localStorage.getItem('oxira-portal-k')) document.documentElement.classList.add('ox-in'); } catch (e) {}</script>
      <a class="btn btn-navy hd-cta" href={link(lang, '/contact/')} aria-current={path === '/contact/' ? 'page' : undefined}>{c.site.contactCta}</a>
      <button type="button" class="hd-menu" id="hd-menu" aria-controls="hd-nav" aria-expanded="false">
        <span class="sr-only">{c.site.menu}</span>
        <i></i><i></i>
      </button>
    </div>
  </div>
</header>

<script>
  const hd = document.getElementById('hd')!;
  const btn = document.getElementById('hd-menu') as HTMLButtonElement;
  btn.addEventListener('click', () => {
    const open = hd.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  });
  // Products menu: opens on click (and on hover with a mouse); closes on Escape or a click outside.
  const dd = document.querySelector<HTMLElement>('.hd-dd')!;
  const ddBtn = document.getElementById('hd-dd-btn') as HTMLButtonElement;
  const setDd = (open: boolean) => { dd.classList.toggle('is-dd', open); ddBtn.setAttribute('aria-expanded', String(open)); };
  const hover = window.matchMedia('(hover: hover) and (min-width: 1201px)');
  // With a mouse the menu is already open on hover, so a click keeps it open instead of closing it.
  ddBtn.addEventListener('click', () => setDd(hover.matches || !dd.classList.contains('is-dd')));
  let leaveT = 0;
  dd.addEventListener('mouseenter', () => { if (hover.matches) { clearTimeout(leaveT); setDd(true); } });
  dd.addEventListener('mouseleave', () => { if (hover.matches) leaveT = window.setTimeout(() => setDd(false), 180); });
  document.addEventListener('click', (e) => { if (!dd.contains(e.target as Node) && hover.matches) setDd(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && dd.classList.contains('is-dd')) { setDd(false); ddBtn.focus(); } });
  dd.addEventListener('focusout', (e) => { if (hover.matches && !dd.contains(e.relatedTarget as Node)) setDd(false); });

  // Signed-in user: avatar menu instead of the sign-in button (session from the account page, kept in localStorage).
  const KEY = 'oxira-portal-k', ME = 'oxira-portal-me';
  const userBox = document.getElementById('hd-user')!;
  const userBtn = document.getElementById('hd-user-btn') as HTMLButtonElement;
  const read = (k: string) => { try { return localStorage.getItem(k) || ''; } catch { return ''; } };
  function paintUser() {
    const signed = !!read(KEY);
    document.documentElement.classList.toggle('ox-in', signed);
    let me: { name?: string; email?: string; avatar?: string } = {};
    try { me = JSON.parse(read(ME) || '{}'); } catch { me = {}; }
    const name = String(me.name || '') || String(me.email || '').split('@')[0];
    const parts = name.trim().split(/\s+/).filter(Boolean);
    const initials = ((parts[0]?.[0] || '') + (parts[1]?.[0] || '')).toUpperCase();
    userBox.querySelectorAll<HTMLElement>('[data-av]').forEach((el) => {
      el.replaceChildren();
      if (me.avatar && /^https:\/\/[^\s"']+$/.test(me.avatar)) { const img = new Image(); img.src = me.avatar; img.alt = ''; img.decoding = 'async'; el.append(img); }
      else if (initials) el.textContent = initials;
      else el.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" /></svg>';
    });
    userBox.querySelector<HTMLElement>('[data-me-name]')!.textContent = name;
    userBox.querySelector<HTMLElement>('[data-me-email]')!.textContent = String(me.email || '');
  }
  paintUser();
  window.addEventListener('ox-me', paintUser);
  window.addEventListener('storage', (e) => { if (e.key === KEY || e.key === ME) paintUser(); });
  const setUser = (open: boolean) => { userBox.classList.toggle('is-open', open); userBtn.setAttribute('aria-expanded', String(open)); };
  userBtn.addEventListener('click', () => setUser(!userBox.classList.contains('is-open')));
  document.addEventListener('click', (e) => { if (!userBox.contains(e.target as Node)) setUser(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && userBox.classList.contains('is-open')) { setUser(false); userBtn.focus(); } });
  userBox.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setUser(false)));
  userBox.querySelector('[data-hd-out]')!.addEventListener('click', () => {
    const k = read(KEY);
    if (k) fetch('https://ibrasalato.app.n8n.cloud/webhook/oxira-auth', { method: 'POST', body: new URLSearchParams({ action: 'logout', k }), keepalive: true }).catch(() => undefined);
    try { localStorage.removeItem(KEY); localStorage.removeItem(ME); sessionStorage.removeItem('oxira-notif'); } catch { /* ignore */ }
    setUser(false);
    paintUser();
    if (/\/account\/?$/.test(location.pathname)) location.reload();
  });

  // Notifications bell (signed-in): from the account API, cached for 5 minutes in this tab.
  const bell = document.getElementById('hd-bell')!;
  const bellBtn = document.getElementById('hd-bell-btn') as HTMLButtonElement;
  const BT = JSON.parse(bell.dataset.t || '{}');
  const escH = (v: unknown) => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  function paintBell(items: any[]) {
    const badge = bell.querySelector<HTMLElement>('.hd-badge')!;
    badge.hidden = !items.length; badge.textContent = items.length > 9 ? '9+' : String(items.length);
    const list = document.getElementById('hd-bell-list')!;
    if (!items.length) { list.innerHTML = `<li class="hd-bell-empty">${escH(BT.empty)}</li>`; return; }
    list.innerHTML = items.map((x) => {
      const txt = String(BT.t?.[x.type] || x.type).replace('{product}', BT.names?.[x.product] || x.product || '').replace('{site}', x.site || '').replace('{n}', String(x.n ?? '')).replace('{date}', x.date || '').replace('{subject}', x.subject || '');
      return `<li><a href="${escH(bell.dataset.acc + '#' + (x.href || 'home'))}" data-order="${escH(x.order_id || '')}"><i class="hd-n-${escH(x.type)}"></i><span>${escH(txt)}</span></a></li>`;
    }).join('');
  }
  async function loadBell(force = false) {
    const k = read(KEY);
    if (!k) { paintBell([]); return; }
    try { const c = JSON.parse(sessionStorage.getItem('oxira-notif') || 'null'); if (!force && c && c.k === k && Date.now() - c.at < 300000) { paintBell(c.items); return; } } catch { /* ignore */ }
    try {
      const res = await fetch('https://ibrasalato.app.n8n.cloud/webhook/oxira-account', { method: 'POST', body: new URLSearchParams({ k, action: 'notifications', lang: document.documentElement.lang || 'ar' }) });
      const r = await res.json();
      const items = r?.success ? r.items : [];
      try { sessionStorage.setItem('oxira-notif', JSON.stringify({ k, at: Date.now(), items })); } catch { /* ignore */ }
      paintBell(items);
    } catch { paintBell([]); }
  }
  loadBell();
  window.addEventListener('ox-notif-refresh', () => loadBell(true));
  window.addEventListener('ox-me', () => loadBell());
  const setBell = (open: boolean) => { bell.classList.toggle('is-open', open); bellBtn.setAttribute('aria-expanded', String(open)); };
  bellBtn.addEventListener('click', () => { setUser(false); setBell(!bell.classList.contains('is-open')); });
  document.addEventListener('click', (e) => { if (!bell.contains(e.target as Node)) setBell(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setBell(false); });
  bell.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-order]');
    if (!a) return;
    if (a.dataset.order) { try { localStorage.setItem('oxira-portal-site', a.dataset.order); } catch { /* ignore */ } }
    setBell(false);
  });

  const onScroll = () => hd.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .hd { position: sticky; top: 0; z-index: 40; border-bottom: 1px solid transparent; transition: border-color .2s; }
  .hd::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgba(255,255,255,.92); backdrop-filter: saturate(1.4) blur(12px); }
  .hd.is-open::before { background: #fff; }
  .hd.is-scrolled { border-bottom-color: var(--line); }
  .hd-row { display: flex; align-items: center; gap: 2rem; min-height: 4.75rem; }
  .hd-brand { font-size: 1.4rem; text-decoration: none; flex: none; }

  .hd-nav { flex: 1; }
  .hd-nav ul { list-style: none; display: flex; align-items: center; gap: clamp(.9rem, 1.7vw, 1.75rem); }
  .hd-nav ul a { white-space: nowrap; text-decoration: none; font-weight: 600; color: var(--muted); padding-block: .4rem; border-bottom: 2px solid transparent; }
  .hd-nav ul a:hover { color: var(--ink); }
  .hd-nav ul a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--amber); }
  .hd-cta-mobile { display: none; }
  .hd-nav ul a.hd-build { color: var(--ink); display: inline-flex; align-items: center; gap: .4rem; }
  .hd-new { font-size: .68rem; font-weight: 700; line-height: 1; padding: .28rem .45rem; border-radius: 999px; background: var(--amber); color: var(--navy); }

  .hd-dd { position: relative; }
  .hd-nav ul button.hd-build { font: 600 1rem var(--font); background: none; border: 0; border-bottom: 2px solid transparent; padding: .4rem 0; cursor: pointer; color: var(--ink); display: inline-flex; align-items: center; gap: .4rem; white-space: nowrap; }
  .hd-build[data-current='page'] { border-bottom-color: var(--amber) !important; }
  .hd-chev { width: 16px; height: 16px; flex: none; fill: none; stroke: currentColor; stroke-width: 2.2; transition: transform .2s; }
  .is-dd .hd-chev { transform: rotate(180deg); }
  .hd-panel { display: none; position: absolute; top: calc(100% + .9rem); inset-inline-start: 50%; translate: -50% 0; width: min(860px, calc(100vw - 2rem)); padding: 1.25rem; border-radius: 20px; background: #fff; border: 1px solid var(--line); box-shadow: 0 30px 70px -30px rgba(6, 26, 45, .45); grid-template-columns: 1fr 1.2fr 1fr; gap: 1.25rem; }
  html[dir='rtl'] .hd-panel { translate: 50% 0; }
  .hd-panel::before { content: ''; position: absolute; inset-inline: 0; top: -1rem; height: 1rem; }
  .is-dd .hd-panel { display: grid; }
  .hd-nav .hd-panel a { border: 0; padding: 0; color: var(--ink); white-space: normal; }
  .hd-nav .hd-panel a.hd-feat { display: flex; flex-direction: column; align-items: flex-start; gap: .5rem; padding: 1.25rem; border-radius: 14px; background: radial-gradient(circle at 80% 0%, rgba(34,199,230,.35), transparent 55%), var(--navy); color: #fff; }
  .hd-feat b { font-size: 1.2rem; }
  .hd-nav .hd-panel a.hd-feat { justify-content: space-between; }
  .hd-feat-go { margin-top: auto; padding: .6rem 1rem; border-radius: 10px; background: var(--amber); color: var(--navy); font-weight: 700; font-size: .92rem; }
  .hd-feat small { color: var(--muted-on-navy); font-size: .9rem; line-height: 1.5; }
  .hd-h { font-size: .8rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; margin-bottom: .5rem; }
  .hd-nav .hd-panel ul { display: grid; gap: .15rem; }
  .hd-nav .hd-panel ul a { display: flex; align-items: center; gap: .65rem; padding: .45rem .5rem; border-radius: 10px; font-weight: 600; font-size: .95rem; }
  .hd-nav .hd-panel ul a:hover, .hd-nav .hd-panel ul a[aria-current='page'] { background: var(--paper); color: var(--ink); }
  .hd-ic { width: 32px; height: 32px; flex: none; border-radius: 9px; background: var(--blue-soft); color: var(--blue); display: grid; place-items: center; }
  .hd-ic svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .hd-nav .hd-other a { flex-direction: column; align-items: flex-start !important; gap: .1rem !important; }
  .hd-other small { color: var(--muted); font-weight: 400; font-size: .85rem; line-height: 1.45; }
  .hd-nav .hd-panel a.hd-all { display: inline-flex; margin-top: .75rem; padding-inline: .5rem; color: var(--blue); }

  .hd-acct { display: inline-flex; align-items: center; gap: .45rem; height: 44px; padding: 0 .9rem; border-radius: 12px; border: 1.5px solid var(--line); text-decoration: none; font-weight: 600; font-size: .95rem; color: var(--ink); white-space: nowrap; }
  .hd-acct:hover, .hd-acct[aria-current='page'] { border-color: var(--navy); }
  .hd-acct svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }

  .hd-end { display: flex; align-items: center; gap: .75rem; }

  .hd-bell { display: none; position: relative; }
  :global(html.ox-in) .hd-bell { display: block; }
  .hd-bell-btn { position: relative; width: 44px; height: 44px; border-radius: 12px; border: 1.5px solid var(--line); background: #fff; display: grid; place-items: center; cursor: pointer; color: var(--ink); }
  .hd-bell-btn:hover, .hd-bell.is-open .hd-bell-btn { border-color: var(--navy); }
  .hd-bell-btn svg { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .hd-badge { position: absolute; top: -6px; inset-inline-end: -6px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px; background: #D92D20; color: #fff; font-size: .7rem; font-weight: 700; display: grid; place-items: center; border: 2px solid #fff; }
  .hd-badge[hidden] { display: none; }
  .hd-bell-menu { display: none; position: absolute; top: calc(100% + .6rem); inset-inline-end: -3.5rem; width: min(22rem, calc(100vw - 2rem)); max-height: 70vh; overflow: auto; background: #fff; border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 24px 60px -24px rgba(6, 26, 45, .45); padding: .5rem; z-index: 50; }
  .hd-bell.is-open .hd-bell-menu { display: block; }
  .hd-bell-h { margin: 0; padding: .5rem .6rem .7rem; font-weight: 800; border-bottom: 1px solid var(--line); }
  .hd-bell-menu ul { list-style: none; margin: .3rem 0 0; padding: 0; display: grid; gap: .1rem; }
  .hd-bell-menu :global(a) { display: flex; gap: .6rem; align-items: flex-start; padding: .6rem; border-radius: 10px; text-decoration: none; color: var(--ink); font-size: .9rem; line-height: 1.5; }
  .hd-bell-menu :global(a:hover) { background: var(--paper); }
  .hd-bell-menu :global(i) { flex: none; width: 8px; height: 8px; margin-top: .45rem; border-radius: 50%; background: var(--amber); }
  .hd-bell-menu :global(i.hd-n-pay), .hd-bell-menu :global(i.hd-n-meta), .hd-bell-menu :global(i.hd-n-ticket_admin) { background: #D92D20; }
  .hd-bell-menu :global(i.hd-n-ticket), .hd-bell-menu :global(i.hd-n-booking) { background: #2E90FA; }
  .hd-bell-menu :global(.hd-bell-empty) { padding: 1.2rem .6rem; color: var(--muted); text-align: center; font-size: .9rem; }
  @media (max-width: 1200px) { .hd-bell-btn { width: 40px; height: 40px; } }
  @media (max-width: 600px) {
    .hd-end { gap: .35rem; }
    .hd-bell-btn { width: 38px; height: 38px; border-radius: 10px; }
    .hd-user-btn { height: 38px; padding: 0 .2rem; }
    .hd-user-btn .hd-chev { display: none; }
    .hd-av { width: 30px; height: 30px; font-size: .75rem; }
    .hd-bell-menu { position: fixed; top: 4.4rem; inset-inline: 1rem; width: auto; }
    .hd-user-menu { position: fixed; top: 4.4rem; inset-inline: 1rem; width: auto; }
  }
  .hd-user { display: none; position: relative; }
  :global(html.ox-in) .hd-user { display: block; }
  :global(html.ox-in) .hd-signin { display: none; }
  .hd-user-btn { display: inline-flex; align-items: center; gap: .3rem; height: 44px; padding: 0 .45rem 0 .3rem; border-radius: 999px; border: 1.5px solid var(--line); background: #fff; cursor: pointer; color: var(--ink); }
  .hd-user-btn:hover, .hd-user.is-open .hd-user-btn { border-color: var(--navy); }
